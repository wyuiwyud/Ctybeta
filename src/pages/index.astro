  <!-- ========================================================================= -->
  <!-- 7. HỆ THỐNG MENU TƯƠNG TÁC BIỂN BÁO ĐÈN LED (TACO SIGNPOST INTERACTIVE)   -->
  <!-- ========================================================================= -->
  <InteractiveSignpostMenu />

  <!-- ========================================================================= -->
  <!-- CLIENT INTERACTIVE CONTROLLERS (Preloader, Drawers, GA Canvas, ROI)      -->
  <!-- ========================================================================= -->
  <script>
    // 1. CAD ARCHITECTURAL PRELOADER LOGIC & DUAL-ARM NEXUS ANIMATION
    function initPreloader() {
      const preloader = document.getElementById('cad-preloader');
      const counter = document.getElementById('cad-counter');
      const progressBar = document.getElementById('cad-progress-bar');
      const statusMsg = document.getElementById('cad-status-msg');

      const handLeftArm = document.getElementById('hand-left-arm');
      const handRightArm = document.getElementById('hand-right-arm');
      const handCenterLogoWrap = document.getElementById('hand-center-logo-wrap');
      const handCenterLogo = document.getElementById('hand-center-logo');
      const logoCorona = document.getElementById('hand-logo-corona');
      const nexusContainer = document.getElementById('dual-hand-nexus-container');

      const infinityGhostTrack = document.getElementById('infinity-ghost-track');
      const infinityLaserStroke = document.getElementById('infinity-laser-stroke');
      const infinitySparkHead = document.getElementById('infinity-spark-head');
      const infinitySparkAnim = document.getElementById('infinity-spark-anim');

      if (!preloader) {
        window.dispatchEvent(new CustomEvent('stage-unlocked'));
        return;
      }

      function triggerExplosionEffect() {
        const shockwave1 = document.getElementById('hand-shockwave-1');
        const shockwave2 = document.getElementById('hand-shockwave-2');
        const shockwave3 = document.getElementById('hand-shockwave-3');
        const flareH = document.getElementById('hand-flare-h');
        const flareV = document.getElementById('hand-flare-v');
        const explosionCore = document.getElementById('hand-explosion-core');
        const sparks = document.querySelectorAll('.nexus-spark-particle');

        // Sóng xung kích 3 tầng
        if (shockwave1) {
          shockwave1.classList.remove('animate-shockwave-1');
          void shockwave1.offsetWidth;
          shockwave1.classList.add('animate-shockwave-1');
        }
        if (shockwave2) {
          shockwave2.classList.remove('animate-shockwave-2');
          void shockwave2.offsetWidth;
          shockwave2.classList.add('animate-shockwave-2');
        }
        if (shockwave3) {
          shockwave3.classList.remove('animate-shockwave-3');
          void shockwave3.offsetWidth;
          shockwave3.classList.add('animate-shockwave-3');
        }

        // Tia chớp hào quang ngang & dọc
        if (flareH) {
          flareH.classList.remove('animate-flare-h');
          void flareH.offsetWidth;
          flareH.classList.add('animate-flare-h');
        }
        if (flareV) {
          flareV.classList.remove('animate-flare-v');
          void flareV.offsetWidth;
          flareV.classList.add('animate-flare-v');
        }

        // Lõi chớp sáng Plasma
        if (explosionCore) {
          explosionCore.classList.remove('animate-explosion-core');
          void explosionCore.offsetWidth;
          explosionCore.classList.add('animate-explosion-core');
        }

        // Hào quang vương miện quanh Logo
        if (logoCorona) {
          logoCorona.style.opacity = '1';
          logoCorona.style.transform = 'translate(-50%, -50%) scale(1)';
        }

        // 12 Tia lửa hạt năng lượng bắn tỏa hình nan hoa
        sparks.forEach((s) => {
          const angle = parseFloat((s as HTMLElement).dataset.angle || '0');
          const dist = 115 + Math.random() * 65;
          const rad = (angle * Math.PI) / 180;
          const tx = Math.cos(rad) * dist;
          const ty = Math.sin(rad) * dist;

          s.animate([
            { transform: 'translate(-50%, -50%) translate(0px, 0px) scale(1.6)', opacity: 1 },
            { transform: `translate(-50%, -50%) translate(${tx}px, ${ty}px) scale(0)`, opacity: 0 }
          ], {
            duration: 880,
            easing: 'cubic-bezier(0.12, 0.9, 0.25, 1)'
          });
        });
      }

      let step1Timer: any = null;
      let step2Timer: any = null;
      let step3Timer: any = null;

      // Hoạt ảnh 3 giai đoạn điện ảnh:
      // Giai đoạn 1: 2 Cánh tay lao từ 2 mép màn hình vào giữa kết hợp thành hình Vô cực
      // Giai đoạn 2: Tia laser neon chạy vòng quanh tạo nét Vô cực rực rỡ
      // Giai đoạn 3: Chữ A 3D bùng nổ Supernova xuất hiện rõ nét tại tâm
      function playDualArmConvergence(isReplay = false) {
        if (!handLeftArm || !handRightArm || !handCenterLogoWrap) return;

        // Dọn dẹp timer đang chạy nếu có
        clearTimeout(step1Timer);
        clearTimeout(step2Timer);
        clearTimeout(step3Timer);

        if (nexusContainer) nexusContainer.classList.remove('dual-arm-floating');
        handLeftArm.classList.remove('animate-arm-left-gesture');
        handRightArm.classList.remove('animate-arm-right-gesture');

        // BẮT ĐẦU TỪ 2 MÉP NGOÀI MÀN HÌNH (-85vw và +85vw) VỚI GÓC XOAY CỬ ĐỘNG TỰ NHIÊN
        handLeftArm.style.transition = isReplay ? 'transform 0.4s ease-out, opacity 0.3s ease-out' : 'none';
        handRightArm.style.transition = isReplay ? 'transform 0.4s ease-out, opacity 0.3s ease-out' : 'none';
        handCenterLogoWrap.style.transition = isReplay ? 'transform 0.35s ease-out, opacity 0.25s ease-out' : 'none';

        handLeftArm.style.transform = 'translateX(-85vw) rotate(-6deg)';
        handLeftArm.style.opacity = '0';
        handRightArm.style.transform = 'translateX(85vw) rotate(6deg)';
        handRightArm.style.opacity = '0';
        handCenterLogoWrap.style.transform = 'scale(0)';
        handCenterLogoWrap.style.opacity = '0';

        if (infinityGhostTrack) {
          infinityGhostTrack.style.opacity = '0';
        }
        if (infinityLaserStroke) {
          infinityLaserStroke.classList.remove('animate-trace-infinity', 'infinity-loop-glowing');
          infinityLaserStroke.style.opacity = '0';
        }
        if (infinitySparkHead) {
          infinitySparkHead.style.opacity = '0';
        }

        if (logoCorona) {
          logoCorona.style.opacity = '0';
          logoCorona.style.transform = 'translate(-50%, -50%) scale(0.5)';
        }

        // Bước 1: 2 Cánh tay lao từ 2 mép màn hình vào giữa tâm, uốn lượn cử động sinh học
        step1Timer = setTimeout(() => {
          handLeftArm.style.transition = 'transform 0.92s cubic-bezier(0.12, 0.9, 0.25, 1), opacity 0.45s ease-out';
          handRightArm.style.transition = 'transform 0.92s cubic-bezier(0.12, 0.9, 0.25, 1), opacity 0.45s ease-out';
          handLeftArm.style.transform = 'translateX(0) rotate(0deg)';
          handLeftArm.style.opacity = '1';
          handRightArm.style.transform = 'translateX(0) rotate(0deg)';
          handRightArm.style.opacity = '1';
        }, isReplay ? 300 : 80);

        // Bước 2: Hai bàn tay vừa khép lại ra hình thù VÔ CỰC -> TIA LASER CHẠY QUANH TẠO NÉT VÔ CỰC HIỆN RÕ LÊN!
        step2Timer = setTimeout(() => {
          if (infinityGhostTrack) {
            infinityGhostTrack.style.opacity = '0.6';
          }

          if (infinityLaserStroke) {
            infinityLaserStroke.classList.remove('animate-trace-infinity', 'infinity-loop-glowing');
            void infinityLaserStroke.offsetWidth; // Force reflow để restart CSS animation
            infinityLaserStroke.style.opacity = '1';
            infinityLaserStroke.classList.add('animate-trace-infinity');
          }

          if (infinitySparkHead) {
            infinitySparkHead.style.opacity = '1';
            try {
              (infinitySparkAnim as any)?.beginElement?.();
            } catch (e) {}
          }
        }, isReplay ? 1280 : 980);

        // Bước 3: Sau khi nét Vô cực đã chạy xong -> HIỆN RÕ LÊN TIẾP CHỮ A (BÙNG NỔ SUPERNOVA RỰC RỠ TẠI TÂM)!
        step3Timer = setTimeout(() => {
          // Ẩn hạt sao chổi, chuyển viền laser sang chế độ phát sáng hào quang vĩnh cửu
          if (infinitySparkHead) {
            infinitySparkHead.style.opacity = '0';
          }
          if (infinityLaserStroke) {
            infinityLaserStroke.classList.add('infinity-loop-glowing');
          }

          // Kích hoạt toàn bộ hiệu ứng bùng nổ Supernova (Lens Flare, 3 Shockwaves, Plasma Core, 12 Sparks)
          triggerExplosionEffect();

          // Biểu tượng chữ A 3D bung nở sắc nét tại tâm vô cực
          handCenterLogoWrap.style.transition = 'transform 0.75s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.22s ease-out';
          handCenterLogoWrap.style.transform = 'scale(1)';
          handCenterLogoWrap.style.opacity = '1';

          // Kích hoạt cử động thở & nhịp rung sinh học tự nhiên cho 2 cánh tay
          handLeftArm.classList.add('animate-arm-left-gesture');
          handRightArm.classList.add('animate-arm-right-gesture');

          if (nexusContainer) {
            nexusContainer.classList.add('dual-arm-floating');
          }
        }, isReplay ? 2020 : 1720);
      }

      playDualArmConvergence(false);

      if (nexusContainer) {
        nexusContainer.addEventListener('click', (e) => {
          e.stopPropagation(); // Giữ nguyên preloader để thưởng thức lại hoạt ảnh
          playDualArmConvergence(true);
        });
      }

      const statusStages = [
        { pct: 20, msg: 'INITIALIZING THREE.JS WEBGL RENDERER...' },
        { pct: 45, msg: 'DEPLOYING DUAL-ARM VECTOR COORDINATES...' },
        { pct: 75, msg: 'SYNCHRONIZING INFINITY LASER TRACE...' },
        { pct: 95, msg: 'SUPERNOVA ERUPTION // MONOLITH "A" ONLINE' },
        { pct: 100, msg: 'STAGE READY // LAUNCHING ADOLSOFT ENGINE' }
      ];

      let interval: any = null;
      let progress = 0;

      const safetyTimer = setTimeout(() => {
        clearInterval(interval);
        if (preloader) preloader.classList.add('loaded');
        window.dispatchEvent(new CustomEvent('stage-unlocked'));
      }, 4200);

      preloader.addEventListener('click', () => {
        clearInterval(interval);
        clearTimeout(safetyTimer);
        if (preloader) preloader.classList.add('loaded');
        window.dispatchEvent(new CustomEvent('stage-unlocked'));
      });

      interval = setInterval(() => {
        progress += Math.floor(Math.random() * 2) + 2;
        if (progress > 100) progress = 100;

        if (counter) counter.textContent = `${String(progress).padStart(3, '0')}%`;
        if (progressBar) progressBar.style.width = `${progress}%`;

        const currentStage = statusStages.find((s) => progress <= s.pct) || statusStages[statusStages.length - 1];
        if (statusMsg) statusMsg.textContent = currentStage.msg;

        if (progress >= 100) {
          clearInterval(interval);
          clearTimeout(safetyTimer);
          setTimeout(() => {
            if (preloader) preloader.classList.add('loaded');
            window.dispatchEvent(new CustomEvent('stage-unlocked'));
          }, 850);
        }
      }, 50);
    }

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initPreloader);
    } else {
      initPreloader();
    }

    // 2. SPATIAL MODAL DRAWERS MANAGEMENT (ROI Lab & Domain Blueprint)
    function openDrawer(drawerId: string) {
      const drawer = document.getElementById(`drawer-${drawerId}`);
      if (drawer) {
        drawer.classList.add('open');
        document.body.style.overflow = 'hidden';
        window.dispatchEvent(new CustomEvent('spatial-drawer-state', { detail: { open: true, drawerId } }));
      }
    }

    function closeDrawer(drawerId: string) {
      const drawer = document.getElementById(`drawer-${drawerId}`);
      if (drawer) {
        drawer.classList.remove('open');
        const anyOpen = document.querySelectorAll('.spatial-drawer.open').length > 0;
        if (!anyOpen) {
          document.body.style.overflow = '';
          window.dispatchEvent(new CustomEvent('spatial-drawer-state', { detail: { open: false } }));
        }
      }
    }

    document.querySelectorAll('[data-open-drawer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.openDrawer;
        if (id) {
          openDrawer(id);
        }
      });
    });

    document.querySelectorAll('[data-close-drawer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.closeDrawer;
        if (id) closeDrawer(id);
      });
    });

    // Close on clicking backdrop
    document.querySelectorAll('.spatial-drawer').forEach((drawer) => {
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) {
          const id = drawer.id.replace('drawer-', '');
          closeDrawer(id);
        }
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.spatial-drawer.open').forEach((drawer) => {
          const id = drawer.id.replace('drawer-', '');
          closeDrawer(id);
        });
      }
    });

    // 3. DOMAIN BLUEPRINT INSPECTION MODAL LISTENER
    window.addEventListener('open-domain-modal', (e: any) => {
      const idx = e.detail?.index ?? 0;
      const domains = (window as any).ADOLSOFT_DOMAINS;
      if (!domains || !domains[idx]) return;

      const d = domains[idx];
      const blueprintCode = document.getElementById('blueprint-code');
      const blueprintBadge = document.getElementById('blueprint-badge');
      const blueprintTitle = document.getElementById('blueprint-title');
      const blueprintSubtitle = document.getElementById('blueprint-subtitle');
      const blueprintSummary = document.getElementById('blueprint-summary');
      const blueprintSpecs = document.getElementById('blueprint-specs');
      const blueprintRoi = document.getElementById('blueprint-roi');
      const blueprintCanvas = document.getElementById('blueprint-detail-canvas') as HTMLCanvasElement;

      if (blueprintCode) blueprintCode.textContent = `● ${d.index} // ${d.category}`;
      if (blueprintBadge) blueprintBadge.textContent = d.metric;
      if (blueprintTitle) blueprintTitle.textContent = d.title;
      if (blueprintSubtitle) blueprintSubtitle.textContent = d.subtitle;
      if (blueprintSummary) blueprintSummary.textContent = d.summary;
      if (blueprintRoi) blueprintRoi.textContent = d.roiImpact;

      if (blueprintSpecs && Array.isArray(d.specs)) {
        blueprintSpecs.innerHTML = d.specs.map((s: string) => `<li>${s}</li>`).join('');
      }

      if (blueprintCanvas && typeof (window as any).renderDomainBlueprintToCanvas === 'function') {
        (window as any).renderDomainBlueprintToCanvas(idx, blueprintCanvas);
      }

      openDrawer('domain-blueprint');
    });

    // Track mouse position on spatial drawer panel for specular highlight
    window.addEventListener('pointermove', (e) => {
      document.querySelectorAll<HTMLElement>('.spatial-drawer-panel').forEach((panel) => {
        const rect = panel.getBoundingClientRect();
        panel.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        panel.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });
  </script>
</BaseLayout>
