---
// src/pages/index.astro
// ADOLSOFT — Spatial WebGL Storytelling Engine & Industrial Automation R&D
// Implements 6 core upgrade pillars:
// 1. Refracted Liquid Glass "A" Monolith Prism with in-scene ADOLSOFT backplane & ghost blend watermark
// 2. Cylindrical Vault with flipped horizontal UV (zero TFOSLODA mirror bug) and HERO -> WORKS morph
// 3. 4-Corner Non-Colliding HUD (Bottom-Left Tweakpane, Bottom-Right Domain & News, Top-Right Quaternion Gizmo)
// 4. 6 Cylindrical Curved Domain Cards with Vertex Shader lens curve, edge chromatic aberration, and floor reflections
// 5. CAD Architectural Preloader (ảnh_8.jpg upgrade: solid 'A' + wireframe 'DOLSOFT' + 000%–100% kernel counter)
// 6. Interactive Spatial Glassmorphic Drawers (B2B ROI & Live Genetic Auto-Nesting Lab, Founder Profile, Domain Blueprint)

import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ThreeCanvas from '../components/ThreeCanvas.astro';
import InteractiveSignpostMenu from '../components/InteractiveSignpostMenu.astro';
---

<BaseLayout
  title="ADOLSOFT® — AI Solution Architecture & Spatial WebGL Storytelling Engine"
  description="Hệ sinh thái Tự động hóa Dàn trang & Cắt bế Decal bằng AI (AI Print-Cut) và Hệ điều hành Nhà máy AI OS Edge. Sáng lập bởi Lê Trường Duy."
>
  <!-- HEADER NAVIGATION & QUATERNION 3D GIZMO -->
  <Navbar />

  <!-- FIXED THREE.JS WEBGL STORYTELLING STAGE -->
  <ThreeCanvas />

  <!-- SCROLL STORY TRACK (600vh drives the GSAP ScrollTrigger Scrubbing) -->
  <main class="relative w-full pointer-events-none" aria-hidden="true">
    <div id="scroll-story-track" class="relative w-full" style="height: 600vh;"></div>
  </main>

  <!-- ========================================================================= -->
  <!-- 5. CAD ARCHITECTURAL PRELOADER (Matches ảnh_8.jpg Benchmark)              -->
  <!-- Solid white 'A' + fine wireframe 'DOLSOFT' + Shader Kernel counter 0-100% -->
  <!-- ========================================================================= -->
  <aside
    id="cad-preloader"
    class="fixed inset-0 z-[99999] bg-[#040407] flex flex-col items-center justify-center select-none"
    role="dialog"
    aria-label="Loading AdolSoft Engine"
  >
    <!-- Architectural CAD Grid Background -->
    <div class="cad-grid-bg"></div>

    <!-- 4 Corner Precision Crosshairs -->
    <div class="absolute top-6 left-6 text-white/30 font-mono text-xs">+ [0.0, 0.0]</div>
    <div class="absolute top-6 right-6 text-white/30 font-mono text-xs">[W, 0.0] +</div>
    <div class="absolute bottom-6 left-6 text-white/30 font-mono text-xs">+ [0.0, H]</div>
    <div class="absolute bottom-6 right-6 text-white/30 font-mono text-xs">[W, H] +</div>

    <!-- Top Telemetry Metadata -->
    <div class="relative z-10 mb-8 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/[0.04] border border-white/10 font-mono text-[10px] tracking-[0.24em] text-[#c8ff00] uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c8ff00] animate-pulse"></span>
        ADOLSOFT ARCHITECTURAL KERNEL // V2.0
      </div>
      <p class="mt-2 font-mono text-[9.5px] tracking-widest text-white/35 uppercase">
        OPTICAL BENCHMARK // THREE.JS 0.186 // SHADER PIPELINE
      </p>
    </div>

    <!-- Centerpiece Typography: Solid Monolith 'A' + Wireframe 'DOLSOFT' -->
    <div class="relative z-10 flex items-baseline justify-center tracking-tight select-none mb-2">
      <!-- Solid White Monolith 'A' với hiệu ứng phát sáng nhẹ -->
      <span class="font-['Syne'] font-extrabold text-white text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-none drop-shadow-[0_0_35px_rgba(255,255,255,0.4)]">
        A
      </span>
      <!-- Wireframe / Outline 'DOLSOFT' với Technical Stroke -->
      <span
        class="font-['Syne'] font-extrabold text-transparent text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-none ml-1.5"
        style="-webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.65); letter-spacing: 0.04em;"
      >
        DOLSOFT
      </span>
    </div>

    <!-- Architectural Dimension Reference Line -->
    <div class="relative z-10 w-64 sm:w-80 md:w-96 my-5 flex items-center justify-between text-white/35 font-mono text-[9px] tracking-wider">
      <span>|◀ 108.4mm</span>
      <div class="flex-1 h-[1px] bg-white/20 mx-3 relative">
        <div class="absolute -top-1 left-1/2 -translate-x-1/2 px-1 bg-[#040407] text-[8.5px] text-[#c8ff00]/80">
          DELTA PRISM
        </div>
      </div>
      <span>▶|</span>
    </div>

    <!-- Loading Progress Bar & Status Text -->
    <div class="relative z-10 w-64 sm:w-80 md:w-96 flex flex-col gap-2">
      <div class="flex items-center justify-between font-mono text-[11px]">
        <span id="cad-status-msg" class="text-white/60 tracking-wider text-[10px] truncate max-w-[220px]">
          INITIALIZING SHADERS...
        </span>
        <span id="cad-counter" class="text-[#c8ff00] font-bold tracking-widest">
          000%
        </span>
      </div>
      <div class="w-full h-[3px] bg-white/10 rounded-full overflow-hidden">
        <div id="cad-progress-bar" class="h-full bg-[#c8ff00] w-0 transition-all duration-75"></div>
      </div>
      <div class="flex items-center justify-between font-mono text-[8.5px] tracking-widest text-white/30 uppercase mt-1">
        <span>MEM: ALLOCATED</span>
        <span>IOR: 1.52 // DISP: 6.0</span>
      </div>
    </div>

    <!-- DUAL-ARM NEXUS ANIMATION: 2 CÁNH TAY TỪ 2 MÉP MÀN HÌNH HỘI TỤ & BÙNG NỔ LOGO -->
    <div
      id="dual-hand-nexus-container"
      class="relative z-10 mt-6 sm:mt-8 w-full flex flex-col items-center justify-center group cursor-pointer select-none overflow-visible"
      title="Nhấp để phát lại hoạt ảnh 2 cánh tay từ 2 mép màn hình và logo bùng nổ"
    >
      <!-- Vòng hào quang đa sắc xung quanh (Sci-Fi Ambient Pulse) -->
      <div class="absolute -inset-6 rounded-3xl bg-gradient-to-r from-[#22c55e]/25 via-[#c8ff00]/20 to-[#0070f3]/25 blur-2xl opacity-70 pointer-events-none nexus-aura-pulse"></div>

      <!-- Sân khấu căn giữa cho 2 cánh tay và logo bùng nổ (Kích thước lớn hoành tráng) -->
      <div class="relative w-[94vw] sm:w-[620px] md:w-[740px] lg:w-[860px] xl:w-[940px] max-w-5xl aspect-[920/513] flex items-center justify-center overflow-visible">

        <!-- Quầng hào quang vương miện tỏa sáng vĩnh cửu sau bùng nổ (Corona Glow) -->
        <div
          id="hand-logo-corona"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full bg-gradient-to-r from-[#22c55e]/35 via-[#c8ff00]/30 to-[#00f0ff]/20 blur-3xl pointer-events-none opacity-0 scale-50 transition-all duration-1000"
        ></div>

        <!-- Tia chớp hào quang Anamorphic Lens Flare ngang & dọc -->
        <div
          id="hand-flare-h"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-[520px] h-[3px] bg-gradient-to-r from-transparent via-[#c8ff00] to-transparent pointer-events-none opacity-0"
        ></div>
        <div
          id="hand-flare-v"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 h-[420px] w-[3px] bg-gradient-to-b from-transparent via-[#22c55e] to-transparent pointer-events-none opacity-0"
        ></div>

        <!-- Sóng xung kích phát nổ vòng 1 (Shockwave Ring 1 - Lime Gold) -->
        <div
          id="hand-shockwave-1"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-20 h-20 rounded-full border-2 border-[#c8ff00] bg-[#c8ff00]/25 pointer-events-none opacity-0"
        ></div>

        <!-- Sóng xung kích phát nổ vòng 2 (Shockwave Ring 2 - Emerald) -->
        <div
          id="hand-shockwave-2"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-32 h-32 rounded-full border border-[#22c55e] bg-[#22c55e]/15 pointer-events-none opacity-0"
        ></div>

        <!-- Sóng xung kích phát nổ vòng 3 (Shockwave Ring 3 - Electric Cyan Siêu Thanh) -->
        <div
          id="hand-shockwave-3"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-44 h-44 rounded-full border border-[#00f0ff] bg-[#00f0ff]/10 pointer-events-none opacity-0"
        ></div>

        <!-- Lõi chớp sáng bùng nổ Supernova tại tâm (Explosion Core Flash) -->
        <div
          id="hand-explosion-core"
          class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-28 h-28 rounded-full bg-gradient-to-r from-white via-[#c8ff00] to-[#22c55e] blur-xl pointer-events-none opacity-0"
        ></div>

        <!-- 12 Tia lửa hạt năng lượng Plasma đa sắc tỏa ra hình nan hoa khi bùng nổ -->
        <div class="absolute left-[50.6%] top-[22.4%] -translate-x-1/2 -translate-y-1/2 w-0 h-0 pointer-events-none">
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#c8ff00] blur-[0.5px] opacity-0" data-angle="0"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#22c55e] blur-[0.5px] opacity-0" data-angle="30"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#ffffff] blur-[0.5px] opacity-0" data-angle="60"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#c8ff00] blur-[0.5px] opacity-0" data-angle="90"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#22c55e] blur-[0.5px] opacity-0" data-angle="120"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#00f0ff] blur-[0.5px] opacity-0" data-angle="150"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#ffffff] blur-[0.5px] opacity-0" data-angle="180"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#c8ff00] blur-[0.5px] opacity-0" data-angle="210"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#22c55e] blur-[0.5px] opacity-0" data-angle="240"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#00f0ff] blur-[0.5px] opacity-0" data-angle="270"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#ffffff] blur-[0.5px] opacity-0" data-angle="300"></div>
          <div class="nexus-spark-particle absolute w-2.5 h-2.5 rounded-full bg-[#c8ff00] blur-[0.5px] opacity-0" data-angle="330"></div>
        </div>

        <!-- CÁNH TAY TRÁI (L-ARM): Bản vẽ độc lập hoàn chỉnh, lao từ mép trái màn hình vào tâm có góc xoay cử động -->
        <img
          id="hand-left-arm"
          src="/assets/hand_left_full.png"
          alt="AdolSoft Left Hand Full Master (From Screen Left Edge)"
          class="absolute inset-0 w-full h-full object-contain pointer-events-none filter drop-shadow-[0_0_15px_rgba(255,255,255,0.7)] z-[1]"
          style="transform: translateX(-85vw) rotate(-6deg); opacity: 0; will-change: transform, opacity;"
        />

        <!-- CÁNH TAY PHẢI (R-ARM): Bản vẽ độc lập hoàn chỉnh, lao từ mép phải màn hình vào tâm có góc xoay cử động -->
        <img
          id="hand-right-arm"
          src="/assets/hand_right_full.png"
          alt="AdolSoft Right Hand Full Master (From Screen Right Edge)"
          class="absolute inset-0 w-full h-full object-contain pointer-events-none filter drop-shadow-[0_0_15px_rgba(255,255,255,0.7)] z-[1]"
          style="transform: translateX(85vw) rotate(6deg); opacity: 0; will-change: transform, opacity;"
        />

        <!-- SVG TIA LASER NEON CHẠY QUANH VẼ NÉT THÀNH HÌNH VÔ CỰC HIỆN RÕ LÊN -->
        <svg
          id="infinity-tracer-svg"
          viewBox="0 0 920 513"
          class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-[2]"
        >
          <defs>
            <linearGradient id="infinityLaserGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#22c55e" />
              <stop offset="50%" stop-color="#c8ff00" />
              <stop offset="100%" stop-color="#00f0ff" />
            </linearGradient>

            <filter id="infinityLaserGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3.5" result="blur1" />
              <feGaussianBlur stdDeviation="9" result="blur2" />
              <feMerge>
                <feMergeNode in="blur2" />
                <feMergeNode in="blur1" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Đường ray đứt đoạn mờ định hình khung Vô cực chuẩn tâm ngón tay -->
          <path
            id="infinity-ghost-track"
            d="M 465,115 C 430,75 355,75 355,105 C 355,135 430,135 465,115 C 500,75 580,75 580,110 C 580,140 500,145 465,115 Z"
            fill="none"
            stroke="rgba(200, 255, 0, 0.35)"
            stroke-width="2.5"
            stroke-dasharray="5 5"
            class="opacity-0 transition-opacity duration-300"
          />

          <!-- Tia Laser Neon chạy xung quanh vẽ nét Vô cực rực rỡ -->
          <path
            id="infinity-laser-stroke"
            d="M 465,115 C 430,75 355,75 355,105 C 355,135 430,135 465,115 C 500,75 580,75 580,110 C 580,140 500,145 465,115 Z"
            fill="none"
            stroke="url(#infinityLaserGrad)"
            stroke-width="5.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            filter="url(#infinityLaserGlow)"
            class="opacity-0"
          />

          <!-- Hạt sao chổi dẫn đầu tia laser quét quanh đường Vô cực -->
          <circle
            id="infinity-spark-head"
            r="7"
            fill="#ffffff"
            filter="url(#infinityLaserGlow)"
            class="opacity-0"
          >
            <animateMotion
              id="infinity-spark-anim"
              dur="0.75s"
              repeatCount="1"
              fill="freeze"
              begin="indefinite"
              path="M 465,115 C 430,75 355,75 355,105 C 355,135 430,135 465,115 C 500,75 580,75 580,110 C 580,140 500,145 465,115 Z"
            />
          </circle>
        </svg>

        <!-- LOGO BÙNG NỔ NẰM TẠI TÂM: Biểu tượng 3D Lục bảo đồng nhất vô cực, chỉ bung nở sau khi viền Vô cực chạy xong -->
        <div
          id="hand-center-logo-wrap"
          class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-[3]"
          style="transform-origin: 50.6% 22.4%; transform: scale(0); opacity: 0; will-change: transform, opacity, filter;"
        >
          <img
            id="hand-center-logo"
            src="/assets/emblem_harmonized_hd.png"
            alt="AdolSoft Emerald Infinity Core Emblem (Letter 'A')"
            class="w-full h-full object-contain filter drop-shadow-[0_0_18px_rgba(34,197,94,0.85)] drop-shadow-[0_0_35px_rgba(200,255,0,0.5)]"
            style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;"
          />
        </div>
      </div>
    </div>
  </aside>

  <!-- ========================================================================= -->
  <!-- 6. SPATIAL DRAWER 1: FOUNDER & ARCHITECT PROFILE MODAL                    -->
  <!-- ========================================================================= -->
  <div id="drawer-founder-architect" class="spatial-drawer" role="dialog" aria-modal="true" aria-label="Founder and Architect Profile">
    <div class="spatial-drawer-panel p-6 sm:p-8 md:p-10 text-white">
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-white/10 pb-5 mb-6">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[#c8ff00] animate-ping"></span>
          <div>
            <h2 class="font-['Syne'] font-extrabold text-lg sm:text-xl text-white tracking-wide">
              ADOLSOFT ARCHITECTURAL LABS
            </h2>
            <p class="font-mono text-[10.5px] tracking-widest text-[#c8ff00] uppercase">
              FOUNDER & AI SOLUTION ARCHITECT PROFILE
            </p>
          </div>
        </div>

        <button
          type="button"
          data-close-drawer="founder-architect"
          class="px-3 py-1.5 rounded-md border border-white/20 bg-white/5 hover:bg-white/15 text-white/70 hover:text-white font-mono text-xs tracking-wider uppercase transition-colors"
        >
          ✕ Close [ESC]
        </button>
      </div>

      <!-- FOUNDER & ARCHITECT PROFILE CONTENT -->
      <div class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5 flex flex-col items-center sm:items-start text-center sm:text-left gap-4">
            <div class="w-32 h-32 rounded-2xl bg-gradient-to-tr from-[#1a8c4a] via-[#c8ff00] to-white/20 p-[2px] shadow-2xl">
              <div class="w-full h-full bg-[#090d14] rounded-2xl flex flex-col items-center justify-center p-3 relative overflow-hidden group">
                <img
                  src="/logo.png"
                  alt="AdolSoft Logo Emblem"
                  class="w-20 h-20 object-contain drop-shadow-[0_4px_16px_rgba(34,197,94,0.4)]"
                />
                <span class="font-mono text-[9px] tracking-widest text-[#c8ff00] uppercase mt-1">ADOLSOFT LABS</span>
              </div>
            </div>

            <div>
              <h3 class="font-['Syne'] font-extrabold text-2xl text-white">Lê Trường Duy</h3>
              <p class="font-mono text-xs text-[#c8ff00] tracking-widest uppercase mt-0.5">
                Founder & AI Solution Architect // AdolSoft
              </p>
              <p class="font-mono text-[11px] text-white/50 mt-1">
                Top 250 AI Young Guru Toàn Quốc
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <a
                href="tel:0559879392"
                class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-mono text-xs tracking-wider transition-colors"
              >
                📞 0559.879.392
              </a>
              <a
                href="mailto:duy@adolsoft.com"
                class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-mono text-xs tracking-wider transition-colors"
              >
                ✉ duy@adolsoft.com
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 bg-black/40 border border-white/10 rounded-xl p-6 space-y-4 font-mono text-xs leading-relaxed text-white/80">
            <div class="border-b border-white/10 pb-3">
              <span class="text-[#c8ff00] font-bold">[ RESEARCH FOCUS & PHILOSOPHY ]</span>
              <p class="mt-2 text-white/70">
                Nghiên cứu chuyên sâu giải thuật Tối ưu hóa Tổ hợp (Combinatorial Optimization) 2D/3D Irregular Bin-Packing, ứng dụng giải thuật di truyền (Genetic Algorithm) kết hợp Minkowski Difference (No-Fit Polygon) trên nền tảng CPU/GPU phân tán.
              </p>
            </div>

            <div class="border-b border-white/10 pb-3">
              <span class="text-[#6ee7b7] font-bold">[ SỨ MỆNH ZERO-WASTE CHO NGÀNH IN ]</span>
              <p class="mt-2 text-white/70">
                Chuyển giao các bộ công cụ AI hoạt động 100% Offline tới hơn 15,000 xưởng in ấn quảng cáo và bao bì tại Việt Nam. Giúp các chủ xưởng tiết kiệm hàng triệu mét vuông vật tư decal/bạt mỗi năm và chuẩn hóa tay nghề kỹ thuật viên chỉ sau 15 phút cài đặt.
              </p>
            </div>

            <div class="flex items-center justify-between pt-1 text-[11px] text-white/50">
              <span>Định hướng: Master of AI in Australia</span>
              <span class="text-[#c8ff00]">AdolSoft R&D Hub</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 6. SPATIAL DRAWER 2: DOMAIN BLUEPRINT DETAIL MODAL                        -->
  <!-- ========================================================================= -->
  <div id="drawer-domain-blueprint" class="spatial-drawer" role="dialog" aria-modal="true" aria-label="Domain Blueprint Inspection">
    <div class="spatial-drawer-panel p-6 sm:p-8 md:p-10 text-white">
      <!-- Modal Top Bar -->
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-sm bg-[#c8ff00]/15 border border-[#c8ff00]/60 flex items-center justify-center text-[#c8ff00] text-[10px] font-mono shadow-[0_0_12px_rgba(200,255,0,0.35)]">
            ▲
          </span>
          <span id="blueprint-code" class="font-mono text-xs tracking-[0.2em] text-[#c8ff00] uppercase">
            ● 01 // DOMAIN BLUEPRINT
          </span>
          <span id="blueprint-badge" class="px-2 py-0.5 rounded bg-[#1a8c4a]/30 border border-[#1a8c4a] text-[#6ee7b7] font-mono text-[10px]">
            15s vs 45m | -12.5% WASTE
          </span>
        </div>

        <button
          type="button"
          data-close-drawer="domain-blueprint"
          class="px-3 py-1.5 rounded-md border border-white/20 bg-white/5 hover:bg-white/15 text-white/70 hover:text-white font-mono text-xs tracking-wider uppercase transition-colors"
        >
          ✕ Close [ESC]
        </button>
      </div>

      <!-- Main Blueprint Two-Column Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: High-Res Blueprint Canvas (Synced with 3D Card Texture) -->
        <div class="lg:col-span-6 bg-[#070a0f] border border-white/15 rounded-xl p-3 flex flex-col gap-2">
          <div class="flex items-center justify-between font-mono text-[10px] text-white/40 pb-1 border-b border-white/10">
            <span>SPATIAL BLUEPRINT MATRIX</span>
            <span>SCALE: 1:1 REAL-TIME</span>
          </div>
          <div class="relative w-full aspect-[16/10] bg-black rounded-lg overflow-hidden border border-white/10">
            <canvas id="blueprint-detail-canvas" width="1280" height="820" class="w-full h-full block"></canvas>
            <div class="stage-crt-grain pointer-events-none"></div>
          </div>
        </div>

        <!-- Right: Technical Specifications & ROI Impact -->
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div>
            <h3 id="blueprint-title" class="font-['Syne'] font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              AI PRINT-CUT
            </h3>
            <p id="blueprint-subtitle" class="font-mono text-xs text-white/70 mt-1">
              Industrial Edge Detection & Genetic Auto-Nesting Engine
            </p>
          </div>

          <p id="blueprint-summary" class="font-mono text-xs leading-relaxed text-white/80 bg-white/[0.03] p-4 rounded-lg border border-white/10">
            Phần mềm Desktop tự động nhận diện biên dạng tem nhãn (Auto-Contour), bù tràn lề (Auto-Bleed), gắn điểm định vị quang học và xếp khít bằng Giải thuật Di truyền chạy 100% Offline.
          </p>

          <div class="space-y-2">
            <span class="font-mono text-[10px] tracking-widest text-[#c8ff00] uppercase block">
              // THÔNG SỐ KIẾN TRÚC KỸ THUẬT:
            </span>
            <ul id="blueprint-specs" class="space-y-1.5 font-mono text-xs text-white/70 list-disc list-inside">
              <li>Tốc độ xử lý tiền kỳ: Rút ngắn từ 45 phút xuống 14.2 giây/bình trang</li>
              <li>Độ phủ vật liệu trung bình: 94.8% (Tiết kiệm 10–15% Decal/Bạt/PP)</li>
              <li>Xuất trực tiếp PDF/DXF/PLT cho máy Mimaki, Graphtec, Roland, máy Trung Quốc</li>
            </ul>
          </div>

          <div class="p-4 rounded-xl bg-gradient-to-r from-[#1a8c4a]/25 to-black border border-[#1a8c4a] mt-2">
            <span class="font-mono text-[10px] tracking-widest text-[#6ee7b7] uppercase block mb-1">
              ROI & HIỆU QUẢ KINH TẾ
            </span>
            <p id="blueprint-roi" class="font-mono text-xs text-white font-semibold leading-relaxed">
              Thu hồi 100% vốn bản quyền Gói Standard (6–8 triệu/năm) chỉ sau 1.5 tháng.
            </p>
          </div>

          <div class="pt-2 flex items-center gap-3">
            <a
              href="https://zalo.me/0559879392"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 rounded-lg bg-[#c8ff00] hover:bg-[#aee600] text-black font-mono text-xs font-bold tracking-widest uppercase text-center transition-colors"
            >
              Liên Hệ Triển Khai Xưởng In ↗
            </a>
          </div>
        </div>
