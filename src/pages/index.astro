---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeCanvas from '../components/ThreeCanvas.astro';

const services = [
  {
    index: "01",
    title: "WebGL & Spatial 3D",
    desc: "Khởi tạo thế giới tương tác 3D thời gian thực với Three.js, xử lý đổ bóng shader GLSL và tối ưu hóa hiệu năng đồ họa đa nền tảng.",
    tools: ["Three.js", "WebGL", "GLSL Shaders", "Blender Pipeline"]
  },
  {
    index: "02",
    title: "Kinetic UI & Animation",
    desc: "Chuyển động giao diện vi mô tinh tế, biên đạo chuyển cảnh mượt mà với GSAP và trải nghiệm cuộn vô trọng lực cùng Lenis.",
    tools: ["GSAP", "ScrollTrigger", "Lenis", "Motion Design"]
  },
  {
    index: "03",
    title: "High-Performance Architecture",
    desc: "Kiến trúc web tốc độ siêu tốc trên nền tảng Astro, phân phối tĩnh tối ưu, chuẩn SEO kỹ thuật và khả năng tiếp cận chuẩn quốc tế.",
    tools: ["Astro", "Tailwind CSS", "TypeScript", "Vite Engine"]
  },
  {
    index: "04",
    title: "Dark Immersive Identity",
    desc: "Định hình ngôn ngữ thị giác mang đậm dấu ấn tương lai, thẩm mỹ đen tuyền tương phản cao và trải nghiệm thương hiệu độc bản.",
    tools: ["Creative Direction", "Design Systems", "Typography"]
  }
];

const pillars = [
  { number: "01", label: "Pure Black Foundation", value: "#000000", detail: "Nền đen vô tận tôn vinh mọi đường nét" },
  { number: "02", label: "Electric Accent", value: "#D7FF00", detail: "Điểm nhấn xanh chanh dẫn hướng thị giác" },
  { number: "03", label: "Geometric Precision", value: "Geist / Inter", detail: "Typography hình học sắc nét từng pixel" },
];
---

<BaseLayout
  title="ADOLSOFT // Studio Công Nghệ & Trải Nghiệm Số"
  description="Trang web dịch vụ/portfolio phong cách Dark Immersive lấy cảm hứng từ alche.studio, tích hợp Three.js, GSAP, Lenis và Tailwind CSS."
>
  <!-- Nền Three.js 3D không gian tương tác -->
  <ThreeCanvas />

  <!-- ==================== 1. HERO SECTION (100vh) ==================== -->
  <section
    id="hero"
    class="relative z-10 flex min-h-screen w-full flex-col justify-between px-6 pt-28 pb-12 md:px-12 lg:px-20 overflow-hidden"
  >
    <!-- Top badge -->
    <div class="hero-fade-in flex items-center justify-between border-b border-dark-border/60 pb-6 text-xs font-mono uppercase tracking-widest text-neutral-400">
      <div class="flex items-center gap-3">
        <span class="inline-block h-2 w-2 rounded-full bg-accent animate-pulse shadow-[0_0_8px_#d7ff00]"></span>
        <span>CREATIVE TECH STUDIO</span>
      </div>
      <div class="hidden sm:block text-neutral-500">
        ALCHE.STUDIO INSPIRATION // DARK IMMERSIVE
      </div>
      <div class="text-accent font-semibold">
        AVAILABLE 2026
      </div>
    </div>

    <!-- Center Hero Typography -->
    <div class="my-auto max-w-6xl py-12">
      <p class="hero-badge text-xs sm:text-sm font-mono uppercase tracking-[0.25em] text-accent mb-6">
        [ CRAFTING THE NEXT DIGITAL REALMS ]
      </p>

      <h1 class="hero-headline text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold uppercase tracking-tight leading-[0.92]">
        WE SCULPT <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-neutral-100 to-neutral-500">IMMERSIVE</span> <br />
        <span class="text-accent underline decoration-accent/40 decoration-wavy underline-offset-8">EXPERIENCES.</span>
      </h1>

      <p class="hero-subtext mt-8 max-w-2xl text-base sm:text-lg text-neutral-400 font-light leading-relaxed">
        ADOLSOFT là studio công nghệ sáng tạo, kết hợp nghệ thuật thị giác tối giản đương đại với kỹ thuật đồ họa 3D thời gian thực để tạo nên những trải nghiệm số lay động cảm xúc.
      </p>

      <!-- Action Buttons -->
      <div class="hero-cta mt-10 flex flex-wrap items-center gap-5">
        <a
          href="#services"
          class="group inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 text-xs font-bold uppercase tracking-wider text-black transition-all duration-300 hover:bg-accent hover:shadow-[0_0_30px_rgba(215,255,0,0.5)]"
        >
          <span>Khám phá dịch vụ</span>
          <span class="transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
        </a>

        <a
          href="#about"
          class="group inline-flex items-center gap-3 rounded-full border border-dark-border bg-dark-card/60 backdrop-blur-sm px-8 py-4 text-xs font-semibold uppercase tracking-wider text-white transition-all duration-300 hover:border-accent hover:text-accent"
        >
          <span>Về chúng tôi</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <!-- Bottom Indicator -->
    <div class="hero-fade-in flex items-center justify-between border-t border-dark-border/60 pt-6 text-xs font-mono uppercase tracking-widest text-neutral-500">
      <div class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Smooth Scroll (Lenis) Activated</span>
      </div>
      <a href="#about" class="hidden sm:flex items-center gap-2 hover:text-accent transition-colors">
        <span>Scroll to explore</span>
        <span>↓</span>
      </a>
      <div>HANOI // GLOBAL COLLABORATION</div>
    </div>
  </section>

  <!-- ==================== 2. ABOUT SECTION (Giới thiệu) ==================== -->
  <section
    id="about"
    class="relative z-10 w-full border-t border-dark-border/80 bg-black/60 backdrop-blur-md px-6 py-28 md:px-12 lg:px-20"
  >
    <div class="mx-auto max-w-7xl">
      <!-- Section Header -->
      <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-accent mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>01 // Triết Lý & Giới Thiệu</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <!-- Main Statement -->
        <div class="lg:col-span-8">
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-tight leading-tight">
            XÓA NHÒA RANH GIỚI GIỮA <span class="text-accent">MỸ HỌC THỊ GIÁC</span> VÀ <span class="text-white underline decoration-dark-border">CÔNG NGHỆ TƯƠNG TÁC</span>.
          </h2>

          <div class="mt-8 space-y-6 text-base sm:text-lg text-neutral-400 font-light leading-relaxed">
            <p>
              Lấy cảm hứng từ chuẩn mực sáng tạo của các studio hàng đầu thế giới như <strong class="text-white font-medium">alche.studio</strong>, chúng tôi kiến tạo các không gian số nơi mọi tương tác đều có mục đích, mọi pixel đều đạt độ hoàn thiện cao nhất và mỗi mili-giây cuộn trang đều êm ái như chuyển động vật lý tự nhiên.
            </p>
            <p>
              Từ nền tảng công nghệ Astro hiện đại, kết hợp sức mạnh hình học của Three.js và sự mượt mà tuyệt đối từ Lenis & GSAP, chúng tôi biến các ý tưởng đột phá thành sản phẩm sống động trên trình duyệt.
            </p>
          </div>
        </div>

        <!-- Right Quick Info / Studio Stats -->
        <div class="lg:col-span-4 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-dark-border/80 pt-8 lg:pt-0 lg:pl-10 space-y-8">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-neutral-500">Design System</span>
            <h3 class="text-xl font-bold uppercase text-white mt-1">Dark Immersive Standard</h3>
            <p class="text-xs text-neutral-400 mt-2 leading-relaxed">
              Tối ưu hóa độ tương phản tối đa trên màn hình OLED và chuẩn hiển thị cao cấp.
            </p>
          </div>

          <div class="space-y-4">
            {pillars.map((item) => (
              <div class="rounded-xl border border-dark-border bg-dark-card/80 p-4 transition-colors hover:border-accent/60">
                <div class="flex items-center justify-between text-xs font-mono">
                  <span class="text-neutral-500">{item.number}</span>
                  <span class="font-bold text-accent">{item.value}</span>
                </div>
                <div class="mt-2 text-sm font-semibold uppercase text-white">{item.label}</div>
                <div class="mt-1 text-xs text-neutral-400">{item.detail}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. SERVICES SECTION (Dịch vụ) ==================== -->
  <section
    id="services"
    class="relative z-10 w-full border-t border-dark-border/80 bg-black/40 backdrop-blur-sm px-6 py-28 md:px-12 lg:px-20"
  >
    <div class="mx-auto max-w-7xl">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div>
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-accent mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            <span>02 // Năng Lực & Giải Pháp</span>
          </div>
          <h2 class="text-4xl sm:text-6xl font-extrabold uppercase tracking-tight">
            Our Services
          </h2>
        </div>
        <p class="max-w-md text-sm text-neutral-400 leading-relaxed">
          Chúng tôi đồng hành cùng các startup sáng tạo và thương hiệu cao cấp để thiết lập tiêu chuẩn trải nghiệm số khác biệt.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {services.map((item) => (
          <div class="service-item group relative flex flex-col justify-between rounded-2xl border border-dark-border bg-dark-card/90 p-8 sm:p-10 transition-all duration-500 hover:border-accent hover:bg-dark-surface hover:shadow-[0_0_30px_rgba(215,255,0,0.08)]">
            <!-- Card Header -->
            <div>
              <div class="flex items-center justify-between border-b border-dark-border/60 pb-6">
                <span class="font-mono text-xs font-bold text-neutral-500 group-hover:text-accent transition-colors">
                  {item.index}
                </span>
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-dark-border bg-black text-xs text-neutral-400 transition-all duration-300 group-hover:border-accent group-hover:text-accent group-hover:rotate-45">
                  ↗
                </span>
              </div>

              <!-- Title & Desc -->
              <h3 class="mt-8 text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-white group-hover:text-accent transition-colors">
                {item.title}
              </h3>
              <p class="mt-4 text-sm text-neutral-400 leading-relaxed font-light">
                {item.desc}
              </p>
            </div>

            <!-- Tech Pills -->
            <div class="mt-8 pt-6 border-t border-dark-border/40 flex flex-wrap gap-2">
              {item.tools.map((tool) => (
                <span class="rounded-full border border-dark-border bg-black/60 px-3 py-1 font-mono text-[11px] text-neutral-400 group-hover:border-accent/40 group-hover:text-neutral-200 transition-colors">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 4. FOOTER SECTION ==================== -->
  <footer
    id="footer"
    class="relative z-10 w-full border-t border-dark-border/80 bg-black px-6 pt-24 pb-12 md:px-12 lg:px-20"
  >
    <div class="mx-auto max-w-7xl">
      <!-- Big Call to Action -->
      <div class="border-b border-dark-border/80 pb-20">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-accent mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          <span>03 // Hợp Tác & Liên Hệ</span>
        </div>

        <div class="mt-6 flex flex-col lg:flex-row lg:items-end justify-between gap-10">
          <div>
            <h2 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold uppercase tracking-tight leading-[0.95]">
              LET'S BUILD THE <br />
              <span class="text-accent underline decoration-accent/40 underline-offset-8">UNEXPECTED.</span>
            </h2>
            <p class="mt-6 max-w-lg text-sm sm:text-base text-neutral-400 font-light">
              Bạn có một dự án mới đòi hỏi sự đột phá về thẩm mỹ thị giác và công nghệ 3D? Hãy bắt đầu cuộc trò chuyện ngay hôm nay.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <a
              href="mailto:contact@adolsoft.studio"
              class="group inline-flex items-center gap-3 rounded-full bg-accent px-8 py-5 text-xs font-bold uppercase tracking-wider text-black transition-all duration-300 hover:bg-white hover:shadow-[0_0_35px_rgba(255,255,255,0.6)]"
            >
              <span>contact@adolsoft.studio</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation & Meta Info Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-16 text-xs font-mono">
        <div>
          <span class="text-neutral-500 uppercase tracking-widest block mb-4">Navigation</span>
          <ul class="space-y-2 text-neutral-300">
            <li><a href="#hero" class="hover:text-accent transition-colors">Hero (Top)</a></li>
            <li><a href="#about" class="hover:text-accent transition-colors">About Studio</a></li>
            <li><a href="#services" class="hover:text-accent transition-colors">Capabilities</a></li>
            <li><a href="#footer" class="hover:text-accent transition-colors">Contact</a></li>
          </ul>
        </div>

        <div>
          <span class="text-neutral-500 uppercase tracking-widest block mb-4">Social & Network</span>
          <ul class="space-y-2 text-neutral-300">
            <li><a href="https://github.com" target="_blank" rel="noopener" class="hover:text-accent transition-colors">GitHub ↗</a></li>
            <li><a href="https://twitter.com" target="_blank" rel="noopener" class="hover:text-accent transition-colors">X / Twitter ↗</a></li>
            <li><a href="https://linkedin.com" target="_blank" rel="noopener" class="hover:text-accent transition-colors">LinkedIn ↗</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener" class="hover:text-accent transition-colors">Instagram ↗</a></li>
          </ul>
        </div>

        <div>
          <span class="text-neutral-500 uppercase tracking-widest block mb-4">Studio Location</span>
          <div class="text-neutral-300 space-y-1">
            <p>Hanoi, Vietnam</p>
            <p class="text-neutral-500">UTC+07:00</p>
            <p class="text-accent mt-2">Remote // Worldwide</p>
          </div>
        </div>

        <div>
          <span class="text-neutral-500 uppercase tracking-widest block mb-4">Technology Core</span>
          <div class="text-neutral-300 space-y-1">
            <p>Astro 5+ Framework</p>
            <p>Tailwind CSS v4 (Dark Immersive)</p>
            <p>Lenis Smooth Scroll</p>
            <p>Three.js WebGL & GSAP</p>
          </div>
        </div>
      </div>

      <!-- Bottom Copyright Line -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-dark-border/60 pt-8 text-xs font-mono text-neutral-500">
        <div>© 2026 ADOLSOFT. ALL RIGHTS RESERVED.</div>
        <div class="flex items-center gap-4">
          <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
          <span>DARK IMMERSIVE // ALCHE.STUDIO SPEC</span>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>

<!-- GSAP ScrollTrigger & Entrance Animation Script -->
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    // 1. Entrance timeline for Hero
    const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    heroTl
      .from('.hero-badge', {
        opacity: 0,
        y: 20,
        duration: 0.8,
        delay: 0.1,
      })
      .from(
        '.hero-headline',
        {
          opacity: 0,
          y: 45,
          duration: 1.1,
        },
        '-=0.5'
      )
      .from(
        '.hero-subtext',
        {
          opacity: 0,
          y: 20,
          duration: 0.8,
        },
        '-=0.6'
      )
      .from(
        '.hero-cta',
        {
          opacity: 0,
          y: 20,
          duration: 0.8,
        },
        '-=0.5'
      )
      .from(
        '.hero-fade-in',
        {
          opacity: 0,
          duration: 1,
        },
        '-=0.7'
      );

    // 2. ScrollTrigger for Services Cards stagger
    gsap.from('.service-item', {
      scrollTrigger: {
        trigger: '#services',
        start: 'top 75%',
      },
      opacity: 0,
      y: 40,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power3.out',
    });
  });
</script>
