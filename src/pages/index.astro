---
// src/pages/index.astro
// ADOLSOFT — Spatial WebGL Storytelling Engine & Industrial Automation R&D
// Implements 6 core upgrade pillars:
// 1. Refracted Liquid Glass "A" Monolith Prism with in-scene ADOLSOFT backplane & ghost blend watermark
// 2. Cylindrical Vault with flipped horizontal UV (zero TFOSLODA mirror bug) and HERO -> WORKS morph
// 3. 4-Corner Non-Colliding HUD (Bottom-Left Tweakpane, Bottom-Right Domain & News, Top-Right Quaternion Gizmo)
// 4. 6 Cylindrical Curved Domain Cards with Vertex Shader lens curve, edge chromatic aberration, and floor reflections
// 5. CAD Architectural Preloader (ảnh_8.jpg upgrade: solid 'A' + wireframe 'DOLSOFT' + 000%–100% kernel counter)
// 6. Interactive Spatial Glassmorphic Drawers (B2B ROI & Live Genetic Auto-Nesting Lab, Founder Profile, Domain Blueprint)

import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ThreeCanvas from '../components/ThreeCanvas.astro';
---

<BaseLayout
  title="ADOLSOFT® — AI Solution Architecture & Spatial WebGL Storytelling Engine"
  description="Hệ sinh thái Tự động hóa Dàn trang & Cắt bế Decal bằng AI (AI Print-Cut) và Hệ điều hành Nhà máy AI OS Edge. Sáng lập bởi Lê Trường Duy."
>
  <!-- HEADER NAVIGATION & QUATERNION 3D GIZMO -->
  <Navbar />

  <!-- FIXED THREE.JS WEBGL STORYTELLING STAGE -->
  <ThreeCanvas />

  <!-- SCROLL STORY TRACK (600vh drives the GSAP ScrollTrigger Scrubbing) -->
  <main class="relative w-full pointer-events-none" aria-hidden="true">
    <div id="scroll-story-track" class="relative w-full" style="height: 600vh;"></div>
  </main>

  <!-- ========================================================================= -->
  <!-- 5. CAD ARCHITECTURAL PRELOADER (Matches ảnh_8.jpg Benchmark)              -->
  <!-- Solid white 'A' + fine wireframe 'DOLSOFT' + Shader Kernel counter 0-100% -->
  <!-- ========================================================================= -->
  <aside
    id="cad-preloader"
    class="fixed inset-0 z-[99999] bg-[#040407] flex flex-col items-center justify-center select-none"
    role="dialog"
    aria-label="Loading AdolSoft Engine"
  >
    <!-- Architectural CAD Grid Background -->
    <div class="cad-grid-bg"></div>

    <!-- 4 Corner Precision Crosshairs -->
    <div class="absolute top-6 left-6 text-white/30 font-mono text-xs">+ [0.0, 0.0]</div>
    <div class="absolute top-6 right-6 text-white/30 font-mono text-xs">[W, 0.0] +</div>
    <div class="absolute bottom-6 left-6 text-white/30 font-mono text-xs">+ [0.0, H]</div>
    <div class="absolute bottom-6 right-6 text-white/30 font-mono text-xs">[W, H] +</div>

    <!-- Top Telemetry Metadata -->
    <div class="relative z-10 mb-8 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/[0.04] border border-white/10 font-mono text-[10px] tracking-[0.24em] text-[#c8ff00] uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c8ff00] animate-pulse"></span>
        ADOLSOFT ARCHITECTURAL KERNEL // V2.0
      </div>
      <p class="mt-2 font-mono text-[9.5px] tracking-widest text-white/35 uppercase">
        OPTICAL BENCHMARK // THREE.JS 0.186 // SHADER PIPELINE
      </p>
    </div>

    <!-- Centerpiece Typography: Solid 'A' + Wireframe 'DOLSOFT' (Matches ảnh_8.jpg) -->
    <div class="relative z-10 flex items-baseline justify-center tracking-tight select-none">
      <!-- Solid White Monolith 'A' -->
      <span class="font-['Syne'] font-extrabold text-white text-6xl sm:text-8xl md:text-9xl leading-none">
        A
      </span>
      <!-- Wireframe / Outline 'DOLSOFT' with Technical Dimensions -->
      <span
        class="font-['Syne'] font-extrabold text-transparent text-6xl sm:text-8xl md:text-9xl leading-none ml-1"
        style="-webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.55); letter-spacing: 0.04em;"
      >
        DOLSOFT
      </span>
    </div>

    <!-- Architectural Dimension Reference Line -->
    <div class="relative z-10 w-64 sm:w-80 md:w-96 my-5 flex items-center justify-between text-white/35 font-mono text-[9px] tracking-wider">
      <span>|◀ 108.4mm</span>
      <div class="flex-1 h-[1px] bg-white/20 mx-3 relative">
        <div class="absolute -top-1 left-1/2 -translate-x-1/2 px-1 bg-[#040407] text-[8.5px] text-[#c8ff00]/80">
          DELTA PRISM
        </div>
      </div>
      <span>▶|</span>
    </div>

    <!-- Loading Progress Bar & Status Text -->
    <div class="relative z-10 w-64 sm:w-80 md:w-96 flex flex-col gap-2">
      <div class="flex items-center justify-between font-mono text-[11px]">
        <span id="cad-status-msg" class="text-white/60 tracking-wider text-[10px] truncate max-w-[220px]">
          INITIALIZING SHADERS...
        </span>
        <span id="cad-counter" class="text-[#c8ff00] font-bold tracking-widest">
          000%
        </span>
      </div>
      <div class="w-full h-[3px] bg-white/10 rounded-full overflow-hidden">
        <div id="cad-progress-bar" class="h-full bg-[#c8ff00] w-0 transition-all duration-75"></div>
      </div>
      <div class="flex items-center justify-between font-mono text-[8.5px] tracking-widest text-white/30 uppercase mt-1">
        <span>MEM: ALLOCATED</span>
        <span>IOR: 1.52 // DISP: 6.0</span>
      </div>
    </div>
  </aside>

  <!-- ========================================================================= -->
  <!-- 6. SPATIAL DRAWER 1: B2B ROI & LIVE GENETIC AUTO-NESTING LAB              -->
  <!-- ========================================================================= -->
  <div id="drawer-roi-lab" class="spatial-drawer" role="dialog" aria-modal="true" aria-label="B2B ROI and Auto-Nesting Lab">
    <div class="spatial-drawer-panel p-6 sm:p-8 md:p-10 text-white">
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-white/10 pb-5 mb-6">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[#c8ff00] animate-ping"></span>
          <div>
            <h2 class="font-['Syne'] font-extrabold text-lg sm:text-xl text-white tracking-wide">
              ADOLSOFT EXPERIMENTAL COMMAND DOCK
            </h2>
            <p class="font-mono text-[10.5px] tracking-widest text-[#c8ff00] uppercase">
              B2B ROI CALCULATOR & LIVE GENETIC AUTO-NESTING SIMULATOR
            </p>
          </div>
        </div>

        <button
          type="button"
          data-close-drawer="roi-lab"
          class="px-3 py-1.5 rounded-md border border-white/20 bg-white/5 hover:bg-white/15 text-white/70 hover:text-white font-mono text-xs tracking-wider uppercase transition-colors"
        >
          ✕ Close [ESC]
        </button>
      </div>

      <!-- Tab Switcher Navigation -->
      <div class="flex items-center gap-2 mb-6 border-b border-white/10 pb-3 font-mono text-xs">
        <button
          type="button"
          id="tab-btn-nesting"
          class="tab-btn active px-4 py-2 rounded-md bg-[#1a8c4a]/30 border border-[#1a8c4a] text-white font-semibold flex items-center gap-2 transition-all"
        >
          <span>01 //</span> Live Genetic Nesting Lab
        </button>
        <button
          type="button"
          id="tab-btn-roi"
          class="tab-btn px-4 py-2 rounded-md bg-white/5 border border-white/10 text-white/60 hover:text-white transition-all"
        >
          <span>02 //</span> B2B ROI Calculator
        </button>
        <button
          type="button"
          id="tab-btn-founder"
          class="tab-btn px-4 py-2 rounded-md bg-white/5 border border-white/10 text-white/60 hover:text-white transition-all"
        >
          <span>03 //</span> Founder & Architect
        </button>
      </div>

      <!-- TAB 1: LIVE GENETIC AUTO-NESTING LAB -->
      <div id="tab-content-nesting" class="tab-pane block space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Left: Interactive Canvas Simulator -->
          <div class="lg:col-span-8 bg-black/60 border border-white/15 rounded-xl p-4 flex flex-col gap-3">
            <div class="flex items-center justify-between font-mono text-[11px] text-white/60 pb-2 border-b border-white/10">
              <span class="flex items-center gap-2 text-[#c8ff00]">
                <span class="w-2 h-2 rounded-full bg-[#c8ff00]"></span>
                VIRTUAL PRINT-CUT ROLL (1.2m WIDTH)
              </span>
              <span id="nesting-gen-badge" class="text-white/40">GENERATION: 042 / 100</span>
            </div>

            <!-- Simulation Canvas -->
            <div class="relative w-full aspect-[16/10] bg-[#070a0f] rounded-lg overflow-hidden border border-white/10 flex items-center justify-center">
              <canvas id="nesting-simulation-canvas" width="800" height="500" class="w-full h-full block"></canvas>
            </div>

            <!-- Canvas Controls -->
            <div class="flex flex-wrap items-center gap-2 pt-2">
              <button
                type="button"
                id="btn-run-nesting"
                class="px-4 py-2 rounded-lg bg-[#1a8c4a] hover:bg-[#4caf50] text-white font-mono text-xs font-bold tracking-wider uppercase transition-all flex items-center gap-2"
              >
                <span>►</span> Run GA Optimization
              </button>
              <button
                type="button"
                id="btn-random-shapes"
                class="px-3 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-mono text-xs tracking-wider uppercase transition-all"
              >
                ↺ Randomize Shapes
              </button>
              <button
                type="button"
                id="btn-toggle-nfp"
                class="px-3 py-2 rounded-lg border border-white/20 hover:border-[#c8ff00] text-white/80 hover:text-[#c8ff00] font-mono text-xs tracking-wider uppercase transition-all"
              >
                ⚙ NFP 0.5° Rotation: ON
              </button>
            </div>
          </div>

          <!-- Right: Telemetry KPI Cards -->
          <div class="lg:col-span-4 flex flex-col gap-3">
            <div class="bg-black/40 border border-white/10 rounded-xl p-4">
              <span class="font-mono text-[10px] tracking-wider text-white/45 uppercase block mb-1">
                Material Yield (Độ Phủ Decal)
              </span>
              <div class="flex items-baseline gap-2">
                <span id="kpi-yield" class="font-['Syne'] font-extrabold text-3xl text-[#c8ff00]">94.8%</span>
                <span class="font-mono text-xs text-[#6ee7b7]">+12.5% vs Manual</span>
              </div>
              <div class="w-full bg-white/10 h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="h-full bg-[#c8ff00] w-[94.8%]"></div>
              </div>
            </div>

            <div class="bg-black/40 border border-white/10 rounded-xl p-4">
              <span class="font-mono text-[10px] tracking-wider text-white/45 uppercase block mb-1">
                Prep-Time Per Job (Thời Gian Tiền Kỳ)
              </span>
              <div class="flex items-baseline gap-2">
                <span class="font-['Syne'] font-extrabold text-3xl text-white">14.2s</span>
                <span class="font-mono text-xs text-white/45">vs 45m Corel</span>
              </div>
              <p class="font-mono text-[10px] text-white/60 mt-1">
                Rút ngắn 99.4% thời gian tạo đường bế và xếp khít file in.
              </p>
            </div>

            <div class="bg-black/40 border border-white/10 rounded-xl p-4">
              <span class="font-mono text-[10px] tracking-wider text-white/45 uppercase block mb-1">
                Algorithm Core (Cốt Lõi Giải Thuật)
              </span>
              <p class="font-mono text-[11px] text-white/80 leading-relaxed">
                ● No-Fit Polygon (NFP) Minkowski Sum<br />
                ● Multi-Core CPU/GPU Genetic Population<br />
                ● Auto-Bleed 1.5mm & Optical Crosshairs
              </p>
            </div>

            <button
              type="button"
              data-switch-to-tab="roi"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-[#1a8c4a] to-[#2e7d32] hover:opacity-95 text-white font-mono text-xs font-bold tracking-widest uppercase text-center transition-all shadow-lg"
            >
              Calculate Your Factory ROI ↗
            </button>
          </div>
        </div>
      </div>

      <!-- TAB 2: B2B ROI CALCULATOR -->
      <div id="tab-content-roi" class="tab-pane hidden space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          <!-- Inputs Column -->
          <div class="lg:col-span-6 bg-black/50 border border-white/15 rounded-xl p-6 space-y-5">
            <h3 class="font-mono text-xs tracking-widest text-[#c8ff00] uppercase">
              // THÔNG SỐ XƯỞNG IN SẢN XUẤT
            </h3>

            <!-- Slider 1: Decal Volume -->
            <div>
              <div class="flex justify-between font-mono text-xs mb-1.5">
                <span class="text-white/70">1. Diện tích Decal in/ngày:</span>
                <span id="roi-vol-val" class="text-[#c8ff00] font-bold">50 m²/ngày</span>
              </div>
              <input
                type="range"
                id="roi-input-vol"
                min="10"
                max="200"
                step="5"
                value="50"
                class="w-full accent-[#c8ff00] cursor-pointer"
              />
              <div class="flex justify-between text-[10px] font-mono text-white/35 mt-1">
                <span>10 m² (Xưởng nhỏ)</span>
                <span>200 m² (Xưởng quy mô lớn)</span>
              </div>
            </div>

            <!-- Slider 2: Material Cost -->
            <div>
              <div class="flex justify-between font-mono text-xs mb-1.5">
                <span class="text-white/70">2. Giá thành Decal trung bình:</span>
                <span id="roi-cost-val" class="text-[#c8ff00] font-bold">45,000 VNĐ/m²</span>
              </div>
              <input
                type="range"
                id="roi-input-cost"
                min="20000"
                max="120000"
                step="5000"
                value="45000"
                class="w-full accent-[#c8ff00] cursor-pointer"
              />
              <div class="flex justify-between text-[10px] font-mono text-white/35 mt-1">
                <span>20,000 đ (Bạt hiflex)</span>
                <span>120,000 đ (Decal xi/phản quang)</span>
              </div>
            </div>

            <!-- Slider 3: Work Days -->
            <div>
              <div class="flex justify-between font-mono text-xs mb-1.5">
                <span class="text-white/70">3. Số ngày vận hành/tháng:</span>
                <span id="roi-days-val" class="text-[#c8ff00] font-bold">26 ngày</span>
              </div>
              <input
                type="range"
                id="roi-input-days"
                min="20"
                max="30"
                step="1"
                value="26"
                class="w-full accent-[#c8ff00] cursor-pointer"
              />
            </div>

            <!-- Slider 4: Saving Percentage -->
            <div>
              <div class="flex justify-between font-mono text-xs mb-1.5">
                <span class="text-white/70">4. Mức tiết kiệm hao hụt vật tư:</span>
                <span id="roi-pct-val" class="text-[#c8ff00] font-bold">12.5%</span>
              </div>
              <input
                type="range"
                id="roi-input-pct"
                min="8"
                max="18"
                step="0.5"
                value="12.5"
                class="w-full accent-[#c8ff00] cursor-pointer"
              />
            </div>
          </div>

          <!-- Outputs Column -->
          <div class="lg:col-span-6 flex flex-col justify-between gap-4">
            <div class="bg-gradient-to-br from-[#1a8c4a]/25 to-black/70 border border-[#1a8c4a]/60 rounded-xl p-6">
              <span class="font-mono text-xs tracking-widest text-[#6ee7b7] uppercase block mb-1">
                TIẾT KIỆM VẬT TƯ HÀNG THÁNG
              </span>
              <div id="roi-monthly-save" class="font-['Syne'] font-extrabold text-4xl sm:text-5xl text-[#c8ff00]">
                7,312,500 đ
              </div>
              <p class="font-mono text-xs text-white/60 mt-2">
                Trực tiếp cắt giảm chi phí decal phế liệu bỏ đi trong quá trình bế khuôn.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="bg-black/50 border border-white/10 rounded-xl p-4">
                <span class="font-mono text-[10px] text-white/40 uppercase block mb-1">
                  TIẾT KIỆM HÀNG NĂM
                </span>
                <div id="roi-yearly-save" class="font-['Syne'] font-bold text-2xl text-white">
                  87,750,000 đ
                </div>
              </div>

              <div class="bg-black/50 border border-white/10 rounded-xl p-4">
                <span class="font-mono text-[10px] text-white/40 uppercase block mb-1">
                  THỜI GIAN HOÀN VỐN BẢN QUYỀN
                </span>
                <div id="roi-payback" class="font-['Syne'] font-bold text-2xl text-[#6ee7b7]">
                  1.1 THÁNG
                </div>
                <span class="font-mono text-[9px] text-white/40">Gói Standard 8tr/năm</span>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-between">
              <div>
                <p class="font-['Syne'] font-bold text-sm text-white">Đăng ký Demo Xếp File Thực Tế</p>
                <p class="font-mono text-[10.5px] text-white/50">Gửi file mẫu để AI xếp thử & đo lường độ phủ trực tiếp.</p>
              </div>
              <a
                href="https://zalo.me/0559879392"
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-lg bg-[#c8ff00] hover:bg-[#aee600] text-black font-mono text-xs font-bold tracking-wider uppercase transition-colors"
              >
                Gửi File Zalo ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: FOUNDER & ARCHITECT PROFILE -->
      <div id="tab-content-founder" class="tab-pane hidden space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5 flex flex-col items-center sm:items-start text-center sm:text-left gap-4">
            <div class="w-32 h-32 rounded-2xl bg-gradient-to-tr from-[#1a8c4a] via-[#c8ff00] to-white/20 p-[2px] shadow-2xl">
              <div class="w-full h-full bg-[#090d14] rounded-2xl flex flex-col items-center justify-center p-3">
                <span class="font-['Syne'] font-extrabold text-3xl text-white">LTD</span>
                <span class="font-mono text-[9px] tracking-widest text-[#c8ff00] uppercase mt-1">FOUNDER</span>
              </div>
            </div>

            <div>
              <h3 class="font-['Syne'] font-extrabold text-2xl text-white">Lê Trường Duy</h3>
              <p class="font-mono text-xs text-[#c8ff00] tracking-widest uppercase mt-0.5">
                Founder & AI Solution Architect // AdolSoft
              </p>
              <p class="font-mono text-[11px] text-white/50 mt-1">
                Top 250 AI Young Guru Toàn Quốc
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <a
                href="tel:0559879392"
                class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-mono text-xs tracking-wider transition-colors"
              >
                📞 0559.879.392
              </a>
              <a
                href="mailto:duy@adolsoft.com"
                class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-mono text-xs tracking-wider transition-colors"
              >
                ✉ duy@adolsoft.com
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 bg-black/40 border border-white/10 rounded-xl p-6 space-y-4 font-mono text-xs leading-relaxed text-white/80">
            <div class="border-b border-white/10 pb-3">
              <span class="text-[#c8ff00] font-bold">[ RESEARCH FOCUS & PHILOSOPHY ]</span>
              <p class="mt-2 text-white/70">
                Nghiên cứu chuyên sâu giải thuật Tối ưu hóa Tổ hợp (Combinatorial Optimization) 2D/3D Irregular Bin-Packing, ứng dụng giải thuật di truyền (Genetic Algorithm) kết hợp Minkowski Difference (No-Fit Polygon) trên nền tảng CPU/GPU phân tán.
              </p>
            </div>

            <div class="border-b border-white/10 pb-3">
              <span class="text-[#6ee7b7] font-bold">[ SỨ MỆNH ZERO-WASTE CHO NGÀNH IN ]</span>
              <p class="mt-2 text-white/70">
                Chuyển giao các bộ công cụ AI hoạt động 100% Offline tới hơn 15,000 xưởng in ấn quảng cáo và bao bì tại Việt Nam. Giúp các chủ xưởng tiết kiệm hàng triệu mét vuông vật tư decal/bạt mỗi năm và chuẩn hóa tay nghề kỹ thuật viên chỉ sau 15 phút cài đặt.
              </p>
            </div>

            <div class="flex items-center justify-between pt-1 text-[11px] text-white/50">
              <span>Định hướng: Master of AI in Australia</span>
              <span class="text-[#c8ff00]">AdolSoft R&D Hub</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 6. SPATIAL DRAWER 2: DOMAIN BLUEPRINT DETAIL MODAL                        -->
  <!-- ========================================================================= -->
  <div id="drawer-domain-blueprint" class="spatial-drawer" role="dialog" aria-modal="true" aria-label="Domain Blueprint Inspection">
    <div class="spatial-drawer-panel p-6 sm:p-8 md:p-10 text-white">
      <!-- Modal Top Bar -->
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <span id="blueprint-code" class="font-mono text-xs tracking-[0.2em] text-[#c8ff00] uppercase">
            ● 01 // DOMAIN BLUEPRINT
          </span>
          <span id="blueprint-badge" class="px-2 py-0.5 rounded bg-[#1a8c4a]/30 border border-[#1a8c4a] text-[#6ee7b7] font-mono text-[10px]">
            15s vs 45m | -12.5% WASTE
          </span>
        </div>

        <button
          type="button"
          data-close-drawer="domain-blueprint"
          class="px-3 py-1.5 rounded-md border border-white/20 bg-white/5 hover:bg-white/15 text-white/70 hover:text-white font-mono text-xs tracking-wider uppercase transition-colors"
        >
          ✕ Close [ESC]
        </button>
      </div>

      <!-- Main Blueprint Two-Column Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: High-Res Blueprint Canvas (Synced with 3D Card Texture) -->
        <div class="lg:col-span-6 bg-[#070a0f] border border-white/15 rounded-xl p-3 flex flex-col gap-2">
          <div class="flex items-center justify-between font-mono text-[10px] text-white/40 pb-1 border-b border-white/10">
            <span>SPATIAL BLUEPRINT MATRIX</span>
            <span>SCALE: 1:1 REAL-TIME</span>
          </div>
          <div class="relative w-full aspect-[16/10] bg-black rounded-lg overflow-hidden border border-white/10">
            <canvas id="blueprint-detail-canvas" width="1280" height="820" class="w-full h-full block"></canvas>
            <div class="stage-crt-grain pointer-events-none"></div>
