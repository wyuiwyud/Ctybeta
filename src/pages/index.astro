<!-- ========================================================================= -->
  <!-- CLIENT INTERACTIVE CONTROLLERS (Preloader, Drawers, GA Canvas, ROI)      -->
  <!-- ========================================================================= -->
  <script>
    // 1. CAD ARCHITECTURAL PRELOADER LOGIC (Matches ảnh_8.jpg)
    window.addEventListener('DOMContentLoaded', () => {
      const preloader = document.getElementById('cad-preloader');
      const counter = document.getElementById('cad-counter');
      const progressBar = document.getElementById('cad-progress-bar');
      const statusMsg = document.getElementById('cad-status-msg');

      const statusStages = [
        { pct: 15, msg: 'INITIALIZING THREE.JS WEBGL RENDERER...' },
        { pct: 35, msg: 'GENERATING FROST NORMAL NOISE BUFFER...' },
        { pct: 60, msg: 'INVERTING VAULT UV COORDS (ZERO MIRROR BUG)...' },
        { pct: 85, msg: 'COMPILING CYLINDRICAL DOMAIN GEOMETRIES...' },
        { pct: 100, msg: 'STAGE READY // LAUNCHING ADOLSOFT ENGINE' }
      ];

      let progress = 0;
      const interval = setInterval(() => {
        progress += Math.floor(Math.random() * 4) + 2;
        if (progress > 100) progress = 100;

        if (counter) counter.textContent = `${String(progress).padStart(3, '0')}%`;
        if (progressBar) progressBar.style.width = `${progress}%`;

        const currentStage = statusStages.find((s) => progress <= s.pct) || statusStages[statusStages.length - 1];
        if (statusMsg) statusMsg.textContent = currentStage.msg;

        if (progress >= 100) {
          clearInterval(interval);
          setTimeout(() => {
            if (preloader) preloader.classList.add('loaded');
          }, 350);
        }
      }, 25);
    });

    // 2. SPATIAL MODAL DRAWERS MANAGEMENT (ROI Lab & Domain Blueprint)
    function openDrawer(drawerId: string) {
      const drawer = document.getElementById(`drawer-${drawerId}`);
      if (drawer) {
        drawer.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer(drawerId: string) {
      const drawer = document.getElementById(`drawer-${drawerId}`);
      if (drawer) {
        drawer.classList.remove('open');
        const anyOpen = document.querySelectorAll('.spatial-drawer.open').length > 0;
        if (!anyOpen) document.body.style.overflow = '';
      }
    }

    document.querySelectorAll('[data-open-drawer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.openDrawer;
        if (id) {
          if (id === 'founder-architect') {
            openDrawer('roi-lab');
            switchTab('founder');
          } else {
            openDrawer(id);
          }
        }
      });
    });

    document.querySelectorAll('[data-close-drawer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.closeDrawer;
        if (id) closeDrawer(id);
      });
    });

    // Close on clicking backdrop
    document.querySelectorAll('.spatial-drawer').forEach((drawer) => {
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) {
          drawer.classList.remove('open');
          const anyOpen = document.querySelectorAll('.spatial-drawer.open').length > 0;
          if (!anyOpen) document.body.style.overflow = '';
        }
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.spatial-drawer.open').forEach((drawer) => {
          drawer.classList.remove('open');
        });
        document.body.style.overflow = '';
      }
    });

    // 3. TAB NAVIGATION INSIDE ROI LAB
    function switchTab(tabKey: string) {
      const tabs = ['nesting', 'roi', 'founder'];
      tabs.forEach((t) => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const content = document.getElementById(`tab-content-${t}`);
        if (t === tabKey) {
          btn?.classList.add('active', 'bg-[#1a8c4a]/30', 'border-[#1a8c4a]', 'text-white', 'font-semibold');
          btn?.classList.remove('bg-white/5', 'border-white/10', 'text-white/60');
          content?.classList.remove('hidden');
          content?.classList.add('block');
        } else {
          btn?.classList.remove('active', 'bg-[#1a8c4a]/30', 'border-[#1a8c4a]', 'text-white', 'font-semibold');
          btn?.classList.add('bg-white/5', 'border-white/10', 'text-white/60');
          content?.classList.add('hidden');
          content?.classList.remove('block');
        }
      });
    }

    document.getElementById('tab-btn-nesting')?.addEventListener('click', () => switchTab('nesting'));
    document.getElementById('tab-btn-roi')?.addEventListener('click', () => switchTab('roi'));
    document.getElementById('tab-btn-founder')?.addEventListener('click', () => switchTab('founder'));
    document.querySelectorAll('[data-switch-to-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.switchToTab;
        if (target) switchTab(target);
      });
    });

    // 4. DOMAIN BLUEPRINT INSPECTION MODAL LISTENER
    window.addEventListener('open-domain-modal', (e: any) => {
      const idx = e.detail?.index ?? 0;
      const domains = (window as any).ADOLSOFT_DOMAINS;
      if (!domains || !domains[idx]) return;

      const d = domains[idx];
      const blueprintCode = document.getElementById('blueprint-code');
      const blueprintBadge = document.getElementById('blueprint-badge');
      const blueprintTitle = document.getElementById('blueprint-title');
      const blueprintSubtitle = document.getElementById('blueprint-subtitle');
      const blueprintSummary = document.getElementById('blueprint-summary');
      const blueprintSpecs = document.getElementById('blueprint-specs');
      const blueprintRoi = document.getElementById('blueprint-roi');
      const blueprintCanvas = document.getElementById('blueprint-detail-canvas') as HTMLCanvasElement;

      if (blueprintCode) blueprintCode.textContent = `● ${d.index} // ${d.category}`;
      if (blueprintBadge) blueprintBadge.textContent = d.metric;
      if (blueprintTitle) blueprintTitle.textContent = d.title;
      if (blueprintSubtitle) blueprintSubtitle.textContent = d.subtitle;
      if (blueprintSummary) blueprintSummary.textContent = d.summary;
      if (blueprintRoi) blueprintRoi.textContent = d.roiImpact;

      if (blueprintSpecs && Array.isArray(d.specs)) {
        blueprintSpecs.innerHTML = d.specs.map((s: string) => `<li>${s}</li>`).join('');
      }

      if (blueprintCanvas && typeof (window as any).renderDomainBlueprintToCanvas === 'function') {
        (window as any).renderDomainBlueprintToCanvas(idx, blueprintCanvas);
      }

      openDrawer('domain-blueprint');
    });

    // 5. INTERACTIVE LIVE GENETIC AUTO-NESTING CANVAS SIMULATOR
    const nestingCanvas = document.getElementById('nesting-simulation-canvas') as HTMLCanvasElement | null;
    if (nestingCanvas) {
      const ctx = nestingCanvas.getContext('2d');
      let animationFrameId: number;
      let generation = 42;
      let isOptimizing = false;

      interface DecalShape {
        x: number;
        y: number;
        w: number;
        h: number;
        r: number;
        color: string;
        type: 'rect' | 'circle' | 'contour';
      }

      let shapes: DecalShape[] = [];

      function generateShapes() {
        shapes = [];
        const colors = ['#c8ff00', '#1a8c4a', '#00f0ff', '#f59e0b', '#a855f7'];
        for (let i = 0; i < 24; i++) {
          const type = i % 3 === 0 ? 'circle' : i % 3 === 1 ? 'contour' : 'rect';
          shapes.push({
            x: 40 + (i % 6) * 120 + Math.random() * 10,
            y: 40 + Math.floor(i / 6) * 100 + Math.random() * 10,
            w: 70 + Math.random() * 35,
            h: 60 + Math.random() * 25,
            r: 12 + Math.random() * 14,
            color: colors[i % colors.length],
            type
          });
        }
      }

      generateShapes();

      function drawNesting() {
        if (!ctx || !nestingCanvas) return;
        ctx.clearRect(0, 0, nestingCanvas.width, nestingCanvas.height);

        // Draw Roll Grid & Bleed Margin Guidelines
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
        ctx.lineWidth = 1;
        for (let x = 0; x < nestingCanvas.width; x += 30) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, nestingCanvas.height); ctx.stroke();
        }
        for (let y = 0; y < nestingCanvas.height; y += 30) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(nestingCanvas.width, y); ctx.stroke();
        }

        // Draw Nested Decal Polygons
        shapes.forEach((s, idx) => {
          ctx.save();
          // Draw Bleed Contour Line (Red fine stroke)
          ctx.strokeStyle = 'rgba(255, 77, 77, 0.45)';
          ctx.lineWidth = 1;
          ctx.strokeRect(s.x - 3, s.y - 3, s.w + 6, s.h + 6);

          // Draw Primary Cut Contour
          ctx.fillStyle = s.color + '26';
          ctx.strokeStyle = s.color;
          ctx.lineWidth = 2;

          if (s.type === 'circle') {
            const rad = Math.min(s.w, s.h) / 2;
            ctx.beginPath();
            ctx.arc(s.x + s.w / 2, s.y + s.h / 2, rad, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
          } else {
            ctx.beginPath();
            ctx.roundRect(s.x, s.y, s.w, s.h, s.r);
            ctx.fill();
            ctx.stroke();
          }

          // Registration Crosshair in center
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
          ctx.lineWidth = 1;
          const cx = s.x + s.w / 2;
          const cy = s.y + s.h / 2;
          ctx.beginPath();
          ctx.moveTo(cx - 5, cy); ctx.lineTo(cx + 5, cy);
          ctx.moveTo(cx, cy - 5); ctx.lineTo(cx, cy + 5);
          ctx.stroke();

          // Label ID
          ctx.font = '9px monospace';
          ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
          ctx.fillText(`P${idx + 1}`, s.x + 6, s.y + 14);

          ctx.restore();
        });

        // Bounding Box Line showing tightest pack
        ctx.strokeStyle = '#c8ff00';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 4]);
        ctx.strokeRect(20, 20, 760, 460);
        ctx.setLineDash([]);
      }

      drawNesting();

      document.getElementById('btn-random-shapes')?.addEventListener('click', () => {
        generateShapes();
        drawNesting();
      });

      document.getElementById('btn-run-nesting')?.addEventListener('click', () => {
        isOptimizing = !isOptimizing;
        const btn = document.getElementById('btn-run-nesting');
        if (btn) {
          btn.innerHTML = isOptimizing ? '<span>■</span> Pause GA Solver' : '<span>►</span> Run GA Optimization';
        }

        if (isOptimizing) {
          const runStep = () => {
            if (!isOptimizing) return;
            generation++;
            const badge = document.getElementById('nesting-gen-badge');
            if (badge) badge.textContent = `GENERATION: ${String(generation).padStart(3, '0')} / 100`;

            // Micro-nudge positions towards tight left packing
            shapes.forEach((s) => {
              s.x -= Math.random() * 1.5;
              if (s.x < 30) s.x = 30 + Math.random() * 5;
            });
            drawNesting();
            animationFrameId = requestAnimationFrame(runStep);
          };
          runStep();
        } else {
          cancelAnimationFrame(animationFrameId);
        }
      });
    }

    // 6. REACTIVE B2B ROI CALCULATOR ENGINE
    const inputVol = document.getElementById('roi-input-vol') as HTMLInputElement | null;
    const inputCost = document.getElementById('roi-input-cost') as HTMLInputElement | null;
    const inputDays = document.getElementById('roi-input-days') as HTMLInputElement | null;
    const inputPct = document.getElementById('roi-input-pct') as HTMLInputElement | null;

    const valVol = document.getElementById('roi-vol-val');
    const valCost = document.getElementById('roi-cost-val');
    const valDays = document.getElementById('roi-days-val');
    const valPct = document.getElementById('roi-pct-val');

    const outMonthly = document.getElementById('roi-monthly-save');
    const outYearly = document.getElementById('roi-yearly-save');
    const outPayback = document.getElementById('roi-payback');

    function calculateROI() {
      const vol = parseFloat(inputVol?.value || '50');
      const cost = parseFloat(inputCost?.value || '45000');
      const days = parseFloat(inputDays?.value || '26');
      const pct = parseFloat(inputPct?.value || '12.5') / 100;

      if (valVol) valVol.textContent = `${vol} m²/ngày`;
      if (valCost) valCost.textContent = `${cost.toLocaleString('vi-VN')} VNĐ/m²`;
      if (valDays) valDays.textContent = `${days} ngày`;
      if (valPct) valPct.textContent = `${(pct * 100).toFixed(1)}%`;

      const monthlySave = vol * days * cost * pct;
      const yearlySave = monthlySave * 12;
      const standardCost = 8000000; // 8M VND standard package
      const paybackMonths = standardCost / (monthlySave || 1);

      if (outMonthly) outMonthly.textContent = `${Math.round(monthlySave).toLocaleString('vi-VN')} đ`;
      if (outYearly) outYearly.textContent = `${Math.round(yearlySave).toLocaleString('vi-VN')} đ`;
      if (outPayback) outPayback.textContent = `${paybackMonths.toFixed(1)} THÁNG`;
    }

    [inputVol, inputCost, inputDays, inputPct].forEach((input) => {
      input?.addEventListener('input', calculateROI);
    });
    calculateROI();
  </script>
