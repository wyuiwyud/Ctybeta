---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ADOLSOFT® — AI Solution Architecture & Spatial WebGL Storytelling Engine',
  description = 'Hệ sinh thái Tự động hóa Dàn trang & Cắt bế Decal bằng AI (AI Print-Cut) và Hệ điều hành Nhà máy AI OS Edge. Sáng lập bởi Lê Trường Duy.'
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040407" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Syne (Display), Inter (UI), JetBrains Mono (Telemetry) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Machine Experience (MX) JSON-LD Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AdolSoft AI Print-Cut & AI OS Edge",
        "applicationCategory": "IndustrialAutomationApplication",
        "operatingSystem": "Windows, Linux Edge OS",
        "creator": {
          "@type": "Person",
          "name": "Lê Trường Duy",
          "jobTitle": "Founder & AI Solution Architect",
          "email": "duy@adolsoft.com",
          "telephone": "+84-559-879-392"
        },
        "offers": {
          "@type": "AggregateOffer",
          "lowPrice": "6000000",
          "highPrice": "20000000",
          "priceCurrency": "VND"
        }
      }
    </script>
  </head>
  <body class="bg-[#040407] text-[#f4f4f6] antialiased selection:bg-[#c8ff00] selection:text-black overflow-x-hidden">
    <slot />
  </body>
</html>
