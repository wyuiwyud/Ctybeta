---
// src/components/Navbar.astro
---
<header class="fixed top-0 left-0 w-full z-[120] pointer-events-none px-6 md:px-10 py-6 flex items-center justify-between">
  <!-- Left: Brand Identity -->
  <div class="flex items-center gap-5 pointer-events-auto">
    <a href="#stage-hero" data-scroll-to="0" class="group flex items-center gap-3">
      <div class="relative w-8 h-8 rounded-lg bg-gradient-to-br from-[#22c55e]/30 via-[#15803d]/20 to-transparent border border-[#22c55e]/40 p-1 flex items-center justify-center shadow-[0_0_16px_rgba(34,197,94,0.35)] group-hover:border-[#22c55e] group-hover:shadow-[0_0_24px_rgba(34,197,94,0.6)] transition-all">
        <img
          src="/logo.png"
          alt="AdolSoft Logo"
          class="w-full h-full object-contain filter drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)] group-hover:scale-105 transition-transform"
        />
      </div>
      <span class="font-['Syne'] font-extrabold tracking-[0.18em] text-sm md:text-base text-white">
        ADOLSOFT
      </span>
    </a>
  </div>

  <!-- Right: Minimalist Navigation Links (Alche Style) -->
  <nav class="hidden md:flex items-center gap-8 pointer-events-auto font-mono text-[11px] tracking-[0.16em] text-white/60">
    <button type="button" data-scroll-to="0" class="nav-phase-btn hover:text-white transition-colors uppercase">
      Origin
    </button>
    <button type="button" data-scroll-to="0.24" class="nav-phase-btn text-white font-semibold hover:text-[#c8ff00] transition-colors uppercase">
      Domains
    </button>
    <button type="button" data-open-drawer="founder-architect" class="hover:text-white transition-colors uppercase">
      Architect
    </button>
  </nav>
</header>

<!-- Top-Right Quaternion 3D Gizmo Widget (Matches Alche Studio Screenshots 1-4) -->
<aside
  id="quaternion-gizmo-panel"
  class="fixed top-16 right-8 md:right-10 z-[110] hidden lg:flex flex-col items-end gap-1.5 pointer-events-auto select-none"
>
  <div class="font-mono text-[9px] tracking-widest text-white/40 flex items-center gap-1.5">
    <span>MainLogo Quaternion</span>
    <span class="text-white/30">::</span>
  </div>
  <div id="quat-readout" class="font-mono text-[10.5px] tracking-wider text-white/85">
    +.08 +.27 .00 .96
  </div>

  <div class="relative w-[72px] h-[72px] flex items-center justify-center my-0.5">
    <canvas id="quaternion-canvas" width="72" height="72" class="w-[72px] h-[72px] cursor-pointer" title="Click to impulse prism rotation"></canvas>
  </div>

  <button
    type="button"
    id="reset-quaternion-btn"
    class="font-mono text-[9px] tracking-[0.14em] text-white/40 hover:text-white transition-colors cursor-pointer"
  >
    Reset Quaternion
  </button>
</aside>
