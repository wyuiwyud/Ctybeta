---
// src/components/Navbar.astro
---
<header class="fixed top-0 left-0 w-full z-[120] pointer-events-none px-6 md:px-10 py-6 flex items-center justify-between">
  <!-- Left: Brand Identity -->
  <div class="flex items-center gap-5 pointer-events-auto">
    <a href="#stage-hero" data-scroll-to="0" class="group flex items-center gap-3">
      <span class="w-5 h-5 rounded-sm bg-[#c8ff00]/15 border border-[#c8ff00]/60 flex items-center justify-center text-[#c8ff00] text-[10px] font-mono shadow-[0_0_12px_rgba(200,255,0,0.35)] group-hover:bg-[#c8ff00] group-hover:text-black transition-all">
        ▲
      </span>
      <span class="font-['Syne'] font-extrabold tracking-[0.18em] text-sm md:text-base text-white">
        ADOLSOFT
      </span>
    </a>
    <span class="hidden lg:inline-block font-mono text-[10px] tracking-[0.2em] text-white/35 uppercase">
      [ ALCHE BENCHMARK // ZERO WASTE AI ]
    </span>
  </div>

  <!-- Center: Minimalist Navigation Links (Alche Style) -->
  <nav class="hidden md:flex items-center gap-8 pointer-events-auto font-mono text-[11px] tracking-[0.16em] text-white/60">
    <button type="button" data-scroll-to="0" class="nav-phase-btn hover:text-white transition-colors uppercase">
      Origin
    </button>
    <button type="button" data-scroll-to="0.24" class="nav-phase-btn text-white font-semibold hover:text-[#c8ff00] transition-colors uppercase">
      Domains
    </button>
    <button type="button" data-open-drawer="roi-lab" class="hover:text-[#c8ff00] transition-colors uppercase flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-[#1a8c4a] animate-pulse"></span>
      ROI & Nesting Lab
    </button>
    <button type="button" data-open-drawer="founder-architect" class="hover:text-white transition-colors uppercase">
      Architect
    </button>
  </nav>

  <!-- Right: Scroll Progress Pill & Contact CTA -->
  <div class="flex items-center gap-3 pointer-events-auto">
    <div class="flex items-center gap-3 px-3.5 py-1.5 rounded-full bg-black/65 border border-white/15 backdrop-blur-md font-mono text-[11px]">
      <span id="nav-domain-counter" class="text-[#c8ff00] font-bold tracking-wider">00 / 06</span>
      <div class="w-14 h-[2px] bg-white/15 overflow-hidden rounded-full">
        <div id="nav-scroll-bar" class="h-full bg-[#c8ff00] w-0 transition-all duration-75"></div>
      </div>
      <span id="nav-scroll-pct" class="text-white/45 text-[10px] w-8 text-right">00%</span>
    </div>

    <button
      type="button"
      data-open-drawer="roi-lab"
      class="hidden sm:inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/25 bg-white/[0.04] hover:bg-[#1a8c4a] hover:border-[#1a8c4a] text-white font-mono text-[10px] tracking-[0.14em] uppercase transition-all backdrop-blur-md"
    >
      Simulate ROI ↗
    </button>
  </div>
</header>

<!-- Top-Right Quaternion 3D Gizmo Widget (Inspired by ảnh_7.jpg of Alche Studio) -->
<aside
  id="quaternion-gizmo-panel"
  class="fixed top-20 right-6 md:right-10 z-[110] hidden lg:flex flex-col items-end gap-2 pointer-events-auto select-none"
>
  <div class="px-3 py-1.5 rounded bg-black/55 border border-white/10 backdrop-blur-md font-mono text-[9.5px] tracking-widest text-white/55 flex items-center gap-3">
    <span class="text-white/35">MainLogo Quaternion</span>
    <span id="quat-readout" class="text-white/85">0.00 | 0.00 | 0.00 | 1.00</span>
  </div>

  <div class="relative w-20 h-20 rounded-full border border-white/15 bg-black/45 backdrop-blur-md flex items-center justify-center shadow-[inset_0_0_18px_rgba(255,255,255,0.04)]">
    <canvas id="quaternion-canvas" width="80" height="80" class="w-20 h-20 cursor-pointer" title="Click to impulse prism rotation"></canvas>
  </div>

  <button
    type="button"
    id="reset-quaternion-btn"
    class="font-mono text-[9.5px] tracking-[0.14em] text-white/45 hover:text-[#c8ff00] transition-colors uppercase"
  >
    Reset Quaternion
  </button>
</aside>
