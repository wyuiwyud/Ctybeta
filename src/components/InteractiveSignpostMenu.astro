            forwards;
    }

    /* Trạng thái thu nhỏ cột */
    #signpost-menu-totem.is-minimized,
    #signpost-menu-totem.is-scrolled-hidden {
        transform: translateY(125%) scale(0.8);
        opacity: 0;
        pointer-events: none;
    }

    /* Trạng thái mở Drawer */
    #taco-interactive-drawer.is-open {
        display: flex !important;
