<style>
    #signpost-graphic-wrapper {
        transform-origin: bottom center;
        transition: transform 0.3s ease-out;
    }

    #signpost-graphic-wrapper:hover {
        transform: translateY(-3px);
    }

    /* Hiệu ứng khi rê chuột vào biển báo */
    .taco-sign-hotspot:hover {
        transform: scale(1.03);
        z-index: 25;
    }

    /* Hiệu ứng Active cho từng hộp đèn */
    .taco-sign-hotspot.is-active .taco-active-indicator {
        opacity: 1 !important;
    }

    /* Hiệu ứng thở / nhấp nháy đèn LED nhẹ tự nhiên (Organic LED Glow Flicker) */
    @keyframes ledPulseT {
        0%,
        100% {
            opacity: 0.25;
            filter: blur(7px) drop-shadow(0 0 6px rgba(59, 130, 246, 0.4));
        }
        50% {
            opacity: 0.65;
            filter: blur(10px) drop-shadow(0 0 16px rgba(59, 130, 246, 0.8));
        }
    }

    @keyframes ledPulseA {
        0%,
        100% {
            opacity: 0.25;
            filter: blur(7px) drop-shadow(0 0 6px rgba(234, 179, 8, 0.4));
        }
        50% {
            opacity: 0.65;
            filter: blur(10px) drop-shadow(0 0 16px rgba(234, 179, 8, 0.8));
        }
    }

    @keyframes ledPulseC {
        0%,
        100% {
            opacity: 0.25;
            filter: blur(7px) drop-shadow(0 0 6px rgba(249, 115, 22, 0.4));
        }
        50% {
            opacity: 0.65;
            filter: blur(10px) drop-shadow(0 0 16px rgba(249, 115, 22, 0.8));
        }
    }

    @keyframes ledPulseO {
        0%,
        100% {
            opacity: 0.25;
            filter: blur(7px) drop-shadow(0 0 6px rgba(239, 68, 68, 0.4));
        }
        50% {
            opacity: 0.65;
            filter: blur(10px) drop-shadow(0 0 16px rgba(239, 68, 68, 0.8));
        }
    }

    .taco-flicker-t {
        animation: ledPulseT 3.6s ease-in-out infinite;
    }

    .taco-flicker-a {
        animation: ledPulseA 4.2s ease-in-out infinite 0.7s;
    }

    .taco-flicker-c {
        animation: ledPulseC 3.8s ease-in-out infinite 1.4s;
    }

    .taco-flicker-o {
        animation: ledPulseO 4.6s ease-in-out infinite 2.1s;
    }

    /* Scanline quét nhẹ qua đèn LED */
    .taco-sign-hotspot::after {
        content: "";
        position: absolute;
        inset: 4px;
        border-radius: 14px;
        background: linear-gradient(
