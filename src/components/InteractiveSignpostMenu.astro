</style>

<script>
    // =========================================================================
    // LOGIC ĐIỀU KHIỂN HỆ THỐNG MENU TƯƠNG TÁC TACO
    // =========================================================================
    document.addEventListener("DOMContentLoaded", () => {
        // 1. Khởi tạo Web Audio API tổng hợp âm thanh Sci-Fi Click (Zero Audio Files)
        let audioCtx: AudioContext | null = null;
        let sfxEnabled = true;

        function getAudioContext(): AudioContext | null {
            if (!sfxEnabled) return null;
            if (!audioCtx) {
                const AudioContextClass =
                    window.AudioContext || (window as any).webkitAudioContext;
                if (AudioContextClass) {
                    audioCtx = new AudioContextClass();
                }
            }
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playSciFiChirp(
            freq = 640,
            type: OscillatorType = "sine",
            duration = 0.06,
        ) {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(
                    freq * 1.5,
                    ctx.currentTime + duration,
                );
                gain.gain.setValueAtTime(0.08, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(
                    0.001,
                    ctx.currentTime + duration,
                );
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {}
        }

        function playConfirmSound() {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "triangle";
                osc.frequency.setValueAtTime(520, ctx.currentTime);
                osc.frequency.setValueAtTime(780, ctx.currentTime + 0.05);
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(
                    0.001,
                    ctx.currentTime + 0.16,
                );
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.16);
            } catch (e) {}
        }

        // 2. Tham chiếu các phần tử DOM
        const totem = document.getElementById("signpost-menu-totem");
        const dockTrigger = document.getElementById("taco-dock-trigger");
        const minimizeBtn = document.getElementById("taco-minimize-btn");
        const sfxToggle = document.getElementById("taco-sfx-toggle");
        const sfxIcon = document.getElementById("taco-sfx-icon");

        const drawer = document.getElementById("taco-interactive-drawer");
        const drawerBackdrop = document.getElementById("taco-drawer-backdrop");
        const drawerClose = document.getElementById("taco-drawer-close");

        const signButtons =
            document.querySelectorAll<HTMLButtonElement>(".taco-sign-hotspot");
        const tabButtons =
            document.querySelectorAll<HTMLButtonElement>(".taco-tab-btn");
        const tabPanes =
            document.querySelectorAll<HTMLElement>(".taco-tab-pane");

        // 3. Xử lý âm thanh tương tác Hover trên từng hộp biển báo
        const freqs: Record<string, number> = {
            t: 880,
            a: 660,
            c: 550,
            o: 440,
        };

        signButtons.forEach((btn) => {
            const key = btn.dataset.menuKey || "t";

            btn.addEventListener("mouseenter", () => {
                playSciFiChirp(freqs[key] || 600, "sine", 0.05);
            });

            btn.addEventListener("click", () => {
                playConfirmSound();
                window.dispatchEvent(
                    new CustomEvent("studio:open", { detail: { key } }),
                );
            });
        });

        // 4. Kích hoạt phân hệ tương tác (Mở Drawer & Chuyển Tab)
        function activateMenuKey(key: string, openModal = true) {
            // Đánh dấu active trên hộp đèn biển báo
            signButtons.forEach((b) => {
                if (b.dataset.menuKey === key) {
                    b.classList.add("is-active");
                } else {
                    b.classList.remove("is-active");
                }
            });

            // Cập nhật giao diện tab trong Drawer
            const colorBorders: Record<string, string> = {
                t: "border-[#3b82f6]/50 bg-[#3b82f6]/15",
                a: "border-[#eab308]/50 bg-[#eab308]/15",
                c: "border-[#f97316]/50 bg-[#f97316]/15",
                o: "border-[#ef4444]/50 bg-[#ef4444]/15",
            };

            tabButtons.forEach((t) => {
                const tKey = t.dataset.tabTarget;
                if (tKey === key) {
                    t.className = `taco-tab-btn px-4 py-3 rounded-xl border ${colorBorders[key]} text-white font-mono text-xs flex flex-col items-start gap-1 transition-all cursor-pointer text-left shadow-lg`;
                } else {
                    t.className = `taco-tab-btn px-4 py-3 rounded-xl border border-white/10 bg-white/[0.03] text-white/70 font-mono text-xs flex flex-col items-start gap-1 transition-all hover:bg-white/[0.08] cursor-pointer text-left`;
                }
            });

            // Hiển thị nội dung pane tương ứng
            tabPanes.forEach((pane) => {
                if (pane.id === `taco-content-${key}`) {
                    pane.classList.remove("hidden");
                    pane.classList.add("block");
                } else {
                    pane.classList.remove("block");
                    pane.classList.add("hidden");
                }
            });

            // Mở modal nếu cần
            if (openModal && drawer) {
                drawer.classList.add("is-open");
                document.body.style.overflow = "hidden";
            }
        }

        // 5. Chuyển Tab ngay trong Drawer
        tabButtons.forEach((tBtn) => {
            tBtn.addEventListener("click", () => {
                const key = tBtn.dataset.tabTarget || "t";
                playSciFiChirp(freqs[key] || 600, "triangle", 0.07);
                activateMenuKey(key, false);
            });
        });

        // 6. Đóng Drawer
        function closeDrawer() {
            if (drawer) {
                drawer.classList.remove("is-open");
                document.body.style.overflow = "";
            }
        }

        if (drawerClose) drawerClose.addEventListener("click", closeDrawer);
        if (drawerBackdrop)
            drawerBackdrop.addEventListener("click", closeDrawer);

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeDrawer();
        });

        // 7. Thu nhỏ / Mở rộng Cột Biển Báo
        if (minimizeBtn) {
            minimizeBtn.addEventListener("click", () => {
                playSciFiChirp(400, "sine", 0.08);
                if (totem) totem.classList.add("is-minimized");
                if (dockTrigger) {
                    dockTrigger.classList.remove("hidden");
                    dockTrigger.classList.add("flex");
                }
            });
        }

        if (dockTrigger) {
            dockTrigger.addEventListener("click", () => {
                playConfirmSound();
                if (dockTrigger) {
                    dockTrigger.classList.remove("flex");
                    dockTrigger.classList.add("hidden");
                }
                if (totem) totem.classList.remove("is-minimized");
            });
        }

        // 8. Bật/Tắt âm thanh SFX
        if (sfxToggle && sfxIcon) {
            sfxToggle.addEventListener("click", () => {
                sfxEnabled = !sfxEnabled;
                sfxIcon.textContent = sfxEnabled ? "🔊" : "🔇";
                if (sfxEnabled) playSciFiChirp(700, "sine", 0.05);
            });
        }

        // 9. Nút Reset Stage & Replay Preloader trong tab [O]
        const resetStageBtn = document.getElementById("taco-reset-stage-btn");
        if (resetStageBtn) {
            resetStageBtn.addEventListener("click", () => {
                closeDrawer();
                const resetGizmo = document.getElementById(
                    "reset-quaternion-btn",
                );
                if (resetGizmo) resetGizmo.click();
            });
        }

        const replayBtn = document.getElementById("taco-replay-preloader-btn");
        if (replayBtn) {
            replayBtn.addEventListener("click", () => {
                closeDrawer();
                const preloader = document.getElementById("cad-preloader");
                if (preloader) {
                    preloader.classList.remove("loaded");
                    const dualHandContainer = document.getElementById(
                        "dual-hand-nexus-container",
                    );
                    if (dualHandContainer) dualHandContainer.click();
                }
            });
        }

        // 10. KHI KÉO XUỐNG CÁC THẺ (DOMAIN CARDS / SCROLL STAGE) -> MENU BIỂN BÁO TỰ ĐỘNG THỤT XUỐNG BIẾN MẤT
        let isHiddenByScroll = false;
        function checkScrollHide() {
            // Khi scroll ra khỏi hero (tiến vào vùng các thẻ card ở p >= 0.08 hoặc scrollY > 200px)
            const scrollTrack = document.getElementById("scroll-story-track");
            let scrollProgress = 0;
            if (scrollTrack) {
                const totalHeight =
                    document.body.scrollHeight - window.innerHeight;
                if (totalHeight > 0) {
                    scrollProgress = window.scrollY / totalHeight;
                }
            }

            const shouldHide = scrollProgress >= 0.06 || window.scrollY > 250;

            if (shouldHide && !isHiddenByScroll) {
                isHiddenByScroll = true;
                if (totem && !totem.classList.contains("is-minimized")) {
                    totem.classList.add("is-scrolled-hidden");
                }
                if (dockTrigger && !totem?.classList.contains("is-minimized")) {
                    dockTrigger.classList.remove("hidden");
                    dockTrigger.classList.add("flex");
                }
            } else if (!shouldHide && isHiddenByScroll) {
                isHiddenByScroll = false;
                if (totem && !totem.classList.contains("is-minimized")) {
                    totem.classList.remove("is-scrolled-hidden");
                }
                if (dockTrigger && !totem?.classList.contains("is-minimized")) {
                    dockTrigger.classList.remove("flex");
                    dockTrigger.classList.add("hidden");
                }
            }
        }

        window.addEventListener("scroll", checkScrollHide, { passive: true });
        window.addEventListener("stage-scroll-update", (e: any) => {
            const p = e.detail?.progress ?? 0;
            const shouldHide = p >= 0.05;
            if (shouldHide && !isHiddenByScroll) {
                isHiddenByScroll = true;
                if (totem && !totem.classList.contains("is-minimized")) {
                    totem.classList.add("is-scrolled-hidden");
                }
                if (dockTrigger && !totem?.classList.contains("is-minimized")) {
                    dockTrigger.classList.remove("hidden");
                    dockTrigger.classList.add("flex");
                }
            } else if (!shouldHide && isHiddenByScroll) {
                isHiddenByScroll = false;
                if (totem && !totem.classList.contains("is-minimized")) {
                    totem.classList.remove("is-scrolled-hidden");
                }
                if (dockTrigger && !totem?.classList.contains("is-minimized")) {
                    dockTrigger.classList.remove("flex");
                    dockTrigger.classList.add("hidden");
                }
            }
        });
    });
</script>
