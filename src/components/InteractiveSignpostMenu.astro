---
// src/components/InteractiveSignpostMenu.astro
// HỆ THỐNG MENU TƯƠNG TÁC BIỂN BÁO ĐÈN LED (TACO INTERACTIVE SIGNPOST TOTEM)
// Thiết kế giao diện tương tác dựa trên mô hình biển báo LED 4 hộp:
// [T] Top-Right (Xanh dương)  - Telemetry & Technology Pipeline
// [A] Mid-Left (Vàng hoàng kim) - Architect & Labs
// [C] Mid-Right (Cam rực lửa)   - Core Solutions & Genetic AI Print-Cut
// [O] Bot-Left (Đỏ ruby)       - Origin & Spatial 3D Monolith
import StudioWorkspace from "./StudioWorkspace.astro";
---

<div id="taco-menu-system" class="select-none pointer-events-none">
    <!-- ========================================================================= -->
    <!-- 1. CỘT BIỂN BÁO TƯƠNG TÁC (INTERACTIVE SIGNPOST TOTEM) CỐ ĐỊNH GÓC DƯỚI PHẢI -->
    <!-- ========================================================================= -->
    <aside
        id="signpost-menu-totem"
        class="fixed bottom-0 right-3 sm:right-6 md:right-10 z-[115] flex flex-col items-end transition-all duration-500 ease-out origin-bottom-right"
        aria-label="Interactive Navigation Signpost Menu"
    >
        <!-- Thanh điều khiển đỉnh cột (Totem Top Controller Pill) -->
        <div class="pointer-events-auto mb-2 flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#090d14]/85 backdrop-blur-md border border-white/15 text-[10px] font-mono tracking-wider shadow-2xl transition-all hover:border-white/30">
            <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#3b82f6] animate-pulse"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#eab308]"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#f97316]"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#ef4444]"></span>
            </div>
            <span class="text-white/80 font-bold ml-1 tracking-widest text-[9.5px]">
                TACO // MENU
            </span>

            <!-- Nút bật/tắt âm thanh hiệu ứng (SFX Toggle) -->
            <button
                type="button"
                id="taco-sfx-toggle"
                class="ml-1.5 p-1 rounded hover:bg-white/10 text-white/60 hover:text-white transition-colors"
                title="Bật/Tắt âm thanh tương tác Sci-Fi"
                aria-label="Toggle Sound FX"
            >
                <span id="taco-sfx-icon">🔊</span>
            </button>

            <!-- Nút thu nhỏ/mở rộng cột biển báo (Minimize Toggle) -->
            <button
                type="button"
                id="taco-minimize-btn"
                class="p-1 rounded hover:bg-white/10 text-white/60 hover:text-white transition-colors"
                title="Thu nhỏ biển báo để xem trọn màn hình"
                aria-label="Minimize Signpost"
            >
                ▼
            </button>
        </div>

        <!-- Khung chính chứa Cột và 4 Hộp đèn LED (Tỷ lệ chuẩn 499 / 804) -->
        <div
            id="signpost-graphic-wrapper"
            class="pointer-events-auto relative h-[250px] sm:h-[290px] md:h-[340px] lg:h-[370px] aspect-[499/804] transition-transform duration-300 ease-out"
        >
            <!-- Ảnh gốc 3D High-Res đã căn chỉnh kích thước viền khít hoàn hảo -->
            <img
                src="/assets/signpost_menu_tight.png"
                alt="ADOLSOFT Interactive Signpost Menu Totem"
                class="w-full h-full object-contain pointer-events-none select-none filter drop-shadow-[0_15px_35px_rgba(0,0,0,0.8)]"
                loading="eager"
            />

            <!-- ===================================================================== -->
            <!-- HOTSPOT 1: HỘP 'T' (TOP-RIGHT, MÀU XANH DƯƠNG)                        -->
            <!-- ===================================================================== -->
            <button
                type="button"
                id="taco-btn-t"
                data-menu-key="t"
                class="taco-sign-hotspot group absolute rounded-2xl cursor-pointer transition-all duration-200 outline-none"
                style="left: 52.1%; top: 0.6%; width: 46.5%; height: 34.8%;"
                aria-label="Open Team authentication gateway"
            >
                <!-- Hào quang Neon Blue khi Hover/Active & Nhấp nháy nhẹ thở sống động -->
                <div class="taco-glow-layer taco-flicker-t absolute inset-0 rounded-2xl bg-[#3b82f6]/25 opacity-30 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none filter blur-md"></div>
                <div class="taco-active-indicator absolute inset-0 rounded-2xl border-2 border-[#3b82f6] shadow-[0_0_20px_rgba(59,130,246,0.8)] opacity-0 pointer-events-none transition-all duration-300"></div>

                <!-- Floating HUD Tooltip bay sang bên trái khi Hover -->
                <div class="taco-hud-tooltip absolute right-[108%] top-1/2 -translate-y-1/2 hidden group-hover:flex items-center gap-2 px-3 py-2 rounded-xl bg-[#090d14]/90 backdrop-blur-md border border-[#3b82f6]/50 shadow-[0_0_25px_rgba(59,130,246,0.35)] whitespace-nowrap pointer-events-none z-30 animate-fade-in-left">
                    <div class="w-2 h-2 rounded-full bg-[#3b82f6] animate-ping"></div>
                    <div class="flex flex-col text-left">
                        <span class="font-mono text-[11px] font-bold text-white tracking-wider flex items-center gap-1.5">
                            <span class="text-[#3b82f6]">[T]</span> TEAM // AUTH
                            GATEWAY
                        </span>
                        <span class="font-mono text-[9px] text-white/50 tracking-widest uppercase">
                            Member login / virtual studio
                        </span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded bg-[#3b82f6]/20 text-[#60a5fa] font-mono text-[8px] uppercase tracking-widest ml-1">
                        OPEN
                    </span>
                </div>
            </button>

            <!-- ===================================================================== -->
            <!-- HOTSPOT 2: HỘP 'A' (MID-LEFT, MÀU VÀNG HOÀNG KIM)                     -->
            <!-- ===================================================================== -->
            <button
                type="button"
                id="taco-btn-a"
                data-menu-key="a"
                class="taco-sign-hotspot group absolute rounded-2xl cursor-pointer transition-all duration-200 outline-none"
                style="left: 1.0%; top: 19.9%; width: 46.7%; height: 34.8%;"
                aria-label="Open Assets and Architecture dashboard"
            >
                <!-- Hào quang Neon Yellow khi Hover/Active & Nhấp nháy nhẹ thở sống động -->
                <div class="taco-glow-layer taco-flicker-a absolute inset-0 rounded-2xl bg-[#eab308]/25 opacity-30 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none filter blur-md"></div>
                <div class="taco-active-indicator absolute inset-0 rounded-2xl border-2 border-[#eab308] shadow-[0_0_20px_rgba(234,179,8,0.8)] opacity-0 pointer-events-none transition-all duration-300"></div>

                <!-- Floating HUD Tooltip bay sang bên trái khi Hover -->
                <div class="taco-hud-tooltip absolute right-[108%] top-1/2 -translate-y-1/2 hidden group-hover:flex items-center gap-2 px-3 py-2 rounded-xl bg-[#090d14]/90 backdrop-blur-md border border-[#eab308]/50 shadow-[0_0_25px_rgba(234,179,8,0.35)] whitespace-nowrap pointer-events-none z-30 animate-fade-in-left">
                    <div class="w-2 h-2 rounded-full bg-[#eab308] animate-ping"></div>
                    <div class="flex flex-col text-left">
                        <span class="font-mono text-[11px] font-bold text-white tracking-wider flex items-center gap-1.5">
                            <span class="text-[#eab308]">[A]</span> ASSETS //
                            ARCHITECTURE
                        </span>
                        <span class="font-mono text-[9px] text-white/50 tracking-widest uppercase">
                            Design resources / engineering docs
                        </span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded bg-[#eab308]/20 text-[#facc15] font-mono text-[8px] uppercase tracking-widest ml-1">
                        OPEN
                    </span>
                </div>
            </button>

            <!-- ===================================================================== -->
            <!-- HOTSPOT 3: HỘP 'C' (MID-RIGHT, MÀU CAM RỰC LỬA)                      -->
            <!-- ===================================================================== -->
            <button
                type="button"
                id="taco-btn-c"
                data-menu-key="c"
                class="taco-sign-hotspot group absolute rounded-2xl cursor-pointer transition-all duration-200 outline-none"
                style="left: 53.1%; top: 41.7%; width: 46.7%; height: 33.6%;"
                aria-label="Open Clients and CRM dashboard"
            >
                <!-- Hào quang Neon Orange khi Hover/Active & Nhấp nháy nhẹ thở sống động -->
                <div class="taco-glow-layer taco-flicker-c absolute inset-0 rounded-2xl bg-[#f97316]/25 opacity-30 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none filter blur-md"></div>
                <div class="taco-active-indicator absolute inset-0 rounded-2xl border-2 border-[#f97316] shadow-[0_0_20px_rgba(249,115,22,0.8)] opacity-0 pointer-events-none transition-all duration-300"></div>

                <!-- Floating HUD Tooltip bay sang bên trái khi Hover -->
                <div class="taco-hud-tooltip absolute right-[108%] top-1/2 -translate-y-1/2 hidden group-hover:flex items-center gap-2 px-3 py-2 rounded-xl bg-[#090d14]/90 backdrop-blur-md border border-[#f97316]/50 shadow-[0_0_25px_rgba(249,115,22,0.35)] whitespace-nowrap pointer-events-none z-30 animate-fade-in-left">
                    <div class="w-2 h-2 rounded-full bg-[#f97316] animate-ping"></div>
                    <div class="flex flex-col text-left">
                        <span class="font-mono text-[11px] font-bold text-white tracking-wider flex items-center gap-1.5">
                            <span class="text-[#f97316]">[C]</span> CLIENTS //
                            CRM
                        </span>
                        <span class="font-mono text-[9px] text-white/50 tracking-widest uppercase">
                            Client projects / support queue
                        </span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded bg-[#f97316]/20 text-[#fb923c] font-mono text-[8px] uppercase tracking-widest ml-1">
                        OPEN
                    </span>
                </div>
            </button>

            <!-- ===================================================================== -->
            <!-- HOTSPOT 4: HỘP 'O' (BOTTOM-LEFT, MÀU ĐỎ RUBY)                         -->
            <!-- ===================================================================== -->
            <button
                type="button"
                id="taco-btn-o"
                data-menu-key="o"
                class="taco-sign-hotspot group absolute rounded-2xl cursor-pointer transition-all duration-200 outline-none"
                style="left: 0.6%; top: 63.4%; width: 47.1%; height: 33.6%;"
                aria-label="Open Operations and Output dashboard"
            >
                <!-- Hào quang Neon Red khi Hover/Active & Nhấp nháy nhẹ thở sống động -->
                <div class="taco-glow-layer taco-flicker-o absolute inset-0 rounded-2xl bg-[#ef4444]/25 opacity-30 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none filter blur-md"></div>
                <div class="taco-active-indicator absolute inset-0 rounded-2xl border-2 border-[#ef4444] shadow-[0_0_20px_rgba(239,68,68,0.8)] opacity-0 pointer-events-none transition-all duration-300"></div>

                <!-- Floating HUD Tooltip bay sang bên trái khi Hover -->
                <div class="taco-hud-tooltip absolute right-[108%] top-1/2 -translate-y-1/2 hidden group-hover:flex items-center gap-2 px-3 py-2 rounded-xl bg-[#090d14]/90 backdrop-blur-md border border-[#ef4444]/50 shadow-[0_0_25px_rgba(239,68,68,0.35)] whitespace-nowrap pointer-events-none z-30 animate-fade-in-left">
                    <div class="w-2 h-2 rounded-full bg-[#ef4444] animate-ping"></div>
                    <div class="flex flex-col text-left">
                        <span class="font-mono text-[11px] font-bold text-white tracking-wider flex items-center gap-1.5">
                            <span class="text-[#ef4444]">[O]</span> OPERATIONS
                            // OUTPUT
                        </span>
                        <span class="font-mono text-[9px] text-white/50 tracking-widest uppercase">
                            Monolith "A" & Vector Stage
                        </span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded bg-[#ef4444]/20 text-[#f87171] font-mono text-[8px] uppercase tracking-widest ml-1">
                        OPEN
                    </span>
                </div>
            </button>
        </div>
    </aside>

    <!-- ========================================================================= -->
    <!-- 2. NÚT DOCK THU GỌN (COMPACT DOCK PILL KHI THU NHỎ BIỂN BÁO)             -->
    <!-- ========================================================================= -->
    <button
        type="button"
        id="taco-dock-trigger"
        class="pointer-events-auto fixed bottom-5 right-5 z-[115] hidden items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-[#090d14]/90 backdrop-blur-md border border-white/20 text-white font-mono text-xs tracking-wider shadow-[0_8px_32px_rgba(0,0,0,0.8)] hover:border-white/40 hover:scale-105 active:scale-95 transition-all cursor-pointer"
        aria-label="Expand TACO Signpost Menu"
    >
        <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#3b82f6] animate-pulse"></span>
            <span class="w-2 h-2 rounded-full bg-[#eab308]"></span>
            <span class="w-2 h-2 rounded-full bg-[#f97316]"></span>
            <span class="w-2 h-2 rounded-full bg-[#ef4444]"></span>
        </div>
        <span class="font-['Syne'] font-bold tracking-widest text-[11px]">
            TACO MENU
        </span>
        <span class="text-white/40 text-[10px]">▲</span>
    </button>

    <!-- ========================================================================= -->
    <!-- 3. BẢNG GIAO DIỆN MENU TƯƠNG TÁC (INTERACTIVE TACO HUD DRAWER / MODAL)   -->
    <!-- ========================================================================= -->
    <div
        id="taco-interactive-drawer"
        class="fixed inset-0 z-[125] hidden opacity-0 transition-opacity duration-300 items-center justify-center p-4 sm:p-6 lg:p-10 pointer-events-none"
        role="dialog"
        aria-modal="true"
        aria-label="ADOLSOFT TACO Interactive System Menu"
    >
        <!-- Phông nền tối mờ (Backdrop Blur) -->
        <div
            id="taco-drawer-backdrop"
            class="absolute inset-0 bg-black/75 backdrop-blur-md cursor-pointer"
        ></div>

        <!-- Bảng điều khiển trung tâm (HUD Control Matrix) -->
        <div
            id="taco-drawer-panel"
            class="relative z-10 w-full max-w-4xl max-h-[90vh] bg-[#090d14]/95 border border-white/15 rounded-3xl p-6 sm:p-8 flex flex-col shadow-[0_25px_80px_rgba(0,0,0,0.9)] overflow-hidden pointer-events-auto transform scale-95 transition-all duration-300"
        >
            <!-- Đường viền trang trí đa sắc công nghệ cao -->
            <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-[#3b82f6] via-[#eab308] via-[#f97316] to-[#ef4444]"></div>

            <!-- Tiêu đề Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-5 mb-5 flex-wrap gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#3b82f6]/30 via-[#eab308]/20 to-transparent border border-white/20 flex items-center justify-center font-mono font-bold text-xs text-[#c8ff00]">
                        A
                    </div>
                    <div>
                        <h2 class="font-['Syne'] font-extrabold text-xl text-white tracking-wide flex items-center gap-2">
                            ADOLSOFT // SPATIAL INTERACTIVE MENU
                            <span class="text-[10px] font-mono font-normal px-2 py-0.5 rounded bg-white/10 text-white/60">
                                TACO SYSTEM
                            </span>
                        </h2>
                        <p class="font-mono text-[10px] tracking-widest text-white/40 uppercase mt-0.5">
                            Giao diện điều khiển tương tác đa phân hệ //
                            Real-Time Architecture
                        </p>
                    </div>
                </div>

                <!-- Nút đóng Drawer -->
                <button
                    type="button"
                    id="taco-drawer-close"
                    class="px-3.5 py-1.5 rounded-lg border border-white/20 bg-white/5 hover:bg-white/15 text-white/70 hover:text-white font-mono text-xs tracking-wider uppercase transition-colors"
                >
                    ✕ Close [ESC]
                </button>
            </div>

            <!-- THANH CHUYỂN TAB ĐỒNG BỘ VỚI 4 HỘP BIỂN BÁO [T] - [A] - [C] - [O] -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6">
                <!-- Tab T -->
                <button
                    type="button"
                    data-tab-target="t"
                    class="taco-tab-btn px-4 py-3 rounded-xl border border-[#3b82f6]/40 bg-[#3b82f6]/10 text-white font-mono text-xs flex flex-col items-start gap-1 transition-all hover:bg-[#3b82f6]/20 cursor-pointer text-left"
                >
                    <div class="flex items-center justify-between w-full">
                        <span class="font-bold text-[#60a5fa] text-sm">
                            [T] TELEMETRY
                        </span>
                        <span class="w-2 h-2 rounded-full bg-[#3b82f6] animate-pulse"></span>
                    </div>
                    <span class="text-[9.5px] text-white/50 tracking-wider">
                        Tech & Shader Core
                    </span>
                </button>

                <!-- Tab A -->
                <button
                    type="button"
                    data-tab-target="a"
                    class="taco-tab-btn px-4 py-3 rounded-xl border border-white/10 bg-white/[0.03] text-white/70 font-mono text-xs flex flex-col items-start gap-1 transition-all hover:bg-white/[0.08] cursor-pointer text-left"
                >
                    <div class="flex items-center justify-between w-full">
                        <span class="font-bold text-[#facc15] text-sm">
                            [A] ARCHITECT
                        </span>
                        <span class="w-2 h-2 rounded-full bg-[#eab308]"></span>
                    </div>
                    <span class="text-[9.5px] text-white/50 tracking-wider">
                        Founder & Studio Labs
                    </span>
                </button>

                <!-- Tab C -->
                <button
                    type="button"
                    data-tab-target="c"
                    class="taco-tab-btn px-4 py-3 rounded-xl border border-white/10 bg-white/[0.03] text-white/70 font-mono text-xs flex flex-col items-start gap-1 transition-all hover:bg-white/[0.08] cursor-pointer text-left"
                >
                    <div class="flex items-center justify-between w-full">
                        <span class="font-bold text-[#fb923c] text-sm">
                            [C] CORE
                        </span>
                        <span class="w-2 h-2 rounded-full bg-[#f97316]"></span>
                    </div>
                    <span class="text-[9.5px] text-white/50 tracking-wider">
                        AI Print-Cut Nesting
                    </span>
                </button>

                <!-- Tab O -->
                <button
                    type="button"
                    data-tab-target="o"
                    class="taco-tab-btn px-4 py-3 rounded-xl border border-white/10 bg-white/[0.03] text-white/70 font-mono text-xs flex flex-col items-start gap-1 transition-all hover:bg-white/[0.08] cursor-pointer text-left"
                >
                    <div class="flex items-center justify-between w-full">
                        <span class="font-bold text-[#f87171] text-sm">
                            [O] ORIGIN
                        </span>
                        <span class="w-2 h-2 rounded-full bg-[#ef4444]"></span>
                    </div>
                    <span class="text-[9.5px] text-white/50 tracking-wider">
                        Spatial 3D & Monolith
                    </span>
                </button>
            </div>

            <!-- NỘI DUNG TỪNG PHÂN HỆ (PLACEHOLDER GIAO DIỆN TƯƠNG TÁC SẴN SÀNG CHO DỮ LIỆU) -->
            <div class="flex-1 overflow-y-auto pr-1 space-y-6">
                <!-- ==================== TAB CONTENT: [T] TELEMETRY ==================== -->
                <div id="taco-content-t" class="taco-tab-pane block space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 flex flex-col justify-between">
                            <span class="font-mono text-[10px] tracking-widest text-[#60a5fa] uppercase">
                                WEBGL SHADER ENGINE
                            </span>
                            <span class="font-['Syne'] font-extrabold text-2xl text-white my-2">
                                Three.js 0.186
                            </span>
                            <span class="font-mono text-[9.5px] text-white/40">
                                Delta Prism Refraction // IOR 1.52
                            </span>
                        </div>
                        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 flex flex-col justify-between">
                            <span class="font-mono text-[10px] tracking-widest text-[#22c55e] uppercase">
                                RENDER FPS // STABLE
                            </span>
                            <span class="font-['Syne'] font-extrabold text-2xl text-white my-2">
                                60.0 FPS
                            </span>
                            <span class="font-mono text-[9.5px] text-white/40">
                                Hardware Acceleration // GPU Active
                            </span>
                        </div>
                        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 flex flex-col justify-between">
                            <span class="font-mono text-[10px] tracking-widest text-[#c8ff00] uppercase">
                                PIPELINE LATENCY
                            </span>
                            <span class="font-['Syne'] font-extrabold text-2xl text-white my-2">
                                14.2 ms
                            </span>
                            <span class="font-mono text-[9.5px] text-white/40">
                                Zero Frame Dropping Algorithm
                            </span>
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-gradient-to-r from-[#3b82f6]/15 via-black to-black border border-[#3b82f6]/30">
                        <h4 class="font-['Syne'] font-bold text-base text-white mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#3b82f6]"></span>
                            Phân Hệ Giám Sát Kỹ Thuật (Telemetry Console)
                        </h4>
                        <p class="font-mono text-xs text-white/70 leading-relaxed mb-4">
                            Khu vực hiển thị thông số chẩn đoán thời gian thực,
                            quản lý Quaternion ma trận góc quay 3D và tài nguyên
                            bộ nhớ đồ họa. Dữ liệu chi tiết sẽ được kết nối theo
                            yêu cầu của bạn.
                        </p>
                        <div class="flex items-center gap-3">
                            <button
                                type="button"
                                class="px-4 py-2 rounded-lg bg-[#3b82f6] hover:bg-[#2563eb] text-white font-mono text-xs font-bold uppercase transition-colors"
                            >
                                Kích hoạt Benchmark
                            </button>
                            <button
                                type="button"
                                class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-mono text-xs uppercase transition-colors"
                            >
                                Xem Log Shaders
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ==================== TAB CONTENT: [A] ARCHITECT ==================== -->
                <div id="taco-content-a" class="taco-tab-pane hidden space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center p-5 rounded-2xl bg-gradient-to-r from-[#eab308]/15 via-black to-black border border-[#eab308]/30">
                        <div class="md:col-span-4 flex flex-col items-center text-center gap-3">
                            <div class="w-28 h-28 rounded-2xl bg-gradient-to-tr from-[#eab308] via-[#c8ff00] to-white/20 p-[2px]">
                                <div class="w-full h-full bg-[#090d14] rounded-2xl flex flex-col items-center justify-center p-3">
                                    <img
                                        src="/logo.png"
                                        alt="AdolSoft"
