    // ============================================================================
    // 2. PROCEDURAL TEXTURES: ORGANIC FROSTED ICE MAPS & ARCHITECTURAL DOME
    // ============================================================================
    function createAlcheIceMaps(noiseScaleParam = 9.0) {
        const size = 512;

        // Canvas 1: Normal Map (Vân băng loang kết hợp viền tia băng xé nhòe chữ trắng)
        const normCanvas = document.createElement("canvas");
        normCanvas.width = size;
        normCanvas.height = size;
        const normCtx = normCanvas.getContext("2d")!;
        const normImg = normCtx.createImageData(size, size);
        const normData = normImg.data;

        // Canvas 2: Color & Patina Map (Tạo sắc Tím Indigo chủ đạo + các mảng tối hữu cơ ở đỉnh nhọn & sườn phải như ảnh gốc)
        const colCanvas = document.createElement("canvas");
        colCanvas.width = size;
        colCanvas.height = size;
        const colCtx = colCanvas.getContext("2d")!;
        const colImg = colCtx.createImageData(size, size);
        const colData = colImg.data;

        // Hàm nhiễu giả lập FBM mượt mà (Không tạo đốm trắng rời rạc)
        function smoothNoise(x: number, y: number) {
            return (
                Math.sin(x * 1.7 + Math.cos(y * 1.4)) * 0.5 +
                Math.cos(y * 2.3 - Math.sin(x * 1.9)) * 0.3 +
                Math.sin((x + y) * 4.5) * 0.2
            );
        }

        for (let y = 0; y < size; y++) {
            for (let x = 0; x < size; x++) {
                const u = x / size;
                const v = 1.0 - y / size; // v = 1 ở đỉnh chữ A, v = 0 ở chân chữ A

                const s = noiseScaleParam * 0.65;
                // Sóng loang lớn tạo độ cong khúc xạ
                const nLarge = smoothNoise(u * s, v * s);
                // Vân băng tần số trung bình tạo hiệu ứng tua rua ở rìa chữ trắng phía sau
                const nFrost =
                    smoothNoise(u * s * 3.8 + nLarge, v * s * 3.8 - nLarge) *
                    0.35;
                // Vân xước ngang nhẹ trên thân lăng kính
                const nStreak = Math.sin(v * 45.0 + nLarge * 6.0) * 0.08;

                const nx = (nLarge + nFrost + nStreak) * 0.5 + 0.5;
                const ny =
                    (smoothNoise(u * s + 2.1, v * s - 1.7) + nFrost) * 0.5 +
                    0.5;

                const idx = (y * size + x) * 4;
                normData[idx] = Math.min(
                    255,
                    Math.max(0, Math.floor(nx * 255)),
                );
                normData[idx + 1] = Math.min(
                    255,
                    Math.max(0, Math.floor(ny * 255)),
                );
                normData[idx + 2] = 255;
                normData[idx + 3] = 255;

                // Tính toán mảng màu Tím Indigo (#5b3ef5) kết hợp mảng tối hữu cơ ở đỉnh (v > 0.65) và sườn phải như ảnh gốc
                const topShadowMask =
                    Math.max(0, (v - 0.58) * 2.2) + (u > 0.48 ? 0.35 : 0.0);
                const organicPatch = smoothNoise(u * 5.5, v * 5.5);
                const darkFactor = Math.min(
                    1.0,
                    Math.max(
                        0.08,
                        1.0 - (topShadowMask * 0.65 + organicPatch * 0.38),
                    ),
                );

                // Sắc Tím Lam Indigo chuẩn Alche Studio
                colData[idx] = Math.floor(155 * darkFactor + 35); // R
                colData[idx + 1] = Math.floor(135 * darkFactor + 20); // G
                colData[idx + 2] = Math.floor(
                    255 * Math.min(1.0, darkFactor * 1.15 + 0.15),
                ); // B (Giữ kênh Blue/Indigo cao)
                colData[idx + 3] = 255;
            }
        }

        normCtx.putImageData(normImg, 0, 0);
        colCtx.putImageData(colImg, 0, 0);

        const normalTex = new THREE.CanvasTexture(normCanvas);
        normalTex.wrapS = THREE.ClampToEdgeWrapping;
        normalTex.wrapT = THREE.ClampToEdgeWrapping;
        normalTex.needsUpdate = true;

        const colorTex = new THREE.CanvasTexture(colCanvas);
        colorTex.wrapS = THREE.ClampToEdgeWrapping;
        colorTex.wrapT = THREE.ClampToEdgeWrapping;
        colorTex.needsUpdate = true;

        return { normalTex, colorTex };
    }

    // ============================================================================
    // PROCEDURAL DOME TEXTURE ATLASES (Alche Studio Halftone State Machine)
    // ============================================================================

    // State 1: Hero Continuous Diagonal Stripes & Macro Checkerboard Blocks (055816_hyprshot.jpg / media_1793573208862.jpg)
    // Resolution 2048x384 exactly matches 64:12 aspect ratio (5.333:1).
    // Every major tile is an EXACT 32x32px square. Every micro-dot is a 2x2px cell!
    function createDomeState1Texture(): THREE.CanvasTexture {
        const width = 2048;
        const height = 384;
        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d")!;

        // 1. Deep Monolithic Black Void
        ctx.fillStyle = "#000000";
        ctx.fillRect(0, 0, width, height);

        // 2. Large-scale Multi-Tile Macro Checkerboard Blocks (spanning 2x2 & 4x4 major tiles)
        const mSize = 64; // 2 major tiles (64x64px)
        const macroCols = width / mSize; // 32
        const macroRows = height / mSize; // 6

        for (let r = 0; r < macroRows; r++) {
            for (let c = 0; c < macroCols; c++) {
                // Reserve specific columns for continuous sweeping 45° diagonal bands
                const tileCol = c * 2;
                if (
                    (tileCol >= 6 && tileCol < 22) ||
                    (tileCol >= 38 && tileCol < 50)
                ) {
                    continue; // Leave for continuous stripe bands
                }

                const x = c * mSize;
                const y = r * mSize;
                const hash = Math.sin(c * 27.53 + r * 59.17) * 43758.5453;
                const rand = hash - Math.floor(hash);

                if (rand > 0.62 && rand <= 0.8) {
                    ctx.fillStyle = "#3a3a44";
                    ctx.fillRect(x, y, mSize, mSize);
                } else if (rand > 0.8 && rand <= 0.9) {
                    ctx.fillStyle = "#828490";
                    ctx.fillRect(x, y, mSize, mSize);
                } else if (rand > 0.9) {
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(x, y, mSize, mSize);
                }
            }
        }

        // 3. Continuous Large-Scale 45° Diagonal Stripe Bands (Sweeping across 16 and 12 major tiles seamlessly)
        // In 2048x384 canvas, dx = dy = 384px is an EXACT 45° diagonal line in 3D world space!
        const stripeZones = [
            { startX: 6 * 32, endX: 22 * 32 }, // 16 major tiles wide (512px)
            { startX: 38 * 32, endX: 50 * 32 }, // 12 major tiles wide (384px)
        ];

        stripeZones.forEach((zone) => {
            ctx.save();
            ctx.beginPath();
            ctx.rect(zone.startX, 0, zone.endX - zone.startX, height);
            ctx.clip();

            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 32.0; // Exactly 1 major square tile width!
            const spacing = 64.0; // Exactly 2 major square tiles cycle!

            for (
                let d = -height;
                d < zone.endX - zone.startX + height;
                d += spacing
            ) {
                ctx.beginPath();
                ctx.moveTo(zone.startX + d, 0);
                ctx.lineTo(zone.startX + d + height, height);
                ctx.stroke();
            }
            ctx.restore();
        });

        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.ClampToEdgeWrapping;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.generateMipmaps = true;
        tex.anisotropy = 4;
        return tex;
    }

    // State 2: Repeating Brand Typography MatrixWall (055831_hyprshot.jpg)
    function createDomeState2Texture(): THREE.CanvasTexture {
        const width = 2048;
        const height = 384;
        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d")!;

        ctx.fillStyle = "#000000";
        ctx.fillRect(0, 0, width, height);

        const numRows = 4;
        const rowH = height / numRows;

        ctx.font = '900 64px "Syne", "Inter", "Arial Black", sans-serif';
        ctx.textBaseline = "middle";
        ctx.fillStyle = "rgba(255, 255, 255, 0.42)";

        const word = "ADOLSOFT    ";
        const wordWidth = ctx.measureText(word).width;

        for (let r = 0; r < numRows; r++) {
            const y = r * rowH + rowH * 0.5;
            const stagger = r % 2 === 0 ? 0 : wordWidth * 0.5;
            for (
                let x = -wordWidth + (stagger % wordWidth);
                x < width + wordWidth * 2;
                x += wordWidth
            ) {
                ctx.fillText(word, x, y);
            }
        }

        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.ClampToEdgeWrapping;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.generateMipmaps = true;
        tex.anisotropy = 4;
        return tex;
    }

    // State 3: Giant Tilted "WORKS" / "DOMAINS" Section Transition (055823_hyprshot.jpg)
    function createDomeState3Texture(): THREE.CanvasTexture {
        const width = 2048;
        const height = 384;
        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d")!;

        ctx.fillStyle = "#000000";
        ctx.fillRect(0, 0, width, height);

        ctx.save();
        ctx.translate(width * 0.5, height * 0.5);
        ctx.rotate(-8 * (Math.PI / 180));

        ctx.font = '900 240px "Syne", "Inter", "Arial Black", sans-serif';
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillStyle = "#ffffff";
        try {
            (ctx as any).letterSpacing = "14px";
        } catch (_) {}
        ctx.fillText("WORKS", 0, 10);
        ctx.restore();

        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.ClampToEdgeWrapping;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.generateMipmaps = true;
        tex.anisotropy = 4;
        return tex;
    }

    function createRazorSharpBrandTexture(
        brandWord = "ADOLSOFT",
    ): THREE.CanvasTexture {
        const isWorks = brandWord === "WORKS" || brandWord === "WORK";
        const c = document.createElement("canvas");
        c.width = 4096;
        c.height = isWorks ? 1390 : 1060;
        const ctx = c.getContext("2d")!;
        ctx.clearRect(0, 0, c.width, c.height);

        const cx = c.width / 2;
        const cy = c.height / 2;

        if (isWorks) {
            // 1. Quầng sáng trắng / cyan tán sắc ở tâm phía sau chữ R (Caustic Glow behind A apex)
            const arcGrad = ctx.createRadialGradient(cx, cy, 40, cx, cy, 680);
            arcGrad.addColorStop(0, "#ffffff");
            arcGrad.addColorStop(0.28, "rgba(240, 248, 255, 0.92)");
            arcGrad.addColorStop(0.58, "rgba(200, 225, 255, 0.42)");
            arcGrad.addColorStop(0.82, "rgba(150, 185, 255, 0.12)");
            arcGrad.addColorStop(1, "transparent");
            ctx.fillStyle = arcGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, 680, 0, Math.PI * 2);
            ctx.fill();

            // 2. Chữ "WORKS" to hoành tráng, font nét dày chuẩn kiến trúc Alche Studio
            let fontSize = 720;
            try {
                (ctx as any).letterSpacing = "115px";
            } catch (e) {}
            ctx.font = `900 ${fontSize}px "Syne", "Inter", "Arial Black", sans-serif`;
            const textMetrics = ctx.measureText("WORKS");
            const maxAvailableWidth = c.width - 240;
            if (textMetrics.width > maxAvailableWidth) {
                fontSize = Math.floor(
                    fontSize * (maxAvailableWidth / textMetrics.width),
                );
                ctx.font = `900 ${fontSize}px "Syne", "Inter", "Arial Black", sans-serif`;
            }

            ctx.textAlign = "center";
            ctx.textBaseline = "middle";

            // Fill chữ với gradient sáng trắng tinh khôi
            const textGrad = ctx.createLinearGradient(
                0,
                cy - fontSize * 0.5,
                0,
                cy + fontSize * 0.5,
            );
            textGrad.addColorStop(0, "#FFFFFF");
            textGrad.addColorStop(0.5, "#F4F7FF");
            textGrad.addColorStop(1, "#DCE5FA");
            ctx.fillStyle = textGrad;
            ctx.fillText("WORKS", cx, cy + 18);

            // 3. Hiệu ứng lưới CAD / Scanlines kiến trúc âm bản bên trong thân chữ (chuẩn 100% ảnh Alche Studio)
            ctx.save();
            ctx.globalCompositeOperation = "source-atop";

            // Scanlines ngang cực mịn
            ctx.strokeStyle = "rgba(12, 18, 32, 0.35)";
            ctx.lineWidth = 3.5;
            for (let y = 0; y < c.height; y += 14) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(c.width, y);
                ctx.stroke();
            }

            // Đường lưới dọc CAD
            ctx.strokeStyle = "rgba(12, 18, 32, 0.25)";
            ctx.lineWidth = 2.5;
            for (let x = 0; x < c.width; x += 28) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, c.height);
                ctx.stroke();
            }

            // Khung lưới phân khối kiến trúc lớn (major grid)
            ctx.strokeStyle = "rgba(8, 14, 26, 0.50)";
            ctx.lineWidth = 5;
            for (let x = cx % 224; x < c.width; x += 224) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, c.height);
                ctx.stroke();
            }
            ctx.restore();

            // Viền sắc nét quanh thân chữ
            ctx.strokeStyle = "rgba(255, 255, 255, 0.88)";
            ctx.lineWidth = 4;
            ctx.strokeText("WORKS", cx, cy + 18);
        } else {
            // 1. Quầng sáng trắng hình vòng cung ở tâm (Central Caustic White Arc)
            const arcGrad = ctx.createRadialGradient(cx, cy, 30, cx, cy, 460);
            arcGrad.addColorStop(0, "#ffffff");
            arcGrad.addColorStop(0.35, "rgba(255, 255, 255, 0.98)");
            arcGrad.addColorStop(0.65, "rgba(255, 255, 255, 0.50)");
            arcGrad.addColorStop(0.85, "rgba(255, 255, 255, 0.15)");
            arcGrad.addColorStop(1, "transparent");
            ctx.fillStyle = arcGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, 460, 0, Math.PI * 2);
            ctx.fill();

            // 2. Perfect Text Padding & Framing for ADOLSOFT
            let fontSize = 380;
            ctx.font = `900 ${fontSize}px "Syne", "Inter", "Arial Black", sans-serif`;
            const textMetrics = ctx.measureText(brandWord);
            const maxAvailableWidth = c.width - 640;
            if (textMetrics.width > maxAvailableWidth) {
                fontSize = Math.floor(
                    fontSize * (maxAvailableWidth / textMetrics.width),
                );
                ctx.font = `900 ${fontSize}px "Syne", "Inter", "Arial Black", sans-serif`;
            }

            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillStyle = "#FFFFFF";
            ctx.fillText(brandWord, cx, cy + 12);

            // Clean Alpha Bleeding for ADOLSOFT
            const imgData = ctx.getImageData(0, 0, c.width, c.height);
            const data = imgData.data;
            for (let i = 0; i < data.length; i += 4) {
                data[i] = 255;
                data[i + 1] = 255;
                data[i + 2] = 255;
            }
            ctx.putImageData(imgData, 0, 0);
        }

        const texture = new THREE.CanvasTexture(c);
        texture.generateMipmaps = false;
        texture.minFilter = THREE.LinearFilter;
        texture.magFilter = THREE.LinearFilter;
        texture.colorSpace = THREE.SRGBColorSpace;
        texture.needsUpdate = true;
        return texture;
    }

    // Pre-load the 100% full-cover liquid glass fluid art background images for the 6 cards
    const cardBgImages: HTMLImageElement[] = [];
    for (let i = 0; i < 6; i++) {
        const img = new Image();
        img.src = `/assets/cards/liquid_full_${i}.jpg`;
        cardBgImages.push(img);
    }

    function drawCardContent(
        ctx: CanvasRenderingContext2D,
        canvas: HTMLCanvasElement,
        domain: DomainItem,
        idx: number,
    ) {
        // 1. Draw 100% Full-Cover Liquid Glass Chromatic Sculpture
        const bgImg = cardBgImages[idx] || cardBgImages[0];
        if (bgImg && bgImg.complete && bgImg.naturalWidth > 0) {
            ctx.drawImage(bgImg, 0, 0, canvas.width, canvas.height);
        } else {
            // Fallback dark gradient base
            const bgGrad = ctx.createLinearGradient(
                0,
                0,
                canvas.width,
                canvas.height,
            );
            bgGrad.addColorStop(0, "#060912");
            bgGrad.addColorStop(0.5, "#0a0e1c");
            bgGrad.addColorStop(1, "#04070e");
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        // 2. Optical Glass Scrim (Tạo độ trong kính tối nhẹ bên trái để chữ nổi bật 100% trên nền chất lỏng)
        const glassOverlay = ctx.createLinearGradient(0, 0, canvas.width, 0);
        glassOverlay.addColorStop(0, "rgba(4, 7, 14, 0.72)");
        glassOverlay.addColorStop(0.48, "rgba(4, 7, 14, 0.42)");
        glassOverlay.addColorStop(0.85, "rgba(4, 7, 14, 0.08)");
        glassOverlay.addColorStop(1, "rgba(4, 7, 14, 0.22)");
        ctx.fillStyle = glassOverlay;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // 3. Subtle CAD architectural background grid
        ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
        ctx.lineWidth = 1;
        for (let x = 0; x < canvas.width; x += 64) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, canvas.height);
            ctx.stroke();
        }
        for (let y = 0; y < canvas.height; y += 64) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(canvas.width, y);
            ctx.stroke();
        }

        // 4. Hairline Corner Registration Accents
        const m = 64;
        const len = 20;
        ctx.strokeStyle = "rgba(255, 255, 255, 0.50)";
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(m, m + len);
        ctx.lineTo(m, m);
        ctx.lineTo(m + len, m);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(canvas.width - m - len, m);
        ctx.lineTo(canvas.width - m, m);
        ctx.lineTo(canvas.width - m, m + len);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(m, canvas.height - m - len);
        ctx.lineTo(m, canvas.height - m);
        ctx.lineTo(m + len, canvas.height - m);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(canvas.width - m - len, canvas.height - m);
        ctx.lineTo(canvas.width - m, canvas.height - m);
        ctx.lineTo(canvas.width - m, canvas.height - m - len);
        ctx.stroke();

        // 5. Razor-Sharp Typography with Drop Shadows for Extreme Legibility over Fluid Art
        ctx.shadowColor = "rgba(0, 0, 0, 0.96)";
        ctx.shadowBlur = 24;
        ctx.shadowOffsetX = 0;
        ctx.shadowOffsetY = 6;

        // Category / Domain Index Tag
        ctx.font = '700 30px "JetBrains Mono", monospace';
        ctx.fillStyle = domain.accent;
        ctx.fillText(
            `■ ${domain.index} // ${domain.label || domain.category}`,
            120,
            155,
        );

        if (idx < 4) {
            // 4 thẻ đầu: Tên chủ đề đã có ở Header HUD phía trên nên không để tên chủ đề trong thẻ
            ctx.font = '600 52px "Inter", sans-serif';
            ctx.fillStyle = "rgba(255, 255, 255, 0.95)";
            const subMaxWidth = canvas.width - 280;
            const subWidth = ctx.measureText(domain.subtitle).width;
            if (subWidth > subMaxWidth) {
                const subFontSize = 52 * (subMaxWidth / subWidth);
                ctx.font = `600 ${subFontSize}px "Inter", sans-serif`;
            }
            ctx.fillText(domain.subtitle, 120, 310);
        } else {
            // Title (Solid, Crisp, Architectural Typography)
            ctx.font = '800 132px "Syne", sans-serif';
            const titleMaxWidth = canvas.width - 280;
            const titleWidth = ctx.measureText(domain.title).width;
            if (titleWidth > titleMaxWidth) {
                const titleFontSize = 132 * (titleMaxWidth / titleWidth);
                ctx.font = `800 ${titleFontSize}px "Syne", sans-serif`;
            }
            ctx.fillStyle = "#ffffff";
            ctx.fillText(domain.title, 120, 375);

            // Subtitle
            ctx.font = '500 40px "Inter", sans-serif';
            ctx.fillStyle = "rgba(255, 255, 255, 0.95)";
            ctx.fillText(domain.subtitle, 120, 465);
        }

        ctx.shadowBlur = 0; // reset shadow for buttons & pills

        // Metric Pill (Frosted Glass Capsule)
        ctx.fillStyle = "rgba(6, 11, 20, 0.88)";
        ctx.strokeStyle = domain.accent;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.roundRect(120, 1030, 740, 96, 48);
        ctx.fill();
        ctx.stroke();

        ctx.font = '700 34px "JetBrains Mono", monospace';
        const metricText = `⚡ ${domain.metric}`;
        const metricMaxWidth = 640;
        const metricWidth = ctx.measureText(metricText).width;
        if (metricWidth > metricMaxWidth) {
            const metricFontSize = 34 * (metricMaxWidth / metricWidth);
            ctx.font = `700 ${metricFontSize}px "JetBrains Mono", monospace`;
        }
        ctx.fillStyle = "#ffffff";
        ctx.fillText(metricText, 165, 1092);

        // CTA Hint
        ctx.font = '600 26px "JetBrains Mono", monospace';
        ctx.fillStyle = "rgba(255, 255, 255, 0.85)";
        ctx.fillText(`CLICK PANEL TO INSPECT ARCHITECTURE ↗`, 1140, 1092);
    }

    function createCurvedCardTexture(
        domain: DomainItem,
        idx: number,
    ): THREE.CanvasTexture {
        const canvas = document.createElement("canvas");
        // High-resolution Retina canvas (2048 x 1312) preserving exact 1.56 aspect ratio
        canvas.width = 2048;
        canvas.height = 1312;
        const ctx = canvas.getContext("2d")!;

        drawCardContent(ctx, canvas, domain, idx);

        const tex = new THREE.CanvasTexture(canvas);
        tex.generateMipmaps = false;
        tex.minFilter = THREE.LinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.anisotropy = 8;
        tex.needsUpdate = true;

        // If image was not yet loaded into cache, re-draw once it finishes loading
        const bgImg = cardBgImages[idx] || cardBgImages[0];
        if (bgImg && (!bgImg.complete || bgImg.naturalWidth === 0)) {
            bgImg.addEventListener("load", () => {
                drawCardContent(ctx, canvas, domain, idx);
                tex.needsUpdate = true;
            });
        }

        return tex;
    }

    (window as any).renderDomainBlueprintToCanvas = (
        domainIndex: number,
        targetCanvas: HTMLCanvasElement,
    ) => {
        const domain = ADOLSOFT_DOMAINS[domainIndex] || ADOLSOFT_DOMAINS[0];
        const sourceTex = createCurvedCardTexture(domain, domainIndex);
        const ctx = targetCanvas.getContext("2d");
        if (ctx && sourceTex.image) {
            ctx.clearRect(0, 0, targetCanvas.width, targetCanvas.height);
            ctx.drawImage(
                sourceTex.image,
                0,
                0,
                targetCanvas.width,
                targetCanvas.height,
            );
        }
    };

    // ============================================================================
    // 3. INITIALIZE THREE.JS SCENE & COMPONENTS
    // ============================================================================
    const canvas = document.getElementById(
        "alche-webgl-canvas",
    ) as HTMLCanvasElement;
    if (canvas) {
        const renderer = new THREE.WebGLRenderer({
            canvas,
            antialias: true,
            powerPreference: "high-performance",
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color("#040407");

        const camera = new THREE.PerspectiveCamera(
            42,
            window.innerWidth / window.innerHeight,
            0.1,
            120,
        );
        camera.position.set(0, 0, 9.2);

        const pmremGenerator = new THREE.PMREMGenerator(renderer);
        const roomEnv = new RoomEnvironment();
        const envMap = pmremGenerator.fromScene(roomEnv, 0.04).texture;
        scene.environment = envMap;
        pmremGenerator.dispose();

        // Studio Directional & Dispersion Lighting (Matching Alche Studio Liquid Glass Prism - NO PointLight hotspot)
        const ambientLight = new THREE.AmbientLight(0x0f172a, 0.85);
        scene.add(ambientLight);

        // 1. Ánh sáng chiếu xuyên sau lưng lỗ tam giác (z = -0.65)
        const prismCyanLight = new THREE.PointLight(0x00f0ff, 32, 6.0);
        prismCyanLight.position.set(-0.35, 0.05, -0.65);
        scene.add(prismCyanLight);

        const prismAmberLight = new THREE.PointLight(0xff6a00, 36, 6.0);
        prismAmberLight.position.set(0.42, -0.15, -0.65);
        scene.add(prismAmberLight);

        // 2. Ánh sáng định hướng mặt trước (TUYỆT ĐỐI KHÔNG dùng PointLight phía trước để tránh điểm lóa mắt)
        const frontIndigoDirLight = new THREE.DirectionalLight(0x6366f1, 3.8);
        frontIndigoDirLight.position.set(-2.5, 3.0, 5.0);
        scene.add(frontIndigoDirLight);

        const fillVioletDirLight = new THREE.DirectionalLight(0x818cf8, 2.5);
        fillVioletDirLight.position.set(3.0, -2.0, 4.0);
        scene.add(fillVioletDirLight);

        // --------------------------------------------------------------------------
        // A. 4-STATE PROCEDURAL HALFTONE CONCAVE CYLINDRICAL DOME (Alche Studio Benchmark)
        // --------------------------------------------------------------------------
        const texState1 = createDomeState1Texture();
        const texState2 = createDomeState2Texture();
        const texState3 = createDomeState3Texture();

        const domeGeo = new THREE.CylinderGeometry(18, 18, 21.206, 96, 1, true);
        const domeMat = new THREE.ShaderMaterial({
            side: THREE.BackSide,
            depthWrite: false,
            uniforms: {
                uTexState1: { value: texState1 },
                uTexState2: { value: texState2 },
                uTexState3: { value: texState3 },
                uTime: { value: 0 },
                uScrollProgress: { value: 0 },
                uActiveCardColor: {
                    value: new THREE.Color(
                        ADOLSOFT_DOMAINS[0]?.accent || "#c8ff00",
                    ),
                },
            },
            vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * viewMatrix * modelMatrix * vec4(position, 1.0);
        }
      `,
            fragmentShader: `
        uniform sampler2D uTexState1; // Continuous diagonal bands & macro blocks
        uniform sampler2D uTexState2; // Repeating ADOLSOFT matrix wall
        uniform sampler2D uTexState3; // Giant tilted WORKS
        uniform float uTime;
        uniform float uScrollProgress; // 0.0 (Hero) -> 1.0 (Works Showcase)
        uniform vec3 uActiveCardColor; // Dynamic color bleed from current 3D project card
        varying vec2 vUv;

        // Helper: Cycle smoothly between 4 Alche color palettes every 2.0 seconds
        vec3 getAlchePalette(float t) {
          float cycle = mod(t * 0.5, 4.0); // 1 step every 2 seconds
          vec3 c0 = vec3(0.16, 0.12, 0.48); // Deep Electric Indigo (055831)
          vec3 c1 = vec3(0.06, 0.30, 0.34); // Cyber Teal / Emerald (121329)
          vec3 c2 = vec3(0.24, 0.10, 0.42); // Royal Violet / Magenta (121335)
          vec3 c3 = vec3(0.18, 0.19, 0.22); // Monochromatic Silver/Graphite (055816)

          if (cycle < 1.0) return mix(c0, c1, smoothstep(0.0, 1.0, cycle));
          if (cycle < 2.0) return mix(c1, c2, smoothstep(1.0, 2.0, cycle));
          if (cycle < 3.0) return mix(c2, c3, smoothstep(2.0, 3.0, cycle));
          return mix(c3, c0, smoothstep(3.0, 4.0, cycle));
        }

        void main() {
          // 1. Correct BackSide Horizontal Mirroring
          vec2 uv = vec2(1.0 - vUv.x, vUv.y);

          // 2. Physical Aspect Ratio Alignment:
          // 64 columns x 12 rows creates perfect 1:1 square tiles in 3D world space (18 radius, 21.206 height)
          vec2 majorGridCount = vec2(64.0, 12.0);
          vec2 gridCell = fract(uv * majorGridCount);
          float majorLine = step(0.965, gridCell.x) + step(0.965, gridCell.y);

          // Micro LED Halftone Dots: exactly 16 circular micro-dots per major square tile
          // totalDots is exactly 1024.0 x 192.0 (integers guarantee zero cylinder seam tearing!)
          vec2 totalDots = majorGridCount * 16.0;
          vec2 dotGridUv = uv * totalDots;
          vec2 dotCenterUv = (floor(dotGridUv) + 0.5) / totalDots; // Quantized UV at dot center!
          vec2 dotLocal = fract(dotGridUv) - 0.5;

          // Crisp circular LED dot mask (radius 0.34, sharp anti-aliased edge)
          // Always a crisp Euclidean circle, NEVER an elongated barcode dash!
          float circleDot = 1.0 - smoothstep(0.28, 0.38, length(dotLocal));

          // Optical Crosshairs (+) at every 2nd major intersection
          vec2 crossGrid = fract(uv * (majorGridCount * 0.5));
          float crossArmX = step(abs(crossGrid.y - 0.5), 0.005) * step(abs(crossGrid.x - 0.5), 0.038);
          float crossArmY = step(abs(crossGrid.x - 0.5), 0.005) * step(abs(crossGrid.y - 0.5), 0.038);
          float crosshair = clamp(crossArmX + crossArmY, 0.0, 1.0);

          // 3. Sample Textures at Quantized Dot Centers (Eliminates blur, guarantees uniform dot brightness!)
          vec2 scrolledUv1 = vec2(dotCenterUv.x + uTime * 0.006, dotCenterUv.y);
          vec2 scrolledUv2 = vec2(dotCenterUv.x - uTime * 0.010, dotCenterUv.y + uScrollProgress * 0.15);
          float s1 = texture2D(uTexState1, scrolledUv1).r;
          float s2 = texture2D(uTexState2, scrolledUv2).r;
          float s3 = texture2D(uTexState3, dotCenterUv).r;

          // State weights based on uScrollProgress:
          // [0.00 - 0.20]: State 1 (Continuous Diagonal Stripes & Macro Blocks)
          // [0.20 - 0.45]: State 2 (Repeating ADOLSOFT Matrix)
          // [0.45 - 0.70]: State 3 (Giant Tilted WORKS)
          // [0.70 - 1.00]: State 4 (Darkened Stage with Floor Color Reflection from Active Card)
          float w1 = 1.0 - smoothstep(0.12, 0.28, uScrollProgress);
          float w2 = smoothstep(0.15, 0.28, uScrollProgress) * (1.0 - smoothstep(0.42, 0.55, uScrollProgress));
          float w3 = smoothstep(0.42, 0.55, uScrollProgress) * (1.0 - smoothstep(0.68, 0.80, uScrollProgress));
          float w4 = smoothstep(0.68, 0.85, uScrollProgress);

          float patternIntensity = (s1 * w1 + s2 * w2 + s3 * w3) * circleDot;

          // 4. Apply 2-Second Dynamic Color Shifting Palette
          vec3 baseDark = vec3(0.015, 0.016, 0.025);
          vec3 dynamicHue = getAlchePalette(uTime);

          // Checkerboard subtle tint variation across major tiles
          vec2 tileId = floor(uv * majorGridCount);
          float checker = mod(tileId.x + tileId.y, 2.0);
          vec3 tileTint = mix(baseDark, dynamicHue * 0.45, checker * 0.65 + 0.35);

          // Chromatic vertical light pillars (amber, magenta, emerald from reference media_1793573208862.jpg)
          float pillar1 = exp(-pow((fract(uv.x + 0.14) - 0.5) * 8.0, 2.0)); // Amber
          float pillar2 = exp(-pow((fract(uv.x + 0.28) - 0.5) * 10.0, 2.0)); // Magenta
          float pillar3 = exp(-pow((fract(uv.x + 0.42) - 0.5) * 7.5, 2.0)); // Emerald
          vec3 chromaticPillars = vec3(1.0, 0.72, 0.15) * pillar1 * 0.35
                                + vec3(0.88, 0.12, 0.42) * pillar2 * 0.40
                                + vec3(0.18, 0.88, 0.38) * pillar3 * 0.32;

          vec3 patternColor = mix(tileTint + chromaticPillars * circleDot * 0.4, dynamicHue * 1.65 + vec3(0.28), patternIntensity);
          patternColor += chromaticPillars * patternIntensity * 0.65;

          // 5. State 4 Floor Ambient Reflection (Matches 055835_hyprshot.jpg)
          float floorMask = smoothstep(0.42, 0.08, vUv.y) * exp(-pow((vUv.x - 0.5) * 2.5, 2.0));
          patternColor += uActiveCardColor * floorMask * w4 * 0.55 * circleDot;

          // 6. Overlay Major Grid Lines & Optical Crosshairs (+)
          patternColor = mix(patternColor, vec3(0.02), clamp(majorLine, 0.0, 1.0) * 0.75);
          patternColor += vec3(0.55, 0.60, 0.75) * crosshair * 0.45;

          // 7. 4-Corner Spatial Radial & Vertical Vignette
          float vertFade = smoothstep(0.01, 0.22, vUv.y) * smoothstep(0.99, 0.78, vUv.y);
          float radialFade = smoothstep(1.15, 0.25, length(vUv - 0.5) * 1.35);

          gl_FragColor = vec4(patternColor * vertFade * (0.35 + 0.65 * radialFade), 1.0);
        }
      `,
        });

        const architecturalDome = new THREE.Mesh(domeGeo, domeMat);
        // Xoay nhẹ vòm trụ để vùng trung tâm (vUv.x = 0.5) nằm đối diện trực tiếp với Camera
        architecturalDome.rotation.y = Math.PI * 0.5;
        scene.add(architecturalDome);

        // --------------------------------------------------------------------------
        // A2. FLOATING SPATIAL CYBER MOTES (Volumetric Bokeh Particles)
        // Hạt quang sai phát sáng lơ lửng trong không gian 3D tạo chiều sâu điện ảnh
        // --------------------------------------------------------------------------
        const particleCount = 140;
        const particleGeo = new THREE.BufferGeometry();
        const pPositions = new Float32Array(particleCount * 3);
        const pBaseY = new Float32Array(particleCount);
        const pSpeeds = new Float32Array(particleCount);
        const pColors = new Float32Array(particleCount * 3);

        const particlePalette = [
            new THREE.Color("#c8ff00"), // Lime
            new THREE.Color("#00f0ff"), // Cyan
            new THREE.Color("#ffaa00"), // Amber
            new THREE.Color("#ffffff"), // Pure White
        ];

        for (let i = 0; i < particleCount; i++) {
            pPositions[i * 3 + 0] = (Math.random() - 0.5) * 18.0;
            const py = (Math.random() - 0.5) * 10.0;
            pPositions[i * 3 + 1] = py;
            pBaseY[i] = py;
            pPositions[i * 3 + 2] = -2.5 - Math.random() * 11.5;
            pSpeeds[i] = 0.25 + Math.random() * 0.45;

            const pCol =
                particlePalette[
                    Math.floor(Math.random() * particlePalette.length)
                ];
            pColors[i * 3 + 0] = pCol.r;
            pColors[i * 3 + 1] = pCol.g;
            pColors[i * 3 + 2] = pCol.b;
        }

        particleGeo.setAttribute(
            "position",
            new THREE.BufferAttribute(pPositions, 3),
        );
        particleGeo.setAttribute(
            "color",
            new THREE.BufferAttribute(pColors, 3),
        );

        function createBokehParticleTexture(): THREE.CanvasTexture {
            const c = document.createElement("canvas");
            c.width = 64;
            c.height = 64;
            const ctx = c.getContext("2d")!;
            const grad = ctx.createRadialGradient(32, 32, 2, 32, 32, 30);
            grad.addColorStop(0, "rgba(255, 255, 255, 1)");
            grad.addColorStop(0.35, "rgba(255, 255, 255, 0.7)");
            grad.addColorStop(0.7, "rgba(255, 255, 255, 0.15)");
            grad.addColorStop(1, "transparent");
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 64, 64);
            const tex = new THREE.CanvasTexture(c);
            return tex;
        }

        const particleMat = new THREE.PointsMaterial({
            size: 0.18,
            map: createBokehParticleTexture(),
            transparent: true,
            opacity: 0.38,
            vertexColors: true,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
        });

        const particleSystem = new THREE.Points(particleGeo, particleMat);
        scene.add(particleSystem);

        // --------------------------------------------------------------------------
        // B. LIQUID CHROMATIC SHOCKWAVE (Z = -1.3, Sóng nước nổ bùm bóng loáng)
        // --------------------------------------------------------------------------
        const shockwaveMat = new THREE.ShaderMaterial({
            transparent: true,
            depthWrite: false,
            uniforms: {
                uTime: { value: 0 },
                uRadius: { value: 0.0 },
                uIntensity: { value: 0.0 },
                uAspect: { value: window.innerWidth / window.innerHeight },
            },
            vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
            fragmentShader: `
        uniform float uTime;
        uniform float uRadius;
        uniform float uIntensity;
        uniform float uAspect;
        varying vec2 vUv;

        void main() {
          vec2 uv = vUv - 0.5;
          uv.x *= uAspect;
          float dist = length(uv) * 2.0;

          // Vòng sóng nước bóng loáng nổ bùm tỏa ra từ tâm
          float ring = exp(-pow(dist - uRadius, 2.0) / 0.035) * uIntensity;
          float ring2 = exp(-pow(dist - uRadius * 0.72, 2.0) / 0.065) * uIntensity * 0.55;

          // Sắc màu quang sai cầu vồng (Lime #c8ff00, Cyan #38bdf8, Purple #a855f7)
          vec3 cLime = vec3(0.78, 1.0, 0.0);
          vec3 cCyan = vec3(0.22, 0.74, 0.97);
          vec3 cViolet = vec3(0.66, 0.33, 0.97);
          vec3 cWhite = vec3(1.0, 1.0, 1.0);

          vec3 col = mix(cCyan, cLime, sin(dist * 12.0 + uTime * 4.0) * 0.5 + 0.5);
          col = mix(col, cViolet, sin(dist * 6.0 - uTime * 3.0) * 0.5 + 0.5);
          col += cWhite * pow(ring, 2.2) * 1.8;

          float totalAlpha = (ring * 1.35 + ring2 * 0.75) * (1.0 - smoothstep(1.6, 2.8, uRadius));
          totalAlpha = clamp(totalAlpha, 0.0, 1.0);

          gl_FragColor = vec4(col, totalAlpha);
        }
      `,
        });
        const shockwaveGeo = new THREE.PlaneGeometry(16, 16);
        const shockwaveMesh = new THREE.Mesh(shockwaveGeo, shockwaveMat);
        shockwaveMesh.position.set(0, 0, -1.3);
        scene.add(shockwaveMesh);

        // --------------------------------------------------------------------------
        // C. CRISP VECTOR-GRADE BRAND TEXT ("ADOLSOFT") AT Z = -1.25
        // Perfect Padding & Framing: Zero Edge Clipping, No Halos, DepthWrite: false
        // --------------------------------------------------------------------------
        const backTextGeo = new THREE.PlaneGeometry(11.2, 2.9);
        const backTextMat = new THREE.MeshBasicMaterial({
            map: createRazorSharpBrandTexture("ADOLSOFT"),
            transparent: true,
            opacity: 0.0,
            toneMapped: false,
            alphaTest: 0.01,
            depthWrite: false,
        });

        const backTextMesh = new THREE.Mesh(backTextGeo, backTextMat);
        // Vị trí xuất phát ngầm dưới đường chân trời để kích nổ hiệu ứng phóng vút lên
        backTextMesh.position.set(0, -2.5, -1.25);
        backTextMesh.scale.set(0.08, 0.08, 1.0);
        backTextMesh.rotation.set(1.5, 0.0, -0.2);
        backTextMat.color.set("#c8ff00");
        backTextMesh.renderOrder = 1;
        scene.add(backTextMesh);

        // --------------------------------------------------------------------------
        // C2. ARCHITECTURAL TRANSITION TEXT ("WORKS") AT Z = -1.35 (Matches Screenshot 1 & 3)
        // Monumental Full-Width CAD Grid Typography: Spans 16.8 x 5.7 across viewport
        // --------------------------------------------------------------------------
        const worksTextGeo = new THREE.PlaneGeometry(16.8, 5.7);
        const worksTextMat = new THREE.MeshBasicMaterial({
            map: createRazorSharpBrandTexture("WORKS"),
            transparent: true,
            opacity: 0.0,
            toneMapped: false,
            alphaTest: 0.01,
            depthWrite: false,
        });
        const worksTextMesh = new THREE.Mesh(worksTextGeo, worksTextMat);
        worksTextMesh.position.set(0, 0.1, -1.35);
        worksTextMesh.renderOrder = 1;
        scene.add(worksTextMesh);
        // C. LIQUID GLASS "A" SCULPTED PRISM (Positioned in FRONT at Z = 0.0)
        // Khối Băng Pha Lê Tím Xanh Xuyên Thấu Tuyệt Đối (Chuẩn Alche Studio ảnh.jpg)
        // --------------------------------------------------------------------------
        // --------------------------------------------------------------------------
        // C. LIQUID GLASS "A" SCULPTED PRISM (Positioned in FRONT at Z = 0.0)
        // Khối Băng Pha Lê Tím Xanh Xuyên Thấu Tuyệt Đối (Chuẩn Alche Studio ảnh.jpg)
        // --------------------------------------------------------------------------
        function createSculptedAlcheLetterAGeometry(): THREE.BufferGeometry {
            const shape = new THREE.Shape();

            // 1. Biên dạng ngoài chữ A chuẩn tỷ lệ Alche Studio (có rãnh khía vát ở 2 chân đế)
            shape.moveTo(0, 1.82); // Đỉnh nhọn chữ A
            shape.lineTo(-1.56, -1.45); // Cạnh sườn trái
            shape.lineTo(-1.5, -1.52); // Vát nhẹ góc ngoài chân trái
            shape.lineTo(-0.82, -1.52); // Đáy bằng chân trái
            shape.lineTo(-0.7, -1.3); // Khía vát lên (Notch trái)
            shape.lineTo(0.7, -1.3); // Đáy thanh ngang gầm chữ A
            shape.lineTo(0.82, -1.52); // Khía vát xuống (Notch phải)
            shape.lineTo(1.5, -1.52); // Đáy bằng chân phải
            shape.lineTo(1.56, -1.45); // Vát nhẹ góc ngoài chân phải
            shape.closePath();

            // 2. Lỗ tam giác rỗng ở chính tâm chữ A (nơi khúc xạ và phát sáng cầu vồng ở cạnh vát)
            const hole = new THREE.Path();
            hole.moveTo(0, 0.36); // Đỉnh lỗ tam giác trong
            hole.lineTo(-0.5, -0.78); // Góc trái lỗ tam giác
            hole.lineTo(0.5, -0.78); // Góc phải lỗ tam giác
            hole.closePath();
            shape.holes.push(hole);

            // 3. Đúc khối 3D với mặt vát (Bevel) rộng ở cạnh trong để bắt dải tán sắc cầu vồng
            const extrudeSettings: THREE.ExtrudeGeometryOptions = {
                steps: 2,
                depth: 0.52,
                bevelEnabled: true,
                bevelThickness: 0.14,
                bevelSize: 0.1,
                bevelOffset: 0,
                bevelSegments: 8,
            };

            const geo = new THREE.ExtrudeGeometry(shape, extrudeSettings);
            geo.center();
            geo.computeVertexNormals();

            // 4. BẮT BUỘC: Chuẩn hóa tọa độ UV về đúng [0.0 -> 1.0] để xóa vĩnh viễn lỗi đốm hạt đá hoa cương
            geo.computeBoundingBox();
            const max = geo.boundingBox!.max;
            const min = geo.boundingBox!.min;
            const rangeX = max.x - min.x || 1;
            const rangeY = max.y - min.y || 1;

            const posAttr = geo.attributes.position;
            const uvAttr = geo.attributes.uv;
            for (let i = 0; i < posAttr.count; i++) {
                const u = (posAttr.getX(i) - min.x) / rangeX;
                const v = (posAttr.getY(i) - min.y) / rangeY;
                uvAttr.setXY(i, u, v);
            }
            uvAttr.needsUpdate = true;

            return geo;
        }

        function createInnerPrismBevelGeometry(): THREE.BufferGeometry {
            const outerPath = [
                new THREE.Vector2(0, 0.38),
                new THREE.Vector2(-0.52, -0.8),
                new THREE.Vector2(0.52, -0.8),
            ];
            const innerPath = [
                new THREE.Vector2(0, 0.34),
                new THREE.Vector2(-0.48, -0.76),
                new THREE.Vector2(0.48, -0.76),
            ];

            const shape = new THREE.Shape(outerPath);
            const hole = new THREE.Path(innerPath);
            shape.holes.push(hole);

            const geo = new THREE.ExtrudeGeometry(shape, {
                depth: 0.48,
                bevelEnabled: false,
            });
            geo.center();
            return geo;
        }

        const innerPrismBevelMat = new THREE.ShaderMaterial({
            transparent: true,
            side: THREE.DoubleSide,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            uniforms: {
                uTime: { value: 0 },
            },
            vertexShader: `
        varying vec2 vUv;
        varying vec3 vPos;
        void main() {
          vUv = uv;
          vPos = position;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
            fragmentShader: `
        uniform float uTime;
        varying vec2 vUv;
        varying vec3 vPos;

        void main() {
          // Góc quanh tâm lỗ tam giác để trải dải cầu vồng luân chuyển nhịp nhàng
          float angle = atan(vPos.y + 0.15, vPos.x);
          float normAngle = fract((angle / 6.28318) + 0.65 + sin(uTime * 2.416) * 0.08);

          // Gradient quang phổ: Cyan (#00f0ff) -> Vàng (#ffea00) -> Cam (#ff5500) -> Đỏ Hồng (#ff00aa)
          vec3 colCyan = vec3(0.0, 0.94, 1.0);
          vec3 colYellow = vec3(1.0, 0.92, 0.0);
          vec3 colOrange = vec3(1.0, 0.33, 0.0);
          vec3 colRed = vec3(1.0, 0.0, 0.55);

          vec3 col = mix(colCyan, colYellow, smoothstep(0.0, 0.33, normAngle));
          col = mix(col, colOrange, smoothstep(0.33, 0.66, normAngle));
          col = mix(col, colRed, smoothstep(0.66, 1.0, normAngle));

          gl_FragColor = vec4(col, 0.85);
        }
      `,
        });

        const innerPrismBevelGeo = createInnerPrismBevelGeometry();
        const innerPrismBevelMesh = new THREE.Mesh(
            innerPrismBevelGeo,
            innerPrismBevelMat,
        );
        innerPrismBevelMesh.position.set(0, -0.21, 0);

        const prismGroup = new THREE.Group();
        // Vị trí xuất phát ban đầu: Hyperspace dive từ gần camera Z = 2.8, scale siêu nhỏ 0.06
        prismGroup.position.set(0, 0.45, 2.8);
        prismGroup.scale.set(0.06, 0.06, 0.06);
        prismGroup.rotation.set(-0.25, 0.0, 0.45);
        scene.add(prismGroup);

        const { normalTex, colorTex } = createAlcheIceMaps(9.0);

        const mainLogoMaterial = new THREE.MeshPhysicalMaterial({
            map: colorTex, // Áp dụng sắc Tím Indigo + mảng băng tối hữu cơ
            color: new THREE.Color("#ffffff"), // Giữ hệ số nhân màu trắng để truyền sáng tối đa
            emissive: new THREE.Color("#2e1a8a"), // Nền phát sáng Tím Indigo sâu để thân chữ A không bao giờ bị đen xỉn
            emissiveMap: colorTex,
            emissiveIntensity: 0.48,
            transmission: 1.0, // Truyền sáng 100% để chữ trắng phía sau xuyên rực rỡ qua thân chữ A
            opacity: 1.0,
            transparent: true,
            metalness: 0.0, // BẮT BUỘC = 0.0 (Không làm đục kính)
            roughness: 0.02, // Bắt đầu siêu trong suốt lấp lánh như kim cương
            ior: 1.46, // Bẻ cong nét chữ trắng phía sau thành vòng cung quanh lỗ tam giác
            thickness: 3.1, // Độ dày quang học lớn để đẩy mạnh khúc xạ
            dispersion: 32.0, // Bùng nổ tán sắc cầu vồng cực đại lúc xuất phát
            attenuationColor: new THREE.Color("#4338ca"), // Nhuộm tia sáng đi qua thành màu Tím Indigo
            attenuationDistance: 1.65,
            specularIntensity: 1.0,
            specularColor: new THREE.Color("#a5b4fc"),
            envMapIntensity: 2.2,
            clearcoat: 0.25, // Giữ thấp để mặt trước có chất nhám băng mờ, không bị bóng nhựa
            clearcoatRoughness: 0.22,
            normalMap: normalTex,
            normalScale: new THREE.Vector2(0.42, 0.42), // Làm viền vòng cung chữ trắng phía sau xé nhòe tự nhiên như băng đúc
        } as any);

        const mainLogoGeo = createSculptedAlcheLetterAGeometry();
        const mainLogoMesh = new THREE.Mesh(mainLogoGeo, mainLogoMaterial);
        mainLogoMesh.position.set(0, 0, 0);
        mainLogoMesh.rotation.set(0.95, -Math.PI * 1.65, -0.65);
        mainLogoMesh.renderOrder = 1;
        mainLogoMesh.add(innerPrismBevelMesh);
        prismGroup.add(mainLogoMesh);
        prismGroup.add(prismCyanLight);
        prismGroup.add(prismAmberLight);

        // Dynamic State Management for Logo Scaling & Spatial Alignment
        const logoAnimState = {
            scale: 1.0,
            targetScale: 1.0,
            posY: 0.0,
            targetPosY: 0.0,
            posZ: 0.0,
            targetPosZ: 0.0,
            drawerMultiplier: 1.0,
        };

        window.addEventListener("spatial-drawer-state", (e: any) => {
            const isOpen = !!e.detail?.open;
            gsap.to(logoAnimState, {
                drawerMultiplier: isOpen ? 1.25 : 1.0,
                duration: 0.65,
                ease: "power2.out",
            });
        });

        // --------------------------------------------------------------------------
        // TWEAKPANE: MAINLOGO MATERIAL (Bottom-Left)
        // --------------------------------------------------------------------------
        const paneContainer = document.getElementById("tweakpane-container");
        const paneParams = {
            roughness: 0.1,
            noiseScale: 9.0,
            color: { r: 255, g: 255, b: 255 },
            domainScale: 1.68,
            domainPosY: 0.18,
            domainPosZ: -0.16,
        };

        let pane: Pane | null = null;
        if (paneContainer) {
            pane = new Pane({
                container: paneContainer,
                title: "MainLogo Material",
                expanded: false,
            });

            pane.addBinding(paneParams, "roughness", {
                min: 0.0,
                max: 0.5,
                step: 0.01,
            }).on("change", (ev) => {
                mainLogoMaterial.roughness = ev.value;
            });

            pane.addBinding(paneParams, "noiseScale", {
                min: 1.0,
                max: 20.0,
                step: 0.1,
            }).on("change", (ev) => {
                const scale = ev.value * 0.045;
                mainLogoMaterial.normalScale.set(scale, scale);
            });

            pane.addBinding(paneParams, "color").on("change", (ev) => {
                mainLogoMaterial.color.setRGB(
                    ev.value.r / 255,
                    ev.value.g / 255,
                    ev.value.b / 255,
                );
            });

            const logoFolder = pane.addFolder({
                title: "Logo Scale & Position",
                expanded: true,
            });

            logoFolder
                .addBinding(paneParams, "domainScale", {
                    label: "A Scale (Domains)",
                    min: 0.8,
                    max: 2.8,
                    step: 0.02,
                })
                .on("change", () => {
                    if (scrollState.progress >= 0.18) {
                        const tVault = Math.min(
                            1,
                            (scrollState.progress - 0.18) / 0.08,
                        );
                        logoAnimState.targetScale = THREE.MathUtils.lerp(
                            1.7,
                            paneParams.domainScale,
                            tVault,
                        );
                    }
                });

            logoFolder
                .addBinding(paneParams, "domainPosY", {
                    label: "A Pos Y (Domains)",
                    min: -0.5,
                    max: 0.8,
                    step: 0.02,
                })
                .on("change", () => {
                    if (scrollState.progress >= 0.18) {
                        const tVault = Math.min(
                            1,
                            (scrollState.progress - 0.18) / 0.08,
                        );
                        logoAnimState.targetPosY = THREE.MathUtils.lerp(
                            0.18,
                            paneParams.domainPosY,
                            tVault,
                        );
                    }
                });

            logoFolder
                .addBinding(paneParams, "domainPosZ", {
                    label: "A Pos Z (Domains)",
                    min: -1.0,
                    max: 0.5,
                    step: 0.02,
                })
                .on("change", () => {
                    if (scrollState.progress >= 0.18) {
                        const tVault = Math.min(
                            1,
                            (scrollState.progress - 0.18) / 0.08,
                        );
                        logoAnimState.targetPosZ = THREE.MathUtils.lerp(
                            -0.15,
                            paneParams.domainPosZ,
                            tVault,
                        );
                    }
                });
        }

        // --------------------------------------------------------------------------
        // D. 6 CURVED SPATIAL DOMAIN CARDS
        // --------------------------------------------------------------------------
        const cardsGroup = new THREE.Group();
        cardsGroup.position.set(0, -12, 1.8);
        scene.add(cardsGroup);

        const cardMeshes: THREE.Mesh[] = [];
        const cardMaterials: THREE.ShaderMaterial[] = [];
        const cardRadius = 6.2;

        const cardVertexShader = `
      uniform float uCurvature;
      varying vec2 vUv;
      varying vec3 vNormal;

      void main() {
        vUv = uv;
        vec3 pos = position;
        pos.z -= pow(pos.x * 0.45, 2.0) * uCurvature;
        vNormal = normalize(normalMatrix * normal);
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

        const cardFragmentShader = `
      uniform sampler2D uTexture;
      uniform vec3 uAccentColor;
      uniform float uOpacity;
      uniform float uHover;
      uniform float uTime;
      uniform float uScrollPos;
      uniform float uScrollSpeed;
      varying vec2 vUv;

      // Hàm khoảng cách hộp bo tròn chuẩn toán học (Aspect Ratio Corrected)
      float sdRoundedBox(vec2 p, vec2 b, float r) {
        vec2 q = abs(p) - b + r;
        return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
      }

      void main() {
        // 1. Chuẩn hóa tỉ lệ chính xác theo kích thước Plane (4.3 / 2.75 = 1.563636)
        // Việc nhân aspect vào x giúp góc bo là một cung tròn hoàn hảo, không bị méo elip dẹt
        float aspect = 1.563636;
        vec2 p = (vUv - 0.5) * vec2(aspect, 1.0);
        vec2 b = vec2(aspect * 0.5, 0.5); // Nửa kích thước hộp theo tọa độ chuẩn
        float radius = 0.092;              // Bán kính bo góc chuẩn Apple Squircle

        // 2. Tính khoảng cách SDF
        float dist = sdRoundedBox(p, b, radius);

        // 3. Khử răng cưa sub-pixel phần cứng bằng hàm vi sai vi phân fwidth()
        float aa = fwidth(dist);
        float cardMask = 1.0 - smoothstep(-aa, aa, dist);

        // Discard pixel bên ngoài vùng bo tròn để tránh rò rỉ độ mờ và tối ưu GPU
        if (cardMask <= 0.0005) {
          discard;
        }

        // Lấy màu sắc từ texture gốc
        vec4 texColor = texture2D(uTexture, vUv);

        // 4. Đường viền phát sáng vi mô (Border Rim) có độ dày đồng nhất 100% tại mọi cung cua
        float borderWidth = 0.0075;
        float borderDist = abs(dist + borderWidth * 0.5) - borderWidth * 0.5;
        float borderMask = 1.0 - smoothstep(-aa, aa, borderDist);

        // 5. Hiệu ứng viền bóng kính phản chiếu & dynamic scroll sheen
        vec2 normP = normalize(p + vec2(0.0001));
        float cornerSpecular = max(0.0, dot(-normP, normalize(vec2(-1.0, 1.2)))) * 0.65;

        // Vệt lướt sáng óng ánh dọc viền khi cuộn trang
        float angle = atan(p.y, p.x);
        float scrollSweepPhase = angle * 1.5 + uScrollPos * 16.0 + uTime * 0.75;
        float scrollGlint = pow(max(0.0, sin(scrollSweepPhase)), 12.0) * (0.50 + uScrollSpeed * 1.6);

        // Kết hợp màu viền neon tinh khiết (Crystal Silver & Accent)
        vec3 silverCrystal = vec3(0.96, 0.98, 1.0);
        vec3 rimColor = mix(silverCrystal, uAccentColor, 0.35);
        vec3 borderEffect = (cornerSpecular * silverCrystal) + (scrollGlint * rimColor * 1.4);
        vec3 finalBorderColor = mix(rimColor, silverCrystal, cornerSpecular) + borderEffect;

        // Blend đường viền vào màu thẻ
        vec3 finalColor = mix(texColor.rgb, finalBorderColor, borderMask * 0.88);

        // Interactive hover brightening
        finalColor += uHover * 0.08;

        gl_FragColor = vec4(finalColor, cardMask * texColor.a * uOpacity);
      }
    `;

        ADOLSOFT_DOMAINS.forEach((domain, idx) => {
            const tex = createCurvedCardTexture(domain, idx);
            const mat = new THREE.ShaderMaterial({
                transparent: true,
                side: THREE.FrontSide, // Enable GPU hardware backface culling
                uniforms: {
                    uTexture: { value: tex },
                    uAccentColor: { value: new THREE.Color(domain.accent) },
                    uCurvature: { value: 0.38 },
                    uOpacity: { value: 0.98 },
                    uHover: { value: 0.0 },
                    uTime: { value: 0.0 },
                    uScrollPos: { value: 0.0 },
                    uScrollSpeed: { value: 0.0 },
                },
                vertexShader: cardVertexShader,
                fragmentShader: cardFragmentShader,
            });

            // 32 segments along X for smooth curvature, 2 segments along Y (curve is strictly horizontal)
            // Reduces vertex processing load by 96% with identical visual appearance!
            const geo = new THREE.PlaneGeometry(4.3, 2.75, 32, 2);
            const mesh = new THREE.Mesh(geo, mat);

            const angle = (idx / ADOLSOFT_DOMAINS.length) * Math.PI * 2;
            mesh.position.set(
                Math.sin(angle) * cardRadius,
                0,
                Math.cos(angle) * cardRadius - cardRadius + 1.2,
            );
            mesh.rotation.y = angle;
            mesh.userData = { domainIndex: idx, baseAngle: angle };

            cardsGroup.add(mesh);
            cardMeshes.push(mesh);
            cardMaterials.push(mat);
        });

        // Hide cardsGroup initially during hero state to save 12 draw calls
        cardsGroup.visible = false;

        // ============================================================================
        // 5. SCI-FI HUD AUDIO FEEDBACK & ACTIVE DOMAIN DATA CONTROLLER
        // ============================================================================
        let currentDomainIndex = 0;
        let audioCtx: AudioContext | null = null;

        function playSciFiTick() {
            try {
                if (!audioCtx) {
                    const AudioContextClass =
                        window.AudioContext ||
                        (window as any).webkitAudioContext;
                    if (AudioContextClass) audioCtx = new AudioContextClass();
                }
                if (audioCtx && audioCtx.state === "running") {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(1200, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(
                        700,
                        audioCtx.currentTime + 0.032,
                    );
                    gain.gain.setValueAtTime(0.035, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(
                        0.0001,
                        audioCtx.currentTime + 0.032,
                    );
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.032);
                }
            } catch (_) {}
        }

        window.addEventListener(
            "pointerdown",
            () => {
                if (audioCtx && audioCtx.state === "suspended") {
                    audioCtx.resume();
                }
            },
            { once: true },
        );

        const headerOverlayHud = document.getElementById("header-overlay-hud");
        const headerHudCategory = document.getElementById(
            "header-hud-category",
        );
        const headerHudTitle = document.getElementById("header-hud-title");
        const headerHudDesc = document.getElementById("header-hud-desc");

        const leftClusterHud = document.getElementById("left-cluster-hud");
        const rightClusterHud = document.getElementById("right-cluster-hud");
        const bottomClusterHud = document.getElementById("bottom-cluster-hud");

        const navDomainCounter = document.getElementById("nav-domain-counter");
        const sideTelemetryLabel = document.getElementById(
            "side-telemetry-label",
        );

        const cachedTargetActiveColor = new THREE.Color(
            ADOLSOFT_DOMAINS[0]?.accent || "#c8ff00",
        );

        function renderDomainSatellites(index: number) {
            const legacyData =
                DOMAIN_SATELLITE_DATA[index] || DOMAIN_SATELLITE_DATA[0];
            const domain = ADOLSOFT_DOMAINS[index];
            const structuredType = (itemIndex: number) =>
                (["red", "blue", "green"] as const)[itemIndex % 3];
            const moduleType: Record<
                DomainModule["type"],
                SatelliteItem["type"]
            > = {
                primary: "white",
                danger: "red",
                warning: "blue",
                success: "green",
                info: "blue",
            };
            const moduleFolderClass: Record<DomainModule["type"], string> = {
                primary: "folder-accent-white",
                danger: "folder-accent-red",
                warning: "folder-accent-warning",
                success: "folder-accent-green",
                info: "folder-accent-blue",
            };
            const d: DomainSatelliteGroup =
                domain?.hudLeft && domain.hudRight && domain.modules
                    ? {
                          title: domain.title,
                          summary: domain.summary,
                          left: domain.hudLeft.map((item, itemIndex) => ({
                              type: structuredType(itemIndex),
                              badge: `0${itemIndex + 1}`,
                              tag: item.label,
                              title: item.value,
                              desc: item.sub,
                              icon: item.icon,
                          })),
                          right: domain.hudRight.map((item, itemIndex) => ({
                              type: structuredType(itemIndex),
                              badge: `0${itemIndex + 1}`,
                              tag: item.label,
                              title: item.value,
                              desc: item.sub,
                              icon: item.icon,
                          })),
                          bottom: domain.modules.map((item) => ({
                              type: moduleType[item.type],
                              moduleType: item.type,
                              badge: item.type.toUpperCase(),
                              tag: item.type.toUpperCase(),
                              title: item.name,
                              desc: item.name,
                              isCta: item.type === "primary",
                          })),
                      }
                    : legacyData;
            const normalizeHudSlots = (items: SatelliteItem[]) =>
                Array.from(
                    { length: 5 },
                    (_, itemIndex) =>
                        items[itemIndex] ?? {
                            type: structuredType(itemIndex),
                            badge: "",
                            tag: "",
                            title: "",
                            desc: "",
                        },
                );
            const leftItems = normalizeHudSlots(d.left);
            const rightItems = normalizeHudSlots(d.right);

            // Cập nhật Tiêu đề & Mô tả trung tâm của thẻ
            if (headerHudTitle) headerHudTitle.textContent = d.title;
            if (headerHudDesc) headerHudDesc.textContent = d.summary;

            // Render Vệ tinh cụm Trái (Pill Stack y chang thiết kế mẫu)
            if (leftClusterHud) {
                leftClusterHud.innerHTML = leftItems
                    .map((item, index) =>
                        item.title
                            ? `
          <div
            class="sat-pill sat-pill-${item.type} hud-interactive-tag flex flex-col justify-center px-6 py-2"
