                <span class="w-1.5 h-1.5 rounded-full ${item.type === "red" ? "bg-[#ef233c]" : item.type === "blue" ? "bg-[#3b82f6]" : "bg-[#22c55e]"} animate-pulse"></span>
                ${item.tag}
              </span>
              <span class="text-white/40 font-mono text-[8.5px]">${item.badge}</span>
            </div>
            <div class="font-['Syne'] font-extrabold text-[13.5px] text-white tracking-wide truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-tight">
              ${item.title}
            </div>
            <div class="font-mono text-[9px] text-white/60 tracking-tight truncate mt-0.5">
              ${item.desc}
            </div>
          </div>
        `
                            : `
                    <div aria-hidden="true" class="sat-pill sat-pill-${item.type} slot-empty border-dashed opacity-30 pointer-events-none"></div>
                `,
                    )
                    .join("");
            }

            // Render Vệ tinh cụm Phải (Pill Stack y chang thiết kế mẫu)
            if (rightClusterHud) {
                rightClusterHud.innerHTML = rightItems
                    .map((item, index) => {
                        if (!item.title) {
                            return `<div aria-hidden="true" class="sat-pill sat-pill-${item.type} slot-empty border-dashed opacity-30 pointer-events-none"></div>`;
                        }
                        if (item.link) {
                            return `
              <a
                href="${item.link}"
                target="_blank"
                rel="noopener noreferrer"
                class="sat-pill sat-pill-${item.type} hud-interactive-tag flex flex-col justify-center px-6 py-2 block text-right"
                                data-icon="${item.icon || ""}"
                style="z-index: ${index + 1};"
                title="${item.desc}"
              >
                <div class="flex items-center justify-between font-mono text-[9px] tracking-wider uppercase mb-0.5" style="color: ${item.type === "red" ? "#ef233c" : item.type === "green" ? "#22c55e" : "#3b82f6"}">
                  <span class="text-white/40 font-mono text-[8.5px]">${item.badge}</span>
                  <span class="flex items-center gap-1.5 font-bold">
                    ${item.tag}
                    <span class="w-1.5 h-1.5 rounded-full ${item.type === "red" ? "bg-[#ef233c]" : item.type === "green" ? "bg-[#22c55e]" : "bg-[#3b82f6]"}"></span>
                  </span>
                </div>
                <div class="font-['Syne'] font-extrabold text-[13.5px] text-white tracking-wide truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-tight group-hover:text-[#c8ff00] transition-colors">
                  ${item.title}
                </div>
                <div class="font-mono text-[9px] text-white/60 tracking-tight truncate mt-0.5">
                  ${item.desc}
                </div>
              </a>
            `;
                        }
                        return `
            <div
              class="sat-pill sat-pill-${item.type} hud-interactive-tag flex flex-col justify-center px-6 py-2 text-right"
                          data-icon="${item.icon || ""}"
              style="z-index: ${index + 1};"
              data-hud-action="blueprint"
              title="${item.desc}"
            >
              <div class="flex items-center justify-between font-mono text-[9px] tracking-wider uppercase mb-0.5" style="color: ${item.type === "red" ? "#ef233c" : item.type === "green" ? "#22c55e" : "#3b82f6"}">
                <span class="text-white/40 font-mono text-[8.5px]">${item.badge}</span>
                <span class="flex items-center gap-1.5 font-bold">
                  ${item.tag}
                  <span class="w-1.5 h-1.5 rounded-full ${item.type === "red" ? "bg-[#ef233c]" : item.type === "green" ? "bg-[#22c55e]" : "bg-[#3b82f6]"} ${item.type === "green" ? "animate-pulse" : ""}"></span>
                </span>
              </div>
              <div class="font-['Syne'] font-extrabold text-[13.5px] ${item.type === "green" ? "text-[#22c55e]" : "text-white"} tracking-wide truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-tight">
                ${item.title}
              </div>
              <div class="font-mono text-[9px] text-white/60 tracking-tight truncate mt-0.5">
                ${item.desc}
              </div>
            </div>
          `;
                    })
                    .join("");
            }

            // Render 6 Vệ tinh cụm Chân đáy dạng THƯ MỤC KÍNH MỜ 3D CHỨA TÀI LIỆU
            if (bottomClusterHud) {
                const materialTag = `
          <div class="hidden 2xl:flex items-center gap-2.5 px-3.5 h-12 sm:h-13 md:h-14 lg:h-15 rounded-xl bg-[#1c1f26]/85 border border-white/10 font-mono text-[11px] text-white/60 shadow-[0_8px_20px_rgba(0,0,0,0.6)] backdrop-blur-md self-end mb-0.5 select-none shrink-0 pointer-events-none">
            <span class="tracking-wider">MainLogo Material</span>
            <span class="text-white/40 font-bold">=</span>
          </div>
        `;

                const cardsHtml = d.bottom
                    .map((item) => {
                        if (item.isCta) {
                            return `
              <button
                type="button"
                class="folder-3d-card folder-accent-white hud-interactive-tag w-22 sm:w-26 md:w-30 lg:w-34 xl:w-36 h-12 sm:h-13 md:h-14 lg:h-15 relative"
                data-hud-action="blueprint"
                title="Khám phá chi tiết Blueprint"
              >
                <!-- Trang tài liệu sau xòe nhẹ -->
                <div class="folder-doc-paper-back"></div>
                <!-- Trang tài liệu trước nhô lên miệng túi -->
                <div class="folder-doc-paper">
                  <div class="folder-doc-lines">
                    <div class="folder-doc-line"></div>
                    <div class="folder-doc-line"></div>
                    <div class="folder-doc-line"></div>
                  </div>
                </div>
                <!-- Tab tai thỏ hồ sơ -->
                <div class="folder-tab-badge"></div>
                <!-- Thân túi kính 3D màu trắng phong cách Blueprint với lỗ định vị kỹ thuật -->
                <div class="folder-pocket-body !flex-row items-center justify-center gap-2 !px-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-black/90 shrink-0"></span>
                  <div class="flex flex-col items-center leading-none">
                    <span class="font-['Syne'] font-extrabold text-[11px] sm:text-[12px] text-black tracking-wider uppercase">BLUEPRINT</span>
                    <span class="font-mono text-[9px] text-black/80 font-bold mt-0.5">↗</span>
                  </div>
                </div>
              </button>
            `;
                        }
                        const colorClass = item.moduleType
                            ? moduleFolderClass[item.moduleType]
                            : item.type === "red"
                              ? "folder-accent-red"
                              : item.type === "blue"
                                ? "folder-accent-blue"
                                : "folder-accent-green";
                        const tagColor =
                            item.moduleType === "danger"
                                ? "#ef233c"
                                : item.moduleType === "warning"
                                  ? "#f59e0b"
                                  : item.moduleType === "success"
                                    ? "#22c55e"
                                    : item.moduleType === "info"
                                      ? "#3b82f6"
                                      : item.type === "red"
                                        ? "#ef233c"
                                        : item.type === "blue"
                                          ? "#0070f3"
                                          : "#22c55e";

                        return `
            <button
              type="button"
              class="folder-3d-card ${colorClass} hud-interactive-tag w-20 sm:w-24 md:w-28 lg:w-32 xl:w-36 h-12 sm:h-13 md:h-14 lg:h-15 relative"
              data-hud-action="blueprint"
              title="${item.desc || item.title}"
            >
              <!-- Trang tài liệu sau xòe nhẹ -->
              <div class="folder-doc-paper-back"></div>
              <!-- Trang tài liệu trước nhô lên miệng túi có dòng kẻ kỹ thuật -->
              <div class="folder-doc-paper">
                <div class="folder-doc-lines">
                  <div class="folder-doc-line"></div>
                  <div class="folder-doc-line"></div>
                  <div class="folder-doc-line"></div>
                </div>
              </div>
              <!-- Tab tai thỏ hồ sơ -->
              <div class="folder-tab-badge"></div>
              <!-- Thân túi kính mờ 3D -->
              <div class="folder-pocket-body">
                <span class="font-mono text-[7.5px] sm:text-[8px] tracking-widest uppercase font-bold truncate max-w-full" style="color: ${tagColor}">${item.tag}</span>
                <span class="font-['Syne'] font-extrabold text-[10px] sm:text-[11px] ${item.moduleType === "success" || (!item.moduleType && item.type === "green") ? "text-[#22c55e]" : "text-white"} tracking-wide truncate max-w-full mt-0.5 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">${item.title}</span>
              </div>
            </button>
          `;
                    })
                    .join("");

                bottomClusterHud.innerHTML = materialTag + cardsHtml;
            }
        }

        let isSatellitesVisible = false;
        let neighborCardsFadeFactor = 1.0; // 1.0: hiển thị bình thường khi lướt, 0.0: ẩn mờ thẻ 2 bên khi thẻ vào giữa

        function showSatellitesForDomain(newIndex: number) {
            if (scrollState.progress < 0.16) return;
            isSatellitesVisible = true;

            const normalized =
                ((newIndex % ADOLSOFT_DOMAINS.length) +
                    ADOLSOFT_DOMAINS.length) %
                ADOLSOFT_DOMAINS.length;
            currentDomainIndex = normalized;
            if (headerHudTitle) headerHudTitle.dataset.initialized = "true";

            const d = ADOLSOFT_DOMAINS[currentDomainIndex];
            if (navDomainCounter)
                navDomainCounter.textContent = `${d.index} / 06`;
            if (sideTelemetryLabel) sideTelemetryLabel.textContent = d.index;

            if (d.accent) {
                cachedTargetActiveColor.set(d.accent);
            }

            playSciFiTick();

            // Nạp dữ liệu vệ tinh độc lập riêng biệt của thẻ
            renderDomainSatellites(currentDomainIndex);

            headerOverlayHud?.classList.remove("hidden");
            leftClusterHud?.classList.remove("hidden");
            rightClusterHud?.classList.remove("hidden");
            bottomClusterHud?.classList.remove("hidden");

            // Thẻ đã cố định chính giữa -> Hiển thị các vệ tinh rõ nét và sắc nét
            gsap.fromTo(
                [
                    headerOverlayHud,
                    leftClusterHud,
                    rightClusterHud,
                    bottomClusterHud,
                ],
                { opacity: 0, scale: 0.94, y: 10, x: 0 },
                {
                    opacity: 1,
                    scale: 1,
                    y: 0,
                    x: 0,
                    duration: 0.38,
                    ease: "power3.out",
                    stagger: 0.03,
                    overwrite: "auto",
                },
            );
        }

        function hideSatellites(immediate = false) {
            isSatellitesVisible = false;
            if (immediate) {
                gsap.set(
                    [
                        headerOverlayHud,
                        leftClusterHud,
                        rightClusterHud,
                        bottomClusterHud,
                    ],
                    {
                        opacity: 0,
                        overwrite: "auto",
                    },
                );
            } else {
                gsap.to(
                    [
                        headerOverlayHud,
                        leftClusterHud,
                        rightClusterHud,
                        bottomClusterHud,
                    ],
                    {
                        opacity: 0,
                        duration: 0.16,
                        ease: "power2.in",
                        overwrite: "auto",
                    },
                );
            }
        }

        const updateActiveDomainHUD = showSatellitesForDomain;

        // Micro-interactions Event Listeners:
        document.addEventListener("click", (e) => {
            const target = (e.target as HTMLElement)?.closest(
                '[data-hud-action="blueprint"], #bottom-hud-primary-cta',
            );
            if (target) {
                window.dispatchEvent(
                    new CustomEvent("open-domain-modal", {
                        detail: { index: currentDomainIndex },
                    }),
                );
            }
        });

        document.addEventListener("pointerover", (e) => {
            const target = (e.target as HTMLElement)?.closest(
                ".hud-interactive-tag",
            );
            if (target) {
                playSciFiTick();
            }
        });

        // ============================================================================
        // 5. EPIC HERO ENTRANCE: SÓNG NƯỚC NỔ BÙM, HYPERSPACE DIVE & ADOLSOFT ERUPTION
        // ============================================================================
        let heroEntrancePlayed = false;
        let isEntranceAnimating = true;
        const harmonicBlend = { value: 0.0 };

        function playHeroEntrance() {
            if (heroEntrancePlayed) return;
            heroEntrancePlayed = true;
            isEntranceAnimating = true;
            harmonicBlend.value = 0.0;

            // 0. Thiết lập lại các thông số xuất phát cực kỳ chuẩn xác trước khi nổ bùm timeline
            prismGroup.position.set(0, 0.45, 2.8);
            prismGroup.scale.set(0.06, 0.06, 0.06);
            prismGroup.rotation.set(-0.25, 0.0, 0.45);
            mainLogoMesh.rotation.set(0.95, -Math.PI * 1.65, -0.65);
            mainLogoMaterial.dispersion = 32.0;
            mainLogoMaterial.roughness = 0.02;

            backTextMesh.position.set(0, -2.5, -1.25);
            backTextMesh.scale.set(0.08, 0.08, 1.0);
            backTextMesh.rotation.set(1.5, 0.0, -0.2);
            backTextMat.opacity = 0.0;
            backTextMat.color.set("#c8ff00");

            const tl = gsap.timeline({
                onComplete: () => {
                    isEntranceAnimating = false;
                    logoAnimState.scale = prismGroup.scale.x;
                    logoAnimState.posY = prismGroup.position.y;
                    logoAnimState.posZ = prismGroup.position.z;
                },
            });

            // 1. Kích nổ Sóng nước WebGL tỏa ra từ tâm
            shockwaveMat.uniforms.uIntensity.value = 1.6;
            shockwaveMat.uniforms.uRadius.value = 0.0;
            tl.to(
                shockwaveMat.uniforms.uRadius,
                {
                    value: 3.2,
                    duration: 2.1,
                    ease: "expo.out",
                },
                0.05,
            );
            tl.to(
                shockwaveMat.uniforms.uIntensity,
                {
                    value: 0.0,
                    duration: 1.7,
                    delay: 0.35,
                    ease: "power2.inOut",
                },
                0.05,
            );

            // 2. Kích nổ Vòng tròn Sóng ánh sáng DOM (Liquid Blast Glow & Rings)
            const blastGlow = document.querySelector(".liquid-blast-glow");
            const blastRings = document.querySelectorAll(".liquid-blast-ring");
            if (blastGlow) {
                tl.fromTo(
                    blastGlow,
                    { scale: 0.06, opacity: 1.0 },
                    { scale: 3.2, opacity: 0, duration: 1.7, ease: "expo.out" },
                    0.02,
                );
            }
            if (blastRings.length) {
                tl.fromTo(
                    blastRings,
                    { scale: 0.04, opacity: 1.0 },
                    {
                        scale: 3.6,
                        opacity: 0,
                        stagger: 0.1,
                        duration: 1.85,
                        ease: "expo.out",
                    },
                    0.05,
                );
            }

            // 3. Khối LOGO chữ A 3D trung tâm lao tới từ Hyperspace Z = 2.8 -> 0.0 với nảy đàn hồi siêu ngầu
            tl.to(
                prismGroup.position,
                {
                    x: 0.0,
                    y: 0.0,
                    z: 0.0,
                    duration: 1.95,
                    ease: "elastic.out(1.15, 0.52)",
                },
                0.06,
            );
            tl.to(
                prismGroup.scale,
                {
                    x: 1.0,
                    y: 1.0,
                    z: 1.0,
                    duration: 1.95,
                    ease: "elastic.out(1.15, 0.52)",
                },
                0.06,
            );
            tl.to(
                prismGroup.rotation,
                {
                    x: 0.0,
                    y: 0.0,
                    z: 0.0,
                    duration: 1.6,
                    ease: "expo.out",
                },
                0.06,
            );
            tl.to(
                mainLogoMesh.rotation,
                {
                    x: 0.0,
                    y: 0.0,
                    z: 0.0,
                    duration: 1.7,
                    ease: "expo.out",
                },
                0.06,
            );

            // Hiệu ứng bùng nổ tán sắc cầu vồng và lắng đọng chất liệu băng pha lê
            tl.to(
                mainLogoMaterial,
                {
                    dispersion: 10.0,
                    roughness: 0.1,
                    duration: 1.85,
                    ease: "power2.out",
                },
                0.06,
            );

            // Kích hoạt xung lực xoay vật lý tactile impulse khi chữ A hạ cánh
            tl.call(
                () => {
                    rotationImpulse = 0.85;
                },
                undefined,
                0.45,
            );

            // 4. Dòng chữ ADOLSOFT phóng vút từ dưới lòng sâu lên và bung nở nảy đàn hồi sau chữ A
            // Giai đoạn 1: Phóng vọt lên với tốc độ cực nhanh (Sonic Boom Eruption)
            tl.to(
                backTextMesh.position,
                {
                    y: 0.16,
                    duration: 0.65,
                    ease: "power4.out",
                },
                0.1,
            );
            tl.to(
                backTextMesh.scale,
                {
                    x: 1.28,
                    y: 1.28,
                    duration: 0.65,
                    ease: "power4.out",
                },
                0.1,
            );
            tl.to(
                backTextMesh.rotation,
                {
                    x: -0.2,
                    z: 0.0,
                    duration: 0.65,
                    ease: "power4.out",
                },
                0.1,
            );
            tl.to(
                backTextMat,
                {
                    opacity: 1.0,
                    duration: 0.35,
                    ease: "power2.out",
                },
                0.1,
            );

            // Giai đoạn 2: Bật nảy đàn hồi (Elastic Snap) về vị trí chuẩn xác không bị méo lệch
            tl.to(
                backTextMesh.position,
                {
                    y: -0.05,
                    duration: 1.25,
                    ease: "elastic.out(1.15, 0.46)",
                },
                0.75,
            );
            tl.to(
                backTextMesh.scale,
                {
                    x: 1.0,
                    y: 1.0,
                    duration: 1.25,
                    ease: "elastic.out(1.15, 0.46)",
                },
                0.75,
            );
            tl.to(
                backTextMesh.rotation,
                {
                    x: 0.0,
                    duration: 1.25,
                    ease: "elastic.out(1.15, 0.46)",
                },
                0.75,
            );

            // Giai đoạn 3: Chuyển màu từ ánh sáng Neon Khởi Động (#c8ff00) sang Trắng Tinh Khiết (#ffffff)
            tl.to(
                backTextMat.color,
                {
                    r: 1.0,
                    g: 1.0,
                    b: 1.0,
                    duration: 1.05,
                    ease: "power2.out",
                },
                0.4,
            );

            // Giai đoạn 4: Hòa trộn mượt mà vào vòng lặp dao động Idle Harmonic Motion
            tl.to(
                harmonicBlend,
                {
                    value: 1.0,
                    duration: 1.0,
                    ease: "power2.inOut",
                },
                1.6,
            );

            // 5. Top Telemetry Tag smooth emergence
            const badge = document.getElementById("hero-brand-badge");
            if (badge) {
                tl.to(
                    badge,
                    { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" },
                    0.55,
                );
            }
        }

        // Expose global replay function for live demos and interactive badge clicking
        (window as any).replayHeroEntrance = () => {
            heroEntrancePlayed = false;
            playHeroEntrance();
        };

        const badgeEl = document.getElementById("hero-brand-badge");
        if (badgeEl) {
            badgeEl.addEventListener("click", () => {
                (window as any).replayHeroEntrance();
            });
        }

        // Lắng nghe sự kiện stage-unlocked khi preloader hoàn tất
        window.addEventListener("stage-unlocked", () => {
            playHeroEntrance();
        });
        // Fallback an toàn nếu trang tải lại hoặc không có preloader
        setTimeout(() => {
            if (!heroEntrancePlayed) playHeroEntrance();
        }, 4500);

        // ============================================================================
        // 6. MASTER LENIS + GSAP SCROLLTRIGGER TIMELINE
        // ============================================================================
        const lenis = new Lenis({
            lerp: 0.065,
            smoothWheel: true,
        });

        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        const scrollState = {
            progress: 0,
            carouselAngle: 0,
            targetCarouselAngle: 0,
            scrollVelocity: 0,
        };

        const ghostLayer = document.getElementById("optical-ghost-layer");
        const ghostWord = document.getElementById("ghost-brand-word");
        const navScrollBar = document.getElementById("nav-scroll-bar");
        const navScrollPct = document.getElementById("nav-scroll-pct");
        let lastScrollPct = -1;
        let lastVaultPhase = false;

        ScrollTrigger.create({
            trigger: "#scroll-story-track",
            start: "top top",
            end: "bottom bottom",
            scrub: 0.35,
            onUpdate: (self) => {
                const p = self.progress;
                scrollState.progress = p;

                const pct = Math.round(p * 100);
                if (pct !== lastScrollPct) {
                    lastScrollPct = pct;
                    if (navScrollBar) navScrollBar.style.width = `${pct}%`;
                    if (navScrollPct)
                        navScrollPct.textContent = `${String(pct).padStart(2, "0")}%`;
                }

                // PHASE 1 (0.0 -> 0.18): HERO PRISM -> "WORKS" ARCHITECTURAL STAGE
                domeMat.uniforms.uScrollProgress.value = p;

                if (ghostLayer && ghostWord) {
                    const ghostOpacity =
                        p < 0.05
                            ? 0
                            : p < 0.25
                              ? THREE.MathUtils.lerp(
                                    0.0,
                                    0.14,
                                    (p - 0.05) / 0.2,
                                )
                              : 0.09;
                    ghostLayer.style.opacity = String(ghostOpacity);
                    const gScale = THREE.MathUtils.lerp(
                        1.0,
                        0.68,
                        Math.min(1, p * 2.2),
                    );
                    ghostWord.style.transform = `scale(${gScale})`;
                }

                // 3D Prism Logo Positioning & Peeking:
                if (p < 0.18) {
                    const tA = Math.min(1, Math.max(0, (p - 0.02) / 0.1));
                    logoAnimState.targetScale = THREE.MathUtils.lerp(
                        1.0,
                        1.7,
                        tA,
                    );
                    logoAnimState.targetPosY = THREE.MathUtils.lerp(
                        0.0,
                        0.18,
                        tA,
                    );
                    logoAnimState.targetPosZ = THREE.MathUtils.lerp(
                        0.0,
                        -0.15,
                        tA,
                    );
                } else {
                    const tVault = Math.min(1, (p - 0.18) / 0.08);
                    logoAnimState.targetPosZ = THREE.MathUtils.lerp(
                        -0.15,
                        paneParams.domainPosZ,
                        tVault,
                    );
                    logoAnimState.targetPosY = THREE.MathUtils.lerp(
                        0.18,
                        paneParams.domainPosY,
                        tVault,
                    );
                    logoAnimState.targetScale = THREE.MathUtils.lerp(
                        1.7,
                        paneParams.domainScale,
                        tVault,
                    );
                }

                // Hardware Frustum & Distance Culling:
                // Hide all 6 curved domain card meshes & reflections when in hero state (p <= 0.03)
                cardsGroup.visible = p > 0.03;

                const inVaultPhase = p >= 0.18;
                if (inVaultPhase !== lastVaultPhase) {
                    lastVaultPhase = inVaultPhase;
                    if (inVaultPhase) {
                        renderDomainSatellites(currentDomainIndex);
                        headerOverlayHud?.classList.remove("hidden");
                        leftClusterHud?.classList.remove("hidden");
                        rightClusterHud?.classList.remove("hidden");
                        bottomClusterHud?.classList.remove("hidden");
                        gsap.to(
                            [
                                headerOverlayHud,
                                leftClusterHud,
                                rightClusterHud,
                                bottomClusterHud,
                            ],
                            {
                                opacity: 1,
                                x: 0,
                                y: 0,
                                duration: 0.45,
                                ease: "cubic-bezier(0.16, 1, 0.3, 1)",
                                stagger: 0.04,
                            },
                        );
                    } else {
                        gsap.to(
                            [
                                headerOverlayHud,
                                leftClusterHud,
                                rightClusterHud,
                                bottomClusterHud,
                            ],
                            {
                                opacity: 0,
                                duration: 0.25,
                                ease: "power2.in",
                                onComplete: () => {
                                    headerOverlayHud?.classList.add("hidden");
                                    leftClusterHud?.classList.add("hidden");
                                    rightClusterHud?.classList.add("hidden");
                                    bottomClusterHud?.classList.add("hidden");
                                },
                            },
                        );
                        if (sideTelemetryLabel)
                            sideTelemetryLabel.textContent = "TOP";
                        if (navDomainCounter)
                            navDomainCounter.textContent = "00 / 06";
                    }
                }

                // PHASE 2: 6 CURVED DOMAIN CARDS ORBIT
                if (!inVaultPhase) {
                    cardsGroup.position.y = THREE.MathUtils.lerp(
                        -11.0,
                        -0.42,
                        p / 0.18,
                    );
                } else {
                    cardsGroup.position.y = -0.42;
                    const worksProgress = THREE.MathUtils.clamp(
                        (p - 0.18) / 0.76,
                        0,
                        1,
                    );
                    scrollState.targetCarouselAngle =
                        -worksProgress *
                        Math.PI *
                        2 *
                        ((ADOLSOFT_DOMAINS.length - 1) /
                            ADOLSOFT_DOMAINS.length);

                    const activeIdx = Math.round(
                        worksProgress * (ADOLSOFT_DOMAINS.length - 1),
                    );
                    const d = ADOLSOFT_DOMAINS[activeIdx];
                    if (navDomainCounter)
                        navDomainCounter.textContent = `${d.index} / 06`;
                    if (sideTelemetryLabel)
                        sideTelemetryLabel.textContent = d.index;
                    if (d.accent) cachedTargetActiveColor.set(d.accent);
                }
            },
        });

        // ============================================================================
        // 6. CYLINDRICAL SNAPPING & MAGNETIC SCROLL INTERPOLATION (Immediate Dynamic Snap)
        // ============================================================================
        let snapTimeout: ReturnType<typeof setTimeout> | null = null;
        let isSnapping = false;

        // Danh sách tọa độ chính xác của 6 thẻ:
        // Thẻ 0: 0.1800 | Thẻ 1: 0.3320 | Thẻ 2: 0.4840 | Thẻ 3: 0.6360 | Thẻ 4: 0.7880 | Thẻ 5: 0.9400
        const cardProgressPoints = [0.18, 0.332, 0.484, 0.636, 0.788, 0.94];

        function snapToNearestCard(predictive = false) {
            const p = scrollState.progress;
            const v = scrollState.scrollVelocity;

            // 1. Nếu đang ở vùng Hero đỉnh trang (p < 0.12) và không có ý định cuộn xuống -> để tự do
            if (p < 0.12 && v <= 0.04) return;
            // 2. Nếu đang ở Thẻ 1 và người dùng cuộn ngược dứt khoát lên trên -> nhường quyền về đỉnh trang
            if (p <= 0.16 && v < -0.15) return;

            // 3. Tự động nhận diện thẻ mục tiêu đồng bộ:
            // Tìm thẻ hiện tại gần vị trí cuộn nhất
            let currentIdx = 0;
            let minDiff = 999;
            cardProgressPoints.forEach((cardP, idx) => {
                const diff = Math.abs(p - cardP);
                if (diff < minDiff) {
                    minDiff = diff;
                    currentIdx = idx;
                }
            });

            let targetIdx = currentIdx;

            // Nhận diện hướng lướt đồng bộ cho TẤT CẢ các thẻ (kể cả Thẻ 1 sang Thẻ 2):
            // - Nếu đang ở Thẻ 1 (idx = 0) và người dùng cuộn xuống (v > 0.04) -> chuyển êm sang Thẻ 2 (targetIdx = 1)
            // - Nếu vừa lướt từ Hero xuống mà chưa có thẻ nào -> tự động đón vào Thẻ 1
            if (p < 0.16 && v > 0.03) {
                targetIdx = 0; // Đón Thẻ 1 khi từ Hero xuống
            } else if (v > 0.04 && currentIdx < cardProgressPoints.length - 1) {
                targetIdx = currentIdx + 1; // Cuộn xuống -> sang thẻ tiếp theo
            } else if (v < -0.04 && currentIdx > 0) {
                targetIdx = currentIdx - 1; // Cuộn lên -> về thẻ trước đó
            }

            const targetProgress = cardProgressPoints[targetIdx];

            // Di chuyển thẻ về vị trí đích
            const maxScroll = document.body.scrollHeight - window.innerHeight;
            const targetScrollY = targetProgress * maxScroll;
            const currentScrollY = window.scrollY;

            // Nếu đang lệch khỏi tâm thẻ hơn 10px thì thực hiện chuyển động lấy đà mượt mà
            if (Math.abs(currentScrollY - targetScrollY) > 10) {
                isSnapping = true;
                hideSatellites(); // Đang di chuyển -> Ẩn các vệ tinh

                const snapObj = { y: currentScrollY };
                const dist = Math.abs(currentScrollY - targetScrollY);

                // Hiệu ứng chuyển động lấy đà: giây đầu chậm, giây sau tăng tốc rồi đáp êm
                const duration = THREE.MathUtils.clamp(
                    dist / 1200 + 0.45,
                    0.55,
                    0.78,
                );

                gsap.killTweensOf(snapObj);
                gsap.to(snapObj, {
                    y: targetScrollY,
                    duration: duration,
                    ease: "cubic-bezier(0.38, 0.04, 0.22, 1)",
                    overwrite: "auto",
                    onUpdate: () => {
                        lenis.scrollTo(snapObj.y, { immediate: true });
                    },
                    onComplete: () => {
                        isSnapping = false;
                        // Thẻ đã tự di chuyển ở giữa xong -> MỚI ĐƯỢC HIỂN THỊ CÁC VỆ TINH XUNG QUANH
                        showSatellitesForDomain(targetIdx);
                    },
                });
            } else {
                if (!isSnapping) {
                    showSatellitesForDomain(targetIdx);
                }
            }
        }

        function scheduleSnap(fast = false) {
            if (snapTimeout) clearTimeout(snapTimeout);
            // Rút ngắn delay phản ứng: 20ms khi buông tay/chuột, 45ms khi dừng con lăn
            const delayMs = fast ? 20 : 45;
            snapTimeout = setTimeout(() => {
                if (!isSnapping) {
                    snapToNearestCard(true);
                }
            }, delayMs);
        }

        lenis.on("scroll", (e: { velocity?: number }) => {
            scrollState.scrollVelocity = THREE.MathUtils.clamp(
                e.velocity || 0,
                -25,
                25,
            );

            // Dispatch custom event for HUD widgets like TACO Signpost
            window.dispatchEvent(
                new CustomEvent("stage-scroll-update", {
                    detail: { progress: scrollState.progress },
                }),
            );

            // Khi bắt đầu chuyển động trong vùng xem thẻ, ẩn vệ tinh
            if (
                scrollState.progress >= 0.16 &&
                Math.abs(scrollState.scrollVelocity) > 0.08
            ) {
                hideSatellites();
            }

            // Kích hoạt khi lướt trong vùng chuyển tiếp vào thẻ (p >= 0.10)
            if (!isSnapping && scrollState.progress >= 0.1) {
                scheduleSnap(false);
            }
        });

        // Khi người dùng nhả chuột hoặc nhấc tay khỏi màn hình -> phản ứng tức thì (fast = true)
        window.addEventListener("mouseup", () => {
            if (scrollState.progress >= 0.1) {
                scheduleSnap(true);
            }
        });

        window.addEventListener("touchend", () => {
            if (scrollState.progress >= 0.1) {
                scheduleSnap(true);
            }
        });

        // Bắt sự kiện dừng con lăn chuột với độ trễ phản ứng siêu nhạy 40ms
        let wheelIdleTimer: ReturnType<typeof setTimeout> | null = null;
        window.addEventListener(
            "wheel",
            () => {
                if (scrollState.progress >= 0.1) {
                    if (wheelIdleTimer) clearTimeout(wheelIdleTimer);
                    wheelIdleTimer = setTimeout(() => {
                        if (!isSnapping) {
                            snapToNearestCard(true);
                        }
                    }, 40);
                }
            },
            { passive: true },
        );

        document
            .getElementById("hud-prev-btn")
            ?.addEventListener("click", () => {
                const nextIdx = Math.max(0, currentDomainIndex - 1);
                const targetP =
                    0.18 + (nextIdx / (ADOLSOFT_DOMAINS.length - 1)) * 0.76;
                isSnapping = true;
                hideSatellites();
                lenis.scrollTo(
                    targetP * (document.body.scrollHeight - window.innerHeight),
                    {
                        duration: 0.65,
                        easing: (t: number) => 1 - Math.pow(1 - t, 3),
                        onComplete: () => {
                            isSnapping = false;
                            showSatellitesForDomain(nextIdx);
                        },
                    },
                );
            });

        document
            .getElementById("hud-next-btn")
            ?.addEventListener("click", () => {
                const nextIdx = Math.min(
                    ADOLSOFT_DOMAINS.length - 1,
                    currentDomainIndex + 1,
                );
                const targetP =
                    0.18 + (nextIdx / (ADOLSOFT_DOMAINS.length - 1)) * 0.76;
                isSnapping = true;
                hideSatellites();
                lenis.scrollTo(
                    targetP * (document.body.scrollHeight - window.innerHeight),
                    {
                        duration: 0.65,
                        easing: (t: number) => 1 - Math.pow(1 - t, 3),
                        onComplete: () => {
                            isSnapping = false;
                            showSatellitesForDomain(nextIdx);
                        },
                    },
                );
            });

        document.querySelectorAll("[data-scroll-to]").forEach((btn) => {
            btn.addEventListener("click", () => {
                const ratio = parseFloat(
                    (btn as HTMLElement).dataset.scrollTo || "0",
                );
                lenis.scrollTo(
                    ratio * (document.body.scrollHeight - window.innerHeight),
                );
            });
        });

        document
            .getElementById("hud-inspect-btn")
            ?.addEventListener("click", () => {
                window.dispatchEvent(
                    new CustomEvent("open-domain-modal", {
                        detail: { index: currentDomainIndex },
                    }),
                );
            });

        // ============================================================================
        // 7. POINTER PARALLAX, RAYCASTER & QUATERNION 3D GIZMO SYNC
        // ============================================================================
        const pointer = new THREE.Vector2(0, 0);
        const targetCameraOffset = new THREE.Vector2(0, 0);
        const raycaster = new THREE.Raycaster();
        let hoveredCard: THREE.Mesh | null = null;
        let rotationImpulse = 0;
        let raycastFrame = 0;

        let winWidth = window.innerWidth;
        let winHeight = window.innerHeight;

        window.addEventListener(
            "pointermove",
            (e) => {
                pointer.x = (e.clientX / winWidth) * 2 - 1;
                pointer.y = -(e.clientY / winHeight) * 2 + 1;
                targetCameraOffset.x = pointer.x * 0.55;
                targetCameraOffset.y = pointer.y * 0.35;
            },
            { passive: true },
        );

        canvas.addEventListener("click", () => {
            if (hoveredCard && scrollState.progress >= 0.16) {
                const idx = hoveredCard.userData.domainIndex;
                window.dispatchEvent(
                    new CustomEvent("open-domain-modal", {
                        detail: { index: idx },
                    }),
                );
            }
        });

        const quatCanvas = document.getElementById(
            "quaternion-canvas",
        ) as HTMLCanvasElement | null;
        const quatReadout = document.getElementById("quat-readout");
        const quatCtx = quatCanvas?.getContext("2d");

        function formatQuatComp(v: number): string {
            const sign = v >= 0 ? "+" : "-";
            const abs = Math.abs(v);
            const str =
                abs >= 0.995
                    ? abs.toFixed(1)
                    : abs.toFixed(2).replace(/^0/, "");
            return `${sign}${str}`;
        }

        const vAxisX = new THREE.Vector3(1, 0, 0);
        const vAxisY = new THREE.Vector3(0, 1, 0);
        const vAxisZ = new THREE.Vector3(0, 0, 1);
        const pAxisX = new THREE.Vector3();
        const pAxisY = new THREE.Vector3();
        const pAxisZ = new THREE.Vector3();
        let gizmoFrame = 0;
        let lastQuatStr = "";

        function renderQuaternionGizmo(q: THREE.Quaternion) {
            gizmoFrame++;
            // Debounce DOM string update to every 4 frames or when value changes
            if (quatReadout && gizmoFrame % 4 === 0) {
                const str = `${formatQuatComp(q.x)} ${formatQuatComp(q.y)} ${formatQuatComp(q.z)} ${formatQuatComp(q.w)}`;
                if (str !== lastQuatStr) {
                    lastQuatStr = str;
                    quatReadout.textContent = str;
                }
            }
            if (!quatCtx || !quatCanvas) return;
            const w = quatCanvas.width;
            const h = quatCanvas.height;
            const cx = w * 0.5;
            const cy = h * 0.5;
            const r = 26;

            quatCtx.clearRect(0, 0, w, h);

            // Outer boundary circle (clean CAD hairline)
            quatCtx.strokeStyle = "rgba(255, 255, 255, 0.22)";
            quatCtx.lineWidth = 1;
            quatCtx.beginPath();
            quatCtx.arc(cx, cy, r, 0, Math.PI * 2);
            quatCtx.stroke();

            // Equator & Meridian ellipses
            quatCtx.strokeStyle = "rgba(255, 255, 255, 0.08)";
            quatCtx.beginPath();
            quatCtx.ellipse(cx, cy, r, r * 0.3, 0, 0, Math.PI * 2);
            quatCtx.stroke();

            quatCtx.beginPath();
            quatCtx.ellipse(cx, cy, r * 0.3, r, 0, 0, Math.PI * 2);
            quatCtx.stroke();

            // 3D axes transformed in-place without vector allocations
            pAxisX.copy(vAxisX).applyQuaternion(q);
            pAxisY.copy(vAxisY).applyQuaternion(q);
            pAxisZ.copy(vAxisZ).applyQuaternion(q);

            const a0 = { v: pAxisX, color: "#ff4d4d" };
            const a1 = { v: pAxisY, color: "#c8ff00" };
            const a2 = { v: pAxisZ, color: "#00f0ff" };

            const list = [a0, a1, a2];
            if (list[0].v.z > list[1].v.z) {
                const t = list[0];
                list[0] = list[1];
                list[1] = t;
            }
            if (list[1].v.z > list[2].v.z) {
                const t = list[1];
                list[1] = list[2];
                list[2] = t;
            }
            if (list[0].v.z > list[1].v.z) {
                const t = list[0];
                list[0] = list[1];
                list[1] = t;
            }

            for (let i = 0; i < 3; i++) {
                const item = list[i];
                const ex = cx + item.v.x * r;
                const ey = cy - item.v.y * r;
                const isBack = item.v.z < 0;

                quatCtx.strokeStyle = isBack ? item.color + "55" : item.color;
                quatCtx.lineWidth = isBack ? 1.0 : 1.8;
                quatCtx.beginPath();
                quatCtx.moveTo(cx, cy);
                quatCtx.lineTo(ex, ey);
                quatCtx.stroke();

                quatCtx.fillStyle = item.color;
                quatCtx.beginPath();
                quatCtx.arc(ex, ey, isBack ? 2.2 : 3.4, 0, Math.PI * 2);
                quatCtx.fill();
            }
        }

        document
            .getElementById("reset-quaternion-btn")
            ?.addEventListener("click", () => {
                rotationImpulse = 0.25;
                gsap.to(mainLogoMesh.rotation, {
                    x: 0,
                    y: 0,
                    z: 0,
                    duration: 0.9,
                    ease: "expo.out",
                });
            });

        quatCanvas?.addEventListener("click", () => {
            rotationImpulse += 0.18;
        });

        // ============================================================================
        // 8. REAL-TIME RENDER LOOP & DYNAMIC TIME-VARIANT COLOR SHIFTER
        // ============================================================================
        let isRunning = true;
        const startTime = performance.now();
        let hiddenAt: number | null = null;
        let hiddenDuration = 0;
        const clock = {
            getElapsedTime: () =>
                (performance.now() -
                    startTime -
                    hiddenDuration -
                    (hiddenAt === null ? 0 : performance.now() - hiddenAt)) *
                0.001,
        };

        function animate() {
            if (!isRunning) return;
            requestAnimationFrame(animate);
            const elapsed = clock.getElapsedTime();

            // 1. Camera Parallax
            camera.position.x +=
                (targetCameraOffset.x - camera.position.x) * 0.05;
            camera.position.y +=
                (targetCameraOffset.y - camera.position.y) * 0.05;
            camera.lookAt(0, 0, 0);

            // 2. Liquid Glass "A" Dynamic Color-Shifting & Internal Refraction Hue Cycling (synchronized 3.0s cycle)
            const prismCycle = elapsed * ((Math.PI * 2) / 3.0);
            let wBlue = Math.pow(
                Math.max(0, Math.cos(prismCycle) * 0.5 + 0.5),
                1.6,
            );
            let wCyan = Math.pow(
                Math.max(0, Math.cos(prismCycle - 2.094395) * 0.5 + 0.5),
                1.6,
            );
            let wViolet = Math.pow(
                Math.max(0, Math.cos(prismCycle - 4.18879) * 0.5 + 0.5),
                1.6,
            );
            const sumW = wBlue + wCyan + wViolet + 0.0001;
            wBlue /= sumW;
            wCyan /= sumW;
            wViolet /= sumW;

            // Color targets matching Image 1 (Blue), Image 4 (Cyan), Image 5 (Violet):
            mainLogoMaterial.emissive.setRGB(
                0.08 * wBlue + 0.02 * wCyan + 0.28 * wViolet,
                0.16 * wBlue + 0.32 * wCyan + 0.08 * wViolet,
                0.52 * wBlue + 0.38 * wCyan + 0.52 * wViolet,
            );

            mainLogoMaterial.attenuationColor.setRGB(
                0.12 * wBlue + 0.03 * wCyan + 0.48 * wViolet,
                0.22 * wBlue + 0.56 * wCyan + 0.12 * wViolet,
                0.55 * wBlue + 0.68 * wCyan + 0.8 * wViolet,
            );

            mainLogoMaterial.specularColor.setRGB(
                0.58 * wBlue + 0.4 * wCyan + 0.75 * wViolet,
                0.75 * wBlue + 0.9 * wCyan + 0.52 * wViolet,
                0.98 * wBlue + 0.98 * wCyan + 0.98 * wViolet,
            );

            mainLogoMaterial.emissiveIntensity =
                0.48 + Math.sin(prismCycle * 0.5) * 0.08;

            // Studio rim lighting subtle breathing & color sync
            prismCyanLight.color.setRGB(
                0.05 * wBlue + 0.0 * wCyan + 0.55 * wViolet,
                0.65 * wBlue + 0.95 * wCyan + 0.12 * wViolet,
                1.0 * wBlue + 1.0 * wCyan + 0.95 * wViolet,
            );
            prismCyanLight.intensity = 28 + Math.sin(prismCycle) * 6;
            prismAmberLight.intensity = 30 + Math.cos(prismCycle * 0.9) * 5;

            // 3. Liquid Glass "A" Monolith Continuous 3D Rotation Choreography
            rotationImpulse *= 0.94;
            const idleRotY =
                Math.sin(elapsed * 0.38) * 0.28 +
                pointer.x * 0.22 +
                rotationImpulse;
            const idleRotX =
                Math.cos(elapsed * 0.52 + 1.1) * 0.12 - pointer.y * 0.16;
            const idlePosY = Math.sin(elapsed * 1.35 + 0.8) * 0.14;
            const idleTextY = Math.sin(elapsed * 1.8) * 0.025;

            const p = scrollState.progress;

            if (!isEntranceAnimating) {
                // Mượt mà nội suy Scale và Vị trí của Khối Prism Logo
                const currentTargetScale =
                    logoAnimState.targetScale * logoAnimState.drawerMultiplier;
                logoAnimState.scale +=
                    (currentTargetScale - logoAnimState.scale) * 0.09;
                logoAnimState.posY +=
                    (logoAnimState.targetPosY - logoAnimState.posY) * 0.09;
                logoAnimState.posZ +=
                    (logoAnimState.targetPosZ - logoAnimState.posZ) * 0.09;

                prismGroup.scale.setScalar(logoAnimState.scale);
                prismGroup.position.z = logoAnimState.posZ;
                prismGroup.position.y = logoAnimState.posY;

                if (p < 0.02) {
                    // Hero standby: gentle idle breathing & pointer interaction
                    mainLogoMesh.rotation.y = idleRotY;
                    mainLogoMesh.rotation.x = idleRotX;
                    mainLogoMesh.rotation.z = 0.0;
                    mainLogoMesh.position.y = idlePosY;

                    backTextMesh.position.set(0, -0.05 + idleTextY, -1.25);
                    backTextMesh.rotation.set(0, 0, 0);
                    backTextMesh.scale.set(1.0, 1.0, 1.0);
                    backTextMat.opacity = 1.0;

                    worksTextMesh.position.set(0, 0.1 + idleTextY * 0.3, -1.35);
                    worksTextMesh.rotation.set(0, 0, 0);
                    worksTextMesh.scale.set(0.85, 0.85, 1.0);
                    worksTextMat.opacity = 0.0;

                    mainLogoMaterial.dispersion = 10.0;
                } else if (p < 0.18) {
                    // =========================================================================
                    // GIAI ĐOẠN ĐẶC BIỆT: LÚC SẮP KÉO TỚI BẢNG GIỚI THIỆU (p: 0.02 -> 0.18)
                    // 1. Chữ A TO RA HOÀNH TRÁNG (scale 1.70) và xoay vào đúng góc benchmark:
                    //    Quaternion [.00 .86 +.00 +.51] -> Euler (0.05, 2.0708, 0.0)
                    // 2. Dòng chữ WORKS TO RA CỰC ĐẠI toàn màn hình với hiệu ứng lưới kiến trúc CAD
                    // 3. Dòng chữ ADOLSOFT trượt sang trái nhường tâm điểm cho WORKS
                    // =========================================================================
                    const tStage = Math.min(1, Math.max(0, (p - 0.02) / 0.1));
                    const spinEase = Math.sin(tStage * Math.PI * 0.5);

                    // 1. CHỮ A: Xoay mượt mà từ góc trực diện vào đúng góc chuẩn ảnh Alche Studio
                    // Góc Euler: Y = 2.0708 rad (~118.6°), X = 0.05 rad -> Quaternion [.00, .86, .00, .51]
                    const targetRotY = 2.0708;
                    const targetRotX = 0.05;

                    mainLogoMesh.rotation.y =
                        idleRotY * (1.0 - spinEase * 0.75) +
                        targetRotY * spinEase;
                    mainLogoMesh.rotation.x =
                        idleRotX * (1.0 - spinEase * 0.75) +
                        targetRotX * spinEase;
                    mainLogoMesh.rotation.z =
                        Math.sin(tStage * Math.PI) * -0.05;
                    mainLogoMesh.position.y = idlePosY * (1.0 - tStage * 0.7);

                    // Quang sai tán sắc cầu vồng và ánh sáng xuyên thân cực đại
                    const peakFx = Math.sin(tStage * Math.PI);
                    mainLogoMaterial.dispersion = 10.0 + peakFx * 32.0;
                    mainLogoMaterial.emissiveIntensity = 0.48 + peakFx * 0.46;
                    mainLogoMaterial.roughness = THREE.MathUtils.lerp(
                        0.08,
                        0.012,
                        peakFx,
                    );

                    prismCyanLight.intensity =
                        32 + Math.sin(prismCycle) * 6 + peakFx * 26.0;
                    prismAmberLight.intensity =
                        36 + Math.cos(prismCycle * 0.9) * 5 + peakFx * 30.0;

                    // Sóng xung kích quang sai lan tỏa
                    shockwaveMat.uniforms.uRadius.value = THREE.MathUtils.lerp(
                        0.2,
                        4.2,
                        tStage,
                    );
                    shockwaveMat.uniforms.uIntensity.value = peakFx * 1.6;

                    // 2. DÒNG CHỮ "ADOLSOFT": Lướt sang trái và mờ dần
                    const posXA = -tStage * 8.5;
                    const posZA = -1.25 - tStage * 1.5;
                    backTextMesh.position.set(posXA, -0.05 + idleTextY, posZA);
                    backTextMesh.rotation.y = -tStage * 0.35;
                    backTextMesh.rotation.x = Math.sin(tStage * Math.PI) * 0.12;
                    backTextMesh.scale.set(
                        1.0 + tStage * 0.08,
                        1.0 + tStage * 0.08,
                        1.0,
                    );
                    backTextMat.opacity = THREE.MathUtils.clamp(
                        1.0 - tStage * 2.2,
                        0.0,
                        1.0,
                    );

                    // 3. HIỆU ỨNG "WORKS" TO RA TOÀN MÀN HÌNH (CHUẨN 100% ẢNH MẪU)
                    // To dần từ scale 0.85 lên 1.06, trải rộng 16.8 đơn vị che phủ toàn bộ viewport
                    const wScale = THREE.MathUtils.lerp(0.85, 1.06, tStage);
                    worksTextMesh.scale.set(wScale, wScale, 1.0);
                    worksTextMesh.position.set(0, 0.1 + idleTextY * 0.3, -1.35);
                    worksTextMesh.rotation.set(0, 0, 0);

                    // Chuyển sắc bừng sáng trắng tinh khiết
                    worksTextMat.opacity = THREE.MathUtils.lerp(
                        0.0,
                        0.82,
                        tStage,
                    );
                    worksTextMat.color.setRGB(1.0, 1.0, 1.0);
                } else {
                    // Works Vault Orbit (Giai đoạn các bảng giới thiệu đã mở, p >= 0.18):
                    // Chữ A tiếp tục xoay 3D liên tục theo tốc độ cuộn trang
                    const worksProgress = THREE.MathUtils.clamp(
                        (p - 0.18) / 0.76,
                        0,
                        1,
                    );
                    const scrollSpinY = worksProgress * Math.PI * 3.8;
                    const scrollTiltX =
                        0.08 + Math.sin(worksProgress * Math.PI * 2.8) * 0.18;
                    const scrollRollZ =
                        Math.cos(worksProgress * Math.PI * 2.0) * 0.08;

                    mainLogoMesh.rotation.y =
                        idleRotY * 0.25 + 2.0708 + scrollSpinY;
                    mainLogoMesh.rotation.x =
                        idleRotX * 0.25 + 0.05 + scrollTiltX;
                    mainLogoMesh.rotation.z = scrollRollZ;
                    mainLogoMesh.position.y = idlePosY * 0.2;

                    // WORKS trở thành hình chìm kiến trúc vững chắc phía sau bảng
                    worksTextMesh.rotation.set(0, 0, 0);
                    worksTextMesh.scale.set(1.06, 1.06, 1.0);
                    worksTextMesh.position.set(0, 0.1 + idleTextY * 0.3, -1.35);
                    worksTextMat.color.setRGB(1.0, 1.0, 1.0);
                    worksTextMat.opacity = THREE.MathUtils.lerp(
                        0.82,
                        0.12,
                        Math.min(1, (p - 0.18) / 0.1),
                    );

                    backTextMesh.position.set(-8.5, -0.05 + idleTextY, -2.75);
                    backTextMat.opacity = 0.0;
                    shockwaveMat.uniforms.uIntensity.value = 0.0;
                }
            } else {
                // Trong lúc entrance diễn ra, GSAP toàn quyền điều khiển quỹ đạo chính.
                if (harmonicBlend.value > 0) {
                    mainLogoMesh.rotation.y +=
                        idleRotY * harmonicBlend.value * 0.06;
                    mainLogoMesh.rotation.x +=
                        idleRotX * harmonicBlend.value * 0.06;
                    mainLogoMesh.position.y +=
                        idlePosY * harmonicBlend.value * 0.06;
                    backTextMesh.position.y +=
                        idleTextY * harmonicBlend.value * 0.06;
                }
            }

            // Performance Culling: Skip invisible mesh passes completely
            shockwaveMesh.visible =
                shockwaveMat.uniforms.uIntensity.value > 0.005;
            backTextMesh.visible = backTextMat.opacity > 0.005;
            worksTextMesh.visible = worksTextMat.opacity > 0.005;

            renderQuaternionGizmo(mainLogoMesh.quaternion);

            // 4. Silky Smooth Carousel Angle Interpolation
            scrollState.carouselAngle +=
                (scrollState.targetCarouselAngle - scrollState.carouselAngle) *
                0.12;
            scrollState.scrollVelocity *= 0.9;

            domeMat.uniforms.uTime.value = elapsed;
            if (domeMat.uniforms.uActiveCardColor) {
                domeMat.uniforms.uActiveCardColor.value.lerp(
                    cachedTargetActiveColor,
                    0.08,
                );
            }
            if (shockwaveMesh.visible) {
                shockwaveMat.uniforms.uTime.value = elapsed;
            }
            innerPrismBevelMat.uniforms.uTime.value = elapsed;

            // Volumetric 3D spatial particle float (Zero CPU-GPU bus stalls)
            particleSystem.position.y = Math.sin(elapsed * 0.25) * 0.22;
            particleSystem.position.x = Math.cos(elapsed * 0.18) * 0.15;
            particleSystem.rotation.y = elapsed * 0.015;
            particleSystem.rotation.z = Math.sin(elapsed * 0.08) * 0.02;

            // 6 Curved Cards Orbit & Breath
            if (cardsGroup.visible) {
                const carouselBreathing = Math.sin(elapsed * 0.8) * 0.025;

                // Cập nhật mượt mà độ mờ của các thẻ xung quanh 2 bên:
                // Khi vệ tinh hiện (ở giữa): neighborCardsFadeFactor dần về 0.0 (ẩn mờ)
                // Khi người dùng lướt: neighborCardsFadeFactor dần về 1.0 (hiện lại)
                const targetFade = isSatellitesVisible ? 0.0 : 1.0;
                neighborCardsFadeFactor +=
                    (targetFade - neighborCardsFadeFactor) * 0.12;

                for (let idx = 0; idx < cardMeshes.length; idx++) {
                    const mesh = cardMeshes[idx];
                    const totalAngle =
                        mesh.userData.baseAngle + scrollState.carouselAngle;
                    mesh.position.x = Math.sin(totalAngle) * cardRadius;
                    mesh.position.z =
                        Math.cos(totalAngle) * cardRadius - cardRadius + 1.1;
                    mesh.position.y = carouselBreathing;
                    mesh.rotation.y = totalAngle;
                    mesh.rotation.z = 0;
                    mesh.rotation.x = 0;

                    const focusFactor = Math.cos(totalAngle);
                    const baseOpacity = THREE.MathUtils.clamp(
                        THREE.MathUtils.smoothstep(focusFactor, -0.35, 0.35),
                        0.0,
                        1.0,
                    );

                    // Thẻ ở chính giữa (focusFactor cao > 0.88) luôn giữ 100% độ rõ nét
                    // Các thẻ 2 bên xung quanh (focusFactor <= 0.88) sẽ mờ dần và ẩn đi khi thẻ giữa xuất hiện vệ tinh
                    const isCenterCard = focusFactor > 0.88;
                    const finalOpacity = isCenterCard
                        ? baseOpacity
                        : baseOpacity * neighborCardsFadeFactor;

                    const mat = cardMaterials[idx];
                    mat.uniforms.uTime.value = elapsed;
                    mat.uniforms.uScrollPos.value = scrollState.progress;
                    mat.uniforms.uScrollSpeed.value = 0.0;
                    mat.uniforms.uOpacity.value = finalOpacity;
                }

                // 5. Throttled Raycasting (once every 3 frames, only when cards are on screen)
                raycastFrame++;
                if (scrollState.progress >= 0.16 && raycastFrame % 3 === 0) {
                    raycaster.setFromCamera(pointer, camera);
                    const intersects = raycaster.intersectObjects(
                        cardMeshes,
                        false,
                    );
                    if (intersects.length > 0) {
                        hoveredCard = intersects[0].object as THREE.Mesh;
                        if (canvas.style.cursor !== "pointer")
                            canvas.style.cursor = "pointer";
                    } else {
                        hoveredCard = null;
                        if (canvas.style.cursor !== "default")
                            canvas.style.cursor = "default";
                    }
                } else if (
                    scrollState.progress < 0.16 &&
                    hoveredCard !== null
                ) {
                    hoveredCard = null;
                    if (canvas.style.cursor !== "default")
                        canvas.style.cursor = "default";
                }

                for (let idx = 0; idx < cardMaterials.length; idx++) {
                    const isHovered =
                        hoveredCard === cardMeshes[idx] ? 1.0 : 0.0;
                    cardMaterials[idx].uniforms.uHover.value +=
                        (isHovered - cardMaterials[idx].uniforms.uHover.value) *
                        0.12;
                }
            }

            renderer.render(scene, camera);
        }

        animate();

        const onResize = () => {
            winWidth = window.innerWidth;
            winHeight = window.innerHeight;
            camera.aspect = winWidth / winHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(winWidth, winHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));
            shockwaveMat.uniforms.uAspect.value = winWidth / winHeight;
            ScrollTrigger.refresh();
        };
        window.addEventListener("resize", onResize);

        const onVisibilityChange = () => {
            if (document.hidden) {
                hiddenAt ??= performance.now();
            } else if (hiddenAt !== null) {
                hiddenDuration += performance.now() - hiddenAt;
                hiddenAt = null;
            }
        };
        document.addEventListener("visibilitychange", onVisibilityChange);

        // Studio Workspace Performance Boost: Freeze/Thaw WebGL Render Loop & Lenis
        let isStudioBoostPaused = false;
        const onBackgroundPause = () => {
            if (isStudioBoostPaused) return;
            isStudioBoostPaused = true;
            isRunning = false;
            try { lenis.stop(); } catch (_) {}
            hiddenAt ??= performance.now();
        };
        const onBackgroundResume = () => {
            if (!isStudioBoostPaused) return;
            isStudioBoostPaused = false;
            isRunning = true;
            try { lenis.start(); } catch (_) {}
            if (hiddenAt !== null) {
                hiddenDuration += performance.now() - hiddenAt;
                hiddenAt = null;
            }
            requestAnimationFrame(animate);
        };
        window.addEventListener("app:background-pause", onBackgroundPause);
        window.addEventListener("app:background-resume", onBackgroundResume);

        document.addEventListener("astro:before-swap", () => {
            isRunning = false;
            window.removeEventListener("app:background-pause", onBackgroundPause);
            window.removeEventListener("app:background-resume", onBackgroundResume);
            window.removeEventListener("resize", onResize);
            document.removeEventListener(
                "visibilitychange",
                onVisibilityChange,
            );
            lenis.destroy();
            renderer.dispose();
            mainLogoGeo.dispose();
            mainLogoMaterial.dispose();
            normalTex.dispose();
            colorTex.dispose();
            innerPrismBevelGeo.dispose();
            innerPrismBevelMat.dispose();
            if (pane) pane.dispose();
            domeGeo.dispose();
            domeMat.dispose();
            texState1.dispose();
            texState2.dispose();
            texState3.dispose();
            particleGeo.dispose();
            particleMat.dispose();
            if (particleMat.map) particleMat.map.dispose();
            backTextGeo.dispose();
            backTextMat.dispose();
            if (backTextMat.map) backTextMat.map.dispose();
            worksTextGeo.dispose();
            worksTextMat.dispose();
            if (worksTextMat.map) worksTextMat.map.dispose();
            shockwaveGeo.dispose();
            shockwaveMat.dispose();
            cardMaterials.forEach((m) => m.dispose());
            cardMeshes.forEach((mesh) => mesh.geometry.dispose());
            ScrollTrigger.getAll().forEach((st) => st.kill());
        });
    }
</script>
