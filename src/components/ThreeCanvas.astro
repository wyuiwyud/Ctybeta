---
// src/components/ThreeCanvas.astro
// Fixed Pinned WebGL Stage - Alche.studio Benchmark
// Features: Hollow Liquid Glass Triangle Prism (MeshPhysicalMaterial with transmission, roughness 0.04, dispersion 6.0),
// harmonic motion phase offset \theta_y(t) = 0.25t, y(t) = \sin(1.4t + 1.2) * 0.18, and camera mouse damping.
---

<div
  id="three-container"
  class="fixed inset-0 pointer-events-none z-1 overflow-hidden w-screen h-screen"
  aria-hidden="true"
>
  <canvas id="three-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

  const canvas = document.getElementById('three-canvas') as HTMLCanvasElement | null;

  if (canvas) {
    // 1. Scene & Dark Immersive Background
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);

    // 2. Camera
    const camera = new THREE.PerspectiveCamera(
      45,
      window.innerWidth / window.innerHeight,
      0.1,
      100
    );
    camera.position.set(0, 0, 8.5);

    // 3. Renderer with high performance & tone mapping
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: false,
      powerPreference: 'high-performance',
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;

    // 4. Room Environment for Physical Glass Transmission & Reflections
    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    pmremGenerator.compileEquirectangularShader();
    const roomEnv = new RoomEnvironment();
    scene.environment = pmremGenerator.fromScene(roomEnv, 0.04).texture;

    // 5. Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 3.2);
    dirLight1.position.set(6, 8, 7);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0xd7ff00, 2.5);
    dirLight2.position.set(-7, -4, 5);
    scene.add(dirLight2);

    // 6. Extruded Hollow Triangle Liquid Glass Prism (AdolSoft Delta Logo)
    const shape = new THREE.Shape();
    const h = 4.2, w = 4.8;
    shape.moveTo(0, h * 0.6);
    shape.lineTo(w * 0.5, -h * 0.4);
    shape.lineTo(-w * 0.5, -h * 0.4);
    shape.closePath();

    const hole = new THREE.Path();
    const ih = 2.2, iw = 2.5;
    hole.moveTo(0, ih * 0.52 - 0.1);
    hole.lineTo(-iw * 0.5, -ih * 0.44);
    hole.lineTo(iw * 0.5, -ih * 0.44);
    hole.closePath();
    shape.holes.push(hole);

    const triangleGeo = new THREE.ExtrudeGeometry(shape, {
      depth: 0.85,
      bevelEnabled: true,
      bevelThickness: 0.15,
      bevelSize: 0.12,
      bevelSegments: 4,
      curveSegments: 12,
    });
    triangleGeo.center();

    const glassMaterial = new THREE.MeshPhysicalMaterial({
      color: new THREE.Color(0xffffff),
      transmission: 1.0,
      roughness: 0.04,
      metalness: 0.05,
      ior: 1.5,
      thickness: 2.2,
      dispersion: 6.0,
      clearcoat: 1.0,
      clearcoatRoughness: 0.04,
      transparent: true,
      depthWrite: true,
    });

    const prismMesh = new THREE.Mesh(triangleGeo, glassMaterial);
    scene.add(prismMesh);

    // Neon accent wireframe
    const wireframe = new THREE.LineSegments(
      new THREE.EdgesGeometry(triangleGeo, 24),
      new THREE.LineBasicMaterial({ color: 0xd7ff00, transparent: true, opacity: 0.35 })
    );
    prismMesh.add(wireframe);

    // 7. Ambient Particle Field
    const particleCount = 140;
    const particleGeo = new THREE.BufferGeometry();
    const particlePos = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount * 3; i += 3) {
      particlePos[i] = (Math.random() - 0.5) * 24;
      particlePos[i + 1] = (Math.random() - 0.5) * 16;
      particlePos[i + 2] = (Math.random() - 0.5) * 10 - 2;
    }
    particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePos, 3));
    const particleMat = new THREE.PointsMaterial({
      size: 0.05,
      color: 0xd7ff00,
      transparent: true,
      opacity: 0.35,
    });
    const particleField = new THREE.Points(particleGeo, particleMat);
    scene.add(particleField);

    // 8. Mouse Parallax with Damping
    let mouseX = 0, mouseY = 0, targetCameraX = 0, targetCameraY = 0;
    window.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    // 9. Resize Handling
    const handleResize = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    };
    window.addEventListener('resize', handleResize);

    // 10. Animation Loop: Harmonic Phase Oscillation
    let isRunning = true;
    const startTime = performance.now();

    const animate = () => {
      if (!isRunning) return;
      requestAnimationFrame(animate);

      const t = (performance.now() - startTime) * 0.001;

      // Camera mouse parallax damping
      targetCameraX += (mouseX * 0.5 - targetCameraX) * 0.05;
      targetCameraY += (-mouseY * 0.5 - targetCameraY) * 0.05;
      camera.position.x = targetCameraX;
      camera.position.y = targetCameraY;
      camera.lookAt(0, 0, 0);

      // Hero Prism harmonic rotation & breathing
      prismMesh.rotation.y = 0.25 * t;
      prismMesh.position.y = Math.sin(1.4 * t + 1.2) * 0.18;

      particleField.rotation.y = t * 0.015;

      renderer.render(scene, camera);
    };
    animate();

    // 11. Cleanup
    document.addEventListener('astro:before-swap', () => {
      isRunning = false;
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
      triangleGeo.dispose();
      glassMaterial.dispose();
      particleGeo.dispose();
      particleMat.dispose();
    });
  }
</script>
