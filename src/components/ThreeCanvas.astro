---
// src/components/ThreeCanvas.astro
// Fixed background Three.js scene with a slowly rotating 3D geometry and responsive handling
---

<div
  id="three-container"
  class="fixed inset-0 pointer-events-none z-0 overflow-hidden opacity-85"
  aria-hidden="true"
>
  <canvas id="three-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('three-canvas') as HTMLCanvasElement | null;

  if (canvas) {
    // 1. Tạo Scene
    const scene = new THREE.Scene();

    // 2. Tạo Camera (PerspectiveCamera)
    const camera = new THREE.PerspectiveCamera(
      45,
      window.innerWidth / window.innerHeight,
      0.1,
      1000
    );
    camera.position.z = 12;

    // 3. Tạo WebGLRenderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 4. Ánh sáng yếu (Dim Lighting)
    // Ánh sáng môi trường nhẹ
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
    scene.add(ambientLight);

    // Ánh sáng định hướng chính (Accent xanh chanh #d7ff00)
    const directionalLight1 = new THREE.DirectionalLight(0xd7ff00, 1.5);
    directionalLight1.position.set(6, 8, 5);
    scene.add(directionalLight1);

    // Ánh sáng định hướng phụ (Điểm nhấn bóng tối dịu)
    const directionalLight2 = new THREE.DirectionalLight(0x444444, 0.8);
    directionalLight2.position.set(-6, -6, -3);
    scene.add(directionalLight2);

    // 5. Khối hình học ở trung tâm màn hình (IcosahedronGeometry)
    // Hình khối mặt phẳng góc cạnh (Flat-shaded Icosahedron)
    const geometry = new THREE.IcosahedronGeometry(3.2, 1);
    
    // Sử dụng MeshStandardMaterial với bề mặt kim loại tối, phản chiếu ánh sáng dịu
    const material = new THREE.MeshStandardMaterial({
      color: 0x0d0d0d,
      roughness: 0.25,
      metalness: 0.85,
      flatShading: true,
    });

    const mesh = new THREE.Mesh(geometry, material);
    mesh.position.set(0, 0, 0); // Đặt chính giữa màn hình
    scene.add(mesh);

    // Khung lưới viền neon (Wireframe Shell) tạo phong cách không gian Alche.studio
    const wireframeMaterial = new THREE.MeshBasicMaterial({
      color: 0xd7ff00,
      wireframe: true,
      transparent: true,
      opacity: 0.18,
    });
    const wireframeMesh = new THREE.Mesh(geometry, wireframeMaterial);
    wireframeMesh.scale.setScalar(1.002);
    mesh.add(wireframeMesh);

    // Thêm các hạt sao bụi vi mô xung quanh
    const starsCount = 200;
    const starsGeometry = new THREE.BufferGeometry();
    const starPositions = new Float32Array(starsCount * 3);
    for (let i = 0; i < starsCount * 3; i += 3) {
      starPositions[i] = (Math.random() - 0.5) * 35;
      starPositions[i + 1] = (Math.random() - 0.5) * 25;
      starPositions[i + 2] = (Math.random() - 0.5) * 20;
    }
    starsGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starsMaterial = new THREE.PointsMaterial({
      size: 0.12,
      color: 0xd7ff00,
      transparent: true,
      opacity: 0.4,
    });
    const starPoints = new THREE.Points(starsGeometry, starsMaterial);
    scene.add(starPoints);

    // Tương tác chuột nhẹ nhàng (Parallax Easing)
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    window.addEventListener('mousemove', (event) => {
      mouseX = (event.clientX / window.innerWidth - 0.5) * 0.8;
      mouseY = (event.clientY / window.innerHeight - 0.5) * 0.8;
    });

    // 6. Logic tự động Resize theo kích thước cửa sổ (Responsive)
    const handleResize = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    };

    window.addEventListener('resize', handleResize);

    // 7. Vòng lặp Render & Xoay khối hình học chậm rãi
    let isRunning = true;

    const animate = () => {
      if (!isRunning) return;
      requestAnimationFrame(animate);

      // Hiệu ứng xoay chậm rãi liên tục
      mesh.rotation.x += 0.003;
      mesh.rotation.y += 0.004;

      // Xoay nhẹ các hạt bụi xung quanh
      starPoints.rotation.y += 0.0008;

      // Gia tốc mượt theo vị trí con trỏ chuột
      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;

      mesh.position.x = targetX * 1.5;
      mesh.position.y = -targetY * 1.5;

      renderer.render(scene, camera);
    };

    animate();

    // Dọn dẹp tài nguyên khi unmount (nếu có SPA routing)
    document.addEventListener('astro:before-swap', () => {
      isRunning = false;
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
      geometry.dispose();
      material.dispose();
      wireframeMaterial.dispose();
      starsGeometry.dispose();
      starsMaterial.dispose();
    });
  }
</script>
