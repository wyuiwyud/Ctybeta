    function renderWorkspaceSummary() {
        const clientCount = document.getElementById("workspace-client-total");
        const projectCount = document.getElementById("workspace-project-total");
        const progressValue = document.getElementById(
            "workspace-progress-total",
        );
        const status = document.getElementById("workspace-data-status");
        if (workspaceDataLoading) {
            if (clientCount) clientCount.textContent = "…";
            if (projectCount) projectCount.textContent = "…";
            if (progressValue) progressValue.textContent = "…";
