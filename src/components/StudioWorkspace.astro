        padding: 8px 4px;
        border-bottom: 1px solid #cceeff20;
    }
    .player-score strong {
        color: #f4fbff;
        font:
            700 29px "Space Grotesk",
            sans-serif;
    }
    .player-score span {
        color: #70899c;
        font:
            7px/1.5 "IBM Plex Mono",
            monospace;
    }
    .player-score b {
        margin-left: auto;
        color: var(--studio-accent);
        font-size: 19px;
    }
    .medal-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 12px 0;
        color: #9ab1c0;
        font:
            8px "IBM Plex Mono",
            monospace;
    }
    .medal-row span:nth-of-type(1) {
        color: #ffd27c;
    }
    .medal-row span:nth-of-type(2) {
        color: #b8c5d1;
    }
    .medal-row span:nth-of-type(3) {
        color: #dfa28e;
    }
    .level-row {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        width: 100%;
        padding: 9px 0;
    }
    .level-row div {
        display: grid;
        gap: 4px;
    }
    .level-row span {
        color: #698196;
        font:
            7px "IBM Plex Mono",
            monospace;
    }
    .level-row b {
        color: #e9f4f9;
        font:
            700 15px "Space Grotesk",
            sans-serif;
    }
    .profile-divider {
        width: 100%;
        height: 1px;
        margin: 7px 0 14px;
        background: linear-gradient(90deg, transparent, #a4d8f551, transparent);
    }
    .member-profile {
