    teamChatForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!member) return;
        const text = teamChatInput?.value.trim() || "";
        const file = pendingChatFile;
        if (!text && !file) return;

        let attachment: ChatAttachment | undefined;
        if (file) {
            try {
                const dataUrl = await new Promise<string>((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () =>
                        typeof reader.result === "string"
                            ? resolve(reader.result)
                            : reject(new Error("File read failed"));
                    reader.onerror = () => reject(reader.error);
                    reader.readAsDataURL(file);
                });
                attachment = {
                    name: file.name,
                    type: file.type || "application/octet-stream",
                    size: file.size,
                    dataUrl,
                };
            } catch {
                tell("Không đọc được tệp đính kèm.");
                return;
            }
        }

        const previousMessages = studioState.messages;
        const time = new Intl.DateTimeFormat("vi-VN", {
            hour: "2-digit",
            minute: "2-digit",
        }).format(new Date());

        const generateSafeUuid = () => {
            if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
                try {
                    return crypto.randomUUID();
                } catch {}
            }
            return "10000000-1000-4000-8000-100000000000".replace(/[018]/g, (c: any) =>
                (c ^ (crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (c / 4)))).toString(16),
            );
        };

        const newMsg: ChatMessage = {
            id: generateSafeUuid(),
            authorId: member.id,
            author: member.name,
            role: member.label,
            text,
            time,
            ...(attachment ? { file: attachment } : {}),
        };
        studioState.messages = [
            ...previousMessages,
            newMsg,
        ].slice(-MAX_CHAT_MESSAGES);

        if (!persist()) {
            studioState.messages = previousMessages;
            renderTeamChat();
            return;
        }

        if (supabase) {
            void Promise.resolve(
                supabase
                    .from("studio_messages")
                    .insert([
                        {
                            id: newMsg.id,
                            author_id: newMsg.authorId,
                            author: newMsg.author,
                            role: newMsg.role,
                            text: newMsg.text,
                            time: newMsg.time,
                            file: newMsg.file || null,
                        },
                    ])
                    .then(({ error }) => {
                        if (error) {
                            console.error("Lỗi gửi tin nhắn lên Supabase:", error);
                            tell("Lỗi gửi tin: " + (error.message || "Không lưu được"));
                        } else {
                            syncMessagesFromSupabase();
                        }
                    }),
            ).catch((error: unknown) => {
                console.error("Lỗi kết nối Supabase:", error);
                tell("Không thể kết nối để gửi tin nhắn; bản trên thiết bị vẫn được giữ.");
            });
        }
        if (teamChatInput) teamChatInput.value = "";
        if (teamChatFileInput) teamChatFileInput.value = "";
        pendingChatFile = null;
        teamChatFilePreview?.setAttribute("hidden", "");
    });
