        node.setAttribute("aria-hidden", String(!show));
    }
    function tell(text: string) {
        if (!toast) return;
        toast.textContent = text;
        window.setTimeout(() => {
            if (toast.textContent === text) toast.textContent = "";
        }, 3600);
    }
    function persist() {
        try {
            localStorage.setItem(sharedStorageKey, JSON.stringify(studioState));
        } catch {}
        renderRoom();
    }
    function projectCards() {
        return [
            ["ADOL OS", "A", "#58caff"],
            ["AI PRINT-CUT", "C", "#f2a94b"],
            ["STUDIO WEB", "W", "#8ce7fc"],
            ["AI LOCAL", "L", "#b08aff"],
            ["BANK TOKEN", "T", "#9fe8c4"],
        ]
            .map(
                ([title, mark, color], i) =>
                    `<article class="project-card" style="--card-color:${color}"><small>0${i + 1} / ACTIVE</small><span>${mark}</span><b>${title}</b></article>`,
            )
            .join("");
    }
    function noticeMarkup() {
        return studioState.notices
            .slice(0, 3)
            .map(
                (n) =>
                    `<div class="feed-item"><b>${escapeText(n.author)} / ${escapeText(n.time)}</b>${escapeText(n.text)}</div>`,
            )
            .join("");
    }
    function taskMarkup(task: Task, actions = true) {
        return `<article class="task-item" draggable="true" data-task-id="${escapeText(task.id)}"><div><b>${escapeText(task.title)}</b><small>${escapeText(task.owner)} · ${task.status.toUpperCase()} · FROM ${escapeText(task.from)}</small></div>${actions ? `<div class="task-actions"><button data-set-status="doing" data-task-id="${escapeText(task.id)}">IN PROGRESS</button><button data-set-status="done" data-task-id="${escapeText(task.id)}">DONE ✓</button><button data-set-status="support" data-task-id="${escapeText(task.id)}">HELP</button></div>` : ""}</article>`;
    }
    function tasksFor(owner: string) {
        return studioState.tasks.filter(
            (t) => t.owner === owner && t.status !== "done",
        );
    }
    function metric(label: string, value: string) {
        return `<div class="metric"><span>${label}</span><b>${value}</b></div>`;
    }
    function panel(
        label: string,
        title: string,
        body: string,
        size = "panel-span-4",
    ) {
        return `<article class="data-panel ${size}"><small>${label}</small><h3>${title}</h3>${body}</article>`;
    }
    function roomMarkup() {
        if (!member) return "";
        const notice = noticeMarkup();
        if (member.role === "admin") {
            const lanes = ["todo", "doing", "done"]
                .map((status) => {
                    const title =
                        status === "todo"
                            ? "TO DO"
                            : status === "doing"
                              ? "IN PROGRESS"
                              : "COMPLETE";
                    const tasks = studioState.tasks.filter(
                        (t) =>
                            t.status === status ||
                            (status === "doing" && t.status === "support"),
                    );
                    return `<div class="room-lane" data-lane="${status}"><div class="panel-label">${title} / ${String(tasks.length).padStart(2, "0")}</div>${tasks.map((t) => taskMarkup(t, false)).join("") || '<p class="empty">Nothing in this lane</p>'}</div>`;
                })
                .join("");
            return `<div class="room-content" data-role="admin">${panel("COMMAND / STUDIO-WIDE", "Studio Kanban", `<div class="room-kanban">${lanes}</div>`, "panel-span-8")}${panel("FOUNDER FEED / QUICK ASSIGN", "Send a brief", `<form class="feed-form" id="founder-feed-form"><input name="message" placeholder="Message or task for the team..." required maxlength="180"/><select name="owner" aria-label="Assign member"><option>Khoi Ng</option><option>Phuc Ho</option><option>Jen</option><option>YenN</option></select><button type="submit">SEND ↗</button></form><div class="feed-list">${notice}</div>`, "panel-span-4")}${panel("FINANCE / YENN", "Studio balance", `<div class="metric-row">${metric("MONTH REVENUE", "128.4M")}${metric("BANK TOKEN", "84,500")}${metric("NET FLOW", "85.6M")}</div><div class="bar-chart"><i style="height:42%"></i><i style="height:56%"></i><i style="height:49%"></i><i style="height:77%"></i><i style="height:68%"></i><i style="height:94%"></i></div><div class="bar-labels"><span>JUN</span><span>JUL</span><span>AUG</span><span>SEP</span><span>OCT</span><span>NOV</span></div>`, "panel-span-6")}${panel("SYSTEM HEALTH / KHOI + PHUC", "Live systems", `<div class="health-row"><span>AdolOS Server</span><b>● ONLINE</b></div><div class="health-row"><span>AI Local Nodes</span><b>● 4 / 5 ACTIVE</b></div><div class="health-row"><span>Security Monitor</span><b>● STABLE</b></div>`, "panel-span-6")}</div>`;
        }
        if (member.role === "senior") {
            const queue =
                tasksFor("Khoi Ng")
                    .map(
                        (t) =>
                            `<article class="task-item"><div><b>${escapeText(t.title)}</b><small>${t.status.toUpperCase()} · REVIEW REQUIRED</small></div><button class="small-action" data-approve="${escapeText(t.id)}">APPROVE → PHUC</button></article>`,
                    )
                    .join("") || '<p class="empty">No pending reviews.</p>';
            return `<div class="room-content" data-role="senior">${panel("ENGINEERING / PRIVATE DOCS", "Tech Library", `<button class="doc-row" data-toast="API Documentation">API Documentation <span>↗</span></button><button class="doc-row" data-toast="AdolOS Architecture">AdolOS Architecture <span>↗</span></button><button class="doc-row" data-toast="AI Agent Modules">AI Agent Modules <span>↗</span></button><button class="doc-row" data-toast="Deployment SOP">Deployment SOP <span>↗</span></button>`, "panel-span-4")}${panel("GIT / INFRA CONTROL", "Server room", `<div class="metric-row">${metric("OPEN PR", "03")}${metric("SERVER", "ONLINE")}${metric("WARNINGS", "02")}</div><div class="health-row"><span>AdolOS API</span><b>● HEALTHY</b></div><div class="health-row"><span>AI Local build</span><b class="warn">● REVIEW</b></div><div class="health-row"><span>Latest logs</span><b class="warn">02 WARNINGS</b></div>`, "panel-span-4")}${panel("DEPLOYMENT QUEUE / REVIEW", "Approve for field ops", queue, "panel-span-4")}${panel("TEAM FEED", "Founder updates", notice, "panel-span-12")}</div>`;
        }
        if (member.role === "tech") {
            const tasks =
                tasksFor("Phuc Ho")
                    .map((t) => taskMarkup(t))
                    .join("") ||
                '<p class="empty">No assigned deployments.</p>';
            return `<div class="room-content" data-role="tech">${panel("CLIENT CARE / TICKETS", "Support desk", `<div class="ticket"><b>USB không nhận AI Local</b><small>Quán Cafe A / 12 min ago</small><span class="pill">OPEN</span></div><div class="ticket"><b>Agent offline sau khi reboot</b><small>Xưởng in B / 34 min ago</small><span class="pill">PRIORITY</span></div><div class="ticket"><b>Request cài đặt từ xa</b><small>Studio Mộc / hôm nay</small><span class="pill">SCHEDULED</span></div>`, "panel-span-4")}${panel("FIELD OPS / YOUR ASSIGNMENTS", "Deployment queue", `<div class="task-list">${tasks}</div>`, "panel-span-5")}${panel("HARDWARE / INVENTORY", "Field kit", `<div class="inventory-row"><span>USB AI Local</span><b>28 left</b></div><div class="inventory-row"><span>SSD deployment</span><b>12 left</b></div><div class="inventory-row"><span>Install kits</span><b>04 ready</b></div><div class="inventory-row"><span>Pending assistance</span><b>${studioState.tasks.filter((t) => t.status === "support").length} tasks</b></div>`, "panel-span-3")}${panel("LIVE TEAM FEED", "New assignments", notice, "panel-span-12")}</div>`;
        }
        if (member.role === "data") {
            return `<div class="room-content" data-role="data">${panel("MARKET SIGNAL / INSIGHTS", "Strategy notes", `<div class="text-entry">AI Local demand rising among small manufacturers.<small>MARKET WATCH / THIS WEEK</small></div><div class="text-entry">Prioritize vertical case studies to improve conversion.<small>FOUNDER BRIEF / SUGGESTED</small></div><div class="text-entry">Office workflow agents trending across SME segment.<small>TECH RADAR / 2026</small></div>`, "panel-span-4")}${panel("ANALYTICS / SAMPLE DATA", "Studio observatory", `<div class="metric-row">${metric("WEB TRAFFIC", "18.6K")}${metric("CONVERSION", "4.8%")}${metric("MOM", "+22%")}</div><div class="bar-chart"><i style="height:31%"></i><i style="height:52%"></i><i style="height:45%"></i><i style="height:70%"></i><i style="height:64%"></i><i style="height:94%"></i></div><div class="bar-labels"><span>JUN</span><span>JUL</span><span>AUG</span><span>SEP</span><span>OCT</span><span>NOV</span></div>`, "panel-span-5")}${panel("CRM / LEAD SEGMENTS", "Prospect radar", `<div class="lead-row"><b>Studio Mộc</b><span class="pill">VIP</span></div><div class="lead-row"><b>Print House 24</b><span class="pill">NEW</span></div><div class="lead-row"><b>Cafe Sông</b><span class="pill">CONSULT</span></div><div class="lead-row"><b>Minh Phát Decor</b><span class="pill">RETURNING</span></div>`, "panel-span-3")}${panel("LIVE TEAM FEED", "Founder updates", notice, "panel-span-12")}</div>`;
        }
        return `<div class="room-content" data-role="finance">${panel("INVOICES / AUTO-QUOTATION", "Receivables", `<div class="invoice-row"><b>INV-2026-041</b><span>Quán Cafe A / 24.0M ₫</span><span class="pill">DUE</span></div><div class="invoice-row"><b>INV-2026-038</b><span>Xưởng in B / 18.5M ₫</span><span class="pill">TODAY</span></div><div class="invoice-row"><b>QT-2026-019</b><span>AI Agent / 32.0M ₫</span><span class="pill">REVIEW</span></div>`, "panel-span-4")}${panel("CASH FLOW / MONTHLY", "The Vault", `<div class="metric-row">${metric("REVENUE", "128.4M")}${metric("EXPENSES", "42.8M")}${metric("NET", "85.6M")}</div><div class="bar-chart"><i style="height:80%"></i><i style="height:53%"></i><i style="height:65%"></i></div><div class="health-row"><span>Web / USB / AI Agent</span><b>52M / 36M / 40M</b></div>`, "panel-span-5")}${panel("TOKEN / OPERATIONS LEDGER", "Bank Token", `<div class="metric"> <span>STUDIO BALANCE</span><b>84,500 TK</b></div><div class="ledger-row"><span>AI API / month</span><b>- 8,240 TK</b></div><div class="ledger-row"><span>Server & infra</span><b>- 3,600 TK</b></div><div class="ledger-row"><span>Team allocation</span><b>- 2,100 TK</b></div><p class="panel-label">SAMPLE DATA / YENN REPORT</p>`, "panel-span-3")}${panel("LIVE TEAM FEED", "Founder updates", notice, "panel-span-12")}</div>`;
    }
    function renderRoom() {
        if (!member) return;
        if (roomContent) roomContent.innerHTML = roomMarkup();
    }
    function setMember(memberData: Member) {
        member = memberData;
        document
            .getElementById("studio-shell")
            ?.style.setProperty("--studio-accent", member.color);
        const text = (id: string, value: string) => {
            const node = document.getElementById(id);
            if (node) node.textContent = value;
        };
        text("member-code", member.id);
        text("member-name", member.name);
        text("member-display", member.name);
        text("member-role", member.label);
        text("member-initials", member.initials);
        text("member-avatar", member.initials);
        text("member-room-short", member.room);
        text(
            "member-access-short",
            member.access.map((x) => x.toUpperCase()).join(" · "),
        );
        text("room-kicker", `PRIVATE SPACE / ${member.id}`);
        text("room-title", member.room);
        text("room-subtitle", member.subtitle);
        text("footer-role", member.label);
        document
            .querySelectorAll<HTMLButtonElement>("[data-module]")
            .forEach((button) => {
                const allowed =
                    member?.access.includes(button.dataset.module || "") ??
                    false;
                button.disabled = !allowed;
                button.classList.remove("active");
            });
        const rail = document.getElementById("project-rail");
        if (rail) rail.innerHTML = projectCards();
        const date = document.getElementById("collection-year");
        if (date) date.textContent = `2026 / ${member.access.length} MODULES`;
        if (roomContent) roomContent.hidden = false;
        if (moduleContent) moduleContent.hidden = true;
        renderRoom();
        setVisible(auth, false);
        setVisible(workspace, true);
        document.body.style.overflow = "hidden";
        idleDeadline = Date.now() + 30 * 60_000;
        window.clearInterval(sessionTimer);
        sessionTimer = window.setInterval(() => {
            if (!member) return;
            const left = Math.max(
                0,
                Math.ceil((idleDeadline - Date.now()) / 1000),
            );
            const clock = document.getElementById("session-clock");
            if (clock)
                clock.textContent = `${String(Math.floor(left / 60)).padStart(2, "0")}:${String(left % 60).padStart(2, "0")}`;
            if (!left) logout("Session expired. Sign in again.");
        }, 1000);
    }
    function openLogin() {
        setVisible(auth, true);
        if (errorLine) {
            errorLine.textContent = pendingModule
                ? "Authenticate to open the requested TACO module."
                : "Mã truy cập không hợp lệ.";
            errorLine.classList.remove("visible-error");
        }
        window.setTimeout(() => passInput.focus(), 100);
    }
    function openModule(key: string) {
        if (!member) return;
        if (!member.access.includes(key)) {
            tell("Module locked for this member role.");
            return;
        }
        const mod = modules[key];
        if (!mod || !moduleContent) return;
        moduleContent.innerHTML = mod.items
            .map(
                (item, index) =>
                    `<article class="module-card"><small>0${index + 1} / ${key.toUpperCase()} MODULE</small><h3>${item.title}</h3><p>${item.detail}</p><button type="button" data-toast="${item.title}">OPEN RESOURCE ↗</button></article>`,
            )
            .join("");
        if (roomContent) roomContent.hidden = true;
        moduleContent.hidden = false;
        const title = document.getElementById("room-title");
        if (title) title.innerHTML = `${mod.title}<span>.</span>`;
        document
            .querySelectorAll<HTMLButtonElement>("[data-module]")
            .forEach((button) =>
                button.classList.toggle(
                    "active",
                    button.dataset.module === key,
                ),
            );
    }
    function logout(reason = "") {
        member = null;
        window.clearInterval(sessionTimer);
        setVisible(workspace, false);
        document.body.style.overflow = "";
        if (reason) {
            openLogin();
            if (errorLine) {
                errorLine.textContent = reason;
                errorLine.classList.add("visible-error");
            }
        }
    }
    window.addEventListener("studio:open", ((
        event: CustomEvent<{ key: string }>,
    ) => {
        const key = event.detail.key;
        if (member) {
            setVisible(workspace, true);
            document.body.style.overflow = "hidden";
            idleDeadline = Date.now() + 30 * 60_000;
            if (["a", "c", "o"].includes(key)) openModule(key);
            else {
                if (roomContent) roomContent.hidden = false;
                if (moduleContent) moduleContent.hidden = true;
                const title = document.getElementById("room-title");
                if (title && member)
                    title.innerHTML = `${member.room}<span>.</span>`;
            }
            return;
        }
        pendingModule = ["a", "c", "o"].includes(key) ? key : "";
        openLogin();
    }) as EventListener);
    loginForm.addEventListener("submit", (event) => {
        event.preventDefault();
        if (Date.now() < lockedUntil) {
            if (errorLine) {
                errorLine.textContent = "Gateway locked for 30 seconds.";
                errorLine.classList.add("visible-error");
            }
            return;
        }
        const found = members[passInput.value.trim().toUpperCase()];
        if (!found) {
            badAttempts++;
            const count = document.getElementById("studio-attempt-count");
            if (count) count.textContent = `${badAttempts} / 3`;
            if (errorLine) {
                errorLine.textContent =
                    badAttempts >= 3
                        ? "Three failed attempts. Gateway locked for 30 seconds."
                        : "Mã truy cập không hợp lệ.";
                errorLine.classList.add("visible-error");
            }
            document.querySelector(".auth-shell")?.classList.remove("glitch");
            void (document.querySelector(".auth-shell") as HTMLElement | null)
                ?.offsetWidth;
            document.querySelector(".auth-shell")?.classList.add("glitch");
            if (badAttempts >= 3) {
                badAttempts = 0;
                lockedUntil = Date.now() + 30_000;
            }
            passInput.select();
            return;
        }
        badAttempts = 0;
        const count = document.getElementById("studio-attempt-count");
        if (count) count.textContent = "0 / 3";
        const requested = pendingModule;
        pendingModule = "";
        setMember(found);
        if (requested && found.access.includes(requested))
            openModule(requested);
    });
    document.querySelector("[data-close]")?.addEventListener("click", () => {
        setVisible(auth, false);
        pendingModule = "";
        document
            .getElementById("signpost-menu-totem")
            ?.classList.remove("is-auth-opening");
    });
    document
        .querySelector("[data-close-workspace]")
        ?.addEventListener("click", () => {
            setVisible(workspace, false);
            document.body.style.overflow = "";
        });
    document
        .querySelector("[data-logout]")
        ?.addEventListener("click", () => logout());
    document
        .querySelector("[data-home]")
        ?.addEventListener("click", (event) => {
            event.preventDefault();
            if (member) {
                if (roomContent) roomContent.hidden = false;
                if (moduleContent) moduleContent.hidden = true;
                const title = document.getElementById("room-title");
                if (title) title.innerHTML = `${member.room}<span>.</span>`;
            }
        });
    document
        .querySelectorAll<HTMLButtonElement>("[data-module]")
        .forEach((button) =>
            button.addEventListener("click", () =>
                openModule(button.dataset.module || ""),
            ),
        );
    roomContent?.addEventListener("submit", (event) => {
        const form = event.target as HTMLFormElement;
        if (form.id !== "founder-feed-form" || member?.role !== "admin") return;
        event.preventDefault();
        const data = new FormData(form);
        const text = String(data.get("message") || "").trim();
        const owner = String(data.get("owner") || "");
        if (!text || !owner) return;
        const time = new Intl.DateTimeFormat("vi-VN", {
            hour: "2-digit",
            minute: "2-digit",
        }).format(new Date());
        studioState.tasks.unshift({
            id: crypto.randomUUID(),
            title: text,
            owner,
            status: "todo",
            from: member.name,
        });
        studioState.notices.unshift({
            text: `${text} · giao cho ${owner}`,
            author: member.name,
            time,
        });
        studioState.notices = studioState.notices.slice(0, 20);
        persist();
        form.reset();
        tell(`Task assigned to ${owner}.`);
    });
    function updateTask(taskId: string, status: Task["status"]) {
        const task = studioState.tasks.find((item) => item.id === taskId);
        if (!task || !member) return;
        if (task.owner !== member.name && member.role !== "admin") return;
        task.status = status;
        persist();
        tell(`Task updated: ${status.toUpperCase()}`);
    }
    roomContent?.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "button",
        );
        if (!target) return;
        if (target.dataset.setStatus && target.dataset.taskId) {
            updateTask(
                target.dataset.taskId,
                target.dataset.setStatus as Task["status"],
            );
            return;
        }
        if (target.dataset.approve && member?.role === "senior") {
            const task = studioState.tasks.find(
                (item) => item.id === target.dataset.approve,
            );
            if (task) {
                task.owner = "Phuc Ho";
                task.status = "todo";
                task.from = `${member.name} / APPROVED`;
                studioState.notices.unshift({
                    text: `${task.title} approved and assigned to Phuc Ho.`,
                    author: member.name,
                    time: new Intl.DateTimeFormat("vi-VN", {
                        hour: "2-digit",
                        minute: "2-digit",
                    }).format(new Date()),
                });
                persist();
                tell("Deployment handed to Phuc Ho.");
            }
            return;
        }
        if (target.dataset.toast)
            tell(`${target.dataset.toast} · Demo resource not connected.`);
    });
    moduleContent?.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-toast]",
        );
        if (target)
            tell(`${target.dataset.toast} · Demo resource not connected.`);
    });
    document.addEventListener("dragstart", (event) => {
        draggedTask = (event.target as HTMLElement).closest<HTMLElement>(
            ".task-item",
        );
        if (draggedTask) draggedTask.style.opacity = ".45";
    });
    document.addEventListener("dragend", () => {
        if (draggedTask) draggedTask.style.opacity = "";
        draggedTask = null;
    });
    document.addEventListener("dragover", (event) => {
        if ((event.target as HTMLElement).closest(".room-lane"))
            event.preventDefault();
    });
    document.addEventListener("drop", (event) => {
        const lane = (event.target as HTMLElement).closest<HTMLElement>(
            ".room-lane",
        );
        const id = draggedTask?.dataset.taskId;
        if (!lane || !id || !member) return;
        const task = studioState.tasks.find((item) => item.id === id);
        if (task && (task.owner === member.name || member.role === "admin")) {
            task.status = lane.dataset.lane as Task["status"];
            persist();
        }
    });
    window.addEventListener("storage", (event) => {
        if (event.key !== sharedStorageKey || !event.newValue) return;
        try {
            const next = JSON.parse(event.newValue) as StudioState;
            if (!Array.isArray(next.tasks) || !Array.isArray(next.notices))
                return;
            const oldIds = new Set(studioState.tasks.map((task) => task.id));
            studioState = next;
            renderRoom();
            const newAssignment =
                member &&
                next.tasks.find(
                    (task) =>
                        task.owner === member?.name && !oldIds.has(task.id),
                );
            if (newAssignment) tell(`New assignment: ${newAssignment.title}`);
        } catch {}
    });
    ["pointerdown", "keydown", "touchstart"].forEach((name) =>
        document.addEventListener(
            name,
            () => {
                if (member) idleDeadline = Date.now() + 30 * 60_000;
            },
            { passive: true },
        ),
    );
    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (auth?.classList.contains("visible")) {
            setVisible(auth, false);
            pendingModule = "";
            document
                .getElementById("signpost-menu-totem")
                ?.classList.remove("is-auth-opening");
        } else if (workspace.classList.contains("visible")) {
            setVisible(workspace, false);
            document.body.style.overflow = "";
        }
    });
</script>
