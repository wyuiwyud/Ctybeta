    async function loadWorkspaceData(memberId: string) {
        workspaceDataLoading = true;
        workspaceDataError = "";
        renderRoom();
        if (!supabase) {
            workspaceDataLoading = false;
            workspaceDataError = "Supabase chưa được cấu hình.";
            renderRoom();
            return;
        }
        try {
            const [clientsResult, projectsResult] = await Promise.all([
                supabase
                    .from("studio_clients")
                    .select("id, name, contact_info")
                    .order("created_at", { ascending: false }),
                supabase
                    .from("studio_projects")
                    .select(
                        "id, client_id, title, description, progress, status, assigned_to",
                    )
                    .order("created_at", { ascending: false }),
            ]);
            if (member?.id !== memberId) return;
            if (clientsResult.error) throw clientsResult.error;
            if (projectsResult.error) throw projectsResult.error;
            studioClients = (clientsResult.data ?? [])
                .map((row) => parseStudioClient(row))
                .filter((row): row is StudioClient => row !== null);
            studioProjects = (projectsResult.data ?? [])
                .map((row) => parseStudioProject(row))
                .filter((row): row is StudioProject => row !== null);
        } catch (error) {
            if (member?.id !== memberId) return;
            console.error("Không thể tải dữ liệu Workspace:", error);
            workspaceDataError =
                "Không tải được khách hàng/dự án từ Supabase. Kiểm tra migration, quyền RLS và kết nối.";
        } finally {
            if (member?.id === memberId) {
                workspaceDataLoading = false;
                renderRoom();
            }
        }
    }
    async function saveProjectProgress(input: HTMLInputElement) {
        const projectId = input.dataset.projectProgress;
        const project = studioProjects.find((item) => item.id === projectId);
        if (!project || !member || !supabase || !projectId) {
            tell("Không thể cập nhật tiến độ: thiếu đăng nhập hoặc kết nối Supabase.");
            return;
        }
        if (member.role === "tech" && project.assigned_to !== member.id) {
            tell("Bạn chỉ có thể cập nhật dự án được giao cho mình.");
            renderRoom();
            return;
        }
        if (projectProgressUpdates.has(projectId)) return;
        const nextProgress = Number(input.value);
        if (!Number.isInteger(nextProgress) || nextProgress < 0 || nextProgress > 100) {
            tell("Giá trị tiến độ không hợp lệ.");
            renderRoom();
            return;
        }
        const previousProgress = project.progress;
        const memberId = member.id;
        projectProgressUpdates.add(projectId);
        input.disabled = true;
        try {
            const { data, error } = await supabase
                .from("studio_projects")
                .update({ progress: nextProgress })
                .eq("id", projectId)
                .select("id, progress")
                .maybeSingle();
            if (error) throw error;
            if (!data) {
                throw new Error(
                    "Không có dòng nào được cập nhật. Kiểm tra quyền RLS của tài khoản.",
                );
            }
            if (member?.id !== memberId) return;
            project.progress = Math.max(
                0,
                Math.min(100, Math.round(Number(data.progress))),
            );
            tell("Đã lưu tiến độ dự án.");
        } catch (error) {
            if (member?.id !== memberId) return;
            console.error("Không thể cập nhật tiến độ dự án:", error);
            project.progress = previousProgress;
            tell(
                error instanceof Error
                    ? `Lưu tiến độ thất bại: ${error.message}`
                    : "Lưu tiến độ thất bại. Vui lòng thử lại.",
            );
        } finally {
            projectProgressUpdates.delete(projectId);
            if (member?.id === memberId) renderRoom();
        }
    }
