    const projectProgressUpdates = new Set<string>();
    function readStudioState(): StudioState {
        try {
            const saved = localStorage.getItem(sharedStorageKey);
            if (saved) {
                const parsed = JSON.parse(saved) as Partial<StudioState>;
                return {
                    messages: Array.isArray(parsed.messages)
                        ? parsed.messages
                        : [],
                };
            }
        } catch {}
        return JSON.parse(JSON.stringify(initialState)) as StudioState;
    }
    function escapeText(text: string) {
        return text.replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                })[c] || c,
        );
    }
    function parseStudioClient(value: unknown): StudioClient | null {
        if (!value || typeof value !== "object") return null;
        const row = value as Record<string, unknown>;
        if (typeof row.id !== "string" || typeof row.name !== "string")
            return null;
        return {
            id: row.id,
            name: row.name,
            contact_info:
                typeof row.contact_info === "string" ? row.contact_info : null,
        };
    }
    function parseStudioProject(value: unknown): StudioProject | null {
        if (!value || typeof value !== "object") return null;
        const row = value as Record<string, unknown>;
        const progress = Number(row.progress ?? 0);
        if (
            typeof row.id !== "string" ||
            typeof row.title !== "string" ||
            !Number.isFinite(progress)
        )
            return null;
        return {
            id: row.id,
            client_id: typeof row.client_id === "string" ? row.client_id : null,
            title: row.title,
            description:
                typeof row.description === "string" ? row.description : null,
            progress: Math.max(0, Math.min(100, Math.round(progress))),
            status: typeof row.status === "string" ? row.status : "active",
            assigned_to:
                typeof row.assigned_to === "string" ? row.assigned_to : null,
        };
    }
    function renderTeamChat() {
