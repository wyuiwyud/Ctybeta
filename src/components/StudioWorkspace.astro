    function escapeText(text: string) {
        return text.replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                })[c] || c,
        );
    }
    function setVisible(node: HTMLElement | null, show: boolean) {
