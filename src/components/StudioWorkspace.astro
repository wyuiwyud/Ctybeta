    };
    type ChatAttachment = {
        name: string;
        type: string;
        size: number;
        dataUrl: string;
    };
    type ChatMessage = {
        id: string;
        authorId: string;
        author: string;
        role: string;
        text: string;
        time: string;
        file?: ChatAttachment;
    };
    type StudioState = {
        messages: ChatMessage[];
    };
    const sharedStorageKey = "adolsoft.virtual-studio.v2";
    const MAX_CHAT_FILE_BYTES = 128 * 1024;
    const MAX_CHAT_MESSAGES = 24;

    const supabaseUrl =
        import.meta.env.PUBLIC_SUPABASE_URL ||
        "https://itvhisblbyhsdtpfyghc.supabase.co";
    const supabaseAnonKey =
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml0dmhpc2JsYnloc2R0cGZ5Z2hjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ0MDg4NjEsImV4cCI6MjEwOTk4NDg2MX0.KJw-6KtVsOrXBzOLmJXQ9rgZFUFOP9Yn3VdQuKSV-jw";
    const supabase =
        supabaseUrl && supabaseAnonKey
            ? createClient(supabaseUrl, supabaseAnonKey)
            : null;

    const memberRoles = new Set<Role>([
        "admin",
        "senior",
        "tech",
        "data",
        "finance",
    ]);

    function parseMemberProfile(value: unknown): Member | null {
        if (!value || typeof value !== "object") return null;
        const row = value as Record<string, unknown>;
        if (
            typeof row.id !== "string" ||
            typeof row.name !== "string" ||
            typeof row.role !== "string" ||
            !memberRoles.has(row.role as Role) ||
            typeof row.label !== "string" ||
            typeof row.initials !== "string" ||
            typeof row.member_code !== "string" ||
            typeof row.room !== "string" ||
            typeof row.subtitle !== "string" ||
            typeof row.color !== "string" ||
            !Array.isArray(row.access) ||
            !row.access.every((item) => typeof item === "string")
        ) {
            return null;
        }
        return {
            id: row.id,
            code: row.member_code,
            name: row.name,
            role: row.role as Role,
            label: row.label,
            initials: row.initials,
            room: row.room,
            subtitle: row.subtitle,
            color: row.color,
            access: row.access as string[],
        };
    }

    async function getMemberProfile(userId: string): Promise<Member> {
        if (!supabase) throw new Error("Supabase chưa được cấu hình.");
        const { data, error } = await supabase
            .from("studio_members")
            .select(
                "id, member_code, name, role, label, initials, room, subtitle, color, access",
            )
            .eq("id", userId)
            .maybeSingle();
        if (error) throw error;
        const profile = parseMemberProfile(data);
        if (!profile) throw new Error("Tài khoản chưa có hồ sơ thành viên.");
        return profile;
    }

    async function syncMessagesFromSupabase() {
        if (!supabase) return;
        try {
            const { data, error } = await supabase
                .from("studio_messages")
                .select("*")
                .order("created_at", { ascending: true })
                .limit(MAX_CHAT_MESSAGES);
            if (!error && Array.isArray(data)) {
                const dbMessages: ChatMessage[] = data.map((row: any) => ({
                    id: String(row.id),
                    authorId: row.author_id,
                    author: row.author,
                    role: row.role,
                    text: row.text || "",
                    time: row.time,
                    file: row.file || undefined,
                }));
                const dbIds = new Set(dbMessages.map((m) => m.id));
                const pendingLocal = studioState.messages.filter(
                    (m) => !dbIds.has(m.id) && m.authorId === member?.id,
                );
                const nextMessages = [...dbMessages, ...pendingLocal].slice(
                    -MAX_CHAT_MESSAGES,
                );

                const currentIds = studioState.messages.map((m) => m.id).join(",");
                const nextIds = nextMessages.map((m) => m.id).join(",");

                if (currentIds !== nextIds || studioState.messages.length !== nextMessages.length) {
                    const oldIds = new Set(studioState.messages.map((m) => m.id));
                    const newRemoteMsg = nextMessages.find(
                        (m) => !oldIds.has(m.id) && member && m.authorId !== member.id,
                    );
                    studioState.messages = nextMessages;
                    try {
                        localStorage.setItem(sharedStorageKey, JSON.stringify(studioState));
                    } catch {}
                    renderTeamChat();
                    if (newRemoteMsg) {
                        tell(`Tin nhắn mới từ ${newRemoteMsg.author}.`);
                    }
                }
            } else if (error) {
                console.warn("Supabase fetch warning:", error.message);
            }
        } catch (e) {
            console.error("Supabase sync error:", e);
        }
    }
    const initialState: StudioState = { messages: [] };
