    .member-profile > div:last-child {
        display: grid;
        gap: 5px;
    }
    .member-profile b {
        color: #dcebf2;
        font:
            700 9px "Space Grotesk",
            sans-serif;
    }
    .member-profile small {
        color: #71899a;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .member-profile small i {
        display: inline-block;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #5de7a3;
    }
    .profile-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
        gap: 8px 3px;
        margin-top: 16px;
        padding: 12px 0;
        border-top: 1px solid #ffffff13;
        border-bottom: 1px solid #ffffff13;
    }
    .profile-stats span {
        color: #698196;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .profile-stats b {
        color: #b9ccd8;
        font:
            7px "IBM Plex Mono",
            monospace;
    }
    .logout-button {
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-top: auto;
        padding: 10px 11px;
        border: 1px solid #f7768752;
        border-radius: 5px;
        color: #ff98a1;
        font:
            8px "IBM Plex Mono",
            monospace;
    }
    .logout-button:hover {
        background: #e95a6917;
    }
    .sidebar-foot {
        margin: 12px 0 0;
        color: #526b7e;
        font:
            6px "IBM Plex Mono",
            monospace;
        letter-spacing: 0.1em;
    }
    .room-main {
        min-width: 0;
    }
    .room-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 15px;
        min-height: 82px;
        margin: 0 2px 13px;
    }
    .room-heading .eyebrow {
        margin: 0 0 7px;
    }
    .room-heading h1 {
        margin: 0;
        color: #f0f8fc;
        font:
            700 clamp(25px, 3vw, 37px)/1 "Space Grotesk",
            sans-serif;
        letter-spacing: 0;
    }
    .room-heading h1 span {
        color: var(--studio-accent);
    }
    .room-heading p {
        margin: 7px 0 0;
        color: #7d95a8;
        font:
            8px "IBM Plex Mono",
            monospace;
    }
    .room-clock {
        display: grid;
        gap: 5px;
        min-width: 90px;
        text-align: right;
    }
    .room-clock span {
        color: #657e91;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .room-clock b {
        color: var(--studio-accent);
        font:
            700 14px "IBM Plex Mono",
            monospace;
    }
    .collection-stage {
        position: relative;
        min-height: 213px;
        padding: 13px 15px 10px;
        overflow: hidden;
    }
    .collection-meta {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: #7390a4;
        font-size: 7px;
    }
    .project-rail {
        position: relative;
        display: flex;
        align-items: center;
        gap: clamp(6px, 1.3vw, 17px);
        height: 147px;
        padding: 8px 10px 3px;
        overflow: hidden;
        perspective: 900px;
    }
    .project-card {
        position: relative;
        flex: 1 1 0;
        min-width: 95px;
        max-width: 170px;
        height: 119px;
        padding: 9px;
        overflow: hidden;
        border: 1px solid
            color-mix(in srgb, var(--studio-accent) 55%, #b5e5ff55);
        border-radius: 8px;
        background: linear-gradient(
            150deg,
            color-mix(in srgb, var(--card-color) 45%, #102136),
            #07111d 75%
        );
        box-shadow:
            0 8px 16px #0008,
            0 0 16px color-mix(in srgb, var(--card-color) 35%, transparent),
            inset 0 1px #ffffff50;
        transform: rotateY(-13deg) rotateX(4deg);
        transition:
            transform 0.28s,
            box-shadow 0.28s;
    }
    .project-card:nth-child(even) {
        transform: translateY(-13px) rotateY(9deg) rotateX(-2deg);
    }
    .project-card:hover {
        z-index: 2;
        transform: translateY(-9px) scale(1.05);
        box-shadow:
            0 14px 24px #0009,
            0 0 24px color-mix(in srgb, var(--card-color) 60%, transparent),
            inset 0 1px #ffffff70;
    }
    .project-card::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
            115deg,
            #ffffff24,
            transparent 24% 72%,
            #ffffff15
        );
    }
    .project-card small {
        position: relative;
        z-index: 1;
        color: #bad5e2;
        font:
            6px "IBM Plex Mono",
            monospace;
        letter-spacing: 0.1em;
    }
    .project-card b {
        position: absolute;
        z-index: 1;
        left: 9px;
        right: 7px;
        bottom: 11px;
        color: #effaff;
        font:
            700 clamp(9px, 1vw, 12px) "Space Grotesk",
            sans-serif;
        text-shadow: 0 2px 8px #000;
    }
    .project-card span {
        position: absolute;
        right: 9px;
        top: 30px;
        color: var(--card-color);
        font:
            700 27px "Space Grotesk",
            sans-serif;
        text-shadow: 0 0 15px var(--card-color);
        opacity: 0.92;
    }
    .timeline {
        display: flex;
        align-items: center;
        gap: 7px;
        height: 21px;
        color: #59778e;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .timeline i {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, #6dbbdb55, #b9dbe255);
    }
    .timeline i::after {
        content: "";
        display: block;
        width: 4px;
        height: 4px;
        margin-top: -2px;
        border-radius: 50%;
        background: #c8f3ff;
        box-shadow: 0 0 7px #68d7ff;
    }
    .room-content {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 10px;
        margin-top: 11px;
    }
    .data-panel {
        min-width: 0;
        padding: 13px;
        overflow: hidden;
        border: 1px solid #c7edff1c;
        border-radius: 8px;
        background: linear-gradient(145deg, #c2eaff10, #557e9908);
        box-shadow:
            inset 0 1px #ffffff09,
            0 10px 22px #0002;
        backdrop-filter: blur(18px);
    }
    .data-panel h3 {
        margin: 5px 0 10px;
        color: #e9f7fd;
        font:
            700 13px "Space Grotesk",
            sans-serif;
    }
    .data-panel > small,
    .panel-label {
        color: var(--studio-accent);
        font:
            6px "IBM Plex Mono",
            monospace;
        letter-spacing: 0.13em;
    }
    .panel-span-4 {
        grid-column: span 4;
    }
    .panel-span-5 {
        grid-column: span 5;
    }
    .panel-span-6 {
        grid-column: span 6;
    }
    .panel-span-7 {
        grid-column: span 7;
    }
    .panel-span-8 {
        grid-column: span 8;
    }
    .panel-span-12 {
        grid-column: span 12;
    }
    .task-list {
        display: grid;
        gap: 7px;
    }
    .task-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        padding: 8px;
        border: 1px solid #d9f4ff11;
        border-radius: 5px;
        background: #06111c91;
    }
    .task-item b {
        display: block;
        color: #d7e7ef;
        font:
            8px/1.4 "Space Grotesk",
            sans-serif;
    }
    .task-item small {
        display: block;
        margin-top: 4px;
        color: #698196;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .task-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    .task-actions button,
    .small-action {
        padding: 5px 6px;
        border: 1px solid
            color-mix(in srgb, var(--studio-accent) 32%, transparent);
        border-radius: 4px;
        color: var(--studio-accent);
        background: #ffffff05;
        font:
            6px "IBM Plex Mono",
            monospace;
        white-space: nowrap;
    }
    .task-actions button:hover,
    .small-action:hover {
        background: color-mix(in srgb, var(--studio-accent) 15%, transparent);
    }
    .feed-form {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px;
        margin-bottom: 9px;
    }
    .feed-form input,
    .feed-form select {
        min-width: 0;
        padding: 8px;
        border: 1px solid #e1f3ff24;
        border-radius: 4px;
        outline: 0;
        color: #e3f5fd;
        background: #07111c;
        font:
            7px "IBM Plex Mono",
            monospace;
    }
    .feed-form input:focus {
        border-color: var(--studio-accent);
    }
    .feed-form button {
        grid-row: span 2;
        padding: 0 10px;
        border-radius: 4px;
        color: #07101a;
        background: var(--studio-accent);
        font:
            700 7px "IBM Plex Mono",
            monospace;
    }
    .feed-form select {
        grid-column: 1;
    }
    .feed-item {
        padding: 7px 0;
        border-top: 1px solid #ffffff12;
        color: #acc0ce;
        font:
            8px/1.5 "Space Grotesk",
            sans-serif;
    }
    .feed-item b {
        display: block;
        margin-bottom: 3px;
        color: var(--studio-accent);
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .metric-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }
    .metric {
        display: grid;
        gap: 5px;
        padding: 8px 6px;
        border: 1px solid #ffffff10;
        border-radius: 4px;
        background: #d1f1ff07;
    }
    .metric span {
        color: #71899c;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .metric b {
        color: var(--studio-accent);
        font:
            700 clamp(13px, 1.7vw, 21px) "Space Grotesk",
            sans-serif;
    }
    .health-row,
    .ledger-row,
    .invoice-row,
    .inventory-row,
    .lead-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 0;
        border-top: 1px solid #ffffff12;
        color: #a9bdc9;
        font:
            7px "IBM Plex Mono",
            monospace;
    }
    .health-row b {
        color: #63e7ad;
        font-size: 6px;
    }
    .health-row b.warn {
        color: #f7c970;
    }
    .invoice-row b,
    .ledger-row b,
    .inventory-row b {
        color: #e1edf2;
    }
    .pill {
        padding: 3px 5px;
        border: 1px solid
            color-mix(in srgb, var(--studio-accent) 35%, transparent);
        border-radius: 3px;
        color: var(--studio-accent);
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .bar-chart {
        display: flex;
        align-items: end;
        gap: 6px;
        height: 83px;
        margin-top: 10px;
        padding: 0 8px;
        border-bottom: 1px solid #ffffff28;
        background: repeating-linear-gradient(
            to bottom,
            transparent 0 20px,
            #ffffff0a 21px
        );
    }
    .bar-chart i {
        flex: 1;
        min-height: 6px;
        border-radius: 3px 3px 0 0;
        background: linear-gradient(
            to top,
            color-mix(in srgb, var(--studio-accent) 22%, transparent),
            var(--studio-accent)
        );
        box-shadow: 0 0 12px
            color-mix(in srgb, var(--studio-accent) 32%, transparent);
    }
    .bar-labels {
        display: flex;
        justify-content: space-between;
        margin: 5px 4px 0;
        color: #647d8e;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .text-entry {
        margin: 7px 0;
        padding: 7px 8px;
        border-left: 2px solid var(--studio-accent);
        color: #b4c7d2;
        background: #c6efff08;
        font:
            8px/1.45 "Space Grotesk",
            sans-serif;
    }
    .text-entry small {
        display: block;
        margin-top: 4px;
        color: #70879a;
        font:
            6px "IBM Plex Mono",
            monospace;
    }
    .module-content {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 11px;
    }
    .module-card {
        padding: 15px;
        border: 1px solid
            color-mix(in srgb, var(--studio-accent) 28%, transparent);
        border-radius: 8px;
        background: linear-gradient(145deg, #c2eaff12, #557e9908);
        backdrop-filter: blur(20px);
    }
    .module-card small {
        color: var(--studio-accent);
        font:
            7px "IBM Plex Mono",
            monospace;
    }
    .module-card h3 {
        margin: 8px 0;
        color: #edf8fc;
        font:
            700 14px "Space Grotesk",
            sans-serif;
    }
    .module-card p {
        color: #8ca1af;
        font:
            8px/1.6 "IBM Plex Mono",
            monospace;
    }
    .module-card button {
        margin-top: 8px;
        color: var(--studio-accent);
        font:
            7px "IBM Plex Mono",
            monospace;
    }
    .studio-toast {
        min-height: 15px;
        margin: 5px 2px;
        color: var(--studio-accent);
        font:
            8px "IBM Plex Mono",
            monospace;
    }
    .room-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin: 5px 2px 0;
        padding: 9px 0;
        border-top: 1px solid #ffffff15;
        font-size: 6px;
    }
    .room-footer b {
        color: #b4cad8;
    }
    .room-content[data-role="admin"] .data-panel {
        border-color: #c8ff0030;
    }
    .room-content[data-role="senior"] .data-panel {
        border-color: #00f0ff2d;
    }
    .room-content[data-role="tech"] .data-panel {
        border-color: #f59e0b35;
    }
    .room-content[data-role="data"] .data-panel {
        border-color: #a855f735;
    }
    .room-content[data-role="finance"] .data-panel {
        border-color: #10b98135;
    }
    @keyframes glass-rise {
        from {
            opacity: 0;
            transform: translateY(12px) scale(0.985);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    @media (max-width: 1000px) {
        .workspace-layout {
            grid-template-columns: 205px minmax(0, 1fr);
            padding: 11px;
            gap: 11px;
        }
        .player-sidebar {
            min-height: 620px;
            padding-inline: 12px;
        }
        .panel-span-4,
        .panel-span-5 {
            grid-column: span 6;
        }
        .project-card {
            min-width: 86px;
        }
    }
    @media (max-width: 720px) {
        .studio-overlay {
            align-items: flex-start;
            padding: 8px;
        }
        .auth-shell {
            grid-template-columns: 1fr;
            min-height: unset;
        }
        .auth-art {
            min-height: 250px;
            padding: 24px;
        }
        .auth-art .crest {
            width: 58px;
            margin-bottom: 14px;
        }
        .crest span {
            font-size: 30px;
        }
        .art-title {
            margin: 10px 0 14px;
            font-size: 36px;
        }
        .trophy-stack {
            max-width: 360px;
        }
        .trophy-stack > div {
            padding: 6px;
        }
        .art-foot {
            margin-top: 15px;
        }
        .auth-form {
            min-height: 390px;
            padding: 26px;
        }
        .workspace {
            max-height: calc(100vh - 16px);
        }
        .topbar {
            flex-wrap: wrap;
            padding: 9px 12px;
        }
        .brand small {
            display: none;
        }
        .module-nav {
            order: 3;
            width: 100%;
            justify-content: center;
            border-top: 1px solid #ffffff12;
            padding-top: 7px;
        }
        .top-actions {
            margin-left: auto;
        }
        .network-state {
            font-size: 6px;
        }
        .workspace-layout {
            grid-template-columns: 1fr;
        }
        .player-sidebar {
            display: grid;
            grid-template-columns: 58px 1fr auto;
            align-items: center;
            gap: 4px 10px;
            min-height: unset;
            padding: 10px;
        }
        .player-sidebar::before,
        .player-topline,
        .medal-row,
        .level-row,
        .profile-divider,
        .profile-stats,
        .sidebar-foot {
            display: none;
        }
        .member-crest {
            grid-row: span 2;
            width: 52px;
            height: 52px;
            margin: 0;
        }
        .crest-ring {
            width: 43px;
        }
        .crest-ring::before {
            width: 51px;
            height: 51px;
        }
        .crest-ring span {
            font-size: 15px;
        }
        .crest-spark {
            width: 4px;
            height: 4px;
        }
        .player-sidebar h2 {
            align-self: end;
            margin: 0;
            font-size: 12px;
        }
        .member-role {
            align-self: start;
            justify-self: start;
            font-size: 6px;
        }
        .player-score {
            display: none;
        }
        .member-profile {
            grid-column: 3;
            grid-row: 1 / span 2;
            width: auto;
        }
        .member-profile .avatar {
            width: 29px;
        }
        .member-profile > div:last-child {
            display: none;
        }
        .logout-button {
            grid-column: 1 / -1;
            margin: 6px 0 0;
            padding: 7px 9px;
        }
        .room-heading {
            min-height: 65px;
        }
        .room-heading h1 {
            font-size: 25px;
        }
        .collection-stage {
            min-height: 180px;
            padding: 11px;
        }
        .project-rail {
            height: 122px;
            overflow-x: auto;
        }
        .project-card {
            flex: 0 0 105px;
            height: 100px;
        }
