            if (status) status.textContent = "Không tải được dữ liệu";
            return;
        }
        const clients = visibleClients();
        const projects = visibleProjects();
        const averageProgress = projects.length
            ? Math.round(
                  projects.reduce(
                      (sum, project) => sum + project.progress,
                      0,
                  ) / projects.length,
              )
            : 0;
        if (clientCount) clientCount.textContent = String(clients.length);
        if (projectCount) projectCount.textContent = String(projects.length);
        if (progressValue) progressValue.textContent = `${averageProgress}%`;
        if (status) status.textContent = "Đã đồng bộ từ Supabase";
