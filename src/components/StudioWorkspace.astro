    function toggleMapOverview() {
        if (isMapOverviewOpen) {
            closeMapOverview();
        } else {
            openMapOverview();
        }
    }

    function resizeInteractiveCanvas() {
        if (!canvasEl) return;
        const rect = canvasEl.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;
        migrateLegacyCanvasData(rect.width, rect.height);
        canvasDpr = window.devicePixelRatio || 1;
        canvasEl.width = Math.round(rect.width * canvasDpr);
        canvasEl.height = Math.round(rect.height * canvasDpr);
        redrawCanvas();
    }

    function redrawCanvas() {
        if (!canvasEl || !canvasCtx) return;
        const rect = canvasEl.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;
        canvasCtx.save();
        canvasCtx.setTransform(1, 0, 0, 1, 0, 0);
        canvasCtx.clearRect(0, 0, canvasEl.width, canvasEl.height);
        canvasCtx.scale(canvasDpr, canvasDpr);

        for (const stroke of canvasStrokes) {
            drawSingleStroke(stroke, rect.width, rect.height);
        }
        if (currentDrawingStroke) {
            drawSingleStroke(currentDrawingStroke, rect.width, rect.height);
        }
        canvasCtx.restore();
    }

    function drawSingleStroke(
        stroke: CanvasStroke,
        width: number,
        height: number,
    ) {
        if (!canvasCtx || stroke.points.length === 0) return;
        const lineWidth = stroke.width * Math.min(width, height);
        canvasCtx.save();
        if (stroke.tool === "eraser") {
            canvasCtx.globalCompositeOperation = "destination-out";
            canvasCtx.strokeStyle = "rgba(0,0,0,1)";
            canvasCtx.lineWidth = lineWidth;
        } else {
            canvasCtx.globalCompositeOperation = "source-over";
            canvasCtx.strokeStyle = stroke.color;
            canvasCtx.lineWidth = lineWidth;
        }
        canvasCtx.lineCap = "round";
        canvasCtx.lineJoin = "round";

        const pts = stroke.points;
        if (pts.length === 1) {
            canvasCtx.fillStyle = stroke.tool === "eraser" ? "rgba(0,0,0,1)" : stroke.color;
            canvasCtx.beginPath();
            canvasCtx.arc(
                pts[0].x * width,
                pts[0].y * height,
                lineWidth / 2,
                0,
                Math.PI * 2,
            );
            canvasCtx.fill();
        } else {
            canvasCtx.beginPath();
            canvasCtx.moveTo(pts[0].x * width, pts[0].y * height);
            for (let i = 1; i < pts.length; i++) {
                canvasCtx.lineTo(pts[i].x * width, pts[i].y * height);
            }
            canvasCtx.stroke();
        }
        canvasCtx.restore();
    }

    function initInteractiveCanvas() {
        canvasEl = document.getElementById("interactive-canvas") as HTMLCanvasElement;
        canvasMapOverviewEl = document.getElementById("canvas-map-overview");
        mapGridEl = document.getElementById("map-grid-25");
        toolMapToggle = document.getElementById("tool-map-toggle");
        mapToggleLabel = document.getElementById("map-toggle-label");
        currentBoardBadge = document.getElementById("current-board-badge");
        const mapCloseBtn = document.getElementById("map-close-btn");

        if (!canvasEl) return;
        canvasCtx = canvasEl.getContext("2d");
        canvasConflictDialog = document.getElementById(
            "canvas-conflict-dialog",
        ) as HTMLDialogElement | null;
        document
            .getElementById("canvas-conflict-use-cloud")
            ?.addEventListener("click", () =>
                pendingCanvasConflictResolver?.("cloud"),
            );
        document
            .getElementById("canvas-conflict-keep-local")
            ?.addEventListener("click", () =>
                pendingCanvasConflictResolver?.("local"),
            );
        canvasConflictDialog?.addEventListener("cancel", (event) => {
            event.preventDefault();
        });

        const penBtn = document.getElementById("tool-pen");
        const eraserBtn = document.getElementById("tool-eraser");
        const undoBtn = document.getElementById("tool-undo");
        const clearBtn = document.getElementById("tool-clear");
        const modeToggle = document.getElementById("canvas-mode-toggle");
        const modeLabel = document.getElementById("canvas-mode-label");
        const colorDots = document.querySelectorAll<HTMLButtonElement>(".color-dot");

        function undoLastStroke() {
            if (canvasStrokes.length === 0) {
                tell("Không có nét vẽ nào để hoàn tác.");
                return;
            }
            canvasStrokes.pop();
            redrawCanvas();
            saveCanvasState(false);
            tell("Đã hoàn tác (Ctrl + Z).");
        }

        function setCanvasTool(tool: "pen" | "eraser") {
            canvasTool = tool;
            for (const button of [penBtn, eraserBtn]) {
                if (!button) continue;
                const active = button.dataset.tool === tool;
                button.classList.toggle("is-active", active);
                button.setAttribute("aria-pressed", String(active));
            }
        }

        penBtn?.addEventListener("click", () => setCanvasTool("pen"));
        eraserBtn?.addEventListener("click", () => setCanvasTool("eraser"));

        undoBtn?.addEventListener("click", () => {
            undoLastStroke();
        });

        toolMapToggle?.addEventListener("click", () => {
            toggleMapOverview();
        });

        mapCloseBtn?.addEventListener("click", () => {
            closeMapOverview();
        });

        // Admin live monitoring and view tabs listeners
        document.getElementById("monitor-exit-btn")?.addEventListener("click", () => {
            exitAdminMonitoring();
        });

        document.getElementById("monitor-view-map-btn")?.addEventListener("click", () => {
            openMapOverview();
        });

        const memberSelect = document.getElementById("admin-target-member-select") as HTMLSelectElement | null;
        memberSelect?.addEventListener("change", (e) => {
            if (isMonitoringMember) exitAdminMonitoring();
            selectedOtherMemberId = (e.target as HTMLSelectElement).value;
            subscribeTeamCanvas(selectedOtherMemberId);
            renderMapGrid();
            if (selectedOtherMemberId === "own") {
                tell("Đang hiển thị 25 bảng vẽ cá nhân của bạn.");
            } else {
                void fetchMemberCanvasesFromSupabase(selectedOtherMemberId);
                const memberObj = OTHER_MEMBERS[selectedOtherMemberId];
                if (memberObj)
                    tell(`Đang hiển thị 25 bảng của ${memberObj.name} (${memberObj.role}).`);
            }
        });

        colorDots.forEach((dot) => {
            dot.addEventListener("click", () => {
                const color = dot.dataset.color;
                if (color) {
                    canvasPenColor = color;
                    colorDots.forEach((d) => {
                        d.classList.remove("is-active");
                        d.setAttribute("aria-pressed", "false");
                    });
                    dot.classList.add("is-active");
                    dot.setAttribute("aria-pressed", "true");
                }
            });
        });

        clearBtn?.addEventListener("click", () => {
            const boardId = getDisplayedCanvasBoardId();
            if (canvasStrokes.length === 0) {
                tell(`Bảng #${String(boardId).padStart(2, "0")} hiện đang trống.`);
                return;
            }
            if (confirm(`Bạn có chắc muốn xoá sạch toàn bộ nét vẽ của Bảng #${String(boardId).padStart(2, "0")}?`)) {
                canvasStrokes = [];
                if (!isMonitoringMember) boardsStrokes[currentBoardId] = [];
                redrawCanvas();
                saveCanvasState(false);
                tell(`Đã dọn sạch toàn bộ nét vẽ của Bảng #${String(boardId).padStart(2, "0")}.`);
            }
        });


        function setDrawingMode(isDrawing: boolean) {
            isCanvasDrawingMode = isDrawing;
            if (!canvasEl || !modeToggle || !modeLabel) return;
            const slider = document.getElementById("canvas-mode-slider");
            const knob = slider?.querySelector<HTMLElement>(".osom-toggle-knob");

            if (isDrawing) {
                canvasEl.classList.remove("is-viewing");
                canvasEl.classList.add("is-drawing");
                modeToggle.classList.remove("is-view-mode");
                modeToggle.setAttribute("aria-checked", "true");
                modeLabel.textContent = "Chế độ vẽ";
                if (knob) knob.style.transform = "translateX(20px)";
                tell("Đã chuyển: Chế độ vẽ");
            } else {
                canvasEl.classList.remove("is-drawing");
                canvasEl.classList.add("is-viewing");
                modeToggle.classList.add("is-view-mode");
                modeToggle.setAttribute("aria-checked", "false");
                modeLabel.textContent = "Chế độ xem";
                if (knob) knob.style.transform = "translateX(2px)";
                tell("Đã chuyển: Chế độ xem (Khoá vẽ)");
            }
        }

        modeToggle?.addEventListener("click", () => {
            setDrawingMode(!isCanvasDrawingMode);
        });

        // Pointer event listeners on Canvas for smooth drawing
        canvasEl.addEventListener("pointerdown", (e) => {
            if (!isCanvasDrawingMode || !canvasEl || isMapOverviewOpen) return;
            const rect = canvasEl.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;
            migrateLegacyCanvasData(rect.width, rect.height);
            isDrawingActive = true;
            canvasEl.setPointerCapture(e.pointerId);
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;

            currentDrawingStroke = {
                tool: canvasTool,
                color: canvasPenColor,
                width:
                    (canvasTool === "eraser"
                        ? canvasEraserWidth
                        : canvasPenWidth) / Math.min(rect.width, rect.height),
                points: [{ x, y }],
            };

            redrawCanvas();
        });

        canvasEl.addEventListener("pointermove", (e) => {
            if (!isDrawingActive || !currentDrawingStroke || !canvasEl || isMapOverviewOpen) return;
            const rect = canvasEl.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;

            currentDrawingStroke.points.push({ x, y });
            redrawCanvas();
        });

        const stopDrawing = (e: PointerEvent) => {
            if (!isDrawingActive || !canvasEl) return;
            isDrawingActive = false;
            if (canvasEl.hasPointerCapture(e.pointerId)) {
                canvasEl.releasePointerCapture(e.pointerId);
            }

            if (currentDrawingStroke && currentDrawingStroke.points.length > 0) {
                canvasStrokes.push(currentDrawingStroke);
                currentDrawingStroke = null;
                saveCanvasState(false);
            }
            redrawCanvas();
        };

        canvasEl.addEventListener("pointerup", stopDrawing);
        canvasEl.addEventListener("pointercancel", stopDrawing);

        // Keyboard shortcuts: Ctrl + Z (Undo), M (Toggle Map Overview)
        document.addEventListener("keydown", (e) => {
            const activeTag = document.activeElement?.tagName.toLowerCase();
            if (
                !member ||
                !workspace.classList.contains("visible") ||
                activeTag === "input" ||
                activeTag === "textarea"
            ) {
                return;
            }

            // Undo: Ctrl + Z or Cmd + Z
            if ((e.ctrlKey || e.metaKey) && (e.key === "z" || e.key === "Z")) {
                e.preventDefault();
                undoLastStroke();
                return;
            }

            // M: Toggle 25 Boards Map Overview
            if (e.key === "m" || e.key === "M") {
                e.preventDefault();
                toggleMapOverview();
                return;
            }

            if (e.key === "Escape" && isMapOverviewOpen) {
                e.preventDefault();
                closeMapOverview();
                return;
            }

            if (e.key === "p" || e.key === "P") {
                setCanvasTool("pen");
                return;
            }
            if (e.key === "e" || e.key === "E") {
                setCanvasTool("eraser");
            }
        });

        // ResizeObserver on canvas container for perfect responsiveness
        const centerCard = document.getElementById("osom-center-stage");
        if (centerCard && window.ResizeObserver) {
            const ro = new ResizeObserver(() => {
                resizeInteractiveCanvas();
            });
            ro.observe(centerCard);
        }

        window.addEventListener("resize", () => {
            resizeInteractiveCanvas();
        });
        window.addEventListener("online", () => {
            if (pendingCanvasBoards.size > 0) scheduleCanvasSync();
        });

        // Initial setup
        loadCanvasForUser(member ? member.id : "guest");
        setTimeout(resizeInteractiveCanvas, 100);
    }

    // Initialize Interactive Canvas
    initInteractiveCanvas();

    // ==========================================
    // 🎨 ADMIN STUDIO FOR AUTH FRAMES MANAGEMENT
    // ==========================================
    const DEFAULT_AUTH_FRAMES: Record<string, string> = {
        portrait: "/assets/neo_design/portrait_clean.png",
        avatar: "/assets/neo_design/r_avatar_clean.png",
        af02: "/assets/neo_design/r_af02_clean.png",
        stamp: "/assets/neo_design/r_ts24_clean.png",
        cyber: "/assets/neo_design/r_cyber_clean.png",
        phone: "/assets/neo_design/r_phone_clean.png",
        peach: "",
        backdrop: "",
    };

    const AUTH_FRAMES_STORAGE_KEY = "adolsoft_auth_custom_frames_v1";
    const AUTH_FRAMES_BUCKET = "studio-auth-frames";
    const AUTH_FRAMES_MAX_BYTES = 5 * 1024 * 1024;
    const AUTH_FRAME_KEYS = [
        "portrait",
        "avatar",
        "af02",
        "stamp",
        "cyber",
        "phone",
        "peach",
        "backdrop",
    ] as const;
    type AuthFrameSlot = (typeof AUTH_FRAME_KEYS)[number];
    const AUTH_FRAME_MIME_TYPES = new Set([
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/gif",
        "image/avif",
    ]);
    let authFramesSyncGeneration = 0;

    function isAuthFrameSlot(value: string): value is AuthFrameSlot {
        return AUTH_FRAME_KEYS.includes(value as AuthFrameSlot);
    }

    function getCustomAuthFrames(): Record<string, string> {
        try {
            const raw = localStorage.getItem(AUTH_FRAMES_STORAGE_KEY);
            if (!raw) return {};
            const parsed: unknown = JSON.parse(raw);
            if (!parsed || typeof parsed !== "object") return {};
            const frames: Record<string, string> = {};
            for (const slot of AUTH_FRAME_KEYS) {
                const image = (parsed as Record<string, unknown>)[slot];
                if (typeof image === "string") frames[slot] = image;
            }
            return frames;
        } catch (error) {
            console.error("Cannot read custom auth frames from localStorage:", error);
            tell("Không thể đọc bộ ảnh Studio đã lưu trên thiết bị.");
            return {};
        }
    }

    function saveCustomAuthFrames(frames: Record<string, string>) {
        try {
            localStorage.setItem(AUTH_FRAMES_STORAGE_KEY, JSON.stringify(frames));
            return true;
        } catch (error) {
            console.error("Cannot cache custom auth frames locally:", error);
            tell("Không thể lưu bộ ảnh dự phòng trên thiết bị.");
            return false;
        }
    }

    function applyAuthFrameImages(
        customFrames = getCustomAuthFrames(),
    ) {
        AUTH_FRAME_KEYS.forEach((key) => {
            const imgSrc = customFrames[key] || DEFAULT_AUTH_FRAMES[key];

            if (key === "backdrop") {
                const backdropImg = document.getElementById("auth-backdrop-bg-img") as HTMLImageElement | null;
                if (backdropImg) {
                    if (imgSrc) {
                        backdropImg.src = imgSrc;
                        backdropImg.style.display = "block";
                    } else {
                        backdropImg.removeAttribute("src");
                        backdropImg.style.display = "none";
                    }
                }
            }

            const frameEl = document.getElementById(`auth-frame-${key}`);
            if (frameEl) {
                if (key === "peach") {
                    // Peach main card background image
                    const bgImg = document.getElementById("auth-peach-bg-img") as HTMLImageElement | null;
                    if (bgImg) {
                        if (imgSrc) {
                            bgImg.src = imgSrc;
                            bgImg.style.display = "block";
                        } else {
                            bgImg.removeAttribute("src");
                            bgImg.style.display = "none";
                        }
                    }
                } else if (frameEl.tagName.toLowerCase() === "img") {
                    if (imgSrc) (frameEl as HTMLImageElement).src = imgSrc;
                } else {
                    const img = frameEl.querySelector("img");
                    if (img && imgSrc) img.src = imgSrc;
                }
            }

            const previewEl = document.getElementById(
                `slot-preview-${key}`,
            ) as HTMLImageElement | null;
            if (previewEl) {
                if ((key === "peach" || key === "backdrop") && !imgSrc) {
                    previewEl.src = "";
                } else if (imgSrc) {
                    previewEl.src = imgSrc;
                }
            }

            const statusEl = document.getElementById(`slot-status-${key}`);
            if (statusEl) {
                if (customFrames[key]) {
                    statusEl.textContent = "✦ Đã thay đổi";
                    statusEl.classList.add("customized");
                } else {
                    statusEl.textContent = "Mặc định";
                    statusEl.classList.remove("customized");
                }
            }
        });
    }

    function getAuthFramePublicUrl(path: string, version: string) {
        if (!supabase) return path;
        const url = supabase.storage
            .from(AUTH_FRAMES_BUCKET)
            .getPublicUrl(path).data.publicUrl;
        return `${url}${url.includes("?") ? "&" : "?"}v=${encodeURIComponent(version)}`;
    }

    async function uploadAuthFrameObject(
        slot: AuthFrameSlot,
        file: Blob,
        contentType: string,
    ) {
        if (!supabase || member?.role !== "admin")
            throw new Error("Chỉ Admin mới được đồng bộ ảnh Studio.");
        const objectPath = `frames/${slot}`;
        const { error: uploadError } = await supabase.storage
            .from(AUTH_FRAMES_BUCKET)
            .upload(objectPath, file, {
                cacheControl: "0",
                contentType,
                upsert: true,
            });
        if (uploadError) throw uploadError;

        const updatedAt = new Date().toISOString();
        const { error: metadataError } = await supabase
            .from("studio_auth_frames")
            .upsert(
                {
                    slot,
                    object_path: objectPath,
                    updated_by: member.id,
                    updated_at: updatedAt,
                },
                { onConflict: "slot" },
            );
        if (metadataError) throw metadataError;
        return getAuthFramePublicUrl(objectPath, updatedAt);
    }

    async function syncAuthFramesFromSupabase() {
        if (!supabase) {
            applyAuthFrameImages();
            return;
        }
        const generation = ++authFramesSyncGeneration;
        const { data, error } = await supabase
            .from("studio_auth_frames")
            .select("slot, object_path, updated_at");
        if (error) {
            console.error("Could not load Studio images from Supabase:", error);
            if (member?.role === "admin")
                tell("Không tải được ảnh Studio từ Cloud. Hãy áp dụng migration đồng bộ Studio Ảnh.");
            applyAuthFrameImages();
            return;
        }

        const cachedFrames = getCustomAuthFrames();
        const cloudFrames: Record<string, string> = {};
        const cloudConfiguredSlots = new Set<AuthFrameSlot>();
        for (const row of data || []) {
            if (
                typeof row.slot !== "string" ||
                !isAuthFrameSlot(row.slot) ||
                typeof row.updated_at !== "string"
            )
                continue;
            cloudConfiguredSlots.add(row.slot);
            if (row.object_path === `frames/${row.slot}`) {
                cloudFrames[row.slot] = getAuthFramePublicUrl(
                    row.object_path,
                    row.updated_at,
                );
            }
        }

        if (member?.role === "admin") {
            for (const slot of AUTH_FRAME_KEYS) {
                const legacyDataUrl = cachedFrames[slot];
                if (
                    cloudConfiguredSlots.has(slot) ||
                    !legacyDataUrl?.startsWith("data:image/")
                )
                    continue;
                try {
                    const response = await fetch(legacyDataUrl);
                    if (!response.ok)
                        throw new Error("Không đọc được ảnh cũ trên thiết bị.");
                    const blob = await response.blob();
                    if (!AUTH_FRAME_MIME_TYPES.has(blob.type))
                        throw new Error("Định dạng ảnh cũ không được hỗ trợ.");
                    cloudFrames[slot] = await uploadAuthFrameObject(
                        slot,
                        blob,
                        blob.type,
                    );
                } catch (migrationError) {
                    console.error(
                        `Could not migrate local Studio image ${slot}:`,
                        migrationError,
                    );
                    tell(`Không thể đồng bộ ảnh ${slot} cũ lên Cloud.`);
                }
            }
        }
        if (generation !== authFramesSyncGeneration) return;

        const mergedFrames = { ...cloudFrames };
        for (const slot of AUTH_FRAME_KEYS) {
            if (
                !mergedFrames[slot] &&
                !cloudConfiguredSlots.has(slot) &&
                cachedFrames[slot]?.startsWith("data:image/")
            ) {
                mergedFrames[slot] = cachedFrames[slot];
            }
        }
        saveCustomAuthFrames(mergedFrames);
        applyAuthFrameImages(mergedFrames);
    }

    function readImageFileAsDataUrl(file: File): Promise<string> {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => {
                if (typeof reader.result === "string") resolve(reader.result);
                else reject(new Error("Không đọc được ảnh đã chọn."));
            };
            reader.onerror = () =>
                reject(reader.error || new Error("Không đọc được ảnh đã chọn."));
            reader.readAsDataURL(file);
        });
    }

    async function uploadStudioAuthFrame(slot: AuthFrameSlot, file: File) {
        if (member?.role !== "admin") {
            tell("Chỉ Admin mới được thay đổi ảnh Studio.");
            return;
        }
        if (!AUTH_FRAME_MIME_TYPES.has(file.type)) {
            tell("Ảnh chỉ hỗ trợ JPG, PNG, WebP, GIF hoặc AVIF.");
            return;
        }
        if (file.size > AUTH_FRAMES_MAX_BYTES) {
            tell("Ảnh vượt quá 5 MB. Vui lòng nén ảnh rồi thử lại.");
            return;
        }

        let fallbackDataUrl = "";
        try {
            fallbackDataUrl = await readImageFileAsDataUrl(file);
            const publicUrl = await uploadAuthFrameObject(
                slot,
                file,
                file.type,
            );
            const frames = getCustomAuthFrames();
            frames[slot] = publicUrl;
            saveCustomAuthFrames(frames);
            applyAuthFrameImages(frames);
            tell("Ảnh Studio đã được đồng bộ cho toàn bộ thiết bị.");
        } catch (error) {
            console.error("Could not upload Studio image:", error);
            if (fallbackDataUrl) {
                const frames = getCustomAuthFrames();
                frames[slot] = fallbackDataUrl;
                saveCustomAuthFrames(frames);
                applyAuthFrameImages(frames);
            }
            tell(
                "Không thể đồng bộ ảnh Studio lên Cloud. Ảnh chỉ được giữ cục bộ trên thiết bị này.",
            );
        }
    }

    async function clearStudioAuthFrame(slot: AuthFrameSlot) {
        if (!supabase || member?.role !== "admin") {
            tell("Chỉ Admin mới được thay đổi ảnh Studio.");
            return;
        }
        const adminId = member.id;
        try {
            const objectPath = `frames/${slot}`;
            const { error: metadataError } = await supabase
                .from("studio_auth_frames")
                .upsert(
                    {
                        slot,
                        object_path: null,
                        updated_by: adminId,
                        updated_at: new Date().toISOString(),
                    },
                    { onConflict: "slot" },
                );
            if (metadataError) throw metadataError;
            const { error: storageError } = await supabase.storage
                .from(AUTH_FRAMES_BUCKET)
                .remove([objectPath]);
            if (storageError) throw storageError;
            const frames = getCustomAuthFrames();
            delete frames[slot];
            saveCustomAuthFrames(frames);
            applyAuthFrameImages(frames);
            tell("Đã khôi phục ảnh mặc định và đồng bộ cho toàn bộ thiết bị.");
        } catch (error) {
            console.error("Could not clear Studio image:", error);
            tell("Không thể khôi phục ảnh mặc định trên Cloud.");
        }
    }

    async function resetStudioAuthFrames() {
        if (!supabase || member?.role !== "admin") {
            tell("Chỉ Admin mới được thay đổi ảnh Studio.");
            return;
        }
        const adminId = member.id;
        try {
            const { data, error } = await supabase
                .from("studio_auth_frames")
                .select("object_path");
            if (error) throw error;
            const objectPaths = (data || [])
                .map((row) => row.object_path)
                .filter(
                    (path): path is string =>
                        typeof path === "string" &&
                        path.startsWith("frames/"),
                );
            const clearedAt = new Date().toISOString();
            const tombstones = AUTH_FRAME_KEYS.map((slot) => ({
                slot,
                object_path: null,
                updated_by: adminId,
                updated_at: clearedAt,
            }));
            const { error: metadataError } = await supabase
                .from("studio_auth_frames")
                .upsert(tombstones, { onConflict: "slot" });
            if (metadataError) throw metadataError;
            if (objectPaths.length) {
                const { error: storageError } = await supabase.storage
                    .from(AUTH_FRAMES_BUCKET)
                    .remove(objectPaths);
                if (storageError) throw storageError;
            }
            saveCustomAuthFrames({});
            applyAuthFrameImages({});
            tell("Đã khôi phục 6 ảnh mặc định và đồng bộ cho toàn bộ thiết bị.");
        } catch (error) {
            console.error("Could not reset Studio images:", error);
            tell("Không thể khôi phục toàn bộ ảnh Studio trên Cloud.");
        }
    }

    // Setup Admin Studio UI handlers
    const adminStudioBtn = document.getElementById("tool-admin-studio");
    const neoQuickStudioBtn = document.getElementById("neo-quick-studio-btn");
    const adminStudioOverlay = document.getElementById("admin-studio-overlay");
    const studioCloseBtn = document.getElementById("studio-close-btn");
    const studioPreviewAuthBtn = document.getElementById("studio-preview-auth-btn");
    const studioResetDefaultsBtn = document.getElementById("studio-reset-defaults-btn");
    const studioFileInput = document.getElementById("admin-studio-file-input") as HTMLInputElement | null;

    let activeUploadSlot: string | null = null;

    function openAdminStudio() {
        if (member?.role !== "admin") {
            tell("Chỉ Admin mới được mở Studio Ảnh.");
            return;
        }
        applyAuthFrameImages();
        void syncAuthFramesFromSupabase();
        adminStudioOverlay?.classList.add("visible");
        adminStudioOverlay?.classList.add("is-open");
    }

    function closeAdminStudio() {
        adminStudioOverlay?.classList.remove("visible");
        adminStudioOverlay?.classList.remove("is-open");
    }

    if (adminStudioBtn) {
        adminStudioBtn.addEventListener("click", () => {
            openAdminStudio();
        });
    }

    if (neoQuickStudioBtn) {
        neoQuickStudioBtn.addEventListener("click", () => {
            // If inside auth modal, open admin studio overlay directly
            openAdminStudio();
        });
    }

    if (studioCloseBtn) {
        studioCloseBtn.addEventListener("click", () => {
            closeAdminStudio();
        });
    }

    if (studioPreviewAuthBtn) {
        studioPreviewAuthBtn.addEventListener("click", () => {
            // Close admin studio and open login modal to preview
            closeAdminStudio();
            setVisible(auth, true);
        });
    }

    if (studioResetDefaultsBtn) {
        studioResetDefaultsBtn.addEventListener("click", () => {
            if (confirm("Bạn có chắc chắn muốn khôi phục toàn bộ 6 khung ảnh về thiết kế mẫu mặc định không?")) {
                void resetStudioAuthFrames();
            }
        });
    }

    // Handle Upload & Clear per slot
    document.querySelectorAll(".btn-upload-slot").forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const btnEl = e.currentTarget as HTMLElement;
            const slot = btnEl.dataset.upload || btnEl.dataset.slot || btnEl.closest("[data-slot]")?.getAttribute("data-slot");
            if (slot && studioFileInput) {
                activeUploadSlot = slot;
                studioFileInput.value = "";
                studioFileInput.click();
            }
        });
    });

    document.querySelectorAll(".btn-clear-slot").forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const btnEl = e.currentTarget as HTMLElement;
            const slot = btnEl.dataset.clear || btnEl.dataset.slot || btnEl.closest("[data-slot]")?.getAttribute("data-slot");
            if (!slot || !isAuthFrameSlot(slot)) return;
            void clearStudioAuthFrame(slot);
        });
    });

    if (studioFileInput) {
        studioFileInput.addEventListener("change", () => {
            if (!studioFileInput.files || studioFileInput.files.length === 0 || !activeUploadSlot) return;
            const file = studioFileInput.files[0];
            const targetSlot = activeUploadSlot;
            activeUploadSlot = null;
            if (isAuthFrameSlot(targetSlot))
                void uploadStudioAuthFrame(targetSlot, file);
        });
    }

    // Initial frame hydration
    applyAuthFrameImages();
    void syncAuthFramesFromSupabase();
    window.addEventListener("online", () => {
        void syncAuthFramesFromSupabase();
    });
    if (supabase) {
        supabase
            .channel("studio-auth-frames-realtime")
            .on(
                "postgres_changes",
                {
                    event: "*",
                    schema: "public",
                    table: "studio_auth_frames",
                },
                () => {
                    void syncAuthFramesFromSupabase();
                },
            )
            .subscribe((status) => {
                if (status === "CHANNEL_ERROR" || status === "TIMED_OUT") {
                    console.error(
                        "Studio image realtime channel unavailable:",
                        status,
                    );
                }
            });
    }

    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (adminStudioOverlay?.classList.contains("visible")) {
            closeAdminStudio();
            return;
        }
        if (auth?.classList.contains("visible")) {
            setVisible(auth, false);
            pendingModule = "";
            document
                .getElementById("signpost-menu-totem")
                ?.classList.remove("is-auth-opening");
        } else if (workspace.classList.contains("visible")) {
            setVisible(workspace, false);
            document.body.style.overflow = "";
        }
    });
</script>
