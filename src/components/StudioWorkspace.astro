<section
    id="studio-auth"
    class="studio-overlay neo-overlay"
    aria-hidden="true"
    aria-label="Studio authentication"
>
    <!-- Background wallpaper for whole auth overlay (editable via Studio) -->
    <img id="auth-backdrop-bg-img" class="neo-auth-backdrop-cover" src="" alt="" aria-hidden="true" style="display: none;" />

    <!-- Master Thick Black Rounded Bezel (Neo-Brutalist Frame) -->
    <div class="auth-shell neo-auth-bezel">
        <!-- TOP WHITE CAPSULE HEADER BAR -->
        <header class="neo-top-bar">
            <!-- Left Brand -->
            <div class="neo-header-brand">
                <span class="neo-subtag">ONLINE PLATFORM FOR DESIGNERS</span>
                <div class="neo-brand-logo-wrap">
                    <span class="neo-brand-logo">Dsgnrs</span>
                    <span class="neo-reg-mark">®</span>
                </div>
            </div>

            <!-- Center & Right Utility Bar -->
            <div class="neo-header-right">
                <div class="neo-warning-badge">
                    <span class="warn-title">WARNING:</span>
                    <span class="warn-sub">GRAPHIC CONTENT</span>
                </div>

                <div class="neo-pill-btn neo-menu-pill">
                    <span>MENU</span>
                    <span class="neo-burger-icon">☰</span>
                </div>

                <div class="neo-pill-badge neo-users-badge">
                    <span class="badge-lbl">USERS</span>
                    <span class="badge-num">57343</span>
                </div>

                <!-- ColorMatch Swatch Barcode Strip -->
                <div class="neo-colormatch-strip">
                    <div class="colormatch-top-row">
                        <div class="color-swatches">
                            <span class="swatch s-magenta"></span>
                            <span class="swatch s-pink"></span>
                            <span class="swatch s-peach"></span>
                            <span class="swatch s-light"></span>
                        </div>
                        <span class="colormatch-label">MAGENTA</span>
                        <span class="colormatch-label">SAMPLE</span>
                    </div>
                    <div class="barcode-divider"></div>
                    <div class="colormatch-bottom-row">
                        <span class="barcode-strip">|||||||||||||||||||||||</span>
                        <span class="barcode-sub">LIBRARY</span>
                        <b class="colormatch-brand">COLORMATCH</b>
                    </div>
                </div>

                <!-- Master Close Button & Quick Studio Button -->
                <button
                    type="button"
                    class="neo-quick-studio-btn"
                    id="neo-quick-studio-btn"
                    title="Mở Studio quản lý & tải ảnh lên cho 6 khung ảnh"
                >
                    <span class="quick-spark">✦</span>
                    <span class="quick-text">Studio Ảnh</span>
                </button>

                <button
                    type="button"
                    class="neo-close-btn"
                    type="button"
                    class="neo-close-btn"
                    data-close
                    aria-label="Đóng"
                    title="Đóng bảng đăng nhập"
                >
                    ✕
                </button>
            </div>
        </header>

        <!-- MAIN 3-COLUMN BENTO GRID -->
        <div class="neo-bento-grid">
            <!-- COLUMN 1: LEFT TALL EDITORIAL PORTRAIT CARD -->
            <aside class="neo-card neo-left-card">
                <div class="left-card-header">
                    <div class="left-card-title">
                        <span>Graphic</span>
                        <span>Illustration</span>
                        <span>3d-modeling</span>
                    </div>
                    <div class="left-arrow-circle">↗</div>
                </div>

                <div class="left-portrait-stage" data-auth-frame="portrait" title="Khung ảnh Editorial (Admin có thể thay đổi)">
                    <img
                        id="auth-frame-portrait"
                        src="/assets/neo_design/portrait_clean.png"
                        alt="Creative Editorial Model with Iridescent Glasses"
                        class="left-portrait-img"
                    />
                </div>

                <div class="left-card-footer">
                    <span class="soc-pill soc-behance">Bē</span>
                    <span class="soc-pill soc-web">🌐</span>
                    <span class="soc-pill soc-twitter">𝕏</span>
                </div>
            </aside>

            <!-- COLUMN 2: CENTER AREA (UTILITY BAR + MAIN PEACH CARD WITH LOGIN FORM) -->
            <div class="neo-center-stack">
                <!-- TOP UTILITY CAPSULE BAR -->
                <div class="neo-utility-bar">
                    <!-- Software Icons -->
                    <div class="software-pills">
                        <span class="soft-circle">Ai</span>
                        <span class="soft-circle">Ps</span>
                        <span class="soft-circle">Ae</span>
                        <span class="soft-circle">Fg</span>
                    </div>

                    <!-- Login / Registration Switch -->
                    <div class="neo-tab-segmented">
                        <button type="button" class="neo-seg-btn is-active">Login</button>
                        <button type="button" class="neo-seg-btn">Registration</button>
                    </div>

                    <!-- Status Dots -->
                    <div class="neo-dots-row">
                        <span class="neo-dot dot-orange"></span>
                        <span class="neo-dot dot-dark"></span>
                        <span class="neo-dot dot-light"></span>
                    </div>

                    <!-- Search Pill -->
                    <div class="neo-search-pill">
                        <span>Search designers</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </div>
                </div>

                <!-- MAIN WARM PEACH / CREAM CARD HOSTING INTERACTIVE LOGIN -->
                <div class="neo-card neo-peach-card" id="auth-frame-peach" data-auth-frame="peach">
                    <img id="auth-peach-bg-img" class="neo-peach-bg-cover" src="" alt="" aria-hidden="true" style="display: none;" />
                    <!-- Top Title Section -->
                    <div class="peach-card-header">
                        <div class="peach-title-group">
                            <h1 class="peach-display-title">ONLINE</h1>
                            <p class="peach-display-sub">BEST PLATFORM FOR DESIGNERS IN THE WORLD</p>
                        </div>
                        <div class="peach-top-circle" title="AdolSoft Workspace Access">↗</div>
                    </div>

                    <!-- Middle Content: Login Form -->
                    <div class="peach-card-main">
                        <!-- Interactive Login Form -->
                        <form id="studio-login-form" class="peach-login-form">
                            <div class="neo-form-group">
                                <label for="studio-email" class="neo-form-label">
                                    MEMBER EMAIL
                                </label>
                                <div class="neo-input-pill">
                                    <input
                                        id="studio-email"
                                        name="email"
                                        type="email"
                                        autocomplete="username"
                                        placeholder="name@example.com"
                                        required
                                    />
                                </div>
                            </div>

                            <div class="neo-form-group">
                                <label for="studio-password" class="neo-form-label">
                                    PASSWORD
                                </label>
                                <div class="neo-input-pill">
                                    <input
                                        id="studio-password"
                                        name="password"
                                        type="password"
                                        autocomplete="current-password"
                                        placeholder="••••••••••"
                                        required
                                    />
                                    <span class="neo-input-icon">🔑</span>
                                </div>
                            </div>

                            <!-- Submit Unlock Button -->
                            <button class="neo-unlock-btn" type="submit">
                                <span>ENTER WORKSPACE</span>
                                <b class="neo-btn-arrow">↗</b>
                            </button>

                            <!-- Error Line -->
                            <p id="studio-login-error" class="login-error" aria-live="polite">
                                Không thể đăng nhập. Vui lòng kiểm tra thông tin.
                            </p>
                        </form>
                    </div>

                    <!-- Bottom Awwwards & Community Count -->
                    <div class="peach-card-footer">
                        <div class="awwwards-directory">
                            <span class="aww-title">AWWWARDS DESIGNERS</span>
                            <ul class="aww-roster">
                                <li>
                                    <span class="roster-name">Tada Golubchyk — Portfolio</span>
                                    <span class="roster-year">2026</span>
                                </li>
                                <li>
                                    <span class="roster-name">ICO Material Library</span>
                                    <span class="roster-year">2025</span>
                                </li>
                                <li>
                                    <span class="roster-name">SUZAKU CURRY SHOP ILLABS</span>
                                    <span class="roster-year">2025</span>
                                </li>
                            </ul>
                        </div>

                        <div class="peach-community-pill">
                            <div class="community-avatars">
                                <span class="comm-avatar ca1"></span>
                                <span class="comm-avatar ca2"></span>
                                <span class="comm-avatar ca3"></span>
                                <span class="comm-avatar ca4"></span>
                                <span class="comm-count">8000+</span>
                            </div>
                            <span class="comm-sub">More than 250 people have joined us</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMN 3: RIGHT BENTO GRID (6 MODULAR CREATIVE CARDS) -->
            <aside class="neo-right-bento">
                <!-- Row 1: Top Avatar (Left) & Orange Action (Right) -->
                <div class="neo-mini-card neo-card-avatar" data-auth-frame="avatar" title="Khung ảnh Avatar">
                    <img
                        id="auth-frame-avatar"
                        src="/assets/neo_design/r_avatar_clean.png"
                        alt="Cyber Designer Avatar"
                        class="mini-card-img"
                    />
                </div>

                <div class="neo-mini-card neo-card-orange">
                    <div class="orange-card-top">
                        <span class="orange-badge">TOP-10</span>
                    </div>
                    <p class="orange-card-txt">
                        designers are ready to work on your project
                    </p>
                    <div class="orange-card-arrow">↗</div>
                </div>

                <!-- Row 2: AF//02 Character (Left) & TS24 Stamp (Right) -->
                <div class="neo-mini-card neo-card-af02" data-auth-frame="af02" title="Khung ảnh Character AF//02">
                    <img
                        id="auth-frame-af02"
                        src="/assets/neo_design/r_af02_clean.png"
                        alt="AF 02-A CON Character"
                        class="mini-card-img"
                    />
                </div>

                <div class="neo-mini-card neo-card-stamp" data-auth-frame="stamp" title="Khung ảnh Con dấu TS24">
                    <img
                        id="auth-frame-stamp"
                        src="/assets/neo_design/r_ts24_clean.png"
                        alt="Property of TS24 Rotating Stamp"
                        class="stamp-spinning-img"
                    />
                </div>

                <!-- Row 3: Cyber Barcode Tag (Span 2) -->
                <div class="neo-mini-card neo-card-cyber" data-auth-frame="cyber" title="Khung ảnh Cyber Tag">
                    <img
                        id="auth-frame-cyber"
                        src="/assets/neo_design/r_cyber_clean.png"
                        alt="Cyberpunk Character Barcode Tag"
                        class="mini-card-img"
                    />
                </div>

                <!-- Row 4: Lilac Phone IP16 Card (Span 2) -->
                <div class="neo-mini-card neo-card-phone" data-auth-frame="phone" title="Khung ảnh Điện thoại IP16">
                    <img
                        id="auth-frame-phone"
                        src="/assets/neo_design/r_phone_clean.png"
                        alt="Smartphone IP16 with 3D liquid splashes"
                        class="phone-splash-img"
                    />
                </div>
            </aside>
        </div>
    </div>
</section>

<section
    id="studio-workspace"
    class="studio-overlay osom-overlay"
    aria-hidden="true"
    aria-label="OSOM Studio Workspace"
>
    <!-- Master Cockpit Shell with thick black rounded bezel -->
    <div class="osom-cockpit" id="studio-shell">
        <!-- Top Right Actions: Nút Out (Đăng xuất) đặt bên cạnh Nút Đóng bảng điều khiển -->
        <div class="osom-cockpit-actions">
            <!-- Nút Out: Đăng xuất tài khoản -->
            <button
                type="button"
                class="osom-action-btn osom-logout-btn"
                id="osom-top-logout-btn"
                data-logout
                aria-label="Đăng xuất tài khoản"
                title="Đăng xuất tài khoản (Out)"
            >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Out</span>
            </button>

            <!-- Close button to dismiss the dashboard -->
            <button
                type="button"
                class="osom-action-btn osom-close-btn"
                data-close-workspace
                aria-label="Đóng bảng điều khiển"
                title="Đóng bảng điều khiển"
            >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- COLUMN 1: LEFT WHITE CARD -->
        <aside class="osom-card osom-card-left">
            <div class="osom-card-top">
                <!-- Brand logo + OSOM -->
                <div class="osom-brand">
                    <svg class="osom-cube-icon" viewBox="0 0 32 32" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                        <path d="M16 3L28 9.5V22.5L16 29L4 22.5V9.5L16 3Z"/>
                        <path d="M16 3V29"/>
                        <path d="M4 9.5L16 16L28 9.5"/>
                    </svg>
                    <span class="osom-brand-title">OSOM</span>
                    <span class="osom-brand-reg">®</span>
                </div>

                <!-- Navigation Bar (Nút T A C O & Menu 3 gạch chuyển sang Cột Trái) -->
                <nav class="osom-floating-nav osom-taco-left" aria-label="Dashboard navigation">
                    <button type="button" class="osom-nav-circle-btn" aria-label="Menu" title="Menu bảng làm việc">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <line x1="3" y1="12" x2="21" y2="12"/>
                            <line x1="3" y1="18" x2="21" y2="18"/>
                        </svg>
                    </button>
                    <div class="osom-nav-pills-bar" role="tablist">
                        <button type="button" class="osom-pill-btn" data-module="t" role="tab" aria-selected="false" title="T · Telemetry">
                            <b>T</b><span class="pill-text"> · TELEMETRY</span>
                        </button>
                        <button type="button" class="osom-pill-btn" data-module="a" role="tab" aria-selected="false" title="A · Assets">
                            <b>A</b><span class="pill-text"> · ASSETS</span>
                        </button>
                        <button type="button" class="osom-pill-btn is-active" data-module="c" role="tab" aria-selected="true" title="C · Clients">
                            <b>C</b><span class="pill-text"> · CLIENTS</span>
                        </button>
                        <button type="button" class="osom-pill-btn" data-module="o" role="tab" aria-selected="false" title="O · Operations">
                            <b>O</b><span class="pill-text"> · OPERATIONS</span>
                        </button>
                    </div>
                </nav>

                <!-- 3D Digital Head Sculpture Display Container -->
                <div class="osom-head-stage">
                    <img
                        src="/assets/osom_head_sculpture_2x.png"
                        alt="3D Digital Head Sculpture"
                        class="osom-head-img"
                    />
                </div>
            </div>

            <!-- Lower Stat & Description -->
            <div class="osom-card-bottom">
                <div class="osom-temp-stat">
                    <span class="osom-temp-num">—</span>
                    <span class="osom-temp-deg"></span>
                    <span class="osom-temp-dot"></span>
                </div>

                <p class="osom-desc-text">
                    Khách hàng và dự án được tải từ Supabase.
                </p>

                <div class="osom-pill-badge">
                    <span>Supabase Workspace</span>
                </div>
            </div>
        </aside>

        <!-- COLUMN 2: CENTER HERO 3D CARD (INTERACTIVE CANVAS & WORKSPACE) -->
        <main class="osom-card osom-card-center" id="osom-center-stage">
            <!-- Background 3D Custom Art with Grid Dots Overlay -->
            <div class="osom-center-art-bg">
                <img
                    src="/assets/osom_center_custom_bg.jpg"
                    alt="3D Iridescent Liquid Obsidian Background"
                    class="osom-bg-img"
                />
                <div class="osom-canvas-grid-overlay"></div>
            </div>

            <!-- Top Header Controls Container: Floating Canvas Toolbar sát mép trên -->
            <div class="osom-center-top-controls">
                <!-- Floating Canvas Toolbar (Miro / Excalidraw Style) -->
                <div class="osom-canvas-toolbar" id="canvas-toolbar" role="toolbar" aria-label="Thanh công cụ vẽ">
                    <!-- Tool: Pen -->
                    <button type="button" class="canvas-tool-btn is-active" id="tool-pen" data-tool="pen" aria-pressed="true" title="Bút vẽ tự do (P)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                            <path d="M2 2l7.586 7.586"/>
                            <circle cx="11" cy="11" r="2"/>
                        </svg>
                    </button>
                    <button type="button" class="canvas-tool-btn" id="tool-eraser" data-tool="eraser" aria-pressed="false" title="Tẩy nét vẽ (E)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m7 21-4-4a2 2 0 0 1 0-3l9-9a2 2 0 0 1 3 0l6 6a2 2 0 0 1 0 3l-7 7z"/>
                            <path d="m5 12 7 7"/>
                        </svg>
                    </button>

                    <!-- Color palette pills -->
                    <div class="canvas-color-palette" title="Chọn màu bút vẽ">
                        <button type="button" class="color-dot is-active" data-color="#ffffff" style="--c: #ffffff;" aria-label="Màu trắng" aria-pressed="true"></button>
                        <button type="button" class="color-dot" data-color="#22c55e" style="--c: #22c55e;" aria-label="Màu xanh neon" aria-pressed="false"></button>
                        <button type="button" class="color-dot" data-color="#f59e0b" style="--c: #f59e0b;" aria-label="Màu hổ phách" aria-pressed="false"></button>
                        <button type="button" class="color-dot" data-color="#06b6d4" style="--c: #06b6d4;" aria-label="Màu cyan" aria-pressed="false"></button>
                        <button type="button" class="color-dot" data-color="#ec4899" style="--c: #ec4899;" aria-label="Màu hồng" aria-pressed="false"></button>
                    </div>

                    <!-- Divider -->
                    <span class="toolbar-sep"></span>

                    <!-- Tool: Undo -->
                    <button type="button" class="canvas-tool-btn" id="tool-undo" title="Hoàn tác nét vẽ (Ctrl + Z)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1 4 1 10 7 10"/>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                        </svg>
                    </button>

                    <!-- Divider -->
                    <span class="toolbar-sep"></span>

                    <!-- Tool: Clear -->
                    <button type="button" class="canvas-tool-btn" id="tool-clear" title="Xoá tất cả bảng vẽ & ghi chú">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </button>

                    <!-- Real-time Cloud Auto-save Status Indicator -->
                    <div class="canvas-cloud-status" id="canvas-cloud-status" title="Tự động lưu thời gian thực">
                        <span class="cloud-status-dot" id="cloud-status-dot"></span>
                        <span class="cloud-status-text" id="cloud-status-text">Đã lưu</span>
                    </div>

                    <!-- Divider -->
                    <span class="toolbar-sep"></span>

                    <!-- Tool: Map Overview (25 Bảng làm việc) -->
                    <button type="button" class="canvas-tool-btn btn-map-toggle" id="tool-map-toggle" title="Phóng map xem toàn cảnh 25 bảng làm việc (M)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/>
                            <rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/>
                        </svg>
                        <span class="tool-label" id="map-toggle-label" style="display: none;">Phóng map</span>
                        <span class="board-indicator" id="current-board-badge" title="Bảng hiện tại">#01</span>
                    </button>

                    <!-- Divider -->
                    <span class="toolbar-sep" id="admin-studio-sep"></span>

                    <!-- Tool: Studio Admin Gallery Editor -->
                    <button type="button" class="canvas-tool-btn btn-admin-studio" id="tool-admin-studio" title="Studio Quản lý khung ảnh đăng nhập (Dành riêng cho Admin)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                        <span class="admin-spark-badge">✦</span>
                    </button>
                </div>
            </div>

            <!-- Interactive Drawing Canvas -->
            <canvas id="interactive-canvas" class="interactive-canvas is-drawing"></canvas>

            <!-- Admin Live Member Monitoring Notification Bar -->
            <div class="admin-monitoring-bar" id="admin-monitoring-bar" style="display: none;">
                <div class="monitor-bar-info">
                    <span class="monitor-pulse-dot"></span>
                    <span class="monitor-tag">ADMIN THEO DÕI</span>
                    <span class="monitor-sep">/</span>
                    <b id="monitor-member-name">Bảng #01 (Khoi Ng · Tech Lead)</b>
                </div>
                <div class="monitor-actions">
                    <button type="button" class="monitor-view-map-btn" id="monitor-view-map-btn" title="Mở lại bản đồ 25 bảng của thành viên">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span>Bản đồ 25 Bảng</span>
                    </button>
                    <button type="button" class="monitor-exit-btn" id="monitor-exit-btn" title="Thoát chế độ theo dõi, trở về bảng của Admin">
                        <span>Về bảng của tôi</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    </button>
                </div>
            </div>

            <!-- 25 Boards Map Overview Overlay Container -->
            <div id="canvas-map-overview" class="canvas-map-overview" aria-hidden="true">
                <div class="map-overview-banner" id="map-overview-banner">
                    <div class="map-banner-title">
