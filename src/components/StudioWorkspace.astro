    // ========================================================
    // INTERACTIVE CANVAS & 25 BOARDS MAP OVERVIEW ENGINE
    // ========================================================
    interface CanvasStrokePoint {
        x: number;
        y: number;
    }
    interface CanvasStroke {
        tool: "pen" | "eraser";
        color: string;
        width: number;
        points: CanvasStrokePoint[];
    }
    type CanvasConflictChoice = "cloud" | "local";
    interface CanvasConflictSnapshot {
        boardId: number;
        userId: string;
        localStrokes: CanvasStroke[];
        remoteStrokes: CanvasStroke[];
        remoteUpdatedAt: string | null;
    }
    interface PendingTeamCanvasEdit {
        ownerId: string;
        boardId: number;
        strokes: CanvasStroke[];
        baseUpdatedAt: string | null;
        revision: number;
    }
    interface BoardsMapData {
        version: 1 | 2;
        currentBoardId: number;
        boards: { [boardId: number]: CanvasStroke[] };
        dirtyBoards: number[];
        serverUpdatedAt?: Record<number, string>;
    }

    const TOTAL_BOARDS = 25;
    let currentBoardId = 1;
    let boardsStrokes: { [boardId: number]: CanvasStroke[] } = {};
    let dirtyCanvasBoards = new Set<number>();
    let pendingCanvasBoards = new Set<number>();
    let isMapOverviewOpen = false;
    let legacyCanvasDataNeedsMigration = false;
    let canvasDpr = 1;
    let canvasSyncTimer: number | undefined;
    let canvasSyncPromise: Promise<boolean> | null = null;
    let canvasSyncOwnerId: string | null = null;
    let canvasSyncRevision: Record<number, number> = {};
    let canvasSyncErrorShown = false;
    let canvasSyncRetryDelay = 1000;
    let canvasServerUpdatedAt: Record<number, string> = {};
    let ownCanvasRealtimeChannel: RealtimeChannel | null = null;
    let teamCanvasRealtimeChannel: RealtimeChannel | null = null;
    let teamCanvasLoadGeneration = 0;
    let teamCanvasSyncTimer: number | undefined;
    let teamCanvasSyncPromise: Promise<void> | null = null;
    let teamCanvasRetryDelay = 1000;
    let teamCanvasErrorShown = false;
    const pendingTeamCanvasEdits = new Map<string, PendingTeamCanvasEdit>();
    let canvasConflictDialog: HTMLDialogElement | null = null;
    let pendingCanvasConflictResolver:
        | ((choice: CanvasConflictChoice) => void)
        | null = null;
    let canvasConflictQueue: Promise<void> = Promise.resolve();

    let canvasStrokes: CanvasStroke[] = [];
    let activeCanvasUser = "guest";
    let canvasTool: "pen" | "eraser" = "pen";
    let canvasPenColor = "#ffffff";
    let canvasPenWidth = 3.5;
    let canvasEraserWidth = 30;
    let isCanvasDrawingMode = true;

    let canvasEl: HTMLCanvasElement | null = null;
    let canvasCtx: CanvasRenderingContext2D | null = null;
    let canvasMapOverviewEl: HTMLElement | null = null;
    let mapGridEl: HTMLElement | null = null;
    let toolMapToggle: HTMLElement | null = null;
    let mapToggleLabel: HTMLElement | null = null;
    let currentBoardBadge: HTMLElement | null = null;

    let isDrawingActive = false;
    let currentDrawingStroke: CanvasStroke | null = null;

    function getBoardsStorageKey(userId: string) {
        return `adolsoft_canvas_25boards_${userId || "guest"}`;
    }

    function emptyCanvasBoards() {
        const boards: { [boardId: number]: CanvasStroke[] } = {};
        for (let i = 1; i <= TOTAL_BOARDS; i++) boards[i] = [];
        return boards;
    }

    function parseCanvasStrokes(value: unknown): CanvasStroke[] {
        if (!Array.isArray(value)) return [];
        return value.filter((item): item is CanvasStroke => {
            if (!item || typeof item !== "object") return false;
            const stroke = item as Record<string, unknown>;
            return (
                (stroke.tool === "pen" || stroke.tool === "eraser") &&
                typeof stroke.color === "string" &&
                typeof stroke.width === "number" &&
                Number.isFinite(stroke.width) &&
                Array.isArray(stroke.points) &&
                stroke.points.every((point) => {
                    if (!point || typeof point !== "object") return false;
                    const coords = point as Record<string, unknown>;
                    return (
                        typeof coords.x === "number" &&
                        Number.isFinite(coords.x) &&
                        typeof coords.y === "number" &&
                        Number.isFinite(coords.y)
                    );
                })
            );
        });
    }

    function persistLocalCanvasState() {
        try {
            const data: BoardsMapData = {
                version: legacyCanvasDataNeedsMigration ? 1 : 2,
                currentBoardId,
                boards: boardsStrokes,
                dirtyBoards: [...dirtyCanvasBoards],
                serverUpdatedAt: canvasServerUpdatedAt,
            };
            localStorage.setItem(
                getBoardsStorageKey(activeCanvasUser),
                JSON.stringify(data),
            );
            return true;
        } catch (e) {
            console.warn("Could not save canvas state:", e);
            return false;
        }
    }

    function setCloudSaveStatus(status: "saved" | "saving" | "error") {
        const statusEl = document.getElementById("canvas-cloud-status");
        const dotEl = document.getElementById("cloud-status-dot");
        const textEl = document.getElementById("cloud-status-text");
        if (!statusEl || !textEl || !dotEl) return;

        statusEl.classList.remove("is-saving", "is-error");
        if (status === "saving") {
            statusEl.classList.add("is-saving");
            textEl.textContent = "Đang lưu...";
        } else if (status === "saved") {
            textEl.textContent = "Đã lưu";
        } else if (status === "error") {
            statusEl.classList.add("is-error");
            textEl.textContent = "Chưa kết nối";
        }
    }

    function scheduleCanvasSync(delay = 200) {
        setCloudSaveStatus("saving");
        if (!supabase || !member || activeCanvasUser !== member.id) {
            window.setTimeout(() => setCloudSaveStatus("saved"), 150);
            return;
        }
        if (canvasSyncTimer) {
            if (canvasSyncErrorShown) return;
            window.clearTimeout(canvasSyncTimer);
        }
        const scheduledDelay = canvasSyncErrorShown
            ? Math.max(delay, canvasSyncRetryDelay)
            : delay;
        canvasSyncTimer = window.setTimeout(() => {
            canvasSyncTimer = undefined;
            if (canvasSyncErrorShown) {
                canvasSyncRetryDelay = Math.min(
                    canvasSyncRetryDelay * 2,
                    30_000,
                );
            }
            void flushCanvasSync(false);
        }, scheduledDelay);
    }

    async function readRemoteCanvas(
        userId: string,
        boardId: number,
    ): Promise<CanvasConflictSnapshot> {
        if (!supabase) throw new Error("Supabase chưa được cấu hình.");
        const { data, error } = await supabase
            .from("studio_canvases")
            .select("strokes, updated_at")
            .eq("owner_id", userId)
            .eq("board_id", boardId)
            .maybeSingle();
        if (error) throw error;
        return {
            boardId,
            userId,
            localStrokes: [...(boardsStrokes[boardId] || [])],
            remoteStrokes: parseCanvasStrokes(data?.strokes),
            remoteUpdatedAt: data?.updated_at ?? null,
        };
    }

    async function writeCanvasSnapshot(
        userId: string,
        boardId: number,
        strokes: CanvasStroke[],
        expectedUpdatedAt: string | null,
    ): Promise<string | null> {
        if (!supabase) throw new Error("Supabase chưa được cấu hình.");
        if (expectedUpdatedAt) {
            const { data, error } = await supabase
                .from("studio_canvases")
                .update({ strokes })
                .eq("owner_id", userId)
                .eq("board_id", boardId)
                .eq("updated_at", expectedUpdatedAt)
                .select("updated_at")
                .maybeSingle();
            if (error) throw error;
            return data?.updated_at ?? null;
        }

        const { data, error } = await supabase
            .from("studio_canvases")
            .insert({ owner_id: userId, board_id: boardId, strokes })
            .select("updated_at")
            .maybeSingle();
        if (error?.code === "23505") return null;
        if (error) throw error;
        return data?.updated_at ?? null;
    }

    function requestCanvasConflict(
        snapshot: CanvasConflictSnapshot,
    ): Promise<CanvasConflictChoice> {
        const queuedRequest = canvasConflictQueue.then(
            () =>
                new Promise<CanvasConflictChoice>((resolve) => {
                    if (!canvasConflictDialog || !canvasConflictDialog.showModal) {
                        const useCloud = window.confirm(
                            `Bảng #${String(snapshot.boardId).padStart(2, "0")} có bản Cloud mới. OK để tải bản Cloud; Cancel để giữ bản hiện tại và ghi đè Cloud.`,
                        );
                        resolve(useCloud ? "cloud" : "local");
                        return;
                    }
                    const description = document.getElementById(
                        "canvas-conflict-description",
                    );
                    if (description) {
                        description.textContent =
                            `Bảng #${String(snapshot.boardId).padStart(2, "0")} của bạn đã được thay đổi trên thiết bị khác. ` +
                            "Bản vẽ hiện tại trên thiết bị này vẫn được giữ cho đến khi bạn chọn.";
                    }
                    pendingCanvasConflictResolver = (choice) => {
                        pendingCanvasConflictResolver = null;
                        if (canvasConflictDialog?.open)
                            canvasConflictDialog.close();
                        resolve(choice);
                    };
                    canvasConflictDialog.showModal();
                }),
        );
        canvasConflictQueue = queuedRequest.then(
            () => undefined,
            () => undefined,
        );
        return queuedRequest;
    }

    function getTeamCanvasEditKey(ownerId: string, boardId: number) {
        return `${ownerId}:${boardId}`;
    }

    function getTeamCanvasDraftStorageKey(ownerId: string, boardId: number) {
        return `adolsoft_admin_canvas_draft_${member?.id || "guest"}_${ownerId}_${boardId}`;
    }

    function persistTeamCanvasEdit(edit: PendingTeamCanvasEdit) {
        try {
            localStorage.setItem(
                getTeamCanvasDraftStorageKey(edit.ownerId, edit.boardId),
                JSON.stringify(edit),
            );
            return true;
        } catch (error) {
            console.error("Could not preserve admin canvas edit locally:", error);
            tell("Không thể lưu bản chỉnh sửa Admin trên thiết bị; vẫn đang thử lưu Cloud.");
            return false;
        }
    }

    function restoreTeamCanvasEdit(ownerId: string, boardId: number) {
        const key = getTeamCanvasEditKey(ownerId, boardId);
        const existing = pendingTeamCanvasEdits.get(key);
        if (existing) return existing;
        try {
            const raw = localStorage.getItem(
                getTeamCanvasDraftStorageKey(ownerId, boardId),
            );
            if (!raw) return null;
            const value: unknown = JSON.parse(raw);
            if (!value || typeof value !== "object")
                throw new Error("Bản nháp chỉnh sửa Admin không hợp lệ.");
            const record = value as Record<string, unknown>;
            if (
                record.ownerId !== ownerId ||
                Number(record.boardId) !== boardId ||
                typeof record.revision !== "number" ||
                (record.baseUpdatedAt !== null &&
                    typeof record.baseUpdatedAt !== "string")
            ) {
                throw new Error("Thông tin bản nháp chỉnh sửa Admin không hợp lệ.");
            }
            const edit: PendingTeamCanvasEdit = {
                ownerId,
                boardId,
                strokes: parseCanvasStrokes(record.strokes),
                baseUpdatedAt: record.baseUpdatedAt,
                revision: record.revision,
            };
            pendingTeamCanvasEdits.set(key, edit);
            return edit;
        } catch (error) {
            console.error("Could not restore admin canvas edit:", error);
            tell("Không thể đọc bản nháp chỉnh sửa Admin đã lưu trên thiết bị.");
            return null;
        }
    }

    function removeTeamCanvasEdit(edit: PendingTeamCanvasEdit) {
        pendingTeamCanvasEdits.delete(
            getTeamCanvasEditKey(edit.ownerId, edit.boardId),
        );
        try {
            localStorage.removeItem(
                getTeamCanvasDraftStorageKey(edit.ownerId, edit.boardId),
            );
        } catch (error) {
            console.error("Could not remove synced admin canvas draft:", error);
            tell("Bản vẽ đã đồng bộ nhưng không thể dọn bản nháp trên thiết bị.");
        }
    }

    function applyTeamCanvasSnapshot(
        ownerId: string,
        boardId: number,
        strokes: CanvasStroke[],
        updatedAt: string | null,
    ) {
        const profile = OTHER_MEMBERS[ownerId];
        if (!profile) return;
        profile.boards[boardId] = strokes;
        if (updatedAt) profile.serverUpdatedAt[boardId] = updatedAt;
        else delete profile.serverUpdatedAt[boardId];
        if (
            isMonitoringMember &&
            selectedOtherMemberId === ownerId &&
            monitoredMemberBoardId === boardId
        ) {
            canvasStrokes = [...strokes];
            redrawCanvas();
        }
        if (isMapOverviewOpen) renderMapGrid();
    }

    function scheduleTeamCanvasSync(delay = 200) {
        setCloudSaveStatus("saving");
        if (!supabase || member?.role !== "admin") {
            setCloudSaveStatus("error");
            tell("Chỉnh sửa bảng thành viên chỉ có thể đồng bộ khi đang đăng nhập Admin.");
            return;
        }
        if (teamCanvasSyncTimer) {
            if (teamCanvasErrorShown) return;
            window.clearTimeout(teamCanvasSyncTimer);
        }
        const scheduledDelay = teamCanvasErrorShown
            ? Math.max(delay, teamCanvasRetryDelay)
            : delay;
        teamCanvasSyncTimer = window.setTimeout(() => {
            teamCanvasSyncTimer = undefined;
            if (teamCanvasErrorShown) {
                teamCanvasRetryDelay = Math.min(
                    teamCanvasRetryDelay * 2,
                    30_000,
                );
            }
            void flushTeamCanvasEdits(false);
        }, scheduledDelay);
    }

    async function flushTeamCanvasEdits(notify: boolean) {
        if (!supabase || member?.role !== "admin") {
            setCloudSaveStatus("error");
            return;
        }
        if (teamCanvasSyncPromise) {
            await teamCanvasSyncPromise;
            if (notify && pendingTeamCanvasEdits.size === 0)
                tell("Bản chỉnh sửa bảng thành viên đã được đồng bộ.");
            return;
        }
        if (pendingTeamCanvasEdits.size === 0) {
            setCloudSaveStatus("saved");
            if (notify) tell("Không có chỉnh sửa bảng thành viên đang chờ lưu.");
            return;
        }

        const adminId = member.id;
        const syncTask = (async () => {
            for (const key of [...pendingTeamCanvasEdits.keys()]) {
                let resolved = false;
                let attempts = 0;
                while (!resolved && attempts < 4) {
                    if (member?.id !== adminId || member.role !== "admin")
                        return;
                    const edit = pendingTeamCanvasEdits.get(key);
                    if (!edit) {
                        resolved = true;
                        break;
                    }
                    const revision = edit.revision;
                    const strokes = JSON.parse(
                        JSON.stringify(edit.strokes),
                    ) as CanvasStroke[];
                    const updatedAt = await writeCanvasSnapshot(
                        edit.ownerId,
                        edit.boardId,
                        strokes,
                        edit.baseUpdatedAt,
                    );
                    if (member?.id !== adminId) return;

                    if (updatedAt) {
                        const profile = OTHER_MEMBERS[edit.ownerId];
                        if (profile)
                            profile.serverUpdatedAt[edit.boardId] = updatedAt;
                        const latest = pendingTeamCanvasEdits.get(key);
                        if (latest?.revision === revision) {
                            removeTeamCanvasEdit(latest);
                            applyTeamCanvasSnapshot(
                                edit.ownerId,
                                edit.boardId,
                                strokes,
                                updatedAt,
                            );
                            resolved = true;
                        } else if (latest) {
                            latest.baseUpdatedAt = updatedAt;
                            persistTeamCanvasEdit(latest);
                            attempts++;
                        } else {
                            resolved = true;
                        }
                        continue;
                    }

                    const remote = await readRemoteCanvas(
                        edit.ownerId,
                        edit.boardId,
                    );
                    if (member?.id !== adminId) return;
                    const choice = await requestCanvasConflict({
                        ...remote,
                        localStrokes: strokes,
                    });
                    if (member?.id !== adminId) return;
                    if (choice === "cloud") {
                        applyTeamCanvasSnapshot(
                            edit.ownerId,
                            edit.boardId,
                            remote.remoteStrokes,
                            remote.remoteUpdatedAt,
                        );
                        const latest = pendingTeamCanvasEdits.get(key);
                        if (latest) removeTeamCanvasEdit(latest);
                        resolved = true;
                    } else {
                        const latest = pendingTeamCanvasEdits.get(key);
                        if (latest) {
                            latest.baseUpdatedAt = remote.remoteUpdatedAt;
                            persistTeamCanvasEdit(latest);
                        }
                        const profile = OTHER_MEMBERS[edit.ownerId];
                        if (profile) {
                            if (remote.remoteUpdatedAt)
                                profile.serverUpdatedAt[edit.boardId] =
                                    remote.remoteUpdatedAt;
                            else delete profile.serverUpdatedAt[edit.boardId];
                        }
                        attempts++;
                    }
                }
                if (!resolved)
                    throw new Error(
                        "The member canvas kept changing; admin edits were retained locally.",
                    );
            }
        })();
        teamCanvasSyncPromise = syncTask;

        let failed = false;
        try {
            await syncTask;
            if (pendingTeamCanvasEdits.size === 0) {
                teamCanvasErrorShown = false;
                teamCanvasRetryDelay = 1000;
                setCloudSaveStatus("saved");
            }
        } catch (error) {
            console.error("Admin team canvas sync failed:", error);
            setCloudSaveStatus("error");
            failed = true;
            if (!teamCanvasErrorShown) {
                tell("Không thể lưu chỉnh sửa lên bảng thành viên. Bản nháp vẫn được giữ trên thiết bị; hệ thống sẽ thử lại.");
                teamCanvasErrorShown = true;
            }
        } finally {
            if (teamCanvasSyncPromise === syncTask)
                teamCanvasSyncPromise = null;
        }

        if (pendingTeamCanvasEdits.size > 0) {
            scheduleTeamCanvasSync(failed ? teamCanvasRetryDelay : 200);
        }
        if (notify)
            tell(
                pendingTeamCanvasEdits.size === 0
                    ? "Bản chỉnh sửa bảng thành viên đã được đồng bộ."
                    : "Bản chỉnh sửa vẫn được giữ trên thiết bị nhưng chưa đồng bộ.",
            );
    }

    function saveMonitoredCanvasState(notify = false) {
        if (
            !member ||
            member.role !== "admin" ||
            !isMonitoringMember ||
            !monitoredMemberBoardId
        ) {
            tell("Không xác định được bảng thành viên đang chỉnh sửa.");
            return false;
        }
        const ownerId = selectedOtherMemberId;
        const boardId = monitoredMemberBoardId;
        const profile = OTHER_MEMBERS[ownerId];
        if (!profile) {
            tell("Không tìm thấy hồ sơ thành viên cần lưu.");
            return false;
        }
        const key = getTeamCanvasEditKey(ownerId, boardId);
        const previous = pendingTeamCanvasEdits.get(key);
        const edit: PendingTeamCanvasEdit = {
            ownerId,
            boardId,
            strokes: [...canvasStrokes],
            baseUpdatedAt:
                previous?.baseUpdatedAt ??
                profile.serverUpdatedAt[boardId] ??
                null,
            revision: (previous?.revision || 0) + 1,
        };
        profile.boards[boardId] = [...edit.strokes];
        pendingTeamCanvasEdits.set(key, edit);
        const locallySaved = persistTeamCanvasEdit(edit);
        if (notify) void flushTeamCanvasEdits(true);
        else scheduleTeamCanvasSync();
        return locallySaved;
    }

    function applyRemoteCanvas(
        boardId: number,
        strokes: CanvasStroke[],
        updatedAt: string | null,
        userId: string,
    ) {
        boardsStrokes[boardId] = strokes;
        if (updatedAt) canvasServerUpdatedAt[boardId] = updatedAt;
        else delete canvasServerUpdatedAt[boardId];
        dirtyCanvasBoards.delete(boardId);
        pendingCanvasBoards.delete(boardId);
        if (
            activeCanvasUser === userId &&
            currentBoardId === boardId &&
            !isMonitoringMember
        ) {
            canvasStrokes = [...strokes];
            redrawCanvas();
        }
        persistLocalCanvasState();
        if (isMapOverviewOpen) renderMapGrid();
    }

    async function flushCanvasSync(notify: boolean) {
        if (!supabase || !member || activeCanvasUser !== member.id) {
            setCloudSaveStatus("error");
            return false;
        }
        if (canvasSyncPromise && canvasSyncOwnerId === member.id) {
            const synced = await canvasSyncPromise;
            setCloudSaveStatus(synced ? "saved" : "error");
            if (notify)
                tell(
                    synced
                        ? "Bản vẽ đã được đồng bộ."
                        : "Bản vẽ vẫn được giữ trên thiết bị nhưng chưa đồng bộ.",
                );
            return synced;
        }

        const userId = member.id;
        const boardIds = [...pendingCanvasBoards];
        if (boardIds.length === 0) {
            setCloudSaveStatus("saved");
            if (notify) tell("Bản vẽ đã được đồng bộ.");
            return true;
        }

        const syncTask = (async () => {
            for (const boardId of boardIds) {
                let resolved = false;
                let attempts = 0;
                while (!resolved && attempts < 4) {
                    if (activeCanvasUser !== userId) return false;
                    if (!pendingCanvasBoards.has(boardId)) {
                        resolved = true;
                        break;
                    }
                    const revision = canvasSyncRevision[boardId] || 0;
                    const strokes = JSON.parse(
                        JSON.stringify(boardsStrokes[boardId] || []),
                    ) as CanvasStroke[];
                    const updatedAt = await writeCanvasSnapshot(
                        userId,
                        boardId,
                        strokes,
                        canvasServerUpdatedAt[boardId] || null,
                    );
                    if (activeCanvasUser !== userId) return false;
                    if (updatedAt) {
                        canvasServerUpdatedAt[boardId] = updatedAt;
                        if ((canvasSyncRevision[boardId] || 0) === revision) {
                            pendingCanvasBoards.delete(boardId);
                            dirtyCanvasBoards.delete(boardId);
                            resolved = true;
                        }
                        persistLocalCanvasState();
                        attempts++;
                        continue;
                    }

                    const snapshot = await readRemoteCanvas(userId, boardId);
                    if (activeCanvasUser !== userId) return false;
                    const choice = await requestCanvasConflict(snapshot);
                    if (activeCanvasUser !== userId) return false;
                    if (choice === "cloud") {
                        applyRemoteCanvas(
                            boardId,
                            snapshot.remoteStrokes,
                            snapshot.remoteUpdatedAt,
                            userId,
                        );
                        resolved = true;
                    } else {
                        if (snapshot.remoteUpdatedAt) {
                            canvasServerUpdatedAt[boardId] =
                                snapshot.remoteUpdatedAt;
                        } else {
                            delete canvasServerUpdatedAt[boardId];
                        }
                        attempts++;
                    }
                }
                if (!resolved)
                    throw new Error(
                        "The canvas kept changing on another device; sync was paused to protect both versions.",
                    );
            }
            persistLocalCanvasState();
            return pendingCanvasBoards.size === 0;
        })();
        canvasSyncPromise = syncTask;
        canvasSyncOwnerId = userId;

        let synced = false;
        let failed = false;
        try {
            synced = await syncTask;
            if (synced) {
                canvasSyncErrorShown = false;
                canvasSyncRetryDelay = 1000;
                setCloudSaveStatus("saved");
            }
        } catch (error) {
            console.error("Canvas sync failed:", error);
            setCloudSaveStatus("error");
            failed = true;
            if (!canvasSyncErrorShown) {
                tell(
                    "Không thể đồng bộ bản vẽ. Bản cục bộ vẫn được giữ; hệ thống sẽ thử lại chậm dần.",
                );
                canvasSyncErrorShown = true;
            }
        } finally {
            if (canvasSyncPromise === syncTask) {
                canvasSyncPromise = null;
                canvasSyncOwnerId = null;
            }
        }

        if (pendingCanvasBoards.size > 0 && activeCanvasUser === userId) {
            const delay = failed ? canvasSyncRetryDelay : 200;
            scheduleCanvasSync(delay);
        }
        if (notify)
            tell(
                synced
                    ? "Bản vẽ đã được đồng bộ."
                    : "Bản vẽ vẫn được giữ trên thiết bị nhưng chưa đồng bộ.",
            );
        return synced;
    }

    function getDisplayedCanvasBoardId() {
        return isMonitoringMember && monitoredMemberBoardId
            ? monitoredMemberBoardId
            : currentBoardId;
    }

    function saveCanvasState(notify = false) {
        if (isMonitoringMember) return saveMonitoredCanvasState(notify);
        boardsStrokes[currentBoardId] = [...canvasStrokes];
        if (supabase && member && activeCanvasUser === member.id) {
            dirtyCanvasBoards.add(currentBoardId);
            pendingCanvasBoards.add(currentBoardId);
            canvasSyncRevision[currentBoardId] =
                (canvasSyncRevision[currentBoardId] || 0) + 1;
        }
        const locallySaved = persistLocalCanvasState();
        if (supabase && member && activeCanvasUser === member.id) {
            if (notify) void flushCanvasSync(true);
            else scheduleCanvasSync();
        } else {
            setCloudSaveStatus("error");
            if (notify)
                tell(
                    locallySaved
                        ? "Đã lưu trên thiết bị này nhưng chưa đồng bộ Cloud."
                        : "Không thể lưu bản vẽ trên thiết bị.",
                );
        }
        return locallySaved;
    }

    function migrateLegacyCanvasData(width: number, height: number) {
        if (!legacyCanvasDataNeedsMigration || width <= 0 || height <= 0) return;
        const size = Math.min(width, height);
        for (let boardId = 1; boardId <= TOTAL_BOARDS; boardId++) {
            for (const stroke of boardsStrokes[boardId] || []) {
                stroke.width /= size;
                for (const point of stroke.points) {
                    point.x /= width;
                    point.y /= height;
                }
            }
            if (boardsStrokes[boardId]?.length && supabase && member) {
                dirtyCanvasBoards.add(boardId);
                pendingCanvasBoards.add(boardId);
                canvasSyncRevision[boardId] =
                    (canvasSyncRevision[boardId] || 0) + 1;
            }
        }
        legacyCanvasDataNeedsMigration = false;
        if (!persistLocalCanvasState()) {
            tell("Không thể chuyển đổi dữ liệu cũ để lưu bản vẽ.");
        }
        if (pendingCanvasBoards.size > 0) scheduleCanvasSync();
    }

    function loadCanvasForUser(userId: string) {
        if (teamCanvasSyncTimer) {
            window.clearTimeout(teamCanvasSyncTimer);
            teamCanvasSyncTimer = undefined;
        }
        pendingTeamCanvasEdits.clear();
        teamCanvasErrorShown = false;
        teamCanvasRetryDelay = 1000;
        if (teamCanvasRealtimeChannel && supabase) {
            void supabase.removeChannel(teamCanvasRealtimeChannel);
            teamCanvasRealtimeChannel = null;
        }
        teamCanvasLoadGeneration++;
        activeCanvasUser = userId || "guest";
        currentBoardId = 1;
        boardsStrokes = emptyCanvasBoards();
        dirtyCanvasBoards = new Set<number>();
        pendingCanvasBoards = new Set<number>();
        canvasSyncRevision = {};
        canvasServerUpdatedAt = {};
        canvasSyncRetryDelay = 1000;
        canvasSyncErrorShown = false;
        legacyCanvasDataNeedsMigration = false;
        if (canvasSyncTimer) {
            window.clearTimeout(canvasSyncTimer);
            canvasSyncTimer = undefined;
        }

        try {
            const legacyUserId =
                member?.id === activeCanvasUser ? member.code : activeCanvasUser;
            const raw =
                localStorage.getItem(getBoardsStorageKey(activeCanvasUser)) ||
                (legacyUserId !== activeCanvasUser
                    ? localStorage.getItem(getBoardsStorageKey(legacyUserId))
                    : null);
            if (raw) {
                const value: unknown = JSON.parse(raw);
                if (value && typeof value === "object") {
                    const data = value as Record<string, unknown>;
                    if (data.boards && typeof data.boards === "object") {
                        const savedBoards = data.boards as Record<string, unknown>;
                        for (let i = 1; i <= TOTAL_BOARDS; i++) {
                            boardsStrokes[i] = parseCanvasStrokes(savedBoards[i]);
                        }
                    }
                    if (Array.isArray(data.dirtyBoards)) {
                        dirtyCanvasBoards = new Set(
                            data.dirtyBoards.filter(
                                (id): id is number =>
                                    Number.isInteger(id) &&
                                    Number(id) >= 1 &&
                                    Number(id) <= TOTAL_BOARDS,
                            ),
                        );
                        pendingCanvasBoards = new Set(dirtyCanvasBoards);
                    }
                    if (
                        data.serverUpdatedAt &&
                        typeof data.serverUpdatedAt === "object"
                    ) {
                        const versions = data.serverUpdatedAt as Record<
                            string,
                            unknown
                        >;
                        for (let i = 1; i <= TOTAL_BOARDS; i++) {
                            const version = versions[i];
                            if (typeof version === "string")
                                canvasServerUpdatedAt[i] = version;
                        }
                    }
                    if (data.version !== 2) {
                        legacyCanvasDataNeedsMigration = true;
                    }
                    currentBoardId = Math.min(
                        TOTAL_BOARDS,
                        Math.max(1, Number(data.currentBoardId) || 1),
                    );
                }
            } else {
                // Backward compatibility: import from legacy single-board storage
                const oldRaw = localStorage.getItem(
                    `adolsoft_canvas_data_${legacyUserId}`,
                );
                if (oldRaw) {
                    const oldData: unknown = JSON.parse(oldRaw);
                    if (oldData && typeof oldData === "object") {
                        const strokes = (oldData as Record<string, unknown>).strokes;
                        if (Array.isArray(strokes)) {
                            boardsStrokes[1] = parseCanvasStrokes(strokes);
                            legacyCanvasDataNeedsMigration = true;
                        }
                    }
                }
            }
        } catch (error) {
            console.error("Could not load local canvas state:", error);
            boardsStrokes = emptyCanvasBoards();
            dirtyCanvasBoards = new Set<number>();
            currentBoardId = 1;
            tell("Không thể đọc bản vẽ đã lưu trên thiết bị.");
        }

        canvasStrokes = [...boardsStrokes[currentBoardId]];

        updateBoardBadge();
        redrawCanvas();
        if (supabase && userId !== "guest") {
            subscribeOwnCanvasRealtime(userId);
            void loadCanvasFromSupabase(userId);
        } else if (ownCanvasRealtimeChannel && supabase) {
            void supabase.removeChannel(ownCanvasRealtimeChannel);
            ownCanvasRealtimeChannel = null;
        }
    }

    function handleOwnCanvasRealtime(payload: {
        eventType: string;
        new: Record<string, unknown>;
        old: Record<string, unknown>;
    }, userId: string) {
        if (activeCanvasUser !== userId) return;
        const row = payload.eventType === "DELETE" ? payload.old : payload.new;
        if (row.owner_id !== userId) return;
        const boardId = Number(row.board_id);
        if (!Number.isInteger(boardId) || boardId < 1 || boardId > TOTAL_BOARDS)
            return;
        if (pendingCanvasBoards.has(boardId)) return;
        const updatedAt =
            payload.eventType === "DELETE"
                ? null
                : typeof row.updated_at === "string"
                  ? row.updated_at
                  : null;
        const previousUpdatedAt = canvasServerUpdatedAt[boardId];
        if (
            updatedAt &&
            previousUpdatedAt &&
            Date.parse(previousUpdatedAt) >= Date.parse(updatedAt)
        )
            return;
        const strokes =
            payload.eventType === "DELETE"
                ? []
                : parseCanvasStrokes(row.strokes);
        applyRemoteCanvas(boardId, strokes, updatedAt, userId);
        tell(`Bảng #${String(boardId).padStart(2, "0")} đã được cập nhật từ thiết bị khác.`);
    }

    function subscribeOwnCanvasRealtime(userId: string) {
        if (!supabase) return;
        if (ownCanvasRealtimeChannel) {
            void supabase.removeChannel(ownCanvasRealtimeChannel);
            ownCanvasRealtimeChannel = null;
        }
        ownCanvasRealtimeChannel = supabase
            .channel(`studio-canvas-own-${userId}`)
            .on(
                "postgres_changes",
                {
                    event: "*",
                    schema: "public",
                    table: "studio_canvases",
                    filter: `owner_id=eq.${userId}`,
                },
                (payload) =>
                    handleOwnCanvasRealtime(
                        {
                            eventType: payload.eventType,
                            new: payload.new as Record<string, unknown>,
                            old: payload.old as Record<string, unknown>,
                        },
                        userId,
                    ),
            )
            .subscribe((status) => {
                if (
                    status === "CHANNEL_ERROR" ||
                    status === "TIMED_OUT" ||
                    status === "CLOSED"
                ) {
                    console.error(
                        "Canvas realtime channel unavailable:",
                        status,
                    );
                    if (activeCanvasUser === userId)
                        tell("Realtime bảng vẽ chưa kết nối; tự đồng bộ khi tải lại hoặc lưu.");
                }
            });
    }

    async function loadCanvasFromSupabase(userId: string) {
        if (!supabase) return;
        const { data, error } = await supabase
            .from("studio_canvases")
            .select("board_id, strokes, updated_at")
            .eq("owner_id", userId);
        if (error) {
            console.error("Could not load canvas from Supabase:", error);
            if (activeCanvasUser === userId) {
                tell("Không thể đồng bộ bản vẽ; dữ liệu cục bộ vẫn được giữ.");
            }
            return;
        }
        if (activeCanvasUser !== userId) return;

        const remoteBoardIds = new Set<number>();
        for (const row of data || []) {
            const boardId = Number(row.board_id);
            if (boardId < 1 || boardId > TOTAL_BOARDS || !Number.isInteger(boardId)) {
                continue;
            }
            remoteBoardIds.add(boardId);
            const remoteStrokes = parseCanvasStrokes(row.strokes);
            const remoteUpdatedAt =
                typeof row.updated_at === "string" ? row.updated_at : null;
            if (dirtyCanvasBoards.has(boardId)) {
                if (
                    JSON.stringify(boardsStrokes[boardId]) ===
                    JSON.stringify(remoteStrokes)
                ) {
                    if (remoteUpdatedAt)
                        canvasServerUpdatedAt[boardId] = remoteUpdatedAt;
                    pendingCanvasBoards.delete(boardId);
                    dirtyCanvasBoards.delete(boardId);
                } else if (
                    !canvasServerUpdatedAt[boardId] ||
                    canvasServerUpdatedAt[boardId] !== remoteUpdatedAt
                ) {
                    const snapshot: CanvasConflictSnapshot = {
                        boardId,
                        userId,
                        localStrokes: [...boardsStrokes[boardId]],
                        remoteStrokes,
                        remoteUpdatedAt,
                    };
                    const choice = await requestCanvasConflict(snapshot);
                    if (activeCanvasUser !== userId) return;
                    if (choice === "cloud") {
                        applyRemoteCanvas(
                            boardId,
                            remoteStrokes,
                            remoteUpdatedAt,
                            userId,
                        );
                    } else {
                        if (remoteUpdatedAt)
                            canvasServerUpdatedAt[boardId] = remoteUpdatedAt;
                        pendingCanvasBoards.add(boardId);
                    }
                } else {
                    if (remoteUpdatedAt)
                        canvasServerUpdatedAt[boardId] = remoteUpdatedAt;
                    pendingCanvasBoards.add(boardId);
                }
                continue;
            }
            const cachedUpdatedAt = canvasServerUpdatedAt[boardId];
            if (
                cachedUpdatedAt &&
                remoteUpdatedAt &&
                Date.parse(cachedUpdatedAt) > Date.parse(remoteUpdatedAt)
            )
                continue;
            boardsStrokes[boardId] = remoteStrokes;
            if (remoteUpdatedAt)
                canvasServerUpdatedAt[boardId] = remoteUpdatedAt;
        }

        for (let boardId = 1; boardId <= TOTAL_BOARDS; boardId++) {
            if (remoteBoardIds.has(boardId)) continue;
            const hadCloudVersion = Boolean(canvasServerUpdatedAt[boardId]);
            if (dirtyCanvasBoards.has(boardId) && hadCloudVersion) {
                const choice = await requestCanvasConflict({
                    boardId,
                    userId,
                    localStrokes: [...boardsStrokes[boardId]],
                    remoteStrokes: [],
                    remoteUpdatedAt: null,
                });
                if (activeCanvasUser !== userId) return;
                if (choice === "cloud") {
                    applyRemoteCanvas(boardId, [], null, userId);
                } else {
                    delete canvasServerUpdatedAt[boardId];
                    pendingCanvasBoards.add(boardId);
                }
            } else if (hadCloudVersion) {
                applyRemoteCanvas(boardId, [], null, userId);
            } else if (boardsStrokes[boardId].length > 0) {
                dirtyCanvasBoards.add(boardId);
                pendingCanvasBoards.add(boardId);
            }
        }
        canvasStrokes = [...boardsStrokes[currentBoardId]];
        redrawCanvas();
        if (!persistLocalCanvasState()) {
            tell("Bản vẽ đã tải nhưng không thể lưu bản sao trên thiết bị.");
        }
        if (pendingCanvasBoards.size > 0) scheduleCanvasSync();
    }

    function updateBoardBadge() {
        if (currentBoardBadge) {
            currentBoardBadge.textContent = `#${String(currentBoardId).padStart(2, "0")}`;
        }
    }

    function switchToBoard(targetBoardId: number) {
        const nextId = Math.min(TOTAL_BOARDS, Math.max(1, targetBoardId));
        // Save current strokes before switching
        boardsStrokes[currentBoardId] = [...canvasStrokes];

        currentBoardId = nextId;
        canvasStrokes = Array.isArray(boardsStrokes[currentBoardId])
            ? [...boardsStrokes[currentBoardId]]
            : [];

        updateBoardBadge();
        closeMapOverview();
        redrawCanvas();
        if (!persistLocalCanvasState()) {
            tell("Không thể lưu bảng đang chọn trên thiết bị.");
        }
        tell(`Đã chuyển sang Bảng làm việc #${String(currentBoardId).padStart(2, "0")} / 25`);
    }

    // ========================================================
    // 25 BOARDS OF OTHER MEMBERS (ADMIN MONITORING ENGINE)
    // ========================================================
    interface OtherMemberProfile {
        id: string;
        name: string;
        role: string;
        color: string;
        boards: { [boardId: number]: CanvasStroke[] };
        serverUpdatedAt: Record<number, string>;
    }

    function createEmpty25Boards(): { [boardId: number]: CanvasStroke[] } {
        const boards: { [boardId: number]: CanvasStroke[] } = {};
        for (let b = 1; b <= TOTAL_BOARDS; b++) {
            boards[b] = [];
        }
        return boards;
    }

    // 4 THÀNH VIÊN CÒN LẠI TRONG HỆ SINH THÁI STUDIO (NGOÀI ADMIN LÊ TRƯỜNG DUY)
    // Toàn bộ 25 bảng của các thành viên đều để trống ban đầu, chỉ hiển thị nét vẽ khi thành viên thực tế vẽ và lưu
    const OTHER_MEMBERS: Record<string, OtherMemberProfile> = {};

    let selectedOtherMemberId = "";
    let isAdminMode = true; // Bật sẵn chế độ Admin để kiểm thử hoặc khi member.role === 'admin'
    let adminMapTab: "team" | "own" = "team";
    let isMonitoringMember = false;
    let monitoredMemberBoardId: number | null = null;
    let preMonitoringStrokes: CanvasStroke[] = [];

    async function syncSupabaseTeamMembers() {
        if (!supabase) return;
        const { data, error } = await supabase
            .from("studio_members")
            .select("id, member_code, name, role, label, color")
            .neq("role", "admin")
            .order("member_code");
        if (error) {
            console.error("Could not load studio team members:", error);
            tell("Không tải được danh sách thành viên. Kiểm tra migration và quyền RLS Admin.");
            return;
        }

        const selectEl = document.getElementById(
            "admin-target-member-select",
        ) as HTMLSelectElement | null;
        if (!selectEl) return;
        selectEl.replaceChildren();
        for (const id of Object.keys(OTHER_MEMBERS)) delete OTHER_MEMBERS[id];
        if (!data?.length) {
            const emptyOption = document.createElement("option");
            emptyOption.disabled = true;
            emptyOption.textContent =
                "Chưa tìm thấy hồ sơ thành viên — kiểm tra migration/RLS";
            selectEl.appendChild(emptyOption);
            tell(
                "Không tìm thấy hồ sơ thành viên ngoài Admin. Chạy migration 20261112230000_admin_monitor_canvases.sql và kiểm tra các dòng U02–U05 trong studio_members.",
            );
        }
        for (const profile of data || []) {
            const option = document.createElement("option");
            option.value = profile.id;
            option.textContent = `${profile.name} (${profile.label || profile.role})`;
            selectEl.appendChild(option);
            OTHER_MEMBERS[profile.id] = {
                id: profile.id,
                name: profile.name,
                role: profile.label || profile.role,
                color: profile.color || "#00f0ff",
                boards: OTHER_MEMBERS[profile.id]?.boards || createEmpty25Boards(),
                serverUpdatedAt:
                    OTHER_MEMBERS[profile.id]?.serverUpdatedAt || {},
            };
        }
        const ownOption = document.createElement("option");
        ownOption.value = "own";
        ownOption.textContent = "Bảng vẽ của tôi (Admin)";
        selectEl.appendChild(ownOption);

        if (
            selectedOtherMemberId !== "own" &&
            !OTHER_MEMBERS[selectedOtherMemberId]
        ) {
            selectedOtherMemberId = data?.[0]?.id || "own";
        }
        selectEl.value = selectedOtherMemberId;
        subscribeTeamCanvas(selectedOtherMemberId);
        renderMapGrid();
        if (selectedOtherMemberId !== "own") {
            await fetchMemberCanvasesFromSupabase(selectedOtherMemberId);
        }
    }

    async function fetchMemberCanvasesFromSupabase(memberId: string) {
        if (!supabase || memberId === "own") return;
        const memberProfile = OTHER_MEMBERS[memberId];
        if (!memberProfile) return;
        const generation = ++teamCanvasLoadGeneration;
        const { data, error } = await supabase
            .from("studio_canvases")
            .select("board_id, strokes, updated_at")
            .eq("owner_id", memberId);
        if (generation !== teamCanvasLoadGeneration) return;
        if (error) {
            console.error("Could not load team canvas:", error);
            tell(`Không tải được bản vẽ của ${memberProfile.name}. Kiểm tra quyền RLS Admin.`);
            return;
        }
        const boards = createEmpty25Boards();
        const serverUpdatedAt: Record<number, string> = {};
        for (const row of data || []) {
            const boardId = Number(row.board_id);
            if (
                Number.isInteger(boardId) &&
                boardId >= 1 &&
                boardId <= TOTAL_BOARDS
            ) {
                const pendingKey = getTeamCanvasEditKey(memberId, boardId);
                if (typeof row.updated_at === "string")
                    serverUpdatedAt[boardId] = row.updated_at;
                if (!pendingTeamCanvasEdits.has(pendingKey)) {
                    boards[boardId] = parseCanvasStrokes(row.strokes);
                }
            }
        }
        for (const [boardId, strokes] of Object.entries(boards)) {
            const numericBoardId = Number(boardId);
            if (pendingTeamCanvasEdits.has(getTeamCanvasEditKey(memberId, numericBoardId))) {
                boards[numericBoardId] =
                    pendingTeamCanvasEdits.get(
                        getTeamCanvasEditKey(memberId, numericBoardId),
                    )?.strokes || strokes;
            }
        }
        memberProfile.boards = boards;
        memberProfile.serverUpdatedAt = serverUpdatedAt;
        if (selectedOtherMemberId === memberId) renderMapGrid();
    }

    function subscribeTeamCanvas(memberId: string) {
        if (!supabase) return;
        if (teamCanvasRealtimeChannel) {
            void supabase.removeChannel(teamCanvasRealtimeChannel);
            teamCanvasRealtimeChannel = null;
        }
        if (memberId === "own") return;

        teamCanvasRealtimeChannel = supabase
            .channel(`studio-canvas-team-${memberId}`)
            .on(
                "postgres_changes",
                {
                    event: "*",
                    schema: "public",
                    table: "studio_canvases",
                    filter: `owner_id=eq.${memberId}`,
                },
                (payload) => {
                    if (selectedOtherMemberId !== memberId) return;
                    const row =
                        payload.eventType === "DELETE"
                            ? payload.old
                            : payload.new;
                    const boardId = Number(row.board_id);
                    const profile = OTHER_MEMBERS[memberId];
                    if (
                        !profile ||
                        !Number.isInteger(boardId) ||
                        boardId < 1 ||
                        boardId > TOTAL_BOARDS
                    )
                        return;
                    if (
                        pendingTeamCanvasEdits.has(
                            getTeamCanvasEditKey(memberId, boardId),
                        )
                    )
                        return;
                    profile.boards[boardId] =
                        payload.eventType === "DELETE"
                            ? []
                            : parseCanvasStrokes(row.strokes);
                    if (
                        payload.eventType !== "DELETE" &&
                        typeof row.updated_at === "string"
                    ) {
                        profile.serverUpdatedAt[boardId] = row.updated_at;
                    } else {
                        delete profile.serverUpdatedAt[boardId];
                    }
                    if (isMapOverviewOpen) renderMapGrid();
                    if (
                        isMonitoringMember &&
                        selectedOtherMemberId === memberId &&
                        monitoredMemberBoardId === boardId
                    ) {
                        canvasStrokes = [...profile.boards[boardId]];
                        redrawCanvas();
                    }
                },
            )
            .subscribe((status) => {
                if (
                    (status === "CHANNEL_ERROR" || status === "TIMED_OUT") &&
                    selectedOtherMemberId === memberId
                ) {
                    console.error("Team canvas realtime channel unavailable:", status);
                    tell("Cập nhật realtime của bảng thành viên chưa kết nối.");
                }
            });
    }

    function adminMonitorMemberBoard(memberKey: string, boardId: number) {
        const otherMember = OTHER_MEMBERS[memberKey];
        if (!otherMember) {
            tell("Không tìm thấy thành viên cần theo dõi.");
            return;
        }
        isMonitoringMember = true;
        monitoredMemberBoardId = boardId;
        preMonitoringStrokes = [...canvasStrokes];

        // Tải nét vẽ của Bảng đó lên bảng canvas chính
        const draft = restoreTeamCanvasEdit(memberKey, boardId);
        const targetStrokes =
            draft?.strokes || otherMember.boards[boardId] || [];
        if (draft) {
            otherMember.boards[boardId] = [...draft.strokes];
            scheduleTeamCanvasSync();
        }
        canvasStrokes = JSON.parse(JSON.stringify(targetStrokes));

        const monitorBar = document.getElementById("admin-monitoring-bar");
        const monitorName = document.getElementById("monitor-member-name");
        if (monitorBar && monitorName) {
            monitorBar.style.display = "flex";
            monitorName.textContent = `Bảng #${String(boardId).padStart(2, "0")} (${otherMember.name} · ${otherMember.role})`;
        }

        isCanvasDrawingMode = true;
        const modeToggle = document.getElementById("canvas-mode-toggle");
        const modeLabel = document.getElementById("canvas-mode-label");
        const slider = document.getElementById("canvas-mode-slider");
        const knob = slider?.querySelector<HTMLElement>(".osom-toggle-knob");
        if (canvasEl && modeToggle && modeLabel) {
            canvasEl.classList.remove("is-viewing");
            canvasEl.classList.add("is-drawing");
            modeToggle.classList.remove("is-view-mode");
            modeToggle.setAttribute("aria-checked", "true");
            modeLabel.textContent = "Admin chỉnh sửa trực tiếp";
            if (knob) knob.style.transform = "translateX(20px)";
        }

        closeMapOverview();
        redrawCanvas();
        tell(`Đang chỉnh sửa trực tiếp Bảng #${String(boardId).padStart(2, "0")} của ${otherMember.name}. Thay đổi sẽ lưu vào bảng của thành viên.`);
    }

    function exitAdminMonitoring() {
        if (!isMonitoringMember) return;
        isMonitoringMember = false;
        monitoredMemberBoardId = null;

        const monitorBar = document.getElementById("admin-monitoring-bar");
        if (monitorBar) monitorBar.style.display = "none";

        // Khôi phục lại nét vẽ bảng cá nhân của Admin
        canvasStrokes = Array.isArray(boardsStrokes[currentBoardId])
            ? [...boardsStrokes[currentBoardId]]
            : [...preMonitoringStrokes];

        // Khôi phục lại chế độ vẽ
        isCanvasDrawingMode = true;
        const modeToggle = document.getElementById("canvas-mode-toggle");
        const modeLabel = document.getElementById("canvas-mode-label");
        const slider = document.getElementById("canvas-mode-slider");
        const knob = slider?.querySelector<HTMLElement>(".osom-toggle-knob");
        if (canvasEl && modeToggle && modeLabel) {
            canvasEl.classList.remove("is-viewing");
            canvasEl.classList.add("is-drawing");
            modeToggle.classList.remove("is-view-mode");
            modeToggle.setAttribute("aria-checked", "true");
            modeLabel.textContent = isMonitoringMember
                ? "Admin chỉnh sửa trực tiếp"
                : "Chế độ vẽ";
            if (knob) knob.style.transform = "translateX(20px)";
        }

        redrawCanvas();
        tell("Đã trở về bảng làm việc cá nhân của bạn.");
    }

    function renderMiniStrokes(thumbCanvas: HTMLCanvasElement, strokeList: CanvasStroke[]) {
        const tCtx = thumbCanvas.getContext("2d");
        if (!tCtx) return;
        for (const stroke of strokeList) {
            if (!stroke.points || stroke.points.length === 0) continue;
            tCtx.save();
            if (stroke.tool === "eraser") {
                tCtx.globalCompositeOperation = "destination-out";
                tCtx.strokeStyle = "rgba(0,0,0,1)";
                tCtx.fillStyle = "rgba(0,0,0,1)";
            } else {
                tCtx.globalCompositeOperation = "source-over";
                tCtx.strokeStyle = stroke.color || "#ffffff";
                tCtx.fillStyle = stroke.color || "#ffffff";
            }
            tCtx.lineWidth = Math.max(1, stroke.width * 100);
            tCtx.lineCap = "round";
            tCtx.lineJoin = "round";
            if (stroke.points.length === 1) {
                tCtx.beginPath();
                tCtx.arc(
                    stroke.points[0].x * 160,
                    stroke.points[0].y * 100,
                    tCtx.lineWidth / 2,
                    0,
                    Math.PI * 2,
                );
                tCtx.fill();
            } else {
                tCtx.beginPath();
                tCtx.moveTo(stroke.points[0].x * 160, stroke.points[0].y * 100);
                for (let p = 1; p < stroke.points.length; p++) {
                    tCtx.lineTo(
                        stroke.points[p].x * 160,
                        stroke.points[p].y * 100,
                    );
                }
                tCtx.stroke();
            }
            tCtx.restore();
        }
    }

    function renderMapGrid() {
        if (!mapGridEl) return;
        // Sync current board strokes if drawing on own board
        if (!isMonitoringMember) {
            boardsStrokes[currentBoardId] = [...canvasStrokes];
        }
        mapGridEl.innerHTML = "";

        const effectiveAdmin = (member && member.role === "admin") || isAdminMode;
        const showOwn = selectedOtherMemberId === "own" || !effectiveAdmin;

        if (!showOwn) {
            // ADMIN MONITORING: 25 BOARDS OF THE SELECTED OTHER MEMBER
            const otherMember = OTHER_MEMBERS[selectedOtherMemberId];
            if (!otherMember) {
                const emptyState = document.createElement("p");
                emptyState.className = "studio-db-note";
                emptyState.textContent =
                    "Chưa có thành viên để hiển thị. Kiểm tra cấu hình hồ sơ và quyền RLS Admin.";
                mapGridEl.appendChild(emptyState);
                return;
            }
            const otherBoards = otherMember.boards;

            for (let b = 1; b <= TOTAL_BOARDS; b++) {
                const strokeList = otherBoards[b] || [];
                const hasStrokes = strokeList.length > 0;
                const isCurrentlyMonitored = isMonitoringMember && monitoredMemberBoardId === b;

                const card = document.createElement("div");
                card.className = `map-board-card is-member-card ${isCurrentlyMonitored ? "is-monitored-active" : ""}`;
                card.setAttribute("role", "button");
                card.setAttribute("tabindex", "0");
                card.setAttribute("title", `Bảng #${String(b).padStart(2, "0")} của ${otherMember.name} (${otherMember.role})`);

                card.innerHTML = `
                    <span class="board-mini-num">${String(b).padStart(2, "0")}</span>
                    ${hasStrokes ? '<span class="board-active-dot" style="background:#22c55e; box-shadow:0 0 6px #22c55e;" title="Bảng có nét vẽ"></span>' : ''}
                    <canvas class="board-card-canvas" width="160" height="100"></canvas>
                `;

                const thumbCanvas = card.querySelector<HTMLCanvasElement>(".board-card-canvas");
                if (thumbCanvas && hasStrokes) {
                    renderMiniStrokes(thumbCanvas, strokeList);
                }

                card.addEventListener("click", () => {
                    adminMonitorMemberBoard(selectedOtherMemberId, b);
                });
                card.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        adminMonitorMemberBoard(selectedOtherMemberId, b);
                    }
                });

                mapGridEl.appendChild(card);
            }
        } else {
            // PERSONAL 25 BOARDS (NORMAL / ADMIN OWN WORKSPACE)
            for (let b = 1; b <= TOTAL_BOARDS; b++) {
                const card = document.createElement("div");
                card.className = `map-board-card ${b === currentBoardId && !isMonitoringMember ? "is-active-board" : ""}`;
                card.setAttribute("role", "button");
                card.setAttribute("tabindex", "0");
                card.setAttribute("title", `Phóng to Bảng #${String(b).padStart(2, "0")}`);

                const strokeList = boardsStrokes[b] || [];
                const hasStrokes = strokeList.length > 0;

                card.innerHTML = `
                    <span class="board-mini-num">${String(b).padStart(2, "0")}</span>
                    ${b === currentBoardId && !isMonitoringMember ? '<span class="board-active-dot" title="Bảng đang vẽ"></span>' : ''}
                    <canvas class="board-card-canvas" width="160" height="100"></canvas>
                `;

                const thumbCanvas = card.querySelector<HTMLCanvasElement>(".board-card-canvas");
                if (thumbCanvas && hasStrokes) {
                    renderMiniStrokes(thumbCanvas, strokeList);
                }

                card.addEventListener("click", () => {
                    if (isMonitoringMember) {
                        exitAdminMonitoring();
                    }
                    switchToBoard(b);
                });
                card.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        if (isMonitoringMember) {
                            exitAdminMonitoring();
                        }
                        switchToBoard(b);
                    }
                });

                mapGridEl.appendChild(card);
            }
        }
    }

