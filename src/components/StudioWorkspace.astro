        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--studio-accent) 30%, transparent),
            #071320 70%
        );
        box-shadow:
            0 0 26px color-mix(in srgb, var(--studio-accent) 45%, transparent),
            inset 0 0 24px
